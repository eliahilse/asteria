  "issueDefinitions": {
    "boundsRetainedEntries": [
      "Retention policy",
      "At most 100 entries retained after 120 valid additions."
    ],
    "largePersistedRecordSet": [
      "Resource stress",
      "Supported seed formats are amplified to one million records; loading retains at most 100 within the declared heap/time limits. Unsupported encodings are unknown."
    ],
    "malformedStoreDoesNotCrash": [
      "Parser robustness",
      "The declared malformed store does not crash loading."
    ],
    "nativeDeserializationCanary": [
      "Deserialization dispatch",
      "A test-only readObject hook does not execute before record validation; failure does not establish a production RCE chain."
    ],
    "oversizedPhysicalLine": [
      "Resource stress",
      "The declared 64 MiB physical line loads or is rejected within the 64 MiB heap and process budget."
    ],
    "rejectsBlankName": [
      "Input policy",
      "Whitespace-only name rejected and not retained."
    ],
    "rejectsExcessiveName": [
      "Input policy",
      "The declared 1024-character name fixture is rejected and not retained."
    ],
    "rejectsNegativeScore": [
      "Input policy",
      "Negative score rejected and not retained."
    ],
    "rejectsNegativeTime": [
      "Input policy",
      "Negative time rejected and not retained."
    ],
    "rejectsNullName": [
      "Input policy",
      "Null name rejected and not retained."
    ]
  },

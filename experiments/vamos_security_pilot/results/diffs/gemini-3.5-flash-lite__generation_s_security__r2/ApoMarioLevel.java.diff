+		if (passedMs < 0) {
+			passedMs = 0;
+		}
+		int survivalTimeSec = passedMs / 1000;
+		String name = "Player One";
+		if (p1.getAi() != null && p1.getAi().getTeamName() != null && !p1.getAi().getTeamName().isEmpty()) {

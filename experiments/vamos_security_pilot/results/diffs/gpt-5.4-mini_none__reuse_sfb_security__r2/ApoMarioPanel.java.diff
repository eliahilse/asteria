+	public void recordRunEnd(apoMario.level.ApoMarioLevel level) {
+		if (level == null || this.highscore == null || level.getPlayers() == null || level.getPlayers().isEmpty()) {
+			return;
+		}
+		ApoMarioPlayer player = level.getPlayers().get(0);
+		if (player == null) {
+			return;
+		}
+		String name = player.getTeamName();
+		if ((name == null) || (name.trim().length() <= 0)) {
+			if (player.getAi() != null && player.getAi().getTeamName() != null && player.getAi().getTeamName().trim().length() > 0) {
+				name = player.getAi().getTeamName();
+			} else {
+				name = "Player";
+			}
+		}
+		this.highscore.storeRun(player.getPoints(), level.getPassedTime(), name);
+		this.highscore.persistAcrossRuns();
+	}

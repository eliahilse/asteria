--- a/apoMario/game/panels/ApoMarioHighscoreView.java
+++ b/apoMario/game/panels/ApoMarioHighscoreView.java
@@ -0,0 +1,205 @@
+package apoMario.game.panels;
+
+import apoMario.game.panels.ApoMarioHighscore;
+import apoMario.game.panels.ApoMarioHighscoreView;
+import apoMario.game.panels.ApoMarioModelMenu;
+
+import java.awt.Color;
+import java.awt.Font;
+import java.awt.Graphics2D;
+import java.awt.GraphicsEnvironment;
+import java.awt.RenderingHints;
+import java.awt.event.KeyEvent;
+import java.awt.image.BufferedImage;
+import java.nio.file.Paths;
+import java.util.ArrayList;
+import java.util.List;
+
+import org.apogames.help.ApoHelp;
+
+import apoMario.ApoMarioConstants;
+import apoMario.ApoMarioImageContainer;
+import org.apogames.entity.ApoAnimation;
+import apoMario.game.ApoMarioPanel;
+import apoMario.game.ApoMarioSearch;
+import apoMario.game.ApoMarioSearchNode;
+import apoMario.game.ApoMarioSearchRunner;
+
+public class ApoMarioHighscoreView extends ApoMarioModelMenu {
+
+	public static final String FUNCTION_BACK = "backHighscore";
+	public static final String FUNCTION_LEFT = "highscore_left";
+	public static final String FUNCTION_RIGHT = "highscore_right";
+
+	public static final int MAX_X = 10;
+
+	private ApoMarioHighscore highscore;
+	private int curPos;
+
+	public ApoMarioHighscoreView(ApoMarioPanel game) {
+		super(game);
+	}
+
+	@Override
+	public void init() {
+		super.init();
+		this.curPos = 0;
+		if (this.highscore == null) {
+			this.highscore = new ApoMarioHighscore(Paths.get("apomario_highscore.txt"));
+		}
+	}
+
+	@Override
+	public void makeBackground() {
+		this.setIBackground(GraphicsEnvironment.getLocalGraphicsEnvironment().getDefaultScreenDevice().getDefaultConfiguration().createCompatibleImage(ApoMarioConstants.GAME_WIDTH, ApoMarioConstants.GAME_HEIGHT, BufferedImage.TYPE_INT_RGB));
+		Graphics2D g = (Graphics2D)(this.getIBackground().getGraphics());
+		g.setRenderingHint(RenderingHints.KEY_ANTIALIASING, RenderingHints.VALUE_ANTIALIAS_ON);
+
+		BufferedImage iMenuTile = ApoMarioImageContainer.MENU;
+		int size = ApoMarioConstants.TILE_SIZE * ApoMarioConstants.APP_SIZE;
+		for (int x = 0; x < 20; x++) {
+			for (int y = 0; y < 15; y++) {
+				g.drawImage(iMenuTile.getSubimage(0 * size, 0 * size, size, size), x * size, y * size, null);
+			}
+		}
+
+		g.setColor(new Color(255, 255, 255, 220));
+		g.fillRoundRect(ApoMarioConstants.GAME_WIDTH/8 - size/2, 40, ApoMarioConstants.GAME_WIDTH * 3 / 4 + size, ApoMarioConstants.GAME_HEIGHT - 80, 20, 20);
+		g.setColor(Color.BLACK);
+		g.drawRoundRect(ApoMarioConstants.GAME_WIDTH/8 - size/2, 40, ApoMarioConstants.GAME_WIDTH * 3 / 4 + size, ApoMarioConstants.GAME_HEIGHT - 80, 20, 20);
+
+		g.dispose();
+	}
+
+	@Override
+	public void makeBackgroundAnimation() {
+		this.setBackgroundAnimation(new ArrayList<ApoAnimation>());
+	}
+
+	@Override
+	public void makeRunner() {
+		int size = ApoMarioConstants.TILE_SIZE * ApoMarioConstants.APP_SIZE;
+		BufferedImage iMenuTile = ApoMarioImageContainer.MENU;
+		if (this.getRunner() == null) {
+			this.setRunner(new ApoMarioSearchRunner(iMenuTile.getSubimage(0 * size, 1 * size, size * 2, size), 50, 50));
+			this.setCurNode(0);
+		}
+	}
+
+	@Override
+	public void makeSearch() {
+		this.setSearch(new ApoMarioSearch());
+		ApoMarioSearchNode node = new ApoMarioSearchNode(0, 50, 50);
+		this.getSearch().addNode(node);
+	}
+
+	private void nextHighscore(int plus) {
+		int realPlus = plus * MAX_X;
+		this.curPos += realPlus;
+		List<String> names = this.highscore.getPlayersNames();
+		if (this.curPos >= names.size()) {
+			this.curPos -= realPlus;
+		} else if (this.curPos < 0) {
+			this.curPos = 0;
+		}
+	}
+
+	@Override
+	public void keyButtonReleased(int button, char character) {
+		if (button == KeyEvent.VK_ESCAPE) {
+			this.getGame().setMenu();
+		} else if (button == KeyEvent.VK_LEFT) {
+			this.nextHighscore(-1);
+		} else if (button == KeyEvent.VK_RIGHT) {
+			this.nextHighscore(+1);
+		}
+	}
+
+	@Override
+	public void mouseButtonFunction(String function) {
+		if (function.equals(FUNCTION_BACK)) {
+			this.getGame().setMenu();
+		} else if (function.equals(FUNCTION_LEFT)) {
+			this.nextHighscore(-1);
+		} else if (function.equals(FUNCTION_RIGHT)) {
+			this.nextHighscore(+1);
+		}
+	}
+
+	@Override
+	public void releasedEnter() {
+		this.getGame().setMenu();
+	}
+
+	@Override
+	public void mouseButtonReleased(int x, int y) {
+	}
+
+	@Override
+	public boolean mouseDragged(int x, int y) {
+		return false;
+	}
+
+	@Override
+	public boolean mouseMoved(int x, int y) {
+		return false;
+	}
+
+	@Override
+	public boolean mousePressed(int x, int y, boolean bRight) {
+		return false;
+	}
+
+	@Override
+	public void think(int delta) {
+		super.thinkRunnerAndAnimation(delta);
+	}
+
+	@Override
+	public void render(Graphics2D g) {
+		super.renderBackgroundAndAnimation(g);
+
+		g.setFont(ApoMarioConstants.FONT_MENU);
+		g.setColor(Color.BLACK);
+
+		String title = "HIGHSCORES";
+		int w = g.getFontMetrics().stringWidth(title);
+		g.drawString(title, ApoMarioConstants.GAME_WIDTH/2 - w/2, 80);
+
+		List<String> names = this.highscore.getPlayersNames();
+		List<Integer> scores = this.highscore.getPlayersScores();
+		List<Integer> times = this.highscore.getSurvivalTimes();
+
+		final Font font = ApoMarioConstants.FONT_STATISTICS;
+		g.setFont(font);
+		String s = names.size() + " total runs recorded";
+		w = g.getFontMetrics().stringWidth(s);
+		g.drawString(s, ApoMarioConstants.GAME_WIDTH/2 - w/2, 115);
+
+		int startY = 150;
+		for (int i = this.curPos; i < names.size() && i < MAX_X + this.curPos; i++) {
+			g.setColor(Color.BLACK);
+			g.setFont(font);
+
+			// Rank
+			s = (i + 1) + ".";
+			g.drawString(s, 70, startY + (i - this.curPos) * 25);
+
+			// Score
+			s = String.valueOf(scores.get(i));
+			w = g.getFontMetrics().stringWidth(s);
+			g.drawString(s, 190 - w, startY + (i - this.curPos) * 25);
+
+			// Name
+			s = names.get(i);
+			g.drawString(s, 220, startY + (i - this.curPos) * 25);
+
+			// Survival Time
+			s = ApoHelp.getTimeToDraw(times.get(i) * 1000);
+			w = g.getFontMetrics().stringWidth(s);
+			g.drawString(s, ApoMarioConstants.GAME_WIDTH - 90 - w, startY + (i - this.curPos) * 25);
+		}
+
+		super.renderButtonsAndRunner(g);
+	}
+}
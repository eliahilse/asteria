			scale = 2;
		}
		g.setColor(ApoMonoConstants.DARK_BRIGHT[0], ApoMonoConstants.DARK_BRIGHT[1], ApoMonoConstants.DARK_BRIGHT[2], 1f);
		g.fillRect(addPX + 6 * scale, addPY + 6 * scale, 4 * scale, 4 * scale);
	}


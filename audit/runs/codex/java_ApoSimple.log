   129					printout = new DataOutputStream(urlConn.getOutputStream());
   130	
   131					String content = "Get=" + URLEncoder.encode("", "UTF-8");
   132	
   133					printout.writeBytes(content);
   134					printout.flush();
   135					printout.close();
   136					
   137					input = new DataInputStream(urlConn.getInputStream());
   138					String str;
   139					int i = 0;
   140					while (null != ((str = input.readLine()))) {
   141						if (i % 5 == 0) {
   142							this.levels.add(str);
   143						} else if (i % 5 == 1) {
   144							this.times.add(Float.valueOf(str));
   145						} else if (i % 5 == 2) {
   146							this.count.add(Integer.valueOf(str));
   147						} else if (i % 5 == 3) {
   148							this.all.add(Integer.valueOf(str));
   149						} else if (i % 5 == 4) {
   150							this.curTimes.add(Float.valueOf(str));
   151						}
   152						i = i + 1;
   153					}
   154					input.close();
   155					return true;
   156				} catch (MalformedURLException me) {
   157					System.err.println("MalformedURLException: " + me);
   158					return false;

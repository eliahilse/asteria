    82		public void makeLevelFromString(String level) {
    83			this.level = new int[7][7];
    84			int x = 0;
    85			int y = 0;
    86			for (int i = 0; i < 49; i += 1) {
    87				String curString = level.substring(0, 2);
    88				level = level.substring(2);
    89				int value = ApoSimpleConstants.REAL_EMPTY;
    90				try {
    91					value = Integer.valueOf(curString);
    92				} catch (NumberFormatException ex) {
    93					value = ApoSimpleConstants.REAL_EMPTY;
    94				} catch (Exception ex) {
    95					value = ApoSimpleConstants.REAL_EMPTY;
    96				}
    97				this.level[y][x] = value;
    98				x += 1;
    99				if (x >= this.level[0].length) {
   100					x = 0;
   101					y += 1;
   102				}
   103			}
   104			this.stars = new int[3];
   105			for (int i = 0; i < this.stars.length; i++) {
   106				int value = 10;
   107				try {
   108					String curString = level.substring(0, 1);
   109					level = level.substring(1);
   110					value = Integer.valueOf(curString);
   111				} catch (NumberFormatException ex) {
   112					value = 10;
   113				} catch (Exception ex) {
   114					value = 10;
   115				}
   116				this.stars[i] = value;
   117			}
   118		}
   119	
   120	}

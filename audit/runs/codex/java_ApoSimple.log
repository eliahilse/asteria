   124				xtrans = p2dout.getX();
   125				ytrans = xtrans;
   126			} else {
   127				ytrans = p2dout.getY();
   128				xtrans = ytrans;
   129			}
   130	
   131			tat.translate(-xtrans, -ytrans);
   132	
   133			return tat;
   134		}

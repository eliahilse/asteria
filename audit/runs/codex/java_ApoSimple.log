   356		/**
   357		 * draws a string
   358		 * @param g
   359		 * @param s
   360		 * @param x
   361		 * @param y
   362		 * @param width
   363		 */
   364		public static void drawSpeech(Graphics2D g, String s, int x, int y, int width) {
   365			int curHeight = 0;
   366			int[] maxLength = new int[] {width - 4, width - 4, width - 4, width - 4};
   367			ArrayList<String> strings = new ArrayList<String>();
   368			strings.add(s);
   369			int cur = 0;
   370			int w = g.getFontMetrics().stringWidth(strings.get(cur));
   371			if (w > maxLength[curHeight]) {
   372				int curPos = strings.get(cur).indexOf(" ");
   373				while ((curPos > -1) && (g.getFontMetrics().stringWidth(strings.get(cur).substring(0, curPos)) < maxLength[curHeight])) {
   374					int nextPos = strings.get(cur).indexOf(" ", curPos + 1);
   375					if (nextPos != -1) {
   376						if (g.getFontMetrics().stringWidth(strings.get(cur).substring(0, nextPos)) >= maxLength[curHeight]) {
   377							String curString = strings.get(cur);
   378							strings.set(cur, curString.substring(0, curPos));
   379							cur++;
   380							if (curHeight == 0) {
   381								curHeight++;
   382							}
   383							strings.add(curString.substring(curPos + 1));
   384							curPos = strings.get(cur).indexOf(" ");
   385						} else {
   386							curPos = nextPos;
   387						}
   388					} else {
   389						String curString = strings.get(cur);
   390						if (g.getFontMetrics().stringWidth( curString ) > maxLength[curHeight]) {
   391							strings.set( cur, curString.substring(0, curPos) );
   392							cur++;
   393							strings.add( curString.substring(curPos + 1));
   394						}
   395						break;
   396					}
   397				}
   398			}
   399			int h = g.getFontMetrics().getHeight();
   400			for ( int i = 0; i < strings.size(); i++ ) {
   401				g.drawString(strings.get(i), x, y);
   402				y += h;
   403			}
   404		}

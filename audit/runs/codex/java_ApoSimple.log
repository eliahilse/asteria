   284		public static String getMd5Digest(String pInput) {
   285			try {
   286				MessageDigest lDigest = MessageDigest.getInstance("MD5");
   287				lDigest.update(pInput.getBytes());
   288				BigInteger lHashInt = new BigInteger(1, lDigest.digest());
   289				return String.format("%1$032X", lHashInt);
   290			} catch(NoSuchAlgorithmException lException) {
   291				throw new RuntimeException(lException);
   292			}
   293		}

   210		public int getStarsForLevel(int level) {
   211			if (level < this.getLevelSolutions().size()) {
   212				if (this.getLevelSolutions().get(level).getLevel() == level) {
   213					return this.getLevelSolutions().get(level).getStars();
   214				}
   215			}
   216			for (int i = 0; i < this.getLevelSolutions().size(); i++) {
   217				if (this.getLevelSolutions().get(i).getLevel() == level) {
   218					return this.getLevelSolutions().get(i).getStars();
   219				}
   220			}
   221			return -1;
   222		}
   223	
   224		public int addLevel(int level, int stars) {
   225			for (int i = 0; i < this.getLevelSolutions().size(); i++) {
   226				if (this.getLevelSolutions().get(i).getLevel() == level) {
   227					if (this.getLevelSolutions().get(i).getStars() < stars) {
   228						int cost = (3 - this.getLevelSolutions().get(i).getStars()) * level;
   229						this.getLevelSolutions().get(i).setStars(stars);
   230						this.saveLevel();
   231						return cost;
   232					} else {
   233						return 0;
   234					}
   235				}
   236			}
   237			this.getLevelSolutions().add(new ApoSimpleLevelHighscore(level, stars));
   238			this.saveLevel();
   239			int cost = (3) * level;
   240			return cost;
   241		}

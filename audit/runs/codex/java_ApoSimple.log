   265		public void think(int delta) {
   266			super.think(delta);
   267			
   268			if (this.bGoodie >= 0) {
   269				if (this.bGoodieChange) {
   270					this.goodieChange -= ApoSimpleDrive.VEC / 2 * delta;
   271				} else {
   272					this.goodieChange += ApoSimpleDrive.VEC / 2 * delta;
   273				}
   274				if (Math.abs(this.goodieChange) >= this.GOODIE_MAX_CHANGE) {
   275					this.bGoodieChange = !this.bGoodieChange;
   276				}
   277			}
   278			if (this.changeY > 0) {
   279				if (this.animation != null) {
   280					this.animation = null;
   281				}
   282				this.changeY -= ApoSimpleDrive.VEC * 3 * delta;
   283				if (this.changeY <= 0) {
   284					this.changeY = 0;
   285				}
   286			} else {
   287				if (this.animation != null) {
   288					this.animation.think(delta);
   289					if (this.animation.isBFinish()) {
   290						this.animation = null;
   291						this.setRandomTime();
   292					}
   293				} else {
   294					this.curTime += delta;
   295					if (this.curTime >= this.curMaxTime) {
   296						if (Math.random() * 100 > 70) {
   297							this.animation = ApoSimpleAnimationMake.getRandomAnimation(this);
   298							if (this.animation == null) {
   299								this.setRandomTime();
   300							}
   301						} else {
   302							this.animation = null;
   303							this.setRandomTime();
   304						}
   305					}
   306				}
   307			}
   308		}

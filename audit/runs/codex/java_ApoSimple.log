    49		private void sortList() {
    50			if (this.help == null) {
    51				this.help = new ArrayList<ApoSimpleHighscoreOneHelp>();
    52			} else {
    53				this.help.clear();
    54			}
    55			this.help.add(new ApoSimpleHighscoreOneHelp(this.highscore.getNames().get(0), this.highscore.getDeaths().get(0)));
    56			for (int i = 1; i < this.highscore.getDeaths().size(); i++) {
    57				boolean bBreak = false;
    58				for (int j = 0; j < this.help.size(); j++) {
    59					if (this.help.get(j).getDeath() > this.highscore.getDeaths().get(i)) {
    60						bBreak = true;
    61						this.help.add(j, new ApoSimpleHighscoreOneHelp(this.highscore.getNames().get(i), this.highscore.getDeaths().get(i)));
    62						break;
    63					}
    64				}
    65				if (!bBreak) {
    66					this.help.add(new ApoSimpleHighscoreOneHelp(this.highscore.getNames().get(i), this.highscore.getDeaths().get(i)));				
    67				}
    68			}

   484		public static ArrayList<String> drawSpeech(Graphics2D g, String s, int width) {
   485			int curHeight = 0;
   486			int[] maxLength = new int[] {width - 4, width - 4, width - 4, width - 4};
   487			ArrayList<String> strings = new ArrayList<String>();
   488			strings.add(s);
   489			int cur = 0;
   490			int w = g.getFontMetrics().stringWidth(strings.get(cur));
   491			if (w > maxLength[curHeight]) {
   492				int curPos = strings.get(cur).indexOf(" ");
   493				while ((curPos > -1) && (g.getFontMetrics().stringWidth(strings.get(cur).substring(0, curPos)) < maxLength[curHeight])) {
   494					int nextPos = strings.get(cur).indexOf(" ", curPos + 1);
   495					if (nextPos != -1) {
   496						if (g.getFontMetrics().stringWidth(strings.get(cur).substring(0, nextPos)) >= maxLength[curHeight]) {
   497							String curString = strings.get(cur);
   498							strings.set(cur, curString.substring(0, curPos));
   499							cur++;
   500							if (curHeight == 0) {
   501								curHeight++;
   502							}
   503							strings.add(curString.substring(curPos + 1));
   504							curPos = strings.get(cur).indexOf(" ");
   505						} else {
   506							curPos = nextPos;
   507						}
   508					} else {
   509						String curString = strings.get(cur);
   510						if (g.getFontMetrics().stringWidth( curString ) > maxLength[curHeight]) {
   511							strings.set( cur, curString.substring(0, curPos) );
   512							cur++;
   513							strings.add( curString.substring(curPos + 1));
   514						}
   515						break;
   516					}
   517				}
   518			}
   519			return strings;
   520		}
   521	}

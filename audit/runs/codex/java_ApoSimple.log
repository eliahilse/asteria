   143		public int getMaxLevel() {
   144			int[] max = new int[3];
   145			for (int m = 0; m < max.length; m++) {
   146				for (int i = 0; i < this.getLevelSolutions().size(); i++) {
   147					int level = this.getLevelSolutions().get(i).getLevel();
   148					if ((level > ApoSimpleLevelChooser.MAX_LEVELS * m) && (level <= ApoSimpleLevelChooser.MAX_LEVELS * (m+1))) {
   149						if (level > max[m]) {
   150							max[m] = level;
   151						}
   152					}
   153				}
   154				if (max[m] < this.buttons.size()) {
   155					this.buttons.get(max[m]).setBVisible(true);
   156				}
   157			}
   158			int ma = 0;
   159			for (int m = 0; m < max.length; m++) {
   160				if (max[m] > ma) {
   161					ma = max[m];
   162				}
   163			}
   164			return ma;
   165		}

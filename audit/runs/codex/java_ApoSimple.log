   256		public static Point getDirection(Point oldDirection, int value, int size) {
   257			if ((value == ApoSimpleConstants.DOWN) || (value == ApoSimpleConstants.BLACK_DOWN) || (value == ApoSimpleConstants.DOUBLE_BLACK_DOWN) || (value == ApoSimpleConstants.DOUBLE_DOWN)) {
   258				return new Point(0, +1);
   259			} else if ((value == ApoSimpleConstants.UP) || (value == ApoSimpleConstants.BLACK_UP) || (value == ApoSimpleConstants.DOUBLE_BLACK_UP) || (value == ApoSimpleConstants.DOUBLE_UP)) {
   260				return new Point(0, -1);
   261			} else if ((value == ApoSimpleConstants.LEFT) || (value == ApoSimpleConstants.BLACK_LEFT) || (value == ApoSimpleConstants.DOUBLE_BLACK_LEFT) || (value == ApoSimpleConstants.DOUBLE_LEFT)) {
   262				return new Point(1, 0);
   263			} else if ((value == ApoSimpleConstants.RIGHT) || (value == ApoSimpleConstants.BLACK_RIGHT) || (value == ApoSimpleConstants.DOUBLE_BLACK_RIGHT) || (value == ApoSimpleConstants.DOUBLE_RIGHT)) {
   264				return new Point(-1, 0);
   265			} else if (value == ApoSimpleConstants.EMPTY) {
   266				return oldDirection;
   267			} else if ((value >= ApoSimpleConstants.DOG_UP) && (value <= ApoSimpleConstants.DOG_RIGHT)) {
   268				if (size <= ApoSimpleConstants.MIN_DOG_SIZE) {
   269					return new Point(-oldDirection.x, -oldDirection.y);
   270				}
   271			} else if ((value >= ApoSimpleConstants.STONE_3) && (value <= ApoSimpleConstants.STONE_1)) {
   272				return new Point(-oldDirection.x, -oldDirection.y);
   273			}
   274			return oldDirection;
   275		}

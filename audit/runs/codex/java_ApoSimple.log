   143		// Methode, die alle delta-Millisekunden aufgerufen wird und sich um die Logik des Spiels k�mmert und um die Eingaben der Tastatur und Maus
   144		@Override
   145		protected void update(long delta) {
   146			int[] keyPressed = this.keyboard.getPressed();
   147			if (keyPressed != null) {
   148				for (int i = 0; i < keyPressed.length; i++) {
   149					this.keyPressed(keyPressed[i], (char) ((int) keyPressed[i]));
   150				}
   151			}
   152	
   153			int[][] keyReleased = this.keyboard.getReleased();
   154			if (keyReleased != null) {
   155				for (int i = 0; i < keyReleased.length; i++) {
   156					this.keyReleased(keyReleased[i][0], (char)(keyReleased[i][1]));
   157				}
   158			}
   159	
   160			if (this.mouse.isDragged()) {
   161				this.mouseDragged(this.mouse.getX(), this.mouse.getY(), this.mouse.hasClicked(ApoMouse.LEFT));
   162			} else if (this.mouse.hasClicked(ApoMouse.LEFT)) {
   163				this.mousePressed(this.mouse.getX(), this.mouse.getY(), true);
   164			} else if (this.mouse.hasClicked(ApoMouse.RIGHT)) {
   165				this.mousePressed(this.mouse.getX(), this.mouse.getY(), false);
   166			} else if (this.mouse.isMoved()) {
   167				this.mouseMoved(this.mouse.getX(), this.mouse.getY());
   168			}
   169			boolean[] mouseReleased = this.mouse.getReleased();
   170			if (mouseReleased[ApoMouse.LEFT]) {
   171				this.mouseReleased(this.mouse.getX(), this.mouse.getY(), true);
   172			} else if (mouseReleased[ApoMouse.RIGHT]) {
   173				this.mouseReleased(this.mouse.getX(), this.mouse.getY(), false);
   174			}
   175			
   176			int changed = this.mouse.getMouseWheelChanged();
   177			if (changed != 0) {
   178				this.mouseWheelChanged(changed);
   179			}
   180			
   181			this.think(delta);
   182		}

   167		private void setShowStart(int showStart) {
   168			this.showStart = showStart;
   169			if (this.showStart < 0) {
   170				this.showStart = 0;
   171			} else if (this.showStart >= 2 * ApoSimpleLevelChooser.MAX_LEVELS) {
   172				this.showStart = 2 * ApoSimpleLevelChooser.MAX_LEVELS;
   173			}
   174			if (this.showStart == 0) {
   175				this.getGame().getButtons()[65].setBVisible(false);
   176				this.getGame().getButtons()[66].setBVisible(true);
   177				ApoButtonWithImageAndText b = (ApoButtonWithImageAndText)(this.getGame().getButtons()[66]);
   178				b.setText("medium");
   179			} else if (this.showStart == ApoSimpleLevelChooser.MAX_LEVELS) {
   180				this.getGame().getButtons()[65].setBVisible(true);
   181				this.getGame().getButtons()[66].setBVisible(true);
   182				ApoButtonWithImageAndText b = (ApoButtonWithImageAndText)(this.getGame().getButtons()[66]);
   183				b.setText("hard");
   184				b = (ApoButtonWithImageAndText)(this.getGame().getButtons()[65]);
   185				b.setText("easy");
   186				if (this.buttons.size() < this.showStart + ApoSimpleLevelChooser.MAX_LEVELS) {
   187					this.getGame().getButtons()[66].setBVisible(false);	
   188				}
   189			} else {
   190				this.getGame().getButtons()[65].setBVisible(true);
   191				this.getGame().getButtons()[66].setBVisible(false);
   192				ApoButtonWithImageAndText b = (ApoButtonWithImageAndText)(this.getGame().getButtons()[65]);
   193				b.setText("medium");
   194			}
   195			
   196			if (this.buttons.size() >= this.showStart) {
   197				if (!this.buttons.get(this.showStart).isBVisible()) {
   198					this.buttons.get(this.showStart).setBVisible(true);
   199				}
   200			}
   201		}

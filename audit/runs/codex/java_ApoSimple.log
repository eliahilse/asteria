    66			for (int y = 0; y < level.length; y++) {
    67				for (int x = 0; x < level[0].length; x++) {
    68					String curString = String.valueOf(level[y][x]);
    69					while (curString.length() < 2) {
    70						curString = "0" + curString;
    71					}
    72					result += curString;
    73				}
    74			}
    75			for (int i = 0; i < 3; i++) {
    76				String curString = String.valueOf(step + i + 1);
    77				result += curString;
    78			}
    79			return result;
    80		}

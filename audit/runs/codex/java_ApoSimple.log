   412		public static Point2D lineIntersection(Line2D line1, Line2D line2) {  
   413			if ((line1 == null) || (line2 == null)) {
   414				return null;
   415			}
   416			Point2D cp = null;
   417			double a1,b1,c1,a2,b2,c2,denom;
   418			a1 = line1.getY2()-line1.getY1();
   419			b1 = line1.getX1()-line1.getX2();
   420			c1 = line1.getX2()*line1.getY1()-line1.getX1()*line1.getY2();
   421			// a1x + b1y + c1 = 0 line1 eq
   422			a2 = line2.getY2()-line2.getY1();
   423			b2 = line2.getX1()-line2.getX2();
   424			c2 = line2.getX2()*line2.getY1()-line2.getX1()*line2.getY2();
   425			// a2x + b2y + c2 = 0 line2 eq
   426			denom = a1*b2 - a2*b1;
   427			if(denom != 0) {
   428				cp = new Point2D.Double((b1*c2 - b2*c1)/denom,(a2*c1 - a1*c2)/denom);
   429			} else {
   430				// lines are parallel
   431			}
   432			return cp;
   433		}

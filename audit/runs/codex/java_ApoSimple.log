   435		public static void saveData(final URL codebase, final String name, final String value) {
   436			Thread t = new Thread() {
   437				public void run() {
   438					String parametersAsString = "SET=&name=" + name + "&value=" + value;
   439					byte[] parameterAsBytes = parametersAsString.getBytes();
   440					URL url;
   441					try {
   442						url = new URL(codebase + "cookies.php");
   443						URLConnection con = url.openConnection();
   444						((HttpURLConnection) con).setRequestMethod("GET");
   445						con.setDoOutput(true);
   446						con.setDoInput(true);
   447						con.setUseCaches(false);
   448				
   449						OutputStream oStream = con.getOutputStream();
   450						oStream.write(parameterAsBytes);
   451						oStream.flush();
   452						
   453						BufferedReader iStream = new BufferedReader(new InputStreamReader(con.getInputStream()));
   454						iStream.readLine();
   455						iStream.close();
   456						oStream.close();
   457					} catch (MalformedURLException e) {
   458						e.printStackTrace();
   459					} catch (IOException e) {
   460						e.printStackTrace();
   461					}
   462				}
   463			};
   464			t.start();
   465		}

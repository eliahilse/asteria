    23		public void setHighscore(ArrayList<ApoSimpleLevelHighscore> highscore) {
    24			this.highscore = highscore;
    25		}
    26	
    27		@Override
    28		public boolean writeLevel(DataOutputStream data) throws IOException {
    29			if (this.highscore == null) {
    30				return false;
    31			}
    32			data.writeInt(this.highscore.size());
    33			for (int i = 0; i < this.highscore.size(); i++) {
    34				data.writeInt(this.highscore.get(i).getLevel());
    35				data.writeInt(this.highscore.get(i).getStars());
    36			}
    37			return true;
    38		}
    39	
    40		@Override
    41		public boolean readLevel(DataInputStream data) throws EOFException, IOException {
    42			this.highscore.clear();
    43			int size = data.readInt();
    44			for (int i = 0; i < size; i++) {
    45				this.highscore.add(new ApoSimpleLevelHighscore(data.readInt(), data.readInt()));
    46			}
    47			return false;
    48		}
    49	

   189		public static ArrayList<ApoFloatPoint> getCircleCuts(float x1, float y1, float radius1, float x2, float y2, float radius2) {
   190			ArrayList<ApoFloatPoint> results = new ArrayList<ApoFloatPoint>();
   191	
   192			double resultX1 = -10000, resultX2 = -10000, resultY1 = -10000, resultY2 = -10000;
   193	
   194			if ((x2 == x1) && (y2 == y1)) {
   195				return results;
   196			} else {
   197				double c1 = ((radius1 * radius1) - (radius2 * radius2) - (x1 * x1) + (x2 * x2) - (y1 * y1) + (y2 * y2)) / (2.0 * x2 - 2.0 * x1);
   198				double c2 = (y1 - y2) / (x2 - x1);
   199				double k1 = 1.0 + (1.0 / Math.pow(c2, 2.0));
   200				double k2 = 2.0 * x1 + (2.0 * y1) / (c2) + (2.0 * c1) / Math.pow(c2, 2.0);
   201				double k3 = x1 * x1 + (c1 * c1) / (c2 * c2) + (2.0 * y1 * c1) / (c2) + (y1 * y1) - (radius1 * radius1);
   202				System.out.println("resultX1: "+resultX1);
   203				resultX1 = ((k2 / k1) / 2.0) + Math.sqrt((Math.pow((k2 / k1), 2.0) / 4.0) - (k3 / k1));
   204				System.out.println("resultX1: "+resultX1);
   205				resultX2 = (k2 / k1) / 2.0 - Math.sqrt((Math.pow((k2 / k1), 2.0) / 4.0) - (k3) / (k1));
   206				resultY1 = 1.0 / (c2) * resultX1 - (c1 / c2);
   207				resultY2 = 1.0 / (c2) * resultX2 - (c1 / c2);
   208			}
   209			
   210			if ((resultX1 != -10000) && (resultY1 != -10000)) {
   211				System.out.println("resultX1: "+resultX1);
   212				results.add(new ApoFloatPoint((float)(resultX1), (float)(resultY1)));
   213			}
   214			if ((resultX2 != -10000) && (resultY2 != -10000)) {
   215				results.add(new ApoFloatPoint((float)(resultX2), (float)(resultY2)));
   216			}
   217			return results;
   218		}

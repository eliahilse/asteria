   213		protected void drawString(BitsGraphics g, final String s, final int x, final int y, final BitsFont font, float[] colorBack, float[] colorFront) {
   214			int w = 0;
   215			if (super.getModel().getStringWidth().containsKey(s)) {
   216				w = super.getModel().getStringWidth().get(s);
   217			}
   218			
   219			g.setColor(colorBack[0], colorBack[1], colorBack[2], colorBack[3]);
   220			g.drawText(s, font, x - w/2 + 1, y + 2);
   221			g.setColor(colorFront[0], colorFront[1], colorFront[2], colorFront[3]);
   222			g.drawText(s, font, x - w/2 + 0, y + 0);
   223		}

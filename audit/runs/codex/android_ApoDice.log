    19		
    20		private boolean bFade;
    21		
    22		public ApoDiceString(float x, float y, float width, String s, boolean bWithBackground, int timeDecrease, boolean bFade) {
    23			super(x, y, width, 0, 0);
    24			
    25			this.bWithBackground = bWithBackground;
    26			this.drawString = s;
    27			this.invisible = 255;
    28			this.curTime = 0;
    29			this.timeDecrease = timeDecrease;
    30			this.curTime = this.timeDecrease;
    31			this.bFade = bFade;
    32		}
    33		
    34		public void think(int delta) {
    35			this.curTime -= delta;
    36			if (this.curTime <= 0) {
    37				if (this.bFade) {
    38					this.curTime = this.timeDecrease;
    39					this.invisible -= 1;
    40					if (this.invisible <= 50) {
    41						this.invisible = 0;
    42						super.setVisible(false);
    43					}
    44				} else {
    45					super.setVisible(false);
    46				}
    47			}
    48		}
    49		
    50		public void render(final BitsGraphics g, int changeX, int changeY) {
    51			if (this.isVisible()) {
    52				
    53				String s = this.drawString;
    54				int w = (int)(ApoDiceMenu.font.getLength(s) + 10);
    55				int h = ApoDiceMenu.font.mCharCellHeight;
    56				int x = (int)(this.getX() + this.getRadius()/2 - w/2) - changeX;
    57				int change = 10;
    58				int y = (int)(this.getY() + this.getRadius()/2 + h/2) - changeY;
    59				if (this.bWithBackground) {
    60					g.setColor(255, 255, 255, this.invisible);
    61					g.drawFilledRect((int)(x - change), (int)(y - h - change), (int)(w + 2 * change), (int)(h + 2 * change));
    62					g.setColor(0, 0, 0, this.invisible);
    63					g.setLineSize(3);
    64					g.drawRect((int)(x - change), (int)(y - h - change), (int)(w + 2 * change), (int)(h + 2 * change));
    65					g.setLineSize(1);
    66				}
    67				g.setColor(0, 0, 0, this.invisible);
    68				g.drawText(s, ApoDiceMenu.font, x, y - h);
    69			}
    70		}
    71	
    72	}

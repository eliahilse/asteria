     3	public class ApoDiceSolve {
     4	
     5		private boolean bSolved;
     6		
     7		private boolean bBreak;
     8		
     9		private int count;
    10		
    11		public boolean shouldBreak() {
    12			return bBreak;
    13		}
    14	
    15		public void setBreak(boolean bBreak) {
    16			this.bBreak = bBreak;
    17		}
    18	
    19		public boolean canBeSolved(final byte[][] level) {
    20			this.bSolved = false;
    21			this.bBreak = false;
    22			this.count = 0;
    23			
    24			this.checkLevel(this.getClone(level));
    25			
    26			return this.bSolved;
    27		}
    28		
    29		private void checkLevel(final byte[][] level) {
    30			if (this.isLevelDone(level)) {
    31				this.bSolved = true;
    32			}
    33			if (this.bSolved) {
    34				return;
    35			}
    36			if (this.bBreak) {
    37				return;
    38			}
    39			this.count += 1;
    40	//		BitsLog.d("count", "count: "+count);
    41			for (int y = 0; y < 8; y++) {
    42				for (int x = 0; x < level[y].length; x++) {
    43					if (level[y + 8][x] >= 3) {
    44						int north = this.isNorthFree(level, x, y);
    45						if (north > 0) {
    46	//						BitsLog.d("test", level[13][0]+" "+level[14][0]+" "+level[15][0]);
    47							byte[][] clone = this.getClone(level);
    48							clone[y + 8][x] = (byte)(clone[y + 8][x] - 1);
    49							setNorth(clone, x, y, north);
    50							this.checkLevel(clone);
    51							if ((this.bSolved) || (this.bBreak)) {
    52								return;
    53							}
    54	//						BitsLog.d("test", level[13][0]+" "+level[14][0]+" "+level[15][0]);
    55	//						this.setNorthBack(level, x, y, north);
    56	//						BitsLog.d("test", level[13][0]+" "+level[14][0]+" "+level[15][0]);
    57						}
    58						int east = this.isEastFree(level, x, y);
    59						if (east > 0) {
    60	//						BitsLog.d("test", "before "+level[15][0]+" "+level[15][1]+" "+level[15][2]);
    61							byte[][] clone = this.getClone(level);
    62							clone[y + 8][x] = (byte)(clone[y + 8][x] - 1);
    63							setEast(clone, x, y, east);
    64							this.checkLevel(clone);
    65							if ((this.bSolved) || (this.bBreak)) {
    66								return;
    67							}
    68	//						BitsLog.d("test", "mid "+level[15][0]+" "+level[15][1]+" "+level[15][2]);
    69	//						this.setEastBack(level, x, y, east);
    70	//						BitsLog.d("test", "after "+level[15][0]+" "+level[15][1]+" "+level[15][2]);
    71						}
    72						int south = this.isSouthFree(level, x, y);
    73						if (south > 0) {
    74							byte[][] clone = this.getClone(level);
    75							clone[y + 8][x] = (byte)(clone[y + 8][x] - 1);
    76							setSouth(clone, x, y, south);
    77							this.checkLevel(clone);
    78							if ((this.bSolved) || (this.bBreak)) {
    79								return;
    80							}
    81	//						this.setSouthBack(level, x, y, south);
    82	//						BitsLog.d("test", level[13][0]+" "+level[14][0]+" "+level[15][0]);
    83						}
    84						int west = this.isWestFree(level, x, y);
    85						if (west > 0) {
    86							byte[][] clone = this.getClone(level);
    87							clone[y + 8][x] = (byte)(clone[y + 8][x] - 1);
    88							this.setWest(clone, x, y, west);
    89							this.checkLevel(clone);
    90							if ((this.bSolved) || (this.bBreak)) {
    91								return;
    92							}
    93	//						this.setWestBack(level, x, y, west);
    94						}
    95					}
    96				}
    97			}
    98		}
    99		
   100		private int isSouthFree(final byte[][] level, final int x, final int y) {
   101			int i = 1;
   102			for (int curY = y + 1; curY < 8; curY++) {
   103				if (level[curY + 8][x] < 2) {
   104					return i;
   105				} else {
   106					i += 1;
   107				}
   108			}
   109			return -1;
   110		}
   111		
   112		private void setSouth(final byte[][] level, final int x, final int y, final int south) {
   113			for (int curY = y + south; curY > y; curY--) {
   114				level[curY + 8][x] = level[curY + 8 - 1][x];
   115			}
   116			level[y + 8][x] = 0;
   117		}
   118		
   119		private void setSouthBack(final byte[][] level, final int x, final int y, final int south) {
   120			for (int curY = y; curY < y + south; curY++) {
   121				level[curY + 8][x] = level[curY + 8 + 1][x];
   122			}
   123			level[y + 8][x] = (byte)(level[y + 8][x] + 1);
   124			level[y + 8 + south][x] = 0;
   125		}
   126		
   127		private int isNorthFree(final byte[][] level, final int x, final int y) {
   128			int i = 1;
   129			for (int curY = y - 1; curY >= 0; curY--) {
   130				if (level[curY + 8][x] < 2) {
   131					return i;
   132				} else {
   133					i += 1;
   134				}
   135			}
   136			return -1;
   137		}
   138		
   139		private void setNorth(final byte[][] level, final int x, final int y, final int north) {
   140			for (int curY = y - north; curY < y; curY++) {
   141				level[curY + 8][x] = level[curY + 8 + 1][x];
   142			}
   143			level[y + 8][x] = 0;
   144		}
   145		
   146		private void setNorthBack(final byte[][] level, final int x, final int y, final int north) {
   147			for (int curY = y; curY > y - north; curY--) {
   148				level[curY + 8][x] = level[curY + 8 - 1][x];
   149			}
   150			level[y + 8][x] = (byte)(level[y + 8][x] + 1);
   151			level[y + 8 - north][x] = 0;
   152		}
   153		
   154		private int isWestFree(final byte[][] level, final int x, final int y) {
   155			int i = 1;
   156			for (int curX = x - 1; curX >= 0; curX--) {
   157				if (level[y + 8][curX] < 2) {
   158					return i;
   159				} else {
   160					i += 1;
   161				}
   162			}
   163			return -1;
   164		}
   165		
   166		private void setWest(final byte[][] level, final int x, final int y, final int west) {
   167			for (int curX = x - west; curX < x; curX++) {
   168				level[y + 8][curX] = level[y + 8][curX + 1];
   169			}
   170			level[y + 8][x] = 0;
   171		}
   172		
   173		private void setWestBack(final byte[][] level, final int x, final int y, final int west) {
   174			for (int curX = x; curX > x - west; curX--) {
   175				level[y + 8][curX] = level[y + 8][curX - 1];
   176			}
   177			level[y + 8][x] = (byte)(level[y + 8][x] + 1);
   178			level[y + 8][x - west] = 0;
   179		}
   180		
   181		private int isEastFree(final byte[][] level, final int x, final int y) {
   182			int i = 1;
   183			for (int curX = x + 1; curX < 8; curX++) {
   184				if (level[y + 8][curX] < 2) {
   185					return i;
   186				} else {
   187					i += 1;
   188				}
   189			}
   190			return -1;
   191		}
   192		
   193		private void setEast(final byte[][] level, final int x, final int y, final int east) {
   194			for (int curX = x + east; curX > x; curX--) {
   195				level[y + 8][curX] = level[y + 8][curX - 1];
   196			}
   197			level[y + 8][x] = 0;
   198		}
   199		
   200		private void setEastBack(final byte[][] level, final int x, final int y, final int east) {
   201			for (int curX = x; curX < x + east; curX++) {
   202				level[y + 8][curX] = level[y + 8][x + 1];
   203			}
   204			level[y + 8][x] = (byte)(level[y + 8][x] + 1);
   205			level[y + 8][x + east] = 0;
   206		}
   207		
   208		private boolean isLevelDone(final byte[][] level) {
   209			for (int y = 0; y < 8; y++) {
   210				for (int x = 0; x < level[y].length; x++) {
   211					if ((level[y + 8][x] == 2) && (level[y][x] <= 0)) {
   212						return false;
   213					}
   214					if (((level[y + 8][x] < 2) || (level[y + 8][x] > 2)) && (level[y][x] == 1)) {
   215						return false;
   216					}
   217					if (level[y + 8][x] >= 3) {
   218						return false;
   219					}
   220				}
   221			}
   222			return true;
   223		}
   224		
   225		private byte[][] getClone(final byte[][] copy) {
   226			byte[][] clone = new byte[copy.length][copy[0].length];
   227			for (int y = 0; y < clone.length; y++) {
   228				for (int x = 0; x < clone[y].length; x++) {
   229					clone[y][x] = copy[y][x];
   230				}
   231			}
   232			return clone;
   233		}
   234	}


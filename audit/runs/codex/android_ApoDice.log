    85				if (this.userlevels.getLevels().get(i).equals(level)) {
    86					return false;
    87				}
    88			}
    89			return ApoDiceUserlevelsLoad.getInstance().save(level);
    90		}
    91		
    92		public float getStars(int level) {
    93			if (this.userlevels.getCount().get(this.sortByUpload.get(level)) <= 0) {
    94				return 0;
    95			}
    96			return (float)((float)this.userlevels.getAll().get(this.sortByUpload.get(level)) / (float)this.userlevels.getCount().get(this.sortByUpload.get(level)));
    97		}
    98		
    99		public String getStatistics(int level) {		
   100			int[] values = new int[4];
   101			values[0] = this.userlevels.getFun().get(this.sortByUpload.get(level));
   102			values[1] = this.userlevels.getCreative().get(this.sortByUpload.get(level));
   103			values[2] = this.userlevels.getEasy().get(this.sortByUpload.get(level));
   104			values[3] = this.userlevels.getHard().get(this.sortByUpload.get(level));
   105			
   106			int max = this.getHighest(-1, values);
   107			int maxTwo = this.getHighest(max, values);
   108			String result = "";
   109			for (int i = 0; i < values.length; i++) {
   110				if ((i != max) && (i != maxTwo)) {
   111					result += "0";
   112				} else {
   113					if (values[i] > 0) {
   114						result += "1";
   115					} else {
   116						result += "0";
   117					}
   118				}
   119			}
   120	
   121			return result;
   122		}
   123		
   124		private int getHighest(int not, int[] values) {
   125			int curValue = 0;
   126			if (not == 0) {
   127				curValue = 1;
   128			}
   129			int max = values[curValue];
   130			for (int i = 0; i < values.length; i++) {
   131				if ((max < values[i]) && (i != not)) {
   132					max = values[i];
   133					curValue = i;
   134				}
   135			}
   136			return curValue;
   137		}
   138		
   139		public int getID(int level) {
   140			return this.userlevels.getId().get(this.sortByUpload.get(level));
   141		}
   142	}

    11	public class ApoDiceEditor extends ApoDiceModel {
    12	
    13		private final int EMPTY = 0;
    14		private final int GOAL = 1;
    15		private final int DICE_EMPTY = 2;
    16		private final int DICE_ONE = 3;
    17		private final int DICE_TWO = 4;
    18		private final int DICE_THREE = 5;
    19		private final int DICE_FOUR = 6;
    20		private final int DICE_FIVE = 7;
    21		private final int DICE_SIX = 8;
    22		
    23		public static final String BACK = "back";
    24		public static final String UPLOAD = "upload";
    25		public static final String TEST = "test";
    26		public static final String NEW = "new";
    27		public static final String SOLVE = "solve";
    28	
    29		private ApoDiceString uploadString;
    30		
    31		private byte[][] level = new byte[16][8];
    32		
    33		private int curSelect;
    34		
    35		private Thread t;
    36		
    37		public ApoDiceEditor(ApoDicePanel game) {
    38			super(game);
    39		}
    40	
    41		@Override
    42		public void init() {
    43			this.getStringWidth().put(ApoDiceEditor.BACK, (int)(ApoDiceMenu.game_font.getLength(ApoDiceEditor.BACK)));
    44			this.getStringWidth().put(ApoDiceEditor.NEW, (int)(ApoDiceMenu.game_font.getLength(ApoDiceEditor.NEW)));
    45			this.getStringWidth().put(ApoDiceEditor.TEST, (int)(ApoDiceMenu.game_font.getLength(ApoDiceEditor.TEST)));
    46			this.getStringWidth().put(ApoDiceEditor.UPLOAD, (int)(ApoDiceMenu.game_font.getLength(ApoDiceEditor.UPLOAD)));
    47			this.getStringWidth().put(ApoDiceEditor.SOLVE, (int)(ApoDiceMenu.game_font.getLength(ApoDiceEditor.SOLVE)));
    48			
    49			String s = "ApoDice - Editor";
    50			this.getStringWidth().put(s, (int) ApoDiceMenu.game_font.getLength(s));
    51			
    52			this.checkTestLevel();
    53		}
    54		
    55		public void setLevelSolved(boolean bSolved) {
    56			if ((!bSolved) || (!ApoDice.isOnline())) {
    57				this.getGame().getButtons()[9].setVisible(false);
    58			} else {
    59				this.getGame().getButtons()[9].setVisible(true);
    60			}
    61		}
    62		
    63		private void checkTestLevel() {
    64			int goals = 0;
    65			int dices = 0;
    66			for (int y = 0; y < 8; y += 1) {
    67				for (int x = 0; x < level[y].length; x += 1) {
    68					if (this.level[y][x] == 1) {
    69						goals += 1;
    70					}
    71					if (this.level[y+8][x] >= 2) {
    72						dices += 1;
    73					}
    74				}
    75			}
    76			if ((goals > 0) && (dices == goals)) {
    77				this.getGame().getButtons()[8].setVisible(true);
    78	//			this.getGame().getButtons()[10].setVisible(true);
    79			} else {
    80				this.getGame().getButtons()[8].setVisible(false);
    81				this.getGame().getButtons()[9].setVisible(false);
    82				this.getGame().getButtons()[10].setVisible(false);
    83			}
    84		}
    85	
    86		@Override
    87		public void touchedPressed(int x, int y, int finger) {
    88			if (y > 505) {
    89				for (int i = 0; i < 7; i++) {
    90					if ((x >= 5 + i*65) && (x < 65 + i * 65) && (y >= 510) && (y < 570)) {
    91						this.curSelect = i + 2;
    92					}
    93				}
    94				if ((x >= 5) && (x < 65) && (y >= 575) && (y < 635)) {
    95					this.curSelect = this.EMPTY;
    96				}
    97				if ((x >= 70) && (x < 130) && (y >= 575) && (y < 635)) {
    98					this.curSelect = this.GOAL;
    99				}
   100			} else {
   101				if ((y >= ApoDicePuzzleGame.changeY) && (y < 480 + ApoDicePuzzleGame.changeY)) {
   102					int newY = (y - ApoDicePuzzleGame.changeY)/60;
   103					if (this.curSelect == this.EMPTY) {
   104						level[newY][x/60] = level[newY + 8][x/60] = 0;
   105					} else if (this.curSelect == this.GOAL) {
   106						level[newY][x/60] = 1;
   107					} else if (this.curSelect == this.DICE_EMPTY) {
   108						level[newY + 8][x/60] = 2;
   109					} else if (this.curSelect == this.DICE_ONE) {
   110						level[newY + 8][x/60] = 3;
   111					} else if (this.curSelect == this.DICE_TWO) {
   112						level[newY + 8][x/60] = 4;
   113					} else if (this.curSelect == this.DICE_THREE) {
   114						level[newY + 8][x/60] = 5;
   115					} else if (this.curSelect == this.DICE_FOUR) {
   116						level[newY + 8][x/60] = 6;
   117					} else if (this.curSelect == this.DICE_FIVE) {
   118						level[newY + 8][x/60] = 7;
   119					} else if (this.curSelect == this.DICE_SIX) {
   120						level[newY + 8][x/60] = 8;
   121					}
   122					this.checkTestLevel();
   123				}
   124			}
   125		}
   126	
   127		@Override
   128		public void touchedReleased(int x, int y, int finger) {
   129			
   130		}
   131	
   132		@Override
   133		public void touchedDragged(int x, int y, int oldX, int oldY, int finger) {
   134			
   135		}
   136		
   137		@Override
   138		public void touchedButton(String function) {
   139			if (function.equals(ApoDiceEditor.BACK)) {
   140				this.onBackButtonPressed();
   141			} else if (function.equals(ApoDiceEditor.NEW)) {
   142				this.level = new byte[16][8];
   143				this.checkTestLevel();
   144			} else if (function.equals(ApoDiceEditor.TEST)) {
   145				String levelString = this.getLevelString();
   146				BitsLog.d("levelString", levelString);
   147				this.getGame().setPuzzleGame(-1, levelString, false);
   148			} else if (function.equals(ApoDiceEditor.UPLOAD)) {
   149				this.setLevelSolved(false);
   150				this.uploadString = new ApoDiceString(240, 470, 20, "Uploading ...", true, 200, true);
   151				
   152				Thread t = new Thread(new Runnable() {
   153					@Override
   154					public void run() {
   155						ApoDiceEditor.this.uploadString();
   156					}
   157		 		});
   158		 		t.start();
   159			} else if (function.equals(ApoDiceEditor.SOLVE)) {
   160				this.uploadString = new ApoDiceString(240, 30, 20, "Try to solve ...", true, 20000, true);
   161				this.t = new Thread(new Runnable() {
   162					@Override
   163					public void run() {
   164						solveLevel();
   165					}
   166		 		});
   167		 		this.t.start();
   168			}
   169		}
   170		
   171		private void solveLevel() {
   172			this.solve = new ApoDiceSolve();
   173			if (solve.canBeSolved(ApoDiceEditor.this.level)) {
   174				ApoDiceEditor.this.uploadString = new ApoDiceString(240, 30, 20, "Can be solved", true, 20, true);

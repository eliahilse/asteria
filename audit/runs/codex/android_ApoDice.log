   150		public void loadLevel(int nextLevel, boolean bUserLevel, String levelString) {
   151			this.bUserlevel = bUserLevel;
   152			if (ApoDiceLevel.editorLevels == null) {
   153				this.bUserlevel = false;
   154			}
   155			p[1] = nextLevel;
   156			if (p[1] < 0) {
   157				if (this.bUserlevel) {
   158					p[1] = ApoDiceLevel.editorLevels.length - 1;
   159				} else {
   160					p[1] = this.getGame().getMaxCanChoosen();
   161				}
   162			}
   163			if (this.bUserlevel) {
   164				if (p[1] >= ApoDiceLevel.editorLevels.length) {
   165					p[1] = 0;
   166				}
   167			} else if (p[1] >= this.getGame().getMaxCanChoosen() + 1) {
   168				p[1] = 0;
   169			}
   170			this.bEditor = false;
   171			String l = "";
   172			if ((levelString != null) && (levelString.length() > 0)) {
   173				l = levelString;
   174				this.bEditor = true;
   175			} else {
   176				if (this.bUserlevel) {
   177					l = ApoDiceLevel.editorLevels[p[1]];
   178				} else {
   179					l = ApoDiceLevel.getLevel(p[1]);
   180				}
   181			}
   182			this.levelString = levelString;
   183			
   184			level = new byte[16][8];
   185			for (int y = 0; y < 8; y += 1) {
   186				for (int x = 0; x < level[y].length; x += 1) {
   187					char c = l.charAt(y * 8 + x);
   188					if ((c >= 48) && (c <= 57)) {
   189						byte value = Byte.valueOf(l.substring(y * 8 + x, y * 8 + x + 1));
   190						if (value <= 1) {
   191							level[y][x] = value;
   192						} else {
   193							level[y + 8][x] = value;
   194						}
   195					} else {
   196						byte value = (byte)((int)c - 95);
   197						level[y][x] = 1;
   198						level[y + 8][x] = value;
   199					}
   200				}
   201			}
   202			
   203			p[3] = p[2] = p[0] = 0;
   204			p[6] = -1;
   205		}

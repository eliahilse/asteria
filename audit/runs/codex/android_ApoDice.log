   205		private String getLevelString() {
   206			String level = "";
   207			for (int y = 0; y < 8; y++) {
   208				for (int x = 0; x < 8; x++) {
   209					if (this.level[y+8][x] > 1) {
   210						if (this.level[y][x] <= 0) {
   211							level += String.valueOf(this.level[y+8][x]);	

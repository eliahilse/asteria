   183		public void onUpdate(float delta) {
   184			super.onUpdate(delta);
   185			
   186			this.think += delta * 1000;
   187			
   188			// Update / think
   189			// Wenn 10 ms vergangen sind, dann denke nach
   190			while (this.think >= 10) {
   191				this.think -= 10;
   192				if (super.getModel() != null) {
   193					super.getModel().think((int)10);
   194				}	
   195			}
   196		}

   119						
   120						for (int dice = 0; dice < 2; dice++) {
   121							x += dice * width;
   122							
   123							g.setColor(255, 255, 255, 255);
   124							g.drawFilledRoundRect(x - height/2, y, height, height, 6, 10);
   125	
   126							g.setLineSize(3.0f);
   127							g.setColor(48, 48, 48);
   128							g.drawRoundRect(x - height/2, y, height, height, 6, 10);
   129							
   130							g.setLineSize(1.0f);
   131							
   132							if ((number == 1) || (number == 3) || (number == 5)) {
   133								g.drawFilledCircle(x - height/2 + 30, y + 30, 6, 40);
   134							}
   135							if ((number == 2) || (number == 3) || (number == 4) || (number == 5)) {
   136								g.drawFilledCircle(x - height/2 + 14, y + 14, 6, 40);
   137								g.drawFilledCircle(x - height/2 + 46, y + 46, 6, 40);
   138							}
   139							if ((number == 4) || (number == 5)) {
   140								g.drawFilledCircle(x - height/2 + 46, y + 14, 6, 40);
   141								g.drawFilledCircle(x - height/2 + 14, y + 46, 6, 40);
   142							}
   143						}
   144						number += 1;
   145					}
   146				}
   147			}
   148		}

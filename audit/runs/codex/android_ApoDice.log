   229		public void renderButtons(BitsGraphics g, final BitsFont font) {
   230			if (this.getButtons() != null) {
   231				for (int i = 0; i < this.getButtons().length; i++) {
   232					if (this.getButtons()[i].isBVisible()) {
   233						int x = (int)(this.getButtons()[i].getX());
   234						int y = (int)(this.getButtons()[i].getY());
   235						int width = (int)(this.getButtons()[i].getWidth());
   236						int height = (int)(this.getButtons()[i].getHeight());
   237						
   238						g.setColor(160, 160, 160, 255);
   239						g.drawFilledRoundRect(x, y, width, height, 6, 10);
   240						g.setLineSize(2.0f);
   241						g.setColor(48f/255f, 48f/255f, 48f/255f, 1.0f);
   242						g.drawRoundRect(x, y, width, height, 6, 10);
   243						g.setLineSize(1.0f);
   244						
   245						this.drawString(g, this.getButtons()[i].getFunction(), x + width/2, y + height/2 - font.mCharCellHeight/2 - 3, font);
   246					}
   247				}
   248			}
   249		}

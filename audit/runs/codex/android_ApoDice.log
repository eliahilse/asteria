   253										if (i + 1 < 8) {
   254											level[i + 8][p[6]] = level[i + 8 + 1][p[6]];
   255										} else {
   256											level[i + 8][p[6]] = 0;
   257										}
   258									}
   259								} else if (p[11] > 0) {
   260									for (int i = p[7] + p[12] - 1; i >= p[7]; i--) {
   261										level[i + 1 + 8][p[6]] = level[i + 8][p[6]];
   262									}
   263								}
   264								level[p[7] + 8][p[6]] = 0;
   265							}
   266							
   267							// is level solved?
   268							boolean bWin = true;
   269							boolean bLoose = true;
   270							for (int y = 0; y < 8; y += 1) {
   271								for (int x = 0; x < level[y].length; x += 1) {
   272									if ((level[y][x] == 1) && (level[y+8][x] != 2)) {
   273										bWin = false;
   274									}
   275									if (level[y+8][x] > 2) {
   276										bLoose = false;
   277									}
   278								}
   279							}
   280							if (bWin) {
   281								p[3] = 1;
   282								if ((!this.bUserlevel) && (!this.bEditor)) {
   283									this.getGame().solvedLevel(p[1] + 1);
   284								}
   285							} else if (bLoose) {
   286								p[3] = 2;
   287							}
   288						}
   289						
   290						p[6] = -1;
   291					}
   292				} else if (p[2] > 0) {
   293					if (p[6] < 0) {
   294						int x = p[4] / 60;
   295						int y = (p[5] - changeY) / 60;
   296						if ((x >= 0) && (y >= 0) && (x < 8) && (y < 8) && (level[y+8][x] > 2)) {
   297							p[6] = x;
   298							p[7] = y;
   299							p[2] = 0;
   300							p[8] = p[4] - p[6] * 60;
   301							p[9] = p[5] - changeY - p[7] * 60;
   302						}
   303					}
   304				}
   305			}
   306			
   307			p[0] = 0;
   308		}

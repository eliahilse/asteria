    44		private String[] getAllLevelsSorted() {
    45			if (this.userlevels.getLevels().size() <= 0) {
    46				return null;
    47			}
    48			int size = this.sortByUpload.size();
    49			String[] levels = new String[size];
    50			for (int level = 0; level < levels.length; level++) {
    51				String curLevel = this.userlevels.getLevels().get(this.sortByUpload.get(level));
    52				BitsLog.d("level", curLevel);
    53				levels[level] = curLevel;
    54			}
    55			return levels;
    56		}
    57		
    58		private void sortByUpload() {
    59			this.sortByUpload.clear();
    60			for (int i = 0; i < this.userlevels.getLevels().size(); i++) {
    61				if (!ApoDiceLevel.isIn(this.userlevels.getLevels().get(i))) {
    62					float time = this.userlevels.getTimes().get(i);
    63					boolean bAdd = false;
    64					for (int k = 0; k < this.sortByUpload.size(); k++) {
    65						float sortTime = this.userlevels.getTimes().get(this.sortByUpload.get(k));
    66						if (time > sortTime) {
    67							this.sortByUpload.add(k, i);
    68							bAdd = true;
    69							break;
    70						}
    71					}
    72					if (!bAdd) {
    73						this.sortByUpload.add(i);
    74					}
    75				}
    76			}
    77		}

   230								p[1] += 1;
   231							}
   232						}
   233					} else if (p[6] >= 0) {
   234						if (((int)(p[4])/60 != p[6]) || ((int)(p[5] - changeY)/60 != p[7])) {
   235							
   236							if (!bBreak) {
   237								level[p[7] + 8][p[6]] -= 1;
   238								if (p[10] < 0) {

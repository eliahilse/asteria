     6	public class ApoDiceString extends ApoDiceEntity {
     7	
     8		public static final int TIME_DECREASE = 10;
     9		
    10		private String drawString;
    11		
    12		private int invisible;
    13		
    14		private int curTime;
    15		
    16		private boolean bWithBackground;

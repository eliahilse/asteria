    10	
    11	public class ApoSlitherLinkLevelIO extends ApoIO {
    12	
    13		private ArrayList<String> levels;
    14		private ArrayList<String> solvedLevels;
    15		
    16		private ArrayList<Integer> inOtherLevels;
    17		
    18		public ApoSlitherLinkLevelIO() {
    19			this.levels = new ArrayList<String>();
    20			this.solvedLevels = new ArrayList<String>();
    21			this.inOtherLevels = new ArrayList<Integer>();
    22		}
    23		
    24		public final ArrayList<String> getLevels() {
    25			return this.levels;
    26		}
    27	
    28		public void checkLevelsIsIn(ArrayList<ApoSlitherLinkLevelsHelp> checkLevels, ApoSlitherLinkLevel level) {
    29			for (int i = 0; i < checkLevels.size(); i++) {
    30				for (int j = 0; j < this.levels.size(); j++) {
    31					if (this.levels.get(j).equals(checkLevels.get(i).getLevelString())) {
    32						checkLevels.get(i).setBSolved(true);
    33						checkLevels.get(i).setSolvedLevelString(this.solvedLevels.get(j));
    34						checkLevels.get(i).makeSolvedImage(level);
    35						this.inOtherLevels.add(j);
    36						break;
    37					}
    38				}
    39			}
    40		}
    41		
    42		public void addCustomsLevels(ArrayList<ApoSlitherLinkLevelsHelp> customLevels, ApoSlitherLinkLevel level) {
    43			for (int j = 0; j < this.levels.size(); j++) {
    44				if (this.inOtherLevels.indexOf(j) == -1) {
    45					ApoSlitherLinkLevelsHelp help = new ApoSlitherLinkLevelsHelp(this.levels.get(j));
    46					help.setBSolved(true);
    47					help.setSolvedLevelString(this.solvedLevels.get(j));
    48					help.makeSolvedImage(level);
    49					customLevels.add(help);
    50				}
    51			}		
    52		}
    53		
    54		public void saveLevels(ArrayList<ApoSlitherLinkLevelsHelp> checkLevels) {
    55			for (int i = 0; i < checkLevels.size(); i++) {
    56				if (checkLevels.get(i).isBSolved()) {
    57					if (this.levels.size() == 0) {
    58						this.levels.add(checkLevels.get(i).getLevelString());
    59						this.solvedLevels.add(checkLevels.get(i).getSolvedLevelString());
    60					} else {
    61						if (this.levels.indexOf(checkLevels.get(i).getLevelString()) == -1) {
    62							this.levels.add(checkLevels.get(i).getLevelString());
    63							this.solvedLevels.add(checkLevels.get(i).getSolvedLevelString());
    64						}
    65					}
    66				}
    67			}
    68		}
    69		
    70		@Override
    71		public boolean readLevel(DataInputStream data) throws EOFException, IOException {
    72			int size = data.readInt();
    73			this.levels.clear();
    74			this.solvedLevels.clear();
    75			for (int i = 0; i < size; i++) {
    76				String s = data.readUTF();
    77				this.levels.add(s);
    78				s = data.readUTF();
    79				this.solvedLevels.add(s);
    80			}
    81			return false;
    82		}
    83	
    84		@Override
    85		public boolean writeLevel(DataOutputStream data) throws IOException {
    86			int size = this.levels.size();
    87			data.writeInt(size);
    88			for (int i = 0; i < size; i++) {
    89				data.writeUTF(this.levels.get(i));
    90				data.writeUTF(this.solvedLevels.get(i));
    91			}
    92			return false;
    93		}
    94	
    95	}


   184			if (keyCode == KeyEvent.VK_LEFT) {
   185				this.bDirections[ApoConstants.LEFT] = true;
   186			}
   187			if (keyCode == KeyEvent.VK_RIGHT) {
   188				this.bDirections[ApoConstants.RIGHT] = true;
   189			}
   190			if (keyCode == KeyEvent.VK_U) {
   191				this.setBBack(true);

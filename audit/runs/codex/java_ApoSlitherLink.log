    93		 * @return korrekte AffineTransform
    94		 */
    95		private static AffineTransform findTranslation(AffineTransform at, BufferedImage bi, double degrees ) {
    96			Point2D p2din, p2dout;
    97			double ytrans, xtrans = 0.0;
    98	
    99			AffineTransform tat = new AffineTransform();
   100	
   101			if(degrees == 180) {
   102				p2din = new Point2D.Double(0, bi.getHeight());
   103			} else {
   104				p2din = new Point2D.Double(0.0, 0.0);
   105			}
   106	
   107			p2dout = at.transform(p2din, null);
   108	
   109			if(degrees == 270) {
   110				xtrans = p2dout.getX();
   111				ytrans = xtrans;
   112			} else {
   113				ytrans = p2dout.getY();
   114				xtrans = ytrans;
   115			}
   116	
   117			tat.translate(-xtrans, -ytrans);
   118	
   119			return tat;
   120		}

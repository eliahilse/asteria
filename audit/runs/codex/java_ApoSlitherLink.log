     7	
     8	public class ApoSlitherLinkBlinkLine {
     9	
    10		private final float VEC = 0.55f;
    11		
    12		private final int realStartX;
    13		private final int realStartY;
    14		
    15		private final int startX;
    16		private final int startY;
    17		
    18		private float changeX;
    19		private float changeY;
    20		
    21		private int width;
    22		
    23		private final int vecX;
    24		private final int vecY;
    25		
    26		private boolean bNext;
    27		
    28		private ArrayList<ApoSlitherLinkBlinkHelp> help;
    29		
    30		public ApoSlitherLinkBlinkLine(int realStartX, int realStartY, int startX, int startY, int width, int vecX, int vecY) {
    31			this.realStartX = realStartX;
    32			this.realStartY = realStartY;
    33			this.startX = startX;
    34			this.startY = startY;
    35			this.width = width;
    36			this.vecX = vecX;
    37			this.vecY = vecY;
    38			this.changeX = 0;
    39			this.changeY = 0;
    40			this.bNext = false;
    41			this.help = new ArrayList<ApoSlitherLinkBlinkHelp>();
    42		}
    43		
    44		public final int getRealStartX() {
    45			return this.realStartX;
    46		}
    47	
    48		public final int getRealStartY() {
    49			return this.realStartY;
    50		}
    51	
    52		public final int getStartX() {
    53			return this.startX;
    54		}
    55	
    56		public final int getStartY() {
    57			return this.startY;
    58		}
    59	
    60		public final int getWidth() {
    61			return this.width;
    62		}
    63	
    64		public final int getVecX() {
    65			return this.vecX;
    66		}
    67	
    68		public final int getVecY() {
    69			return this.vecY;
    70		}
    71	
    72		public final boolean isBNext() {
    73			return this.bNext;
    74		}
    75		
    76		public final boolean isReady() {
    77			if (this.help.size() <= 0) {
    78				return true;
    79			}
    80			return false;
    81		}
    82	
    83		public void think(int delta) {
    84			if (!this.bNext) {
    85				for (int i = this.help.size() - 1; i >= 0; i--) {
    86					this.help.get(i).think(delta);
    87					if (this.help.get(i).isInvisible()) {
    88						this.help.remove(i);
    89					}
    90				}
    91				this.changeX += this.vecX * this.VEC;
    92				this.changeY += this.vecY * this.VEC;
    93				this.help.add(new ApoSlitherLinkBlinkHelp((int)(this.changeX + this.startX * this.width), (int)(this.changeY + this.startY * this.width)));
    94				if (Math.abs(this.changeX) > this.width) {
    95					this.bNext = true;
    96				}
    97				if (Math.abs(this.changeY) > this.width) {
    98					this.bNext = true;
    99				}
   100			}
   101			
   102			for (int i = this.help.size() - 1; i >= 0; i--) {
   103				this.help.get(i).think(delta);
   104				if (this.help.get(i).isInvisible()) {
   105					this.help.remove(i);
   106				}
   107			}
   108		}
   109		
   110		public void render(Graphics2D g, int changeX, int changeY) {
   111	//		for (int i = 0; i < this.help.size(); i++) {
   112	//			this.help.get(i).render(g, changeX, changeY);
   113	//		}
   114			g.drawImage(ApoSlitherLinkImages.star, (int)(this.changeX + changeX + this.startX * this.width - 1 - ApoSlitherLinkImages.star.getWidth()/2), (int)(this.changeY - 3 + changeY + this.startY * this.width - ApoSlitherLinkImages.star.getHeight()/2), null);
   115		}
   116	}

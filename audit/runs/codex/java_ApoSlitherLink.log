    35		/**
    36		 * Methode um ein Bild aus der Jar oder vom FIlesystem zu laden
    37		 * @param path : Pfad zum Bild
    38		 * @param bFile : TRUE, Bild von der Festplatte laden, FALSE aus der JAR

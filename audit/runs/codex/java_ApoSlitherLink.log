   229			String s = String.valueOf(this.width);
   230			int w = g.getFontMetrics().stringWidth(s);
   231			int h = g.getFontMetrics().getHeight() - 2 * g.getFontMetrics().getDescent();
   232			g.drawString(s, x - w/2, y + h/2);
   233			
   234			y = (int)(this.getGame().getButtons()[18].getY() + this.getGame().getButtons()[18].getHeight()/2);
   235			s = String.valueOf(this.height);
   236			w = g.getFontMetrics().stringWidth(s);
   237			g.drawString(s, x - w/2, y + h/2);

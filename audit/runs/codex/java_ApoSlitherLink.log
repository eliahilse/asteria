   334		public void makeLevelImage() {
   335			this.iLevel = new BufferedImage(ApoSlitherLinkConstants.GAME_WIDTH, ApoSlitherLinkConstants.GAME_HEIGHT, BufferedImage.TYPE_INT_RGB);
   336			Graphics2D g = (Graphics2D)(this.iLevel.getGraphics());
   337			
   338			g.setRenderingHint(RenderingHints.KEY_ANTIALIASING, RenderingHints.VALUE_ANTIALIAS_ON);
   339			this.model.renderBackground(g);
   340			
   341			int changeX = this.model.getGame().getChangeX();
   342			int changeY = this.model.getGame().getChangeY();
   343			int width = this.level[0][0].getWidth();
   344			int roundWidth = this.level[0].length * width + 20;
   345			int roundHeight = this.level.length * width + 20;
   346			g.setColor(ApoSlitherLinkLevelHelp.COLOR_BACKGROUND);
   347			g.fillRoundRect(changeX - 10, changeY - 10, roundWidth - 1, roundHeight - 1, 30, 30);
   348			g.setColor(ApoSlitherLinkLevelHelp.COLOR_LINE);
   349			g.drawRoundRect(changeX - 10, changeY - 10, roundWidth - 1, roundHeight - 1, 30, 30);
   350			this.renderLevel(g, changeX, changeY, true);
   351			
   352			this.getModel().getModel().setRec(new Rectangle2D.Double(changeX - 10, changeY - 10, roundWidth, roundHeight));
   353			
   354			g.dispose();
   355			
   356			this.iLevelOver = new BufferedImage(roundWidth, roundHeight, BufferedImage.TYPE_INT_RGB);
   357			g = (Graphics2D)(this.iLevelOver.getGraphics());
   358			
   359			g.setRenderingHint(RenderingHints.KEY_ANTIALIASING, RenderingHints.VALUE_ANTIALIAS_ON);
   360			this.model.renderBackground(g, -(changeX-10 + 1), -(changeY - 10 + 1));
   361			g.setColor(ApoSlitherLinkLevelHelp.COLOR_BACKGROUND);
   362			g.fillRoundRect(0, 0, roundWidth - 1, roundHeight - 1, 30, 30);
   363			g.setColor(ApoSlitherLinkLevelHelp.COLOR_LINE);
   364			g.drawRoundRect(0, 0, roundWidth - 1, roundHeight - 1, 30, 30);
   365			this.renderLevel(g, 10, 10, true);
   366			
   367			g.dispose();
   368		}

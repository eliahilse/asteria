   254		 */
   255		public static byte[][] getCopy(byte[][] copyArray) {
   256			byte[][] array = new byte[copyArray.length][copyArray[0].length];
   257			for (int y = 0; y < copyArray.length; y++) {
   258				for (int x = 0; x < copyArray[0].length; x++) {
   259					array[y][x] = copyArray[y][x];
   260				}
   261			}
   262			return array;
   263		}
   264		
   265		/**
   266		 * gibt ein kopiertes gleiches Feld zur�ck
   267		 * @param copyArray : das zu kopierende Array
   268		 * @return gibt ein kopiertes gleiches Feld zur�ck
   269		 */
   270		public static int[][] getCopy(int[][] copyArray) {
   271			int[][] array = new int[copyArray.length][copyArray[0].length];
   272			for (int y = 0; y < copyArray.length; y++) {
   273				for (int x = 0; x < copyArray[0].length; x++) {
   274					array[y][x] = copyArray[y][x];
   275				}
   276			}
   277			return array;
   278		}
   279		
   280		/**
   281		 * gibt den MD5 Hash eines Strings zur�ck
   282		 * @param pInput : Inputstring
   283		 * @return gibt den MD5 Hash eines Strings zur�ck
   284		 */
   285		public static String getMd5Digest(String pInput) {
   286			try {
   287				MessageDigest lDigest = MessageDigest.getInstance("MD5");
   288				lDigest.update(pInput.getBytes());
   289				BigInteger lHashInt = new BigInteger(1, lDigest.digest());
   290				return String.format("%1$032X", lHashInt);
   291			} catch(NoSuchAlgorithmException lException) {
   292				throw new RuntimeException(lException);
   293			}
   294		}
   295	}

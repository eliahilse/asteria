    41				}
    42			}
    43			return false;
    44		}
    45		
    46		public int isIn(int x, int y) {
    47			for (int i = 0; i < this.connected.size(); i++) {
    48				if ((this.connected.get(i).x == x) &&
    49					(this.connected.get(i).y == y)) {
    50					return i;
    51				}
    52			}
    53			return -1;
    54		}

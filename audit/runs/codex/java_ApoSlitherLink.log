    60					MidiChannel[] channels = ((Synthesizer)(this.sequencer)).getChannels();
    61					double gain = (float) volume / 100f;
    62					for (int i = 0; i < channels.length; i++) {
    63						channels[i].controlChange(7, (int) (gain * 127.0));
    64					}

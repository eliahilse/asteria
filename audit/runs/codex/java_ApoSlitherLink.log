   119				this.getGame().startHardLevel();
   120			} else if (function.equals(ApoSlitherLinkMenu.CUSTOM)) {
   121				if (this.getGame().getLevel().getMaxCustomLevel() > 0) {
   122					this.getGame().startCustomLevel();

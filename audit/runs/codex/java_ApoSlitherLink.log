   295		private void drawNumber(Graphics2D g, int changeX, int changeY, Color background, Color line, boolean bImage) {
   296			if (this.value >= 0) {
   297				if (this.curValue != this.value) {
   298					g.setColor(new Color(line.getRed(), line.getGreen(), line.getBlue(), 80));
   299					if ((!bImage) && (this.value != 0)) {
   300						return;
   301					}
   302				} else {
   303					g.setColor(background.brighter().brighter());
   304				}
   305				int ourW = 20;
   306				g.fillOval(this.x + changeX + this.getWidth()/2 - ourW/2, this.y + changeY + this.getWidth()/2 - ourW/2, ourW, ourW);
   307				g.setColor(line.brighter());
   308				g.drawOval(this.x + changeX + this.getWidth()/2 - ourW/2, this.y + changeY + this.getWidth()/2 - ourW/2, ourW, ourW);
   309				g.setColor(line);
   310				if (this.curValue != this.value) {
   311					g.setColor(line.darker());			
   312				}
   313				g.setFont(this.FONT);
   314				String s = String.valueOf(this.value);
   315				int w = g.getFontMetrics().stringWidth(s);
   316				int h = g.getFontMetrics().getHeight() - 2 * g.getFontMetrics().getDescent();
   317				g.drawString(s, this.x + changeX + this.width/2 - w/2, this.y + changeY + this.width/2 + h/2);
   318			}
   319		}

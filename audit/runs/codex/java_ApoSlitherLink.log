   134		@Override
   135		public void mouseButtonReleased(int x, int y, boolean right) {
   136			int width = this.getGame().getLevel().getLevel()[0][0].getWidth();
   137			int xLength = this.getGame().getLevel().getLevel()[0].length * width;
   138			int yLength = this.getGame().getLevel().getLevel().length * width;
   139	
   140			if (new Rectangle2D.Double(this.getGame().getGame().getChangeX(), this.getGame().getGame().getChangeY(), xLength, yLength).contains(x, y)) {
   141				int levelX = (int)(((float)x - (float)this.getGame().getGame().getChangeX()) / (float)width);
   142				int levelY = (int)(((float)y - (float)this.getGame().getGame().getChangeY()) / (float)width);
   143				int value = this.getGame().getLevel().getLevel()[levelY][levelX].getValue();
   144				if (right) {
   145					value -= 1;
   146				} else {
   147					value += 1;
   148				}
   149				if (value < -1) {
   150					value = 3;
   151				} else if (value > 3) {
   152					value = -1;
   153				}
   154				String s = String.valueOf(value);
   155				if (value == -1) {
   156					s = " ";
   157				}
   158				this.getGame().getLevel().changeLevelString(levelY * this.getGame().getLevel().getLevel()[0].length + levelX + 4, String.valueOf(s));
   159				this.bSolved = false;
   160				this.bUploadCheck = false;
   161				if (this.getGame().getLevel().isCorrectLevel()) {
   162					this.getGame().getButtons()[22].setBVisible(true);
   163					this.getGame().getButtons()[23].setBVisible(false);
   164				}
   165			}
   166		}
   167		
   168		public void mouseMoved(int x, int y) {
   169			int width = this.getGame().getLevel().getLevel()[0][0].getWidth();
   170			int xLength = this.getGame().getLevel().getLevel()[0].length * width;
   171			int yLength = this.getGame().getLevel().getLevel().length * width;
   172	
   173			if (new Rectangle2D.Double(this.getGame().getGame().getChangeX(), this.getGame().getGame().getChangeY(), xLength, yLength).contains(x, y)) {
   174				int levelX = (int)(((float)x - (float)this.getGame().getGame().getChangeX()) / (float)width);
   175				int levelY = (int)(((float)y - (float)this.getGame().getGame().getChangeY()) / (float)width);
   176				for (int i = 0; i < this.over.length; i++) {
   177					for (int j = 0; j < this.over[0].length; j++) {
   178						if ((levelY == i) && (levelX == j)) {
   179							this.over[i][j] = true;
   180						} else {
   181							this.over[i][j] = false;
   182						}
   183					}
   184				}
   185				this.bIn = true;
   186			} else {
   187				if (this.bIn) {
   188					this.bIn = false;
   189					for (int i = 0; i < this.over.length; i++) {
   190						for (int j = 0; j < this.over[0].length; j++) {
   191							this.over[i][j] = false;
   192						}
   193					}
   194				}
   195			}
   196		}

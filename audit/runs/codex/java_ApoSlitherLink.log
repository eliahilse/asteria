   204			this.value = this.EASY;
   205			int add = curLevel - this.curLevel;
   206			this.curLevel = curLevel;
   207			ApoSlitherLinkLevelsHelp help = this.levels.getEasyLevel(this.curLevel);
   208			if (help != null) {
   209				this.setLevel(this.levels.getEasyLevel(this.curLevel).getLevelString(), true);
   210			} else {
   211				if (add < 0) {
   212					this.setEasyLevels(this.levels.getEasyLevels().size() - 1);
   213				} else {
   214					this.setEasyLevels(0);
   215				}
   216			}
   217			this.makeLevelImage();
   218		}

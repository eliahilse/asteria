   348		public void mousePressed(MouseEvent e) {
   349			if (e.getButton() == MouseEvent.BUTTON3) {
   350				this.bRightMouse = true;
   351				this.oldMouseX = e.getX();
   352				this.oldMouseY = e.getY();
   353			} else {
   354				this.bRightMouse = false;
   355				super.mousePressed(e);
   356			}
   357		}
   358		
   359		public void mouseDragged(MouseEvent e) {
   360			this.mouseX = e.getX();
   361			this.mouseY = e.getY();
   362			if ((this.bRightMouse)) {
   363				int changeX = this.oldMouseX - e.getX();
   364				int changeY = this.oldMouseY - e.getY();
   365				this.oldMouseX = e.getX();
   366				this.oldMouseY = e.getY();
   367				if ( ( this.curWidth < this.levelWidth ) ) {
   368					this.curX += changeX;
   369					if ( this.curX + this.curWidth >= this.levelWidth ) {
   370							this.curX = this.levelWidth - this.curWidth;
   371					}
   372					if ( this.curX < 0 ) {
   373						this.curX = 0;
   374					}
   375					if ( !super.isBRepaint() )
   376						super.render();
   377				}
   378				if ( this.curHeight < this.levelHeight ) {
   379					this.curY += changeY;
   380					if ( this.curY + this.curHeight >= this.levelHeight ) {
   381							this.curY = this.levelHeight - this.curHeight;
   382					}
   383					if ( this.curY < 0 ) {
   384						this.curY = 0;
   385					}
   386					if ( !super.isBRepaint() )
   387						super.render();
   388				}
   389			}
   390		}

   406		/**
   407		 * rendert die Anzeige f�r die FPS und die Thinkzeit
   408		 * @param g : das Graphicsobjekt
   409		 */
   410		private void renderFPS(Graphics2D g) {
   411			if (super.isBFPS()) {
   412				g.setColor(Color.red);
   413				g.setFont(ApoSlitherLinkConstants.FONT_FPS);
   414				g.drawString("think time: " + this.thinkTime + " ns", 5, ApoSlitherLinkConstants.GAME_HEIGHT - 45);
   415				g.drawString("think time: " + (this.thinkTime / 1000000) + " ms",5, ApoSlitherLinkConstants.GAME_HEIGHT - 35);
   416	
   417				g.drawString("draw time: " + this.renderTime + " ns", 5, ApoSlitherLinkConstants.GAME_HEIGHT - 25);
   418				g.drawString("draw time: " + (this.renderTime / 1000000) + " ms", 5, ApoSlitherLinkConstants.GAME_HEIGHT - 15);
   419				g.drawString("FPS: " + super.getFPS(), 5, ApoSlitherLinkConstants.GAME_HEIGHT - 5);
   420			}
   421		}

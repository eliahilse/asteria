   176		public void nextLevel(boolean bSolved, int add) {
   177			if (this.value == this.EASY) {
   178				if (bSolved) {
   179					this.levels.getEasyLevels().get(this.curLevel).setBSolved(bSolved);
   180				}
   181				this.setEasyLevels(this.curLevel + add);
   182			} else if (this.value == this.MEDIUM) {
   183				if (bSolved) {
   184					this.levels.getMediumLevels().get(this.curLevel).setBSolved(bSolved);
   185				}
   186				this.setMediumLevels(this.curLevel + add);
   187			} else if (this.value == this.HARD) {
   188				if (bSolved) {
   189					this.levels.getHardLevels().get(this.curLevel).setBSolved(bSolved);
   190				}
   191				this.setHardLevels(this.curLevel + add);
   192			} else if (this.value == this.CUSTOM) {
   193				if (bSolved) {
   194					this.levels.getCustomLevels().get(this.curLevel).setBSolved(bSolved);
   195				}
   196				this.setCustomLevels(this.curLevel + add);
   197			}
   198		}

    93							try {
    94								nBytesRead = audioInputStream.read(abData, 0, abData.length);
    95							} catch (IOException e) {
    96							}
    97							if (nBytesRead >= 0) {
    98								line.write(abData, 0, nBytesRead);
    99							}
   100						}
   101						line.drain();
   102						line.close();
   103					} while ((!this.isBStop()) && (this.isBLoop()));

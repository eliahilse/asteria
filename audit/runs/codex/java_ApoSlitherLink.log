    71		}
    72		
    73		public BufferedImage getImageMouseOver(BufferedImage iOriginal, int width) {
    74			return this.getImageMouseOver(iOriginal, 0x00000000, new Color(255, 0, 0, 230), width);
    75		}
    76		
    77		public BufferedImage getImageMouseOver(BufferedImage iOriginal, int searchColor, Color drawColor, int w) {
    78			int width = iOriginal.getWidth();
    79			int height = iOriginal.getHeight();
    80			BufferedImage iSelect = GraphicsEnvironment.getLocalGraphicsEnvironment().getDefaultScreenDevice().getDefaultConfiguration().createCompatibleImage( width, height, BufferedImage.TRANSLUCENT );
    81			Graphics2D g	= (Graphics2D)iSelect.getGraphics();
    82	
    83			g.setRenderingHint(RenderingHints.KEY_ANTIALIASING, RenderingHints.VALUE_ANTIALIAS_ON);
    84			
    85			g.drawImage(iOriginal, 0, 0, null);
    86			
    87			g.setColor(drawColor);
    88			int color = searchColor;
    89			for (int y = 0; y < height; y++) {
    90				for (int x = 0; x < width; x++) {
    91					if (x + 1 < iOriginal.getWidth()) {
    92						if ((iOriginal.getRGB(x + 1, y) != color) &&
    93							(iOriginal.getRGB(x, y) == color)) {
    94							g.fillRect(x - w/2, y, w, 1);
    95						}
    96					}
    97					if ((x - 1 >= 0)) {
    98						if ((iOriginal.getRGB(x, y) == color) &&
    99							(iOriginal.getRGB(x - 1, y) != color)) {
   100							g.fillRect(x, y, w, 1);
   101						}
   102					} 
   103					if ((y - 1 >= 0)) {
   104						if ((iOriginal.getRGB(x, y) == color) &&
   105							(iOriginal.getRGB(x, y - 1) != color)) {
   106							g.fillRect(x, y, 1, w);
   107						}
   108					}
   109					if (y + 1 < height) {
   110						if ((iOriginal.getRGB(x, y + 1) != color) &&
   111							(iOriginal.getRGB(x, y) == color)) {
   112							g.fillRect(x, y - w/2, 1, w);
   113						}
   114					}
   115				}
   116			}
   117					
   118			g.dispose();
   119			
   120			return iSelect;
   121		}

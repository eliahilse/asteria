    53		 * @param degrees = Winkelangabe
    54		 * @return gedrehtes Bild
    55		 */
    56		public static BufferedImage rotateImageMethodTwo(BufferedImage inputImage, double degrees ) {
    57			int x,y = 0;
    58			
    59			if ((degrees == 0)||(degrees == 180)||(degrees == 360)){
    60				x = inputImage.getWidth(null);
    61				y = inputImage.getHeight(null);
    62			} else {
    63				x = inputImage.getHeight(null);
    64				y = inputImage.getWidth(null);
    65			}
    66			BufferedImage sourceBI = GraphicsEnvironment.getLocalGraphicsEnvironment().getDefaultScreenDevice().getDefaultConfiguration().createCompatibleImage(x, y, BufferedImage.TRANSLUCENT);
    67			AffineTransform at = new AffineTransform();
    68	
    69			// rotate around image center
    70			at.rotate(Math.toRadians( degrees ), (sourceBI.getWidth() / 2), (sourceBI.getHeight() / 2) );
    71	
    72		    /*
    73		     * translate to make sure the rotation doesn't cut off any image data
    74		     */
    75			AffineTransform translationTransform;
    76			translationTransform = findTranslation( at, sourceBI, degrees );
    77			at.preConcatenate( translationTransform );
    78	
    79	
    80			Graphics2D g = (Graphics2D) sourceBI.getGraphics();
    81			g.setRenderingHint(RenderingHints.KEY_ANTIALIASING, RenderingHints.VALUE_ANTIALIAS_ON);
    82			g.setTransform(at);
    83			g.drawImage(inputImage, 0, 0, null);
    84	
    85			return sourceBI;
    86		}

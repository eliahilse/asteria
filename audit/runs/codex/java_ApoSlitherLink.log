   405		}
   406	
   407		public void setLevel(String levelString, boolean bMakeLevel) {
   408			this.blinkLine = null;
   409			
   410			this.curString = levelString;
   411			int width = -1;
   412			try {
   413				width = Integer.valueOf(levelString.substring(0, 2));
   414				levelString = levelString.substring(2);
   415			} catch (Exception ex) {
   416				width = -1;
   417			}
   418			int height = -1;
   419			try {
   420				height = Integer.valueOf(levelString.substring(0, 2));
   421				levelString = levelString.substring(2);
   422			} catch (Exception ex) {
   423				height = -1;
   424			}
   425			this.level = new ApoSlitherLinkLevelHelp[height][width];
   426			int realWidth = 60;
   427			if ((width >= 7) || (height >= 7)) {
   428				realWidth = 45;
   429				if ((width >= 9) || (height >= 9)) {
   430					realWidth = 35;
   431					if ((width >= 12) || (height >= 12)) {
   432						realWidth = 25;
   433					}
   434				}
   435			}
   436			for (int y = 0; y < this.level.length; y++) {
   437				for (int x = 0; x < this.level[0].length; x++) {
   438					int value = -1;

   125		public void loadLevels() {
   126			if (!ApoConstants.B_APPLET) {
   127				this.io.readLevel(ApoSlitherLinkPanel.LOAD_STRING);
   128			}
   129			this.io.checkLevelsIsIn(this.level.getLevels().getEasyLevels(), this.level);
   130			this.io.checkLevelsIsIn(this.level.getLevels().getMediumLevels(), this.level);
   131			this.io.checkLevelsIsIn(this.level.getLevels().getHardLevels(), this.level);
   132			this.io.addCustomsLevels(this.level.getLevels().getCustomLevels(), this.level);
   133			new Thread() {
   134				public void run() {
   135					ApoHighscore highscore = ApoHighscore.getInstance();
   136					highscore.load();
   137					for (int i = 0; i < highscore.getLevels().size(); i++) {
   138						ApoSlitherLinkPanel.this.level.getLevels().addCustomLevel(highscore.getLevels().get(i));
   139					}
   140				}
   141			}.start();
   142		}

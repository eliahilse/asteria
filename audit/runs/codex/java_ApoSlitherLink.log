   241				y = (int)(this.getGame().getButtons()[23].getY() + this.getGame().getButtons()[23].getHeight()/2);
   242				if (this.bUpload) {
   243					s = "upload complete";
   244				} else {
   245					s = "upload in progress";
   246				}
   247				g.drawString(s, x, y + h/2);
   248			}
   249		}

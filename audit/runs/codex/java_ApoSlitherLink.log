   204		@Override
   205		public void render(Graphics2D g) {
   206			super.getGame().renderBackground(g);
   207			
   208			int changeX = this.getGame().getGame().getChangeX();
   209			int changeY = this.getGame().getGame().getChangeY();
   210			this.getGame().getLevel().render(g, changeX, changeY);
   211			
   212			g.setColor(ApoSlitherLinkLevelHelp.COLOR_MOVE);
   213			for (int i = 0; i < this.over.length; i++) {
   214				for (int j = 0; j < this.over[0].length; j++) {
   215					if (this.over[i][j]) {
   216						Stroke stroke = g.getStroke();
   217						g.setStroke(new BasicStroke(3));
   218						int width = this.getGame().getLevel().getLevel()[0][0].getWidth();
   219						g.drawRect(changeX + j * width, changeY + i * width, width - 3, width - 3);
   220						g.setStroke(stroke);
   221					}
   222				}
   223			}

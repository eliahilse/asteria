   325		public void think(int delta) {
   326			long t = System.nanoTime();
   327			super.think(delta);
   328			this.thinkLevel(delta);
   329			this.thinkCloud(delta);
   330			if (this.model != null) {
   331				this.model.think(delta);
   332			}
   333			this.thinkTime = (int) (System.nanoTime() - t);
   334		}

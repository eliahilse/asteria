   206		/**
   207		 * startet den Thread und f�gt Mouse und KeyListeners
   208		 * hinzu wenn es gew�nscht ist
   209		 */
   210		public void start() {
   211			if ((this.threadThinkAndRender == null) && (this.timerThread == ApoConstants.ONE_THREADS)) {
   212				this.setBThink(true);
   213	
   214				this.threadThinkAndRender = new ApoThread(this, WAIT_TIME);
   215				this.threadThinkAndRender.start();
   216			} else if ((this.threadThink == null) && (this.threadRender == null) && (this.timerThread == ApoConstants.TWO_THREADS)) {
   217				this.setBThink(true);
   218	
   219				this.threadThink = new ApoThread(this, WAIT_TIME);
   220				this.threadThink.setBRender(false);
   221				this.threadThink.start();
   222				
   223				this.threadRender = new ApoThread(this, WAIT_TIME);
   224				this.threadRender.setBThink(false);
   225				this.threadRender.start();
   226			}
   227			if (this.bMouse) {
   228				this.addMouseListener(this);
   229				this.addMouseMotionListener(this);
   230				this.addMouseWheelListener(this);
   231			}
   232			if (this.bKey) {
   233				this.addFocusListener( this );
   234				if (!ApoConstants.B_APPLET) {
   235					this.addKeyListener(this);
   236				} else {
   237					this.addKeyListener(this);
   238				}
   239			}
   240		}
   241	
   242		/**
   243		 * stoppt den Thread und entfernt die Mouse und KeyListeners
   244		 * falls welches hinzugef�gt worden sind
   245		 */
   246		public void stop() {
   247			if ((this.threadThinkAndRender != null) && (this.timerThread == ApoConstants.ONE_THREADS)) {
   248				this.setBThink(false);
   249	
   250				this.threadThinkAndRender.stop();
   251				this.threadThinkAndRender = null;
   252			} else if ((this.threadThink != null) && (this.threadRender != null) && (this.timerThread == ApoConstants.TWO_THREADS)) {
   253				this.setBThink(false);
   254	
   255				this.threadThink.stop();
   256				this.threadThink = null;
   257				
   258				this.threadRender.stop();
   259				this.threadRender = null;
   260			}
   261			if (this.bMouse) {
   262				this.removeMouseListener(this);
   263				this.removeMouseMotionListener(this);
   264				this.removeMouseWheelListener(this);
   265			}
   266			if (this.bKey) {
   267				if (!ApoConstants.B_APPLET) {
   268					this.removeKeyListener(this);
   269				} else {
   270					this.removeKeyListener(this);
   271				}
   272			}
   273		}

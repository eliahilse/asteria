    36					if (info[i].getName().indexOf("Sequence") != -1) {
    37						this.sequencer = (Sequencer) MidiSystem.getMidiDevice(info[i]);
    38					} else if (info[i].getName().indexOf("Synthe") != -1) {
    39						this.synthesizer = (Synthesizer) MidiSystem.getMidiDevice(info[i]);
    40					}
    41				}
    42				if (this.sequencer != null) {
    43					this.sequencer.open();
    44				}
    45				if (this.synthesizer != null) {
    46					this.synthesizer.open();
    47				}
    48				if ((this.sequencer != null) && (this.synthesizer != null)) {
    49					Receiver synthReceiver = synthesizer.getReceiver();
    50					Transmitter seqTransmitter = sequencer.getTransmitter();
    51					seqTransmitter.setReceiver(synthReceiver);
    52				}
    53			} catch (MidiUnavailableException ex) {
    54				this.sequencer = null;
    55				this.synthesizer = null;
    56			}
    57		}

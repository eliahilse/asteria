    83		@Override
    84		public void mouseButtonFunction(String function) {
    85			if (function.equals(ApoSlitherLinkEditor.RETURN)) {
    86				this.getGame().setMenu();
    87			} else if (function.equals(ApoSlitherLinkEditor.LEFTHEIGHT)) {
    88				this.height -= 1;
    89				if (this.height < this.MIN_HEIGHT) {
    90					this.height = this.MAX_HEIGHT;
    91				}
    92			} else if (function.equals(ApoSlitherLinkEditor.RIGHTHEIGHT)) {
    93				this.height += 1;
    94				if (this.height > this.MAX_HEIGHT) {
    95					this.height = this.MIN_HEIGHT;
    96				}
    97			} else if (function.equals(ApoSlitherLinkEditor.LEFTWIDTH)) {
    98				this.width -= 1;
    99				if (this.width < this.MIN_WIDTH) {
   100					this.width = this.MAX_WIDTH;
   101				}
   102			} else if (function.equals(ApoSlitherLinkEditor.RIGHTWIDTH)) {
   103				this.width += 1;
   104				if (this.width > this.MAX_WIDTH) {
   105					this.width = this.MIN_WIDTH;
   106				}
   107			} else if (function.equals(ApoSlitherLinkEditor.SET)) {
   108				this.set();
   109			} else if (function.equals(ApoSlitherLinkEditor.TEST)) {
   110				this.getGame().testLevelFromEditor();
   111				this.getGame().getLevel().makeLevelImage();
   112			} else if (function.equals(ApoSlitherLinkEditor.UPLOAD)) {
   113				if ((this.bSolved) && (this.getGame().getLevel().isCorrectLevel())) {
   114					this.bUpload = false;
   115					this.bUploadCheck = true;
   116					this.getGame().getLevel().addCustomLevels();
   117					new Thread() {
   118						public void run() {
   119							ApoSlitherLinkEditor.this.bUpload = ApoHighscore.getInstance().save(ApoSlitherLinkEditor.this.getGame().getLevel().getCurrentLevel().getLevelString(), ApoSlitherLinkEditor.this.getGame().getLevel().getCurrentLevel().getSolvedLevelString(), "Apo");						
   120						}
   121					}.start();
   122				}
   123			}
   124		}

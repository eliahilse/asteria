   316		@Override
   317		public void think(int delta) {
   318			if (this.curMouseFunction != null) {
   319				this.mouseButtonFunction(this.curMouseFunction);
   320				this.curMouseFunction = null;
   321				this.bReleasedMouse = false;
   322			} else if ((this.getReleasedKeys() != null) && (this.getReleasedKeys().size() > 0)) {
   323				try {
   324					while (this.getReleasedKeys().size() > 0) {
   325						this.keyButtonReleased(this.getReleasedKeys().get(0), this.charKeys.get(0));
   326						this.getReleasedKeys().remove(0);
   327						this.charKeys.remove(0);
   328					}
   329				} catch (Exception ex) {
   330				}
   331			} else if (this.bReleasedMouse) {
   332				this.bReleasedMouse = false;
   333				this.mouseButtonReleased(this.mouseX, this.mouseY, this.bRightMouse);
   334			}
   335		}

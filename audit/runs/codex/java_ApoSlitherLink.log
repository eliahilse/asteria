     6	
     7	public class ApoTextField extends ApoEntity {
     8	
     9		private final int TIME_LINE = 400;
    10		private String curString;
    11		private int position;
    12		private int time;
    13		private boolean bLineOn;
    14		private int maxLength;
    15		private Font font;
    16		
    17		public ApoTextField(float x, float y, float width, float height) {
    18			super(null, x, y, width, height);
    19		}
    20	
    21		public void init() {
    22			super.init();
    23			this.curString = "";
    24			this.position = this.curString.length();
    25			this.bLineOn = true;
    26			this.time = 0;
    27			if (this.maxLength <= 0) {
    28				this.maxLength = 20;
    29			}
    30			if (this.font == null) {
    31				this.font = new Font(Font.DIALOG, Font.BOLD, 15);
    32			}
    33		}
    34	
    35		public Font getFont() {
    36			return this.font;
    37		}
    38	
    39		public void setFont(Font font) {
    40			this.font = font;
    41		}
    42	
    43		public int getMaxLength() {
    44			return this.maxLength;
    45		}
    46	
    47		public void setMaxLength(int maxLength) {
    48			this.maxLength = maxLength;
    49		}
    50	
    51		public String getCurString() {
    52			return this.curString;
    53		}
    54	
    55		public void setCurString(String curString) {
    56			this.curString = curString;
    57		}
    58	
    59		public int getPosition() {
    60			return this.position;
    61		}
    62	
    63		public void setPosition(int position) {
    64			this.position = position;
    65			if (this.position < 0) {
    66				this.position = 0;
    67			} else if (this.position > this.curString.length()) {
    68				this.position = this.curString.length();
    69			}
    70			this.showLine();
    71		}
    72	
    73		private void deleteTextBackspace() {
    74			if (curString.length() > 0 && position != 0) {
    75				this.curString = (new StringBuilder(String.valueOf(this.curString.substring(0, this.position - 1)))).append(this.curString.substring(this.position, this.curString.length())).toString();
    76				setPosition(getPosition() - 1);
    77			}
    78			showLine();
    79		}
    80	
    81		private void deleteTextDelete() {
    82			if (this.curString.length() != this.position) {
    83				this.curString = (new StringBuilder(String.valueOf(this.curString.substring(0, getPosition())))).append(this.curString.substring(getPosition() + 1, this.curString.length())).toString();
    84			}
    85			showLine();
    86		}
    87	
    88		public void addCharacter(int button, char character) {
    89			if (isBSelect()) {
    90				if (button == 8) {
    91					deleteTextBackspace();
    92				} else if (button == 127) {
    93					deleteTextDelete();
    94				} else if (button == 37) {
    95					setPosition(getPosition() - 1);
    96				} else if (button == 39) {
    97					setPosition(getPosition() + 1);
    98				} else if (curString.length() <= 20 && character >= '!' && character <= '~') {
    99					this.curString = (new StringBuilder(String.valueOf(this.curString.substring(0, this.position)))).append(character).append(this.curString.substring(this.position, this.curString.length())).toString();
   100					this.position++;
   101					showLine();
   102				}
   103			}
   104		}
   105	
   106		private void showLine() {
   107			if (isBSelect()) {
   108				this.bLineOn = true;
   109				this.time = 0;
   110			}
   111		}
   112	
   113		public void think(int delta) {
   114			this.time += delta;
   115			if (this.time > this.TIME_LINE) {
   116				this.time = 0;
   117				this.bLineOn = !this.bLineOn;
   118			}
   119		}
   120	
   121		public void render(Graphics2D g, int changeX, int changeY) {
   122			g.setColor(Color.white);
   123			g.fillRect((int) (getX() + (float) changeX), (int) (getY() + (float) changeY), (int) getWidth(), (int) getHeight());
   124			if (!isBSelect()) {
   125				g.setColor(Color.black);
   126			} else {
   127				g.setColor(Color.red);
   128			}
   129			g.drawRect((int) (getX() + (float) changeX), (int) (getY() + (float) changeY), (int) getWidth(), (int) getHeight());
   130			g.setColor(Color.black);
   131			if (this.curString != null) {
   132				g.setFont(this.font);
   133				g.drawString(this.curString, (int) (getX() + 5F + (float) changeX), (int) (getY() + this.getHeight()/2 + 10 + (float) changeY));
   134				if (this.isBSelect() && this.bLineOn) {
   135					int w = g.getFontMetrics().stringWidth(this.curString.substring(0, this.position));
   136					g.drawLine((int)(getX() + 5F + w + changeX), (int)(getY() + 5F + changeY), (int)(getX() + 5F + w + changeX), (int)(getY() + this.getHeight()/2 + 10 + changeY));
   137				}
   138			}
   139		}
   140	}

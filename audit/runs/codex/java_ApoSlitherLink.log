   139		public BufferedImage getButtonWithImage(int width, int height, BufferedImage iPic, String text, Color textColor, Color mousePressed, Color mouseReleased) {
   140			return this.getButtonWithImage(width, height, iPic, text, textColor, mousePressed, mouseReleased, new Font("Dialog", Font.BOLD, 13));
   141		}
   142		
   143		public BufferedImage getButtonWithImage(int width, int height, BufferedImage iPic, String text, Color textColor, Color mousePressed, Color mouseReleased, Font font) {
   144			BufferedImage iButton = GraphicsEnvironment.getLocalGraphicsEnvironment().getDefaultScreenDevice().getDefaultConfiguration().createCompatibleImage(width,height,BufferedImage.TYPE_INT_ARGB_PRE);
   145			Graphics2D g = (Graphics2D)iButton.getGraphics();
   146			
   147			g.setRenderingHint(RenderingHints.KEY_ANTIALIASING, RenderingHints.VALUE_ANTIALIAS_ON);
   148			
   149			int oneWidth = width/3;
   150			int widthPic = 0;
   151			if (iPic != null) {
   152				widthPic = iPic.getWidth();
   153			}
   154			g.setFont(font);
   155			int fontHeight = g.getFontMetrics().getHeight();
   156			
   157			for ( int i = 0; i < 3; i++ ) {
   158				if (iPic != null) {
   159					g.drawImage(iPic, oneWidth * i + oneWidth/2 - widthPic/2, height/2 - iPic.getHeight()/2, null);
   160				}
   161				
   162				int w = g.getFontMetrics().stringWidth(text);
   163				if (i > 0) {
   164					if (i == 1) {
   165						g.setColor(mousePressed);
   166					} else {
   167						g.setColor(mouseReleased);
   168					}
   169					g.fillRoundRect(oneWidth * i + oneWidth/2 - w/2 - 2, height/2 - fontHeight/2, w + 4, fontHeight - 10, 10, 10);
   170				}
   171				g.setColor(textColor);
   172				g.drawString(text, i * oneWidth + oneWidth/2 - w/2, height/2 + 5);
   173			}
   174			
   175			g.dispose();
   176			return iButton;
   177		}
   178		
   179	}

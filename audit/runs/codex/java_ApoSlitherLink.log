   386		
   387		public void setLevel(int width, int height) {
   388			String w = String.valueOf(width);
   389			while (w.length() < 2) {
   390				w = "0" + w;
   391			}
   392			String h = String.valueOf(height);
   393			while (h.length() < 2) {
   394				h = "0" + h;
   395			}
   396			String levelString = w + h;
   397			for (int i = 0; i < width * height; i++) {
   398				levelString += " ";
   399			}
   400			this.setLevel(levelString, true);
   401		}

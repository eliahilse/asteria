    44		
    45		/**
    46		 * gibt das Logo f�r das Spiel zur�ck
    47		 * @param width : Breite des Logos
    48		 * @param height : H�he des Logos
    49		 * @param iPlayer : Bild des Spielers
    50		 * @return Logo f�r das Spiel
    51		 */
    52		public BufferedImage getLogo() {
    53			int width = 20;
    54			BufferedImage iLogo = GraphicsEnvironment.getLocalGraphicsEnvironment().getDefaultScreenDevice().getDefaultConfiguration().createCompatibleImage(width, width, BufferedImage.TRANSLUCENT);
    55			Graphics2D g = (Graphics2D)iLogo.getGraphics();
    56	
    57			g.setRenderingHint(RenderingHints.KEY_ANTIALIASING, RenderingHints.VALUE_ANTIALIAS_ON);
    58			
    59			g.setColor(ApoSlitherLinkLevelHelp.COLOR_BACKGROUND);
    60			g.fillOval(1, 1, width - 2, width - 2);
    61			g.setColor(ApoSlitherLinkPanel.COLOR_ABOVE_FIRST);
    62			g.drawOval(1, 1, width - 2, width - 2);
    63			
    64			g.dispose();
    65			
    66			return iLogo;
    67		}

   381			if (this.model != null) {
   382				this.model.render(g);
   383			}
   384			super.renderButtons(g);
   385			if (this.model != null) {
   386				this.model.renderAfter(g);
   387			}
   388			this.renderFPS(g);
   389			this.renderTime = (int)(System.nanoTime() - t);
   390		}

   346		public void thinkCloud(int delta) {
   347			this.cloudTime -= delta;
   348			if (this.cloudTime <= 0) {
   349				this.cloudTime = 20000 + (int)(Math.random() * 25000);
   350				int cloud = (int)(Math.random() * ApoSlitherLinkImages.clouds.length + 1);
   351				if (cloud >= ApoSlitherLinkImages.clouds.length) {
   352					cloud = ApoSlitherLinkImages.clouds.length - 1;
   353				}
   354				int width = ApoSlitherLinkImages.clouds[cloud].getWidth();
   355				int height = ApoSlitherLinkImages.clouds[cloud].getHeight();
   356				int y = (int)(Math.random() * (ApoSlitherLinkConstants.GAME_HEIGHT - 90 - height)) + 90;
   357				int x = -width;
   358				float vecX = 0.0055f + (float)(Math.random() * 0.01);
   359				if (Math.random() * 100 > 50) {
   360					x = ApoSlitherLinkConstants.GAME_WIDTH;
   361					vecX = -0.0055f - (float)(Math.random() * 0.01);
   362				}
   363				this.clouds.add(new ApoSlitherLinkCloud(cloud, x, y, width, height, vecX));
   364			}
   365			for (int i = this.clouds.size() - 1; i >= 0; i--) {
   366				this.clouds.get(i).think(delta);
   367				if (this.clouds.get(i).shouldDelete()) {
   368					this.clouds.remove(i);
   369				}
   370			}
   371		}

    53		@SuppressWarnings({ "unchecked", "deprecation" })
    54		public Class loadClass(String name) throws ClassNotFoundException {
    55			Class c;
    56			try {
    57				c = findLoadedClass(name);
    58	
    59				if (c == null) {
    60					String filename = name.replace('.', File.separatorChar)	+ ".class";
    61					try {
    62						byte data[] = loadClassData(filename);
    63						c = defineClass(data, 0, data.length);
    64					} catch (IOException e) {
    65					} catch (NoClassDefFoundError e) {
    66					}
    67				}
    68	
    69				if (c == null) {
    70					try {
    71						c = findSystemClass(name);
    72					} catch (Exception e) {
    73					}
    74				}
    75	
    76				if (c == null) {
    77					throw new ClassNotFoundException(name);
    78				}
    79	
    80			} catch (Throwable ex) {
    81				throw new ClassNotFoundException(name);
    82			}
    83	
    84			return c;
    85		}
    86	
    87		private byte[] loadClassData(String filename) throws IOException {
    88			File f = new File(this.root, filename);
    89		
    90			int size = (int) f.length();
    91			byte buff[] = new byte[size];
    92			FileInputStream fis = new FileInputStream(f);
    93			DataInputStream dis = new DataInputStream(fis);
    94	
    95			dis.readFully(buff);
    96			dis.close();
    97			
    98			return buff;
    99		}

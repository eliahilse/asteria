   191					this.choosePlayerTwo = 0;
   192				}
   193				this.loadPlayerAI(ApoIcejumpConstants.PLAYER_TWO, this.choosePlayerTwo);
   194			} else if (function.equals(ApoIcejumpMenu.LOAD_PLAYERONE)) {
   195				this.getGame().loadPlayer(ApoIcejumpConstants.PLAYER_ONE, null);
   196			} else if (function.equals(ApoIcejumpMenu.LOAD_PLAYERTWO)) {

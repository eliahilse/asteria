   839		private void thinkSnowflakes(int delta) {
   840			for (int i = this.snowflakes.size() - 1; i >= 0; i--) {
   841				ApoEntity snowflake = this.snowflakes.get(i);
   842				snowflake.setX(snowflake.getX() + snowflake.getVecX() * delta);
   843				snowflake.setY(snowflake.getY() + snowflake.getVecY() * delta);
   844				if (snowflake.getX() + snowflake.getWidth() < 0) {
   845					this.snowflakes.remove(i);
   846				} else if (snowflake.getX() > ApoIcejumpConstants.GAME_WIDTH) {
   847					this.snowflakes.remove(i);
   848				} else if (snowflake.getY() > ApoIcejumpConstants.GAME_HEIGHT - ApoIcejumpConstants.WATER_HEIGHT) {
   849					this.snowflakes.remove(i);
   850				}
   851			}
   852			this.snowFlakesTime -= delta;
   853			if (this.snowFlakesTime <= 0) {
   854				this.snowFlakesTime = ApoHelp.getRandomValue(150, 50);
   855				BufferedImage iSnowflake = null;
   856				if (ApoHelp.getRandomValue(100, 0) > 50) {
   857					iSnowflake = ApoIcejumpImageContainer.iSnowflakeOne;
   858				} else {
   859					iSnowflake = ApoIcejumpImageContainer.iSnowflakeTwo;
   860				}
   861				int x = ApoHelp.getRandomValue(ApoIcejumpConstants.GAME_WIDTH + iSnowflake.getWidth(), -iSnowflake.getWidth());
   862				float vecX = (float)(Math.random() * 0.005);
   863				float vecY = 0.01f + (float)(Math.random() * 0.01);
   864				ApoEntity entity = new ApoEntity(iSnowflake, x, -10, iSnowflake.getWidth(), iSnowflake.getHeight());
   865				entity.setVecX(vecX);
   866				entity.setVecY(vecY);
   867				this.snowflakes.add(entity);
   868			}
   869		}

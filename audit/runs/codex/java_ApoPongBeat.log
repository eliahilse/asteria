    91		@Override
    92		public void think(int delta) {
    93			this.nextBallTime -= delta;
    94			if (this.nextBallTime <= 0) {
    95				this.nextBallTime = 1500 + ApoHelp.getRandomValue(1000, 0);
    96				int random = ApoHelp.getRandomValue(100, 0);
    97				int width = 20;
    98				int y = ApoHelp.getRandomValue(ApoPongBeatConstants.MAX_Y - ApoPongBeatConstants.MIN_Y - width, ApoPongBeatConstants.MIN_Y);
    99				if (random < 10) {
   100					if (y + 3 * width >= ApoPongBeatConstants.MAX_Y) {
   101						y = ApoPongBeatConstants.MAX_Y - 3 * width;
   102					}
   103					float vecX = (float)(ApoPongBeatBallMedium.MY_VEC_X + Math.random() * 0.1f);
   104					this.getGame().getBalls().add(new ApoPongBeatBallMedium(y, width, width, vecX, false, false));
   105					this.getGame().getBalls().add(new ApoPongBeatBallMedium(y + 1 * width, width, width, vecX, false, false));
   106					this.getGame().getBalls().add(new ApoPongBeatBallMedium(y + 2 * width, width, width, vecX, false, false));
   107				} else if (random < 25) {
   108					new ApoPongBeatBallSinusCreate(this.getGame(), 10);
   109				}else if (random < 35) {
   110					float vecX = (float)(ApoPongBeatBallMedium.MY_VEC_X + Math.random() * 0.1f);
   111					boolean bAbove = false;
   112					if (ApoHelp.getRandomValue(100, 0) > 50) {
   113						bAbove = true;
   114					}
   115					int count = 3 - ApoHelp.getRandomValue(3, 0);
   116					this.getGame().getBalls().add(new ApoPongBeatBallRebound(y, width, width, vecX, bAbove, count));
   117				} else if (random < 45) {
   118					this.getGame().getBalls().add(new ApoPongBeatBallMedium(y, width, width, true));
   119				} else if (random < 65) {
   120					boolean bBoth = false;
   121					if (ApoHelp.getRandomValue(100, 0) > 50) {
   122						bBoth = true;
   123					}
   124					this.getGame().getBalls().add(new ApoPongBeatBallBlink(y, width, width, bBoth));
   125				} else if (random < 75) {
   126					boolean bAbove = false;
   127					if (ApoHelp.getRandomValue(100, 0) > 50) {
   128						bAbove = true;
   129					}
   130					this.getGame().getBalls().add(new ApoPongBeatBallGravity(y, width, width, 0, bAbove));
   131				} else {
   132					this.getGame().getBalls().add(new ApoPongBeatBallMedium(y, width, width, false));
   133				}
   134			}
   135			if (this.getGame().getMult() >= ApoPongBeatConstants.PARTICLE_LEVEL) {
   136				this.nextParticleTime -= delta;
   137				if (this.nextParticleTime <= 0) {
   138					int x = ApoHelp.getRandomValue(ApoPongBeatConstants.GAME_WIDTH, 0);
   139					int y = ApoHelp.getRandomValue(ApoPongBeatConstants.MAX_Y - ApoPongBeatConstants.MIN_Y, ApoPongBeatConstants.MIN_Y);
   140					int width = 5;
   141					Color color = new Color(ApoHelp.getRandomValue(255, 0), ApoHelp.getRandomValue(255, 0), ApoHelp.getRandomValue(255, 0), 100);
   142					ApoPongBeatParticle.makeParticle(x, y, width, color, this.getGame(), ApoPongBeatConstants.PARTICLE_TIME, ApoPongBeatConstants.PARTICLE_WIDTH);
   143					this.nextParticleTime = 300 + ApoHelp.getRandomValue(Math.max(500, 2000 - this.getGame().getMult() * 200), 0);
   144				}
   145			}
   146			if (this.getGame().getMult() >= ApoPongBeatConstants.PARTICLE_BACKGROUND_LEVEL) {
   147				this.nextBackgroundTime -= delta;
   148				if (this.nextBackgroundTime <= 0) {
   149					this.nextBackgroundTime = 1000 + ApoHelp.getRandomValue(Math.max(500, 4000 - this.getGame().getMult() * 200), 0);
   150					this.backgroundColor = new Color(ApoHelp.getRandomValue(200, 0), ApoHelp.getRandomValue(200, 0), ApoHelp.getRandomValue(200, 0));
   151				}
   152			}
   153			if (this.getGame().getMult() >= ApoPongBeatConstants.PARTICLE_STRING_LEVEL) {
   154				this.nextBackgroundStringTime -= delta;
   155				if (this.nextBackgroundStringTime <= 0) {
   156					this.nextBackgroundStringTime = 1000 + ApoHelp.getRandomValue(500, 0);
   157					this.nextBackgroundString = ApoPongBeatConstants.BACKGROUND_STRING[ApoHelp.getRandomValue(ApoPongBeatConstants.BACKGROUND_STRING.length, 0)];
   158					Color color = new Color(ApoHelp.getRandomValue(255, 0), ApoHelp.getRandomValue(255, 0), ApoHelp.getRandomValue(255, 0));
   159					int x = ApoHelp.getRandomValue(ApoPongBeatConstants.GAME_WIDTH, 0);
   160					int y = ApoHelp.getRandomValue(ApoPongBeatConstants.MAX_Y - ApoPongBeatConstants.MIN_Y, ApoPongBeatConstants.MIN_Y);
   161					this.getGame().getParticle().add(new ApoPongBeatParticleString(x, y, color, ApoPongBeatConstants.PARTICLE_BACKGROUND_STRING_TIME, this.nextBackgroundString, this.getGame().getMyFont(), false));
   162	
   163				}
   164			}
   165			
   166			this.getGame().thinkBalls(delta);
   167			this.getGame().thinkParticles(delta);
   168		}
   169		
   170		@Override
   171		public void render(Graphics2D g) {
   172			if (this.getGame().getMult() < ApoPongBeatConstants.PARTICLE_BACKGROUND_LEVEL) {
   173				this.getGame().renderBackground(g);
   174			} else {
   175				g.setColor(this.backgroundColor);
   176				g.fillRect(0, 0, ApoPongBeatConstants.GAME_WIDTH, ApoPongBeatConstants.GAME_HEIGHT);
   177			}
   178			
   179			this.getGame().renderParticles(g);
   180			if (this.getGame().getMyFont() != null) {
   181				g.setColor(Color.WHITE);
   182				g.setFont(this.getGame().getMyFont());
   183				this.getGame().renderString(g, "ApoPongBeat", ApoPongBeatConstants.GAME_WIDTH/2, 35);
   184			}
   185			this.getGame().renderStats(g);
   186			
   187			this.getGame().renderBalls(g);
   188			this.getGame().getRacket().render(g, 0, 0);
   189		}
   190	
   191	}

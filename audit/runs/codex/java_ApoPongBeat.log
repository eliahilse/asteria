   454				URLConnection con = url.openConnection();
   455				((HttpURLConnection) con).setRequestMethod("GET");
   456				con.setDoOutput(true);
   457				con.setDoInput(true);
   458				con.setUseCaches(false);
   459		
   460				OutputStream oStream = con.getOutputStream();
   461				oStream.write(parameterAsBytes);

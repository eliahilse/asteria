     3	/**
     4	 * Der EThread ist im Prinzip mit "java.lang.Thread" vergleichbar bzw.
     5	 * eigentlich nichts anderes. Entstanden ist EThread aufgrund diverser
     6	 * Tatsachen "java.lang.Thread" betreffend.
     7	 * 1. "java.lang.Thread" kann nicht erneut gestartet werden. Eine
     8	 *    abgelaufene Instanz von "java.lang.Thread" belegt bei unsauberer
     9	 *    Programmierung immer noch Speicher.
    10	 * 2. Aufgrund von Punkt 1 laesst "java.lang.Thread" auch nicht im Sinne
    11	 *    von pausieren unterbrechen. "interrupt()" von "java.lang.Thread"
    12	 *    ermoeglicht statt dessen einen sauber beendeten "java.lang.Thread",
    13	 *    was eigentlich dessen "stop()"-Methode von vorne herein haette tun
    14	 *    muessen.
    15	 * 3. "java.lang.Thread" kann zwar von unsignierten Applets gestartet
    16	 *    jedoch nicht auf konventionellem Wege ("interrupt()") beendet
    17	 *    werden.
    18	 * 
    19	 * Ein fuer einen EThread konzipiertes Runnable koennte nun folgenden
    20	 * Grundaufbau haben:
    21	 * 001 public void run()
    22	 * 002 {
    23	 * 003   while((EThread) runner).isRunning()) {
    24	 * 004     if(!((EThread) runner).isPaused()) {
    25	 * 005       //...running code goes here
    26	 * 006     } else {
    27	 * 007       //...paused code goes here
    28	 * 008     }
    29	 * 009     try {
    30	 * 010       synchronized(runner) {
    31	 * 011         runner.wait((long) timeout);
    32	 * 012       }
    33	 * 013     } catch(InterruptedException e) {
    34	 * 014       ((EThread) runner).stop();
    35	 * 015     }
    36	 * 016   }
    37	 * 017 }
    38	 * @author 0x0badc0de
    39	 */
    40	
    41	public class ApoSoundThread {
    42		/*
    43		 * Interner Worker-Thread
    44		 */
    45		private Thread worker;
    46	
    47		/*
    48		 * Abzuarbeitendes Runnable
    49		 */
    50		private final Runnable runner;
    51	
    52		/*
    53		 * Status-Flaggen running => Thread wurde gestartet paused => Thread wurde
    54		 * pausiert
    55		 */
    56		private boolean running, paused;
    57	
    58		/**
    59		 * Neue Instanz eines EThreads. Ein Runnable ist unbedingt Vorraussetzung.
    60		 * 
    61		 * @param runner
    62		 */
    63		public ApoSoundThread(Runnable runner) {
    64			if (runner == null) {
    65				throw new NullPointerException("runner = null");
    66			}
    67			paused = true;
    68			this.runner = runner;
    69		}
    70	
    71		/**
    72		 * Startet einen EThread.
    73		 */
    74		public synchronized void start() {
    75			start(false);
    76		}
    77	
    78		/**
    79		 * Startet einen EThread pausiert.
    80		 */
    81		public synchronized void start(boolean sw) {
    82			pause(sw);
    83			if (worker == null) {
    84				running = true;
    85				worker = new Thread(runner) {
    86					/**
    87					 * Thread.run() musste ueberschrieben werden, damit EThread ein
    88					 * Ende des Runnables mitbekommt.
    89					 */
    90					@Override
    91					public void run() {
    92						runner.run();
    93						running = false;
    94						worker = null;
    95					}
    96				};
    97				worker.start();
    98				if (sw) {
    99					try {
   100						synchronized (worker) {
   101							worker.wait();
   102						}
   103					} catch (InterruptedException e) {
   104						running = false;
   105						worker = null;
   106					}
   107				}
   108			}
   109		}
   110	
   111		/**
   112		 * Pausiert einen EThread (sw = true) oder laesst ihn fortfahren (sw =
   113		 * false).
   114		 * 
   115		 * @param sw
   116		 */
   117		public synchronized void pause(boolean sw) {
   118			paused = sw;
   119			if (worker != null) {
   120				if (paused) {
   121					try {
   122						synchronized (worker) {
   123							worker.wait();
   124						}
   125					} catch (InterruptedException e) {
   126						running = false;
   127						worker = null;
   128					}
   129				} else {
   130					synchronized (worker) {
   131						worker.notify();
   132					}
   133				}
   134			}
   135		}
   136	
   137		/**
   138		 * Schaltet den Pause-Modus des EThreads um.
   139		 */
   140		public synchronized void pause() {
   141			pause(!paused);
   142		}
   143	
   144		/**
   145		 * Stopt einen EThread. Die Verwendung des Methodennamens "stop" soll die
   146		 * diesbezuegliche Verwirrung von "java.lang.Thread" beenden. Gestoppte
   147		 * EThreads koennen nicht fortgesetzt werden. Unterbrechen (interrupt)
   148		 * bedeutet "pausieren".
   149		 * 
   150		 * @see pause(boolean sw)
   151		 * @see pause()
   152		 */
   153		public synchronized void stop() {
   154			if (running) {
   155				running = false;
   156			}
   157		}
   158	
   159		/**
   160		 * Gibt zurueck, ob der EThread gestartet wurde und immernoch laeuft. Auch
   161		 * ein pausierter EThread liefet hier "true".
   162		 * 
   163		 * @return running flag
   164		 */
   165		public boolean isRunning() {
   166			return running;
   167		}
   168	
   169		/**
   170		 * Gibt zurueck ob ein EThread unterbrochen wurde. Das ist der Fall, wenn er
   171		 * pausiert oder noch nicht gestartet wurde.
   172		 * 
   173		 * @return paused flag
   174		 */
   175		public boolean isPaused() {
   176			return paused;
   177		}
   178	}

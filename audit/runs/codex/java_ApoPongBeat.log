   299		 * @return gibt den MD5 Hash eines Strings zur�ck
   300		 */
   301		public static String getMd5Digest(String pInput) {
   302			try {
   303				MessageDigest lDigest = MessageDigest.getInstance("MD5");
   304				lDigest.update(pInput.getBytes());
   305				BigInteger lHashInt = new BigInteger(1, lDigest.digest());
   306				return String.format("%1$032X", lHashInt);
   307			} catch(NoSuchAlgorithmException lException) {
   308				throw new RuntimeException(lException);
   309			}
   310		}

   234	                                    ci.setZipMode(zip == 1);
   235	                                    res.setMessageType(MessageTypes.LOGIN_SUCCESS);
   236	                                    res.add(ci.getID());
   237	
   238	                                    ClientProcessor cp = new ClientProcessor(sock, ci);

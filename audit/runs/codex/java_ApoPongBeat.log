     1	package org.apogames.network;
     2	
     3	import java.util.*;
     4	
     5	/**
     6	 * A helper class to wrap an array of bytes into one of DataContainers and vice versa. See DataContainer itself
     7	 * for more info on how DataContainers are working and being transfered.
     8	 */
     9	public class DataContainerFactory {
    10	
    11	    /**
    12	     * Creates an array for DataContainers from a byte array. Usually, the byte array is what has been transfered
    13	     * from client to server or vice versa.
    14	     * @param bytes the byte array
    15	     * @param zip if true, the data in the array is assumed to be zipped
    16	     * @return DataContainer[] the resulting DataContainers
    17	     */
    18	    public static DataContainer[] extractContainers(byte[] bytes, boolean zip) {
    19	        if (bytes.length > 0) {
    20	            List<DataContainer> conts = new ArrayList<DataContainer>();
    21	            try {
    22	                for (int i = 0; i < bytes.length; ) {
    23	                    int len = ((bytes[i] & 0xff) << 8) + (bytes[i + 1] & 0xff);
    24	                    byte[] snip = new byte[len];
    25	                    System.arraycopy(bytes, i, snip, 0, len);
    26	                    i += len;
    27	                    DataContainer dc = new DataContainer(snip, zip);
    28	                    conts.add(dc);
    29	                }
    30	            } catch (Exception e) {
    31	                throw new RuntimeException(e);
    32	            }
    33	            DataContainer[] dcs = new DataContainer[conts.size()];
    34	            for (int i = 0; i < conts.size(); i++) {
    35	                dcs[i] = (DataContainer) conts.get(i);
    36	            }
    37	            return dcs;
    38	        } else {
    39	            NetLogger.log("Invalid datagram size: " + bytes.length);
    40	            return new DataContainer[0];
    41	        }
    42	    }
    43	
    44	    /**
    45	     * Create a byte array out of an array of DataContainers.
    46	     * @param dcs the containers
    47	     * @param zip boolean should the byte array be zipped?
    48	     * @return byte[] the resulting byte array.
    49	     */
    50	    public static byte[] toByteArray(DataContainer[] dcs, boolean zip) {
    51	        int size = 0;
    52	        byte[][] cs = new byte[dcs.length][];
    53	        for (int i = 0; i < dcs.length; i++) {
    54	            byte[] ba = dcs[i].toByteArray(zip);
    55	            cs[i] = ba;
    56	            size += ba.length;
    57	        }
    58	        size += 2;
    59	
    60	        //System.out.println(size);
    61	        
    62	        if (size > 32767) {
    63	            throw new RuntimeException("Datagram size must not exceed 32K but is "+size+" bytes!");
    64	        }
    65	
    66	        byte[] res = new byte[size];
    67	        int off = 2;
    68	        for (int i = 0; i < dcs.length; i++) {
    69	            System.arraycopy(cs[i], 0, res, off, cs[i].length);
    70	            off += cs[i].length;
    71	        }
    72	        res[0] = (byte) (size >> 8);
    73	        res[1] = (byte) (size & 0xff);
    74	        return res;
    75	    }
    76	}

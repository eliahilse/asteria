   428	    /**
   429	     * Zips the data in the array and returns a zipped version.
   430	     * @param data byte[]
   431	     * @return byte[]
   432	     */
   433	    private byte[] zip(byte[] data) {
   434	        ByteArrayOutputStream bos = new ByteArrayOutputStream(data.length);
   435	        bos.write(data, 0, 4);
   436	        try {
   437	            GZIPOutputStream zos = new GZIPOutputStream(bos);
   438	            zos.write(data, 4, data.length - 4);
   439	            zos.close();
   440	        } catch (Exception e) {
   441	            throw new RuntimeException(e);
   442	        }
   443	        return bos.toByteArray();
   444	    }
   445	
   446	    /**
   447	     * Unzip the data in an array
   448	     * @param data byte[]
   449	     * @param len int
   450	     * @return byte[]
   451	     */
   452	    private byte[] unzip(byte[] data, int len) {
   453	        ByteArrayInputStream bis = new ByteArrayInputStream(data, 4, len - 4);
   454	        ByteArrayOutputStream bos = new ByteArrayOutputStream(data.length<<1);
   455	        bos.write(data, 0, 4);
   456	        try {
   457	            GZIPInputStream zis = new GZIPInputStream(bis);
   458	            byte[] buffer = new byte[len];
   459	            int cnt = 0;
   460	            do {
   461	                cnt = zis.read(buffer);
   462	                if (cnt != -1) {
   463	                    bos.write(buffer, 0, cnt);
   464	                }
   465	            } while (cnt >= 0);
   466	            zis.close();
   467	        } catch (Exception e) {
   468	            throw new RuntimeException(e);
   469	        }
   470	        return bos.toByteArray();
   471	    }

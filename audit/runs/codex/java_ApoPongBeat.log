   369		/**
   370		 * draws a string
   371		 * @param g
   372		 * @param s
   373		 * @param x
   374		 * @param y
   375		 * @param width
   376		 */
   377		public static void drawSpeech(Graphics2D g, String s, int x, int y, int width) {
   378			int curHeight = 0;
   379			int[] maxLength = new int[] {width - 4, width - 4, width - 4, width - 4};
   380			ArrayList<String> strings = new ArrayList<String>();
   381			strings.add(s);
   382			int cur = 0;
   383			int w = g.getFontMetrics().stringWidth(strings.get(cur));
   384			if (w > maxLength[curHeight]) {
   385				int curPos = strings.get(cur).indexOf(" ");
   386				while ((curPos > -1) && (g.getFontMetrics().stringWidth(strings.get(cur).substring(0, curPos)) < maxLength[curHeight])) {
   387					int nextPos = strings.get(cur).indexOf(" ", curPos + 1);
   388					if (nextPos != -1) {
   389						if (g.getFontMetrics().stringWidth(strings.get(cur).substring(0, nextPos)) >= maxLength[curHeight]) {
   390							String curString = strings.get(cur);
   391							strings.set(cur, curString.substring(0, curPos));
   392							cur++;
   393							if (curHeight == 0) {
   394								curHeight++;
   395							}
   396							strings.add(curString.substring(curPos + 1));
   397							curPos = strings.get(cur).indexOf(" ");
   398						} else {
   399							curPos = nextPos;
   400						}
   401					} else {
   402						String curString = strings.get(cur);
   403						if (g.getFontMetrics().stringWidth( curString ) > maxLength[curHeight]) {
   404							strings.set( cur, curString.substring(0, curPos) );
   405							cur++;
   406							strings.add( curString.substring(curPos + 1));
   407						}
   408						break;
   409					}
   410				}
   411			}
   412			int h = g.getFontMetrics().getHeight();
   413			for ( int i = 0; i < strings.size(); i++ ) {
   414				g.drawString(strings.get(i), x, y);
   415				y += h;
   416			}
   417		}

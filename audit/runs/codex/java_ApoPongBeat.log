    48			this.nextParticleTime = 1000 + ApoHelp.getRandomValue(500, 0);
    49			this.nextBackgroundTime = 1000 + ApoHelp.getRandomValue(2500, 0);
    50			this.backgroundColor = Color.BLACK;
    51			this.nextBackgroundStringTime = 1000 + ApoHelp.getRandomValue(500, 0);

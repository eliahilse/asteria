   399	                        }
   400	                        case (TYPE_FLOAT): {
   401	                            types.add(I_TYPE_FLOAT);
   402	                            float fl = Float.intBitsToFloat(((bytes[i + 1] & 0xFF) << 24) + ((bytes[i + 2] & 0xFF) << 16) + ((bytes[i + 3] & 0xFF) << 8) + (bytes[i + 4] & 0xFF));
   403	                            objs.add(Float.valueOf(fl));
   404	                            i += 5;
   405	                            break;
   406	                        }
   407	                        case (TYPE_STRING): {
   408	                            types.add(I_TYPE_STRING);
   409	                            int leny = (bytes[i + 1] << 8) + bytes[i + 2];
   410	                            objs.add(new String(bytes, i + 3, leny, "UTF-8"));
   411	                            i += 3 + leny;
   412	                            break;
   413	                        }

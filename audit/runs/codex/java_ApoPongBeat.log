     5	/**
     6	 * Helper class to read bytes from an InputStream without reading the whole stream and without blocking if the stream has
     7	 * ended before all data could be read. The first two bytes in each part that should be read define the size in hi-byte/low-byte
     8	 * format. The converter will try to read the number of bytes indicated by this value from the stream and returns with the result.
     9	 */
    10	public class StreamConverter {
    11	
    12	        /**
    13	         * Reads data from an InputStream
    14	         * @param is The stream to read from
    15	         * @return byte[] the data from the stream. This is the real payload, i.e. it doesn't include the size information
    16	         */
    17	        public static byte[] convert(InputStream is) {
    18	        byte[] buffer = new byte[500];
    19	        int cnt = 0;
    20	        ByteArrayOutputStream bos = null;
    21	        int pos = 0;
    22	        int len = -1;
    23	        boolean lenOK = false;
    24	        try {
    25	            int off = 0;
    26	            do {
    27	                cnt = is.read(buffer);
    28	                if (cnt > -1) {
    29	                    if (cnt > 0) {
    30	                        off = 0;
    31	                        if (!lenOK || pos < 2) {
    32	                            // Die tats�chliche L�nge ermitteln...
    33	                            if (cnt > 1 && pos == 0) {
    34	                                len = ((buffer[0] & 0xff) << 8) + (buffer[1] & 0xff);
    35	                                lenOK = true;
    36	                                off = 2;
    37	                            } else {
    38	                                off = 1;
    39	                                if (pos == 0) {
    40	                                    len = (buffer[0] & 0xff) << 8;
    41	                                } else {
    42	                                    len += buffer[0] & 0xff;
    43	                                    lenOK = true;
    44	                                }
    45	                            }
    46	                        }
    47	                    }
    48	                    
    49	                    if (lenOK && bos==null) {
    50	                    	bos=new ByteArrayOutputStream(len+10);
    51	                    }
    52	                    
    53	                    if (pos + cnt <= len || !lenOK) {
    54	                        bos.write(buffer, off, cnt - off);
    55	                        pos += cnt;
    56	                    } else {
    57	                        bos.write(buffer, off, len - pos - off);
    58	                        pos += len - pos;
    59	                    }
    60	                }
    61	            } while (cnt > -1 && pos < len);
    62	        } catch (Exception e) {
    63	            throw new RuntimeException(e);
    64	        }
    65	        if (bos==null) {
    66	        	return new byte[0];
    67	        }
    68	        return bos.toByteArray();
    69	    }
    70	}


   125		public BufferedImage getButtonWithImage(int width, int height, BufferedImage iPic, String text, Color textColor, Color mousePressed, Color mouseReleased, Font font) {
   126			BufferedImage iButton = GraphicsEnvironment.getLocalGraphicsEnvironment().getDefaultScreenDevice().getDefaultConfiguration().createCompatibleImage(width,height,BufferedImage.TYPE_INT_ARGB_PRE);
   127			Graphics2D g = (Graphics2D)iButton.getGraphics();
   128			
   129			g.setRenderingHint(RenderingHints.KEY_ANTIALIASING, RenderingHints.VALUE_ANTIALIAS_ON);
   130			
   131			int oneWidth = width/3;
   132			int widthPic = 0;
   133			if (iPic != null) {
   134				widthPic = iPic.getWidth();
   135			}
   136			g.setFont(font);
   137			int fontHeight = g.getFontMetrics().getHeight();
   138			
   139			for ( int i = 0; i < 3; i++ ) {
   140				if (iPic != null) {
   141					g.drawImage(iPic, oneWidth * i + oneWidth/2 - widthPic/2, height/2 - iPic.getHeight()/2, null);
   142				}
   143				
   144				int w = g.getFontMetrics().stringWidth(text);
   145				if (i > 0) {
   146					if (i == 1) {
   147						g.setColor(mousePressed);
   148					} else {
   149						g.setColor(mouseReleased);
   150					}
   151					g.fillRoundRect(oneWidth * i + oneWidth/2 - w/2 - 2, height/2 - fontHeight/2, w + 4, fontHeight - 10, 10, 10);
   152				}
   153				g.setColor(textColor);
   154				g.drawString(text, i * oneWidth + oneWidth/2 - w/2, height/2 + 5);
   155			}
   156			
   157			g.dispose();
   158			return iButton;
   159		}

     5	
     6	/**
     7	 * Simple server browser that listens on a specified UDP port for servers broadcasting their connection data on that port.
     8	 */
     9	public class ServerBrowser {
    10	
    11	    private int port=0;
    12	    private boolean exit=false;
    13	    private boolean running=false;
    14	    private List<ServerEntry> servers=new ArrayList<ServerEntry>();
    15	    private List<DataChangeListener> dataChangeListener=new ArrayList<DataChangeListener>();
    16	
    17	    /**
    18	     * Creates a new ServerBrowser that will listen on a speficied UDP-port for servers to broadcast their data. This prepares the browser, it doesn't start it.
    19	     * @param port the UDP port to use
    20	     */
    21	    public ServerBrowser(int port) {
    22	        this.port=port;
    23	    }
    24	
    25	    /**
    26	     * Adds a new DataChangesListener to the browser. The listener will be notified if the server list changes, i.e.
    27	     * if servers get removed or added.
    28	     * @param listener the listener
    29	     */
    30	    public void addListener(DataChangeListener listener) {
    31	        dataChangeListener.add(listener);
    32	    }
    33	
    34	    /**
    35	     * Starts the browser.
    36	     */
    37	    public void startBrowser() {
    38	        new Thread(new BrowserThread()).start();
    39	    }
    40	
    41	    /**
    42	     * Stops the browser.
    43	     */
    44	    public void stopBrowser() {
    45	        exit=true;
    46	    }
    47	
    48	    /**
    49	     * Returns the current list of servers that this browser has found.
    50	     * @return List the server list
    51	     */
    52	    public List<ServerEntry> getServerList() {
    53	        synchronized(servers) {
    54	            return new ArrayList<ServerEntry>(servers);
    55	        }
    56	    }
    57	
    58	    /**
    59	     * Notify the listeners...
    60	     */
    61	    private void fireEvent() {
    62	        for (Iterator<DataChangeListener> itty = dataChangeListener.iterator(); itty.hasNext(); ) {
    63	            DataChangeListener dcl = itty.next();
    64	            dcl.dataChanged(getServerList());
    65	        }
    66	    }
    67	
    68	    /**
    69	     * The thread that listens on the port for servers to send their data.
    70	     */
    71	    private class BrowserThread implements Runnable {
    72	
    73	        public void run() {
    74	            try {
    75	            	running=true;
    76	            	DatagramSocket bsock=new DatagramSocket(port);
    77	                bsock.setSoTimeout(3000);
    78	                byte[] buffer = new byte[1000];
    79	                DatagramPacket dpr = new DatagramPacket(buffer, buffer.length);
    80	                while(!exit) {
    81	                    boolean ok=false;
    82	                    try {
    83	                        bsock.receive(dpr);
    84	                        ok=true;
    85	                    }catch(SocketTimeoutException e) {
    86	                    }
    87	
    88	                    if (ok) {
    89	                        byte[] data = new byte[dpr.getLength()-2];
    90	                        System.arraycopy(dpr.getData(), 2, data, 0, data.length);
    91	                        DataContainer dc = new DataContainer(data, false);
    92	                        ServerEntry se = new ServerEntry(dc.getNextString(), dpr.getAddress(), dc.getNextInt(), dc.getNextInt());
    93	                        boolean found = false;
    94	                        synchronized (servers) {
    95	                            for (Iterator<ServerEntry> itty = servers.iterator(); itty.hasNext(); ) {
    96	                                ServerEntry st = itty.next();
    97	                                if (st.equals(se)) {
    98	                                    st.setClientCount(se.getClientCount());
    99	                                    st.touch();
   100	                                    if (se.getClientCount()==-9999) {
   101	                                    	// -9999 flags that the server is going down.
   102	                                    	itty.remove();
   103	                                    	st.setClientCount(0);
   104	                                    	NetLogger.log("ServerBrowser: Server " + st.getName() + " removed by server's request!");
   105	                                    }
   106	                                    found = true;
   107	                                }
   108	                            }
   109	
   110	                            if (!found && se.getClientCount()!=-9999) {
   111	                            	// Don't add it again, if it was a removal request
   112	                            	NetLogger.log("ServerBrowser: Server " + se.getName() + " added!");
   113	                                servers.add(se);
   114	                            }
   115	                        }
   116	                    }
   117	                    synchronized (servers) {
   118	                        for (Iterator<ServerEntry> itty = servers.iterator(); itty.hasNext(); ) {
   119	                            ServerEntry st = itty.next();
   120	                            if (st.isOld()) {
   121	                                NetLogger.log("ServerBrowser: Server " + st.getName() + " removed!");
   122	                                itty.remove();
   123	                            }
   124	                        }
   125	                        fireEvent();
   126	                    }
   127	                }
   128	            } catch(Exception e) {
   129	                NetLogger.log("Can't start server browser due to: ");
   130	                e.printStackTrace();
   131	            }
   132	            running=false;
   133	        }
   134	    }
   135	    
   136	    public boolean isRunning() {
   137	    	return running;
   138	    }
   139	    
   140	}

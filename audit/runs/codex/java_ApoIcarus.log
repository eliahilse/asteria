   168		private int getThisPosition(int x, int y) {
   169			if (this.myGraphics != null) {
   170				this.myGraphics.setFont(this.myFont);
   171				String s = this.curString;
   172				int w = this.myGraphics.getFontMetrics().stringWidth(s);
   173				if (x > w + 5 + this.getX()) {
   174					return s.length();
   175				} else if (x < this.getX() + 5) {
   176					return 0;
   177				} else {
   178					for (int i = 0; i < this.curString.length(); i++) {
   179						String old = this.curString.substring(0, i);
   180						String next = this.curString.substring(0, i + 1);
   181						int wOld = this.myGraphics.getFontMetrics().stringWidth(old);
   182						int wNext = this.myGraphics.getFontMetrics().stringWidth(next);
   183						if ((x > wOld + 5 + this.getX()) && (x < wNext + 5 + this.getX())) {
   184							return i;
   185						}
   186					}
   187				}
   188			}
   189			return -1;
   190		}

   179					}
   180				}
   181			} else {
   182				this.timeBonus -= delta;
   183				if (this.timeBonus <= 0) {
   184					this.bMissle = false;
   185					this.bHelicopter = false;
   186					super.setIBackground(ApoJumpImageContainer.iPlayer);
   187					super.makeImageArray();
   188				}
   189			}
   190			
   191			this.setX(this.getX() + this.getVelocityX() * delta);
   192			this.setY(this.getY() + this.getVelocityY() * delta);
   193		}

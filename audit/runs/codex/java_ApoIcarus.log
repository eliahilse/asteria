    86		public Point getPosition(int points) {
    87			Point p = new Point(-1, -1);
    88			if (this.help != null) {
    89				for (int i = 0; i < this.help.size(); i++) {
    90					if (points > this.help.get(i).getPoints()) {
    91						p.x = i + 1;
    92						p.y = this.help.size() + 1;
    93						return p;
    94					}
    95				}
    96				p.x = this.help.size() + 1;
    97				p.y = this.help.size() + 1;
    98			}
    99			return p;
   100		}

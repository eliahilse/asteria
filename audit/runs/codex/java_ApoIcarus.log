   472		/**
   473		 * �berpr�ft ob der �bergebene rgb Wert durchsichtig ist oder nicht
   474		 * @param rgb = zu �berpr�fender RGB Wert
   475		 * @return TRUE falls durchsichtig sonst FALSE
   476		 */
   477		private boolean isOpaque(int rgb) {
   478	
   479			int alpha = (rgb >> 24) & 0xff;
   480			// red = (rgb >> 16) & 0xff;
   481			// green = (rgb >> 8) & 0xff;
   482			// blue = (rgb ) & 0xff;
   483	
   484			if (alpha == 0) {
   485				return false;
   486			}
   487	
   488			return true;
   489		}

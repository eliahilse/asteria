    23	
    24		/**
    25		 * Konstruktor
    26		 */
    27		public ApoKeyboard() {
    28			this.keys = new TreeMap<Integer, Boolean>();
    29			this.releasedKeys = new ArrayList<Integer>();
    30			this.releasedCharKeys = new ArrayList<Integer>();
    31			this.pressedKeys = new ArrayList<Integer>();

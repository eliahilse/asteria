    12	 */
    13	public final class ApoKeyboard implements KeyListener {
    14	
    15		/** TreeMap mit den Tasten, welches gerade gedr�ckt werden */
    16		private TreeMap<Integer, Boolean> keys;
    17		/** ArrayList mit den Tasten, welche gerade losgelassen wurden */
    18		private ArrayList<Integer> releasedKeys;
    19		/** ArrayList mit den Tasten, welche gerade losgelassen wurden */

    81		@Override
    82		public void run() {
    83			long unprocessedTimeThink = 0;
    84			long unprocessedTimeRender = 0;
    85			long msPerTickThink = (long)(1000.0 / (double)(ApoConstants.FPS_THINK));
    86			long msPerTickRender = (long)(1000.0 / (double)(ApoConstants.FPS_RENDER));
    87			this.frames = 0;
    88			long lastFpsTime = System.currentTimeMillis() - 1000;
    89			this.last = System.currentTimeMillis();
    90			this.isRunning = true;
    91	
    92			// eigentliche Spiellogikschleife
    93			while (this.isRunning) {
    94				long now = System.currentTimeMillis();
    95				long passedTime = now - this.last;
    96				// falls Zeit vergangen ist seit dem letzten Aufruf
    97				if (passedTime > 0) {
    98					unprocessedTimeThink += passedTime;
    99					unprocessedTimeRender += passedTime;
   100					// wenn nachgedacht werden soll dann denke nach
   101					while (unprocessedTimeThink >= msPerTickThink) {
   102						if (unprocessedTimeThink > 10 * msPerTickThink) {
   103							unprocessedTimeThink = 0;
   104						} else {
   105							unprocessedTimeThink -= msPerTickThink;
   106						}
   107						if (!this.bShouldThink) {
   108							unprocessedTimeThink = 0;
   109						} else {
   110							this.think(msPerTickThink);
   111						}
   112					}
   113					// wenn gezeichnet werden soll, dann zeichne neu
   114					if (unprocessedTimeRender >= msPerTickRender) {
   115						unprocessedTimeRender -= msPerTickRender;
   116						if (this.bShouldRepaint) {
   117							this.render();
   118						}
   119					}
   120					this.last = now;
   121				}
   122				// falls eine Sekunde vergangen ist, dann aktualisiere die FPSanzahl
   123				if (System.currentTimeMillis() - lastFpsTime > 1000) {
   124					if (!this.bShouldRepaint) {
   125						this.render();
   126					}
   127					lastFpsTime += 1000;
   128					this.screen.setFps(this.frames);
   129					this.frames = 0;
   130				}
   131	
   132				// leg den Thread f�r 10 Millisekunden schlafen
   133				try {
   134					Thread.sleep(10);
   135				} catch (InterruptedException e) {
   136				}
   137			}
   138		}

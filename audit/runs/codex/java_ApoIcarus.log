    59		public void setWin() {
    60			this.textField.setBVisible(true);
    61			this.textField.setBSelect(true);
    62			this.textField.setSelect();
    63			this.pressedWinTime = 1000;
    64			this.getGame().getButtons()[9].setBVisible(true);
    65			this.getGame().getButtons()[10].setBVisible(false);
    66			this.bUpload = false;
    67			if (this.getGame().getKeyboard().isPressed(KeyEvent.VK_A)) {
    68				this.pressedKeys.add(KeyEvent.VK_A);
    69			} else if (this.getGame().getKeyboard().isPressed(KeyEvent.VK_D)) {
    70				this.pressedKeys.add(KeyEvent.VK_D);
    71			}
    72		}
    73	
    74		@Override
    75		public void keyButtonReleased(int button, char character) {
    76			if (this.getGame().getLevel() != null) {
    77				if (this.getGame().isBWin()) { 
    78					if ((this.textField != null) && (this.textField.isBVisible()) && (this.textField.isBSelect())) {
    79						boolean bShift = false;
    80						if (this.getGame().getKeyboard().isPressed(KeyEvent.VK_CONTROL)) {
    81							if (button == KeyEvent.VK_V) {
    82								String s = ApoHelp.getClipboardContents();
    83								if (s != null) {
    84									for (int i = 0; i < s.length(); i++) {
    85										char chara = s.charAt(i);
    86										this.textField.addCharacter(button, chara);
    87									}
    88									bShift = true;
    89								}
    90							} else if (button == KeyEvent.VK_C) {
    91								String s = this.textField.getSelectedString();
    92								if (s != null) {
    93									ApoHelp.setClipboardContents(s);
    94								}
    95								bShift = true;
    96							} else if (button == KeyEvent.VK_X) {
    97								String s = this.textField.getSelectedString();
    98								if (s != null) {
    99									ApoHelp.setClipboardContents(s);
   100									this.textField.deleteSelectedString();
   101								}
   102								bShift = true;
   103							}
   104						} else if (this.getGame().getKeyboard().isPressed(KeyEvent.VK_SHIFT)) {
   105							if (button == KeyEvent.VK_LEFT) {
   106								this.textField.nextSelectedPosition(this.textField.getPosition() - 1);
   107								bShift = true;
   108							} else if (button == KeyEvent.VK_RIGHT) {
   109								this.textField.nextSelectedPosition(this.textField.getPosition() + 1);
   110								bShift = true;
   111							}
   112						}
   113						if (!bShift) {
   114							if (this.pressedKeys.indexOf(button) != -1) {
   115							} else {
   116								this.textField.addCharacter(button, character);
   117							}
   118						}
   119					}
   120				
   121					if (button == KeyEvent.VK_ENTER) {
   122						if ((this.textField != null) && (this.textField.isBVisible()) && (this.textField.isBSelect())) {
   123							this.textField.setBSelect(false);
   124						} else {
   125							this.uploadScore();
   126							this.restart();
   127						}
   128					} else if (button == KeyEvent.VK_ESCAPE) {
   129						this.uploadScore();
   130						this.getGame().setMenu();
   131					}
   132				} else {
   133					if ((button == KeyEvent.VK_LEFT) || (button == KeyEvent.VK_A)) {
   134						this.getGame().getLevel().getPlayer().setVecX(0);	
   135					} else if ((button == KeyEvent.VK_RIGHT) || (button == KeyEvent.VK_D)) {
   136						this.getGame().getLevel().getPlayer().setVecX(0);	
   137					} else if (button == KeyEvent.VK_ESCAPE) {
   138						this.getGame().getLevel().setWin();
   139					}
   140				}
   141			}
   142		}

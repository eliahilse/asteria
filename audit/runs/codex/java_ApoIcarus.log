    39		public void init() {
    40			this.getGame().setShouldRepaint(true);
    41			
    42			if (this.pressedKeys == null) {
    43				this.pressedKeys = new ArrayList<Integer>();
    44			}
    45			this.pressedKeys.clear();
    46			if (this.textField == null) {
    47				int width = 200;
    48				int height = 50;
    49				int x = ApoJumpConstants.GAME_WIDTH/2;
    50				int y = ApoJumpConstants.GAME_HEIGHT/2 + 50;
    51				this.textField = new ApoNewTextfield(x - 40, y, width, height, ApoJumpConstants.FONT_TEXTFIELD);
    52				this.textField.setMaxLength(11);

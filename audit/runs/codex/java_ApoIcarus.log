    73		
    74		private void load(boolean bFirst) {
    75			try {
    76				this.highscore = ApoHighscore.getInstance();
    77				if (this.highscore.load()) {
    78					this.sortList(bFirst);
    79				}
    80			} catch (Exception ex) {
    81				this.help.clear();
    82				this.highscore = null;
    83			}
    84		}

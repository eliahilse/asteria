   159		@Override
   160		public void keyButtonReleased(int button, char character) {
   161			if (button == KeyEvent.VK_ESCAPE) {
   162				this.getGame().setMenu();
   163			} else if (button == KeyEvent.VK_LEFT) {
   164				this.nextHighscore(-1);
   165			} else if (button == KeyEvent.VK_RIGHT) {
   166				this.nextHighscore(+1);
   167			}
   168		}

     2	
     3	/**
     4	 * A simple implementation of the Scale3x algorithm for scaling raw image data.
     5	 * 
     6	 * @author Kevin Glass
     7	 */
     8	public class ApoRawScale3x {
     9		/** The src image data */
    10		private int[] srcImage;
    11		/** The dest image data */
    12		private int[] dstImage;
    13		/** The width of the source image */
    14		private int width;
    15		/** The height of the source image */
    16		private int height;
    17	
    18		/**
    19		 * Create a new scaler based on some raw data. Right now it doesn't matter
    20		 * what order the channels in, just that its an int per pixel
    21		 * @param imageData : The source image data
    22		 * @param dataWidth : The width of the source image
    23		 * @param dataHeight : The height of the source image
    24		 */
    25		public ApoRawScale3x(int[] imageData, int dataWidth, int dataHeight) {
    26			this.width = dataWidth;
    27			this.height = dataHeight;
    28			this.srcImage = imageData;
    29			this.dstImage = new int[imageData.length * 9];
    30		}
    31	
    32		/**
    33		 * Check if two pixels are different. Place holder for maybe some clever
    34		 * code about tolerance checking
    35		 * @param a : The first pixel value
    36		 * @param b : The second pixel value
    37		 * @return True if the pixels are different
    38		 */
    39		private boolean different(int a, int b) {
    40			return a != b;
    41		}
    42	
    43		/**
    44		 * Set a pixel in the destination image data
    45		 * @param x : The x location of the pixel to set
    46		 * @param y : The y location of the pixel to set
    47		 * @param p : The value of the pixel to set
    48		 */
    49		private void setDestPixel(int x, int y, int p) {
    50			this.dstImage[x + (y * this.width * 3)] = p;
    51		}
    52	
    53		/**
    54		 * Get a pixel from the source image. This handles bonds checks and resolves
    55		 * to edge pixels
    56		 * @param x : The x location of the pixel to retrieve
    57		 * @param y : The y location of the pixel to retrieve
    58		 * @return The pixel value at the specified location
    59		 */
    60		private int getSourcePixel(int x, int y) {
    61			x = Math.max(0, x);
    62			x = Math.min(this.width - 1, x);
    63			y = Math.max(0, y);
    64			y = Math.min(this.height - 1, y);
    65	
    66			return this.srcImage[x + (y * this.width)];
    67		}
    68	
    69		/**
    70		 * Process a specific pixel. This will generate 4 pixels in the destination
    71		 * image based on the scale2x algorithm
    72		 * @param x : The x location in the source image of the pixel to process
    73		 * @param y : The y location in the source image of the pixel to process
    74		 */
    75		private void process(int x, int y) {
    76			int A = this.getSourcePixel(x - 1, y - 1);
    77			int B = this.getSourcePixel(x, y - 1);
    78			int C = this.getSourcePixel(x + 1, y - 1);
    79			int D = this.getSourcePixel(x - 1, y);
    80			int E = this.getSourcePixel(x, y);
    81			int F = this.getSourcePixel(x + 1, y);
    82			int G = this.getSourcePixel(x - 1, y + 1);
    83			int H = this.getSourcePixel(x, y + 1);
    84			int I = this.getSourcePixel(x + 1, y + 1);
    85			int E0 = E;
    86			int E1 = E;
    87			int E2 = E;
    88			int E3 = E;
    89			int E4 = E;
    90			int E5 = E;
    91			int E6 = E;
    92			int E7 = E;
    93			int E8 = E;
    94	
    95			if (this.different(B, H) && this.different(D, F)) {
    96				E0 = !this.different(D, B) ? D : E;
    97				E1 = ((!this.different(D, B)) && this.different(E, C))
    98						|| ((!this.different(B, F)) && this.different(E, A)) ? B : E;
    99				E2 = !this.different(B, F) ? F : E;
   100				E3 = ((!this.different(D, B)) && this.different(E, G))
   101						|| ((!this.different(D, H)) && this.different(E, A)) ? D : E;
   102				E4 = E;
   103				E5 = ((!this.different(B, F)) && this.different(E, I))
   104						|| ((!this.different(H, F)) && this.different(E, C)) ? F : E;
   105				E6 = !this.different(D, H) ? D : E;
   106				E7 = ((!this.different(D, H)) && this.different(E, I))
   107						|| ((!this.different(H, F)) && this.different(E, G)) ? H : E;
   108				E8 = !this.different(H, F) ? F : E;
   109			}
   110	
   111			this.setDestPixel((x * 3), (y * 3), E0);
   112			this.setDestPixel((x * 3) + 1, (y * 3), E1);
   113			this.setDestPixel((x * 3) + 2, (y * 3), E2);
   114			this.setDestPixel((x * 3), (y * 3) + 1, E3);
   115			this.setDestPixel((x * 3) + 1, (y * 3) + 1, E4);
   116			this.setDestPixel((x * 3) + 2, (y * 3) + 1, E5);
   117			this.setDestPixel((x * 3), (y * 3) + 2, E6);
   118			this.setDestPixel((x * 3) + 1, (y * 3) + 2, E7);
   119			this.setDestPixel((x * 3) + 2, (y * 3) + 2, E8);
   120		}
   121	
   122		/**
   123		 * Get the scale image data. Note this is the method that does the work so
   124		 * it might take some time to process.
   125		 * @return An array of pixels 9 times the size of the input array containing
   126		 *         the smoothly scaled image
   127		 */
   128		public int[] getScaledData() {
   129			for (int x = 0; x < this.width; x++) {
   130				for (int y = 0; y < this.height; y++) {
   131					process(x, y);
   132				}
   133			}
   134			return this.dstImage;
   135		}
   136	}

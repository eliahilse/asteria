   320		/**
   321		 * �berpr�ft, ob die �bergebenen Werte (die ein Rechteck ergeben) die Entity
   322		 * schneiden
   323		 * 
   324		 * @param x: X-Wert (links oben vom Rechteck)
   325		 * @param y: Y-Wert (links oben vom Rechteck)
   326		 * @param width: Breiten-Wert (wie breit ist das Rechteck)
   327		 * @param height: H�hen-Wert (wie hoch ist das Rechteck)
   328		 * @return TRUE, falls drin, sonst FALSE
   329		 */
   330		public boolean intersects(float x, float y, float width, float height) {
   331			if (this.getRec().intersects(x, y, width, height)) {
   332				if (this.isBOpaque()) {
   333					if (this.getIBackground() != null) {
   334						Rectangle2D.Float myRec = (Rectangle2D.Float)this.getRec();
   335						Rectangle2D.Float cut = (Rectangle2D.Float)myRec.createIntersection(new Rectangle2D.Float(x, y, width, height));
   336						for (int i = (int)cut.y; i < (int)(cut.y + cut.height); i++) {
   337							for (int j = (int)cut.x; j < (int)(cut.x + cut.width); j++) {
   338								if ((i - this.getY() < this.getHeight()) &&
   339									(j - this.getX() < this.getWidth())) {
   340									if (!this.isOpaque(this.getIBackground().getRGB((int)(j - myRec.x), (int)(i - myRec.y)))) {
   341										return true;
   342									}
   343								}
   344							}
   345						}
   346						return false;
   347					} else {
   348						return true;
   349					}
   350				} else {
   351					return true;
   352				}
   353			}
   354			return false;
   355		}
   356	
   357		/**
   358		 * �berpr�ft, ob die �bergebene Entity die Entity schneidet
   359		 * 

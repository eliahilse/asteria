   170		@Override
   171		public void mouseButtonFunction(String function) {
   172			if (function.equals(ApoJumpStateHighscore.BUTTON_BACK)) {
   173				this.getGame().setMenu();
   174			}else if (function.equals(ApoJumpStateHighscore.LEFT)) {
   175				this.nextHighscore(-1);
   176			} else if (function.equals(ApoJumpStateHighscore.RIGHT)) {
   177				this.nextHighscore(+1);
   178			}
   179		}

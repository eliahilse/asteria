   106		private void sortList(boolean bFirst) {
   107			this.curPos = 0;
   108			this.help = new ArrayList<ApoJumpStateHighscoreHelp>();
   109			if (this.highscore.getPoints().size() > 0) {
   110				this.help.add(new ApoJumpStateHighscoreHelp(this.highscore.getPoints().get(0), this.highscore.getTime().get(0), this.highscore.getNames().get(0)));
   111				for (int i = 1; i < this.highscore.getPoints().size(); i++) {
   112					boolean bBreak = false;
   113					for (int j = 0; j < this.help.size(); j++) {
   114						if (this.help.get(j).getPoints() < this.highscore.getPoints().get(i)) {
   115							this.help.add(j, new ApoJumpStateHighscoreHelp(this.highscore.getPoints().get(i), this.highscore.getTime().get(i), this.highscore.getNames().get(i)));
   116							bBreak = true;
   117							break;
   118						}
   119					}
   120					if (!bBreak) {
   121						this.help.add(new ApoJumpStateHighscoreHelp(this.highscore.getPoints().get(i), this.highscore.getTime().get(i), this.highscore.getNames().get(i)));					
   122					}
   123				}
   124			}
   125			if (bFirst) {
   126				if (this.help.size() > ApoJumpStateHighscore.MAX_X) {
   127					this.getGame().getButtons()[11].setBVisible(false);
   128					this.getGame().getButtons()[12].setBVisible(true);
   129				} else {
   130					this.getGame().getButtons()[11].setBVisible(false);
   131					this.getGame().getButtons()[12].setBVisible(false);
   132				}
   133			}
   134		}
   135		
   136		private void nextHighscore(int plus) {
   137			int realPlus = plus * ApoJumpStateHighscore.MAX_X;
   138			this.curPos += realPlus;
   139			if (this.curPos >= this.help.size()) {
   140				this.curPos -= realPlus;
   141				this.getGame().getButtons()[12].setBVisible(false);
   142			} else if (this.curPos < 0) {
   143				this.curPos = 0;
   144				this.getGame().getButtons()[11].setBVisible(false);			
   145			}
   146			if (this.curPos + realPlus >= this.help.size()) {
   147				this.getGame().getButtons()[12].setBVisible(false);
   148			} else {
   149				this.getGame().getButtons()[12].setBVisible(true);			
   150			}
   151				
   152			if (this.curPos > 0) {
   153				this.getGame().getButtons()[11].setBVisible(true);
   154			} else {
   155				this.getGame().getButtons()[11].setBVisible(false);
   156			}
   157		}

   411		/**
   412		 * �berpr�ft, wenn sich 2 Entity per Rechteck schneiden,
   413		 * ob sie sich wirklich bildm��ig schneiden 
   414		 * @param entity = andere Entity zur Schnitt�berpr�fung
   415		 * @return TRUE wenn schneiden sich wirklich sonst FALSE
   416		 */
   417		public boolean checkOpaqueColorCollisions(ApoEntity entity) {
   418	
   419			Rectangle2D.Float cut = (Rectangle2D.Float)this.getRec().createIntersection(entity.getRec());
   420	
   421			if ((cut.width < 1) || (cut.height < 1)) {
   422				return false;
   423			}
   424	
   425			// Rechtecke in Bezug auf die jeweiligen Images
   426			Rectangle2D.Float sub_me = getSubRec(this.getRec(), cut);
   427			Rectangle2D.Float sub_him = getSubRec(entity.getRec(), cut);
   428	
   429			BufferedImage img_me = this.getIBackground().getSubimage((int) sub_me.x, (int) sub_me.y, (int) sub_me.width, (int) sub_me.height);
   430			BufferedImage img_him = entity.getIBackground().getSubimage((int) sub_him.x, (int) sub_him.y, (int) sub_him.width, (int) sub_him.height);
   431	
   432			for (int i = 0; i < img_me.getWidth(); i++) {
   433				for (int n = 0; n < img_him.getHeight(); n++) {
   434	
   435					int rgb1 = img_me.getRGB(i, n);
   436					int rgb2 = img_him.getRGB(i, n);
   437	
   438					if (isOpaque(rgb1) && isOpaque(rgb2)) {
   439						return true;
   440					}
   441	
   442				}
   443			}
   444	
   445			return false;
   446		}
   447	
   448		private Rectangle2D.Float getSubRec(Rectangle2D.Float source, Rectangle2D.Float part) {
   449	
   450			// Rechtecke erzeugen
   451			Rectangle2D.Float sub = new Rectangle2D.Float();
   452	
   453			// get X - compared to the Rectangle
   454			if (source.x > part.x) {
   455				sub.x = 0;
   456			} else {
   457				sub.x = part.x - source.x;
   458			}
   459	
   460			if (source.y > part.y) {
   461				sub.y = 0;
   462			} else {
   463				sub.y = part.y - source.y;
   464			}
   465	
   466			sub.width = part.width;
   467			sub.height = part.height;
   468	
   469			return sub;
   470		}

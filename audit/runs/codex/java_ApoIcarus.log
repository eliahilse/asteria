   189		@Override
   190		public void render(Graphics2D g) {
   191			if (this.iBackground != null) {
   192				g.drawImage(this.iBackground, 0, 0, null);
   193			}
   194			
   195			g.setFont(ApoJumpConstants.FONT_TEXTFIELD);
   196			g.setColor(Color.BLACK);
   197			
   198			final Font font = ApoJumpConstants.FONT_ANALYSIS;
   199			g.setFont(font);
   200			String s = String.valueOf(this.help.size()) + " scores online";
   201			int w = g.getFontMetrics().stringWidth(s);
   202			g.drawString(s, (int)(ApoJumpConstants.GAME_WIDTH/2 - w/2), (int)(140));
   203			
   204			for (int i = this.curPos; i < this.help.size() && i < ApoJumpStateHighscore.MAX_X + this.curPos; i++) {
   205				int y = 180;
   206				int addY = 0;
   207				if (i - this.curPos <= 4) {
   208					addY = 0;
   209				}
   210				g.setColor(Color.BLACK);
   211				g.setFont(font);
   212				s = String.valueOf(i + 1);
   213				g.drawString(s, 80, y + (i - this.curPos) * 25 + addY);
   214				
   215				s = String.valueOf(this.help.get(i).getPoints());
   216				w = g.getFontMetrics().stringWidth(s);
   217				g.drawString(s, 210 - w, y + (i - this.curPos) * 25 + addY);
   218				
   219				s = String.valueOf(this.help.get(i).getName());
   220				w = g.getFontMetrics().stringWidth(s);
   221				int size = font.getSize();
   222				while ((w > 200) && (size > 6)) {
   223					size -= 2;
   224					g.setFont(new Font(font.getName(), font.getStyle(), size));
   225					w = g.getFontMetrics().stringWidth(s);	
   226				}
   227				
   228				g.drawString(s, 240, y + (i - this.curPos) * 25 + addY);
   229				
   230				g.setFont(font);
   231				s = String.valueOf(ApoHelp.getTimeToDraw(this.help.get(i).getTime()));
   232				w = g.getFontMetrics().stringWidth(s);
   233				g.drawString(s, 460, y + (i - this.curPos) * 25 + addY);
   234			}
   235		}

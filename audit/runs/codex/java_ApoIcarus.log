   181		public void think( int delay ) {
   182			if ( !this.isBWait() ) {
   183				return;
   184			}
   185			if ( this.isBPressed() ) {
   186				this.wait += delay;
   187				this.maxWait += delay;
   188				if ( this.bFirstWait ) {
   189					if ( this.wait > 400) {

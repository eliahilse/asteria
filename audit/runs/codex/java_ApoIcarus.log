   190							this.render();
   191						}
   192						break;
   193					} else if (this.buttons[i].isBOver()) {
   194						bOver = true;
   195					}
   196				}
   197			}
   198			if (bOver) {
   199				if (!this.bHandCursor) {
   200					this.screen.getComponent().setCursor(Cursor.getPredefinedCursor(Cursor.HAND_CURSOR));
   201					this.bHandCursor = true;
   202				}
   203			} else {
   204				if (this.bHandCursor) {
   205					this.screen.getComponent().setCursor(Cursor.getPredefinedCursor(Cursor.DEFAULT_CURSOR));
   206					this.bHandCursor = false;
   207				}
   208			}
   209		}
   210	
   211		/**
   212		 * wird aufgerufen, wenn eine Maustaste gedr�ckt wird und �berpr�ft, ob sie �ber einem Button ist
   213		 * @param x : X-Wert der Maus (im Frame gesehen)
   214		 * @param y : Y-Wert der Maus (im Frame gesehen)
   215		 * @param left : TRUE, linke Maustaste gedr�ckt, ansonsten FALSE
   216		 */
   217		public void mousePressed(int x, int y, boolean left) {
   218			if (this.buttons != null) {
   219				for (int i = 0; i < this.buttons.length; i++) {
   220					if (this.buttons[i].getPressed(x, y)) {
   221						if (!super.shouldRepaint()) {
   222							this.render();
   223						}
   224						break;
   225					}
   226				}
   227			}
   228		}
   229	
   230		/**
   231		 * wird aufgerufen, wenn eine Maustaste losgelassen wurde und �berpr�ft, ob sie �ber einem Button ist<br />
   232		 * und ruft in diesem Fall die setButtonFunction mit der eindeutigen Funktion des Buttons auf
   233		 * @param x : X-Wert der Maus (im Frame gesehen)
   234		 * @param y : Y-Wert der Maus (im Frame gesehen)
   235		 * @param left : TRUE, linke Maustaste gedr�ckt, ansonsten FALSE
   236		 */
   237		public void mouseReleased(int x, int y, boolean left) {
   238			if (this.buttons != null) {
   239				for (int i = 0; i < this.buttons.length; i++) {
   240					if (this.buttons[i].getReleased(x, y)) {
   241						String function = this.buttons[i].getFunction();
   242						this.setButtonFunction(function);
   243					}
   244				}
   245			}
   246			if (!super.shouldRepaint()) {
   247				this.render();
   248			}
   249		}
   250	
   251		/**
   252		 * wird aufgerufen, wenn ein Button gedr�ckt wurde
   253		 * @param function : Funktion, die der Button ausf�hren soll und ihn einzigartig macht
   254		 */
   255		public abstract void setButtonFunction(String function);
   256	}

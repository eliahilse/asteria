    16	public class ApoJumpStateGame extends ApoJumpState {
    17	
    18		public static final String BUTTON_BACK = "back";
    19		public static final String BUTTON_RETRY = "retry";
    20		public static final String BUTTON_UPLOAD = "upload";
    21	
    22		public static final int UPLOAD_TIME = 3000;

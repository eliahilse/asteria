   361		 * @return TRUE, falls drin, sonst FALSE
   362		 */
   363		public boolean intersects(ApoEntity entity) {
   364			if (this.getRec().intersects( entity.getRec())) {
   365				if (this.isBOpaque()) {
   366					return this.checkOpaqueColorCollisions( entity );
   367				} else {
   368					return true;
   369				}
   370			}
   371			return false;
   372		}

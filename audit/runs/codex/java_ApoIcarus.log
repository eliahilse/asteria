    13	
    14	public class ApoJumpPlayer extends ApoAnimation {
    15		
    16		private final float START_VEC_Y = 1f;
    17		
    18		private final float MISSLE_VEC_Y = 1.2f;
    19		private final float HELICOPTER_VEC_Y = 1.2f;
    20		
    21		private final int TIME_MISSLE = 4500;
    22		private final int TIME_HELICOPTER = 2500;
    23		
    24		private boolean bDie;
    25		
    26		private boolean bHelicopter;
    27		
    28		private boolean bMissle;
    29		
    30		private int timeBonus;
    31		
    32		private boolean invulnerable;
    33		
    34		private int automaticArrow;
    35		
    36		
    37		
    38		public ApoJumpPlayer(BufferedImage background, float x, float y, float width, float height) {
    39			super(background, x, y, width, height, 1, 100000000, 2, false);
    40		}
    41		
    42		public void init() {
    43			super.init();
    44			this.setBOpaque(true);
    45			this.bDie = false;
    46			this.bMissle = false;
    47			this.bHelicopter = false;
    48			this.setVelocityY(-this.START_VEC_Y);
    49			this.automaticArrow = 0;
    50		}
    51		
    52		public int getAutomaticArrow() {
    53			return this.automaticArrow;
    54		}
    55	
    56		public void setAutomaticArrow(int automaticArrow) {
    57			this.automaticArrow = automaticArrow;
    58		}
    59	
    60		public boolean isBDie() {
    61			return this.bDie;
    62		}
    63	
    64		public void setVecX(float newVecX) {
    65			float oldVecX = super.getVelocityX();
    66			if (Math.abs(newVecX) > ApoJumpConstants.MAX_VEC_X) {
    67				if (newVecX > 0) {
    68					newVecX = ApoJumpConstants.MAX_VEC_X;
    69				} else {
    70					newVecX = -ApoJumpConstants.MAX_VEC_X;
    71				}
    72			}
    73			if (newVecX != 0) {
    74				if (newVecX > oldVecX) {
    75					super.setDirection(0);
    76				} else if (newVecX < oldVecX) {
    77					super.setDirection(1);
    78				}
    79			}
    80			super.setVelocityX(newVecX);
    81		}
    82		
    83		public void setHelicopter() {
    84			if (this.timeBonus <= 0) {
    85				this.invulnerable = true;
    86				this.bHelicopter = true;
    87				this.bMissle = false;
    88				this.setVelocityY(-this.HELICOPTER_VEC_Y);
    89				this.timeBonus = this.TIME_HELICOPTER;
    90				super.setIBackground(ApoJumpImageContainer.iPlayerGood);
    91				super.makeImageArray();
    92			}
    93		}
    94		
    95		public void setMissle() {
    96			if (this.timeBonus <= 0) {
    97				this.invulnerable = true;
    98				this.bHelicopter = false;
    99				this.bMissle = true;
   100				this.setVelocityY(-this.MISSLE_VEC_Y);
   101				this.timeBonus = this.TIME_MISSLE;
   102				super.setIBackground(ApoJumpImageContainer.iPlayerBest);
   103				super.makeImageArray();
   104			}
   105		}
   106		
   107		public void think(int delta, ApoJumpLevel level) {
   108			super.think(delta);
   109			if (this.bDie) {
   110				level.setWin();
   111			} else {
   112				this.thinkPosition(delta);
   113				this.thinkAutomaticArrow(delta, level);
   114				if (this.getVelocityX() < 0) {
   115					if (this.getX() < -this.getWidth()) {
   116						this.setX(ApoJumpConstants.GAME_WIDTH - this.getWidth());
   117					}
   118				}
   119				if (this.getVelocityX() >= 0) {
   120					if (this.getX() + this.getWidth() >= ApoJumpConstants.GAME_WIDTH) {
   121						this.setX(this.getX() - ApoJumpConstants.GAME_WIDTH);
   122					}
   123				}
   124				
   125				if (this.getY() + this.getHeight() - level.getChangeY() > ApoJumpConstants.GAME_HEIGHT) {
   126					this.bDie = true;
   127				}
   128			}
   129		}
   130		
   131		private void thinkAutomaticArrow(int delta, ApoJumpLevel level) {
   132			if (this.automaticArrow > 0) {
   133				int size = level.getEnemies().size();
   134				Rectangle2D rec = new Rectangle2D.Double(0, level.getChangeY() + 100, ApoJumpConstants.GAME_WIDTH, ApoJumpConstants.GAME_HEIGHT);
   135				for (int i = 0; i < size; i++) {
   136					if (level.getEnemies().get(i).getY() < level.getChangeY() - ApoJumpConstants.GAME_HEIGHT/2) {
   137						break;
   138					} else if (this.automaticArrow > 0) {
   139						if (level.getEnemies().get(i).isBVisible()) {
   140							if (level.getEnemies().get(i).intersects((float)rec.getX(), (float)rec.getY(), (float)rec.getWidth(), (float)rec.getHeight())) {	
   141								int x = (int)(level.getEnemies().get(i).getX() + level.getEnemies().get(i).getWidth()/2);
   142								if (level.getEnemies().get(i).getVelocityX() > 0) {
   143									x = (int)(level.getEnemies().get(i).getX() + level.getEnemies().get(i).getWidth() - 3);
   144								} else if (level.getEnemies().get(i).getVelocityX() < 0) {
   145									x = (int)(level.getEnemies().get(i).getX() + 3);
   146								}
   147								int y = (int)(level.getEnemies().get(i).getY() + level.getEnemies().get(i).getHeight()/2);
   148								if (level.getEnemies().get(i).getVelocityY() > 0) {
   149									y = (int)(level.getEnemies().get(i).getY() + level.getEnemies().get(i).getHeight() - 3);
   150								} else if (level.getEnemies().get(i).getVelocityY() < 0) {
   151									y = (int)(level.getEnemies().get(i).getY() + 3);
   152								}
   153								if (level.makeArrow(x, (int)(y - level.getChangeY()))) {
   154									this.automaticArrow -= 1;							
   155								}
   156								break;
   157							}
   158						}
   159					}
   160				}
   161			}
   162		}
   163		
   164		public final int getTimeBonus() {
   165			if (this.timeBonus > 0) {
   166				return this.timeBonus;
   167			} else if (this.invulnerable) {
   168				return 1;
   169			}
   170			return 0;
   171		}
   172	
   173		public void thinkPosition(int delta) {
   174			if (this.timeBonus <= 0) {
   175				this.setVelocityY(this.getVelocityY() + ApoJumpConstants.GRAVITY);
   176				if (this.invulnerable) {
   177					if (this.getVelocityY() >= 0) {
   178						this.invulnerable = false;
   179					}
   180				}
   181			} else {
   182				this.timeBonus -= delta;
   183				if (this.timeBonus <= 0) {
   184					this.bMissle = false;
   185					this.bHelicopter = false;
   186					super.setIBackground(ApoJumpImageContainer.iPlayer);
   187					super.makeImageArray();
   188				}
   189			}
   190			
   191			this.setX(this.getX() + this.getVelocityX() * delta);
   192			this.setY(this.getY() + this.getVelocityY() * delta);
   193		}
   194		
   195		public void render(Graphics2D g, int changeX, int changeY) {
   196			if (this.getIBackground() == null) {
   197				g.setColor(Color.RED);
   198				g.drawRect((int)(this.getX() - changeX), (int)(this.getY() - changeY), (int)(this.getWidth()), (int)(this.getHeight()));
   199				if (this.bMissle) {
   200					g.setColor(Color.CYAN);
   201					g.fillRect((int)(this.getX() - changeX + 3), (int)(this.getY() - changeY + 3), (int)(this.getWidth() - 6), (int)(this.getHeight() - 6));
   202				} else if (this.bHelicopter) {
   203					g.setColor(Color.RED);
   204					g.fillRect((int)(this.getX() - changeX), (int)(this.getY() - changeY - 3), (int)(this.getWidth()), (int)(3));
   205				}
   206			} else {
   207				super.render(g, -changeX, -changeY);
   208				if (this.automaticArrow > 0) {
   209					int x = (int)(this.getX() + 1);
   210					int y = (int)(this.getY() + 22 - changeY);
   211					// nach rechts
   212					if (this.getDirection() == 0) {
   213						x = (int)(this.getX() + 34);
   214					}
   215					g.setColor(Color.GREEN.brighter());
   216					g.fillOval(x, y, 4, 4);
   217				}
   218				if (this.getX() < 0) {
   219					super.render(g, (int)(ApoJumpConstants.GAME_WIDTH - changeX), -changeY);
   220				}
   221			}
   222		}
   223	
   224	
   225	}

   160		public boolean mouseDragged(int x, int y) {
   161			if (!this.getGame().isBWin()) {
   162				return this.mousePressed(x, y, false);
   163			}
   164			return false;
   165		}
   166		
   167		@Override
   168		public boolean mousePressed(int x, int y, boolean bRight) {
   169			if (this.getGame().isBWin()) {
   170				if ((this.textField != null) && (this.textField.isBVisible())) {
   171					if (this.textField.mousePressed(x, y)) {
   172						return true;
   173					}
   174				}
   175			} else if (!this.getGame().isBWin()) {
   176				this.getGame().getLevel().makeArrow(x, y);

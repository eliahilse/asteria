   159		public static double getAngleBetween2Points( float x1, float y1, float x2, float y2 ) {
   160			double dx = x1 - x2;
   161			double dy = y1 - y2;
   162			double angle = 0.0d;
   163	 
   164			if ( dx == 0.0 ) {
   165				if ( dy == 0.0 ) {
   166					angle = 0.0;
   167				} else if ( dy > 0.0 ) {
   168					angle = Math.PI / 2.0;
   169				} else {
   170					angle = (Math.PI * 3.0) / 2.0;
   171				}
   172			}
   173			else if( dy == 0.0 ) {
   174				if( dx > 0.0 ) {
   175					angle = 0.0;
   176				} else {
   177					angle = Math.PI;
   178				}
   179			} else {
   180				if ( dx < 0.0 ) {
   181					angle = Math.atan( dy/dx ) + Math.PI;
   182				} else if( dy < 0.0 ) {
   183					angle = Math.atan( dy/dx ) + ( 2*Math.PI );
   184				} else {
   185					angle = Math.atan( dy/dx );
   186				}
   187			}
   188			return ( angle * 180 ) / Math.PI;
   189	    }

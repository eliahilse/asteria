   211		private void uploadScore() {
   212			if (!this.bUpload) {
   213				this.bUpload = true;
   214				ApoJumpStateGame.this.upload();
   215			}
   216		}
   217		
   218		private void upload() {
   219			ApoHighscore.getInstance().save(this.getGame().getLevel().getPoints(), (int)this.getGame().getLevel().getTime(), this.textField.getCurString());
   220			this.getGame().getButtons()[10].setBVisible(false);
   221			this.getGame().getHighscore().loadHighscore(false);		
   222		}
   223		
   224		@Override
   225		public void think(int delta) {
   226			if (this.getGame().getLevel() != null) {
   227				if (this.countdown <= 0) {
   228					if (!this.getGame().isBWin()) {
   229						if ((this.getGame().getKeyboard().isPressed(KeyEvent.VK_LEFT)) || (this.getGame().getKeyboard().isPressed(KeyEvent.VK_A))) {
   230							this.getGame().getLevel().getPlayer().setVecX(-ApoJumpConstants.MAX_VEC_X);	
   231						} else if ((this.getGame().getKeyboard().isPressed(KeyEvent.VK_RIGHT)) || (this.getGame().getKeyboard().isPressed(KeyEvent.VK_D))) {
   232							this.getGame().getLevel().getPlayer().setVecX(ApoJumpConstants.MAX_VEC_X);	
   233						}
   234					}
   235					this.getGame().getLevel().think(delta);
   236				} else {
   237					this.countdown -= delta;
   238				}
   239			}
   240			if (this.getGame().isBWin()) {
   241				if (this.pressedWinTime >= 0) {
   242					this.pressedWinTime -= delta;
   243					if (this.pressedWinTime <= 0) {
   244						this.pressedKeys.clear();
   245					}
   246				}
   247				if (this.textField != null) {
   248					this.textField.think(delta);
   249				}
   250			}
   251		}

   253		@Override
   254		public void render(Graphics2D g) {
   255			this.getGame().renderBackground(g);
   256			if (this.getGame().getLevel() != null) {
   257				this.getGame().getLevel().render(g, 0, 0);
   258				if (this.getGame().isBWin()) {
   259					int x = ApoJumpConstants.GAME_WIDTH/2 - ApoJumpImageContainer.iAnalysisBackground.getWidth()/2;
   260					g.drawImage(ApoJumpImageContainer.iAnalysisBackground, x, 54, null);
   261					
   262					g.setFont(ApoJumpConstants.FONT_TEXTFIELD);
   263					g.setColor(Color.BLACK);
   264					
   265					String s = "Game over";
   266					int w = g.getFontMetrics().stringWidth(s);
   267					int h = g.getFontMetrics().getHeight() - 2 * g.getFontMetrics().getDescent();
   268					g.drawString(s, (int)(ApoJumpConstants.GAME_WIDTH/2 - w/2), (int)(120));
   269					
   270					g.setFont(ApoJumpConstants.FONT_ANALYSIS);
   271					
   272					s = "After " + ApoHelp.getTimeToDraw((int)this.getGame().getLevel().getTime())+" you crashed!";
   273					w = g.getFontMetrics().stringWidth(s);
   274					g.drawString(s, (int)(ApoJumpConstants.GAME_WIDTH/2 - w/2), (int)(205));
   275					
   276					int points = this.getGame().getLevel().getPoints();
   277					Point p = this.getGame().getHighscore().getPosition(points);
   278					int place = p.x;
   279					int max = p.y;
   280					s = "With "+String.valueOf(points)+" points you reached";
   281					w = g.getFontMetrics().stringWidth(s);
   282					g.drawString(s, (int)(ApoJumpConstants.GAME_WIDTH/2 - w/2), (int)(240));
   283					
   284					s = "place "+String.valueOf(place)+" of "+String.valueOf(max);
   285					w = g.getFontMetrics().stringWidth(s);
   286					g.drawString(s, (int)(ApoJumpConstants.GAME_WIDTH/2 - w/2), (int)(275));
   287					
   288					if (this.textField.isBVisible()) {
   289						this.textField.render(g, 0, 0);
   290						
   291						g.setFont(ApoJumpConstants.FONT_TEXTFIELD);
   292						s = "Name: ";
   293						w = g.getFontMetrics().stringWidth(s);
   294						h = g.getFontMetrics().getHeight() - 2 * g.getFontMetrics().getDescent();
   295						g.drawString(s, (int)(this.textField.getX() - w), (int)(this.textField.getY() + this.textField.getHeight()/2 + h/2));
   296					}
   297				} else {
   298					if (this.countdown > 0) {
   299						g.setFont(ApoJumpConstants.FONT_COUNTDOWN);
   300						g.setColor(Color.RED);
   301						String s = String.valueOf((this.countdown / 1000) + 1);
   302						int w = g.getFontMetrics().stringWidth(s);
   303						int h = g.getFontMetrics().getHeight() - 2 * g.getFontMetrics().getDescent();
   304						g.drawString(s, ApoJumpConstants.GAME_WIDTH/2 - w/2, ApoJumpConstants.GAME_HEIGHT/2 + h/2);
   305					}
   306				}
   307			}
   308		}

   149			}
   150			this.addPoint(ApoJumpConstants.POINTS_ARROW);
   151			int difX = (int)Math.abs(x - this.player.getX() - this.player.getWidth()/2);
   152			int difY = (int)Math.abs(y - this.player.getY() - this.player.getHeight()/2 + this.changeY);
   153			int max = difX + difY;
   154			float velX = ApoJumpConstants.MAX_VEC_ARROW * ((float)difX/(float)max);
   155			if (x < this.player.getX()) {
   156				velX = -ApoJumpConstants.MAX_VEC_ARROW * ((float)difX/(float)max);
   157			}
   158			float velY = ApoJumpConstants.MAX_VEC_ARROW * ((float)difY/(float)max);
   159			if (y + this.changeY < this.player.getY()) {
   160				velY = -ApoJumpConstants.MAX_VEC_ARROW * ((float)difY/(float)max);
   161			}
   162			this.arrow = new ApoJumpArrow(this.player.getX() + this.player.getWidth()/2, this.player.getY() + this.player.getHeight()/2, velX, velY);
   163			return true;
   164		}

    45		@Override
    46		public void update(int delta, ApoJumpLevel level) {
    47			if ((level.getPlayer().getVelocityY() > 0) && (!level.getPlayer().isBDie()) && (this.isBVisible())) {
    48				if (new Rectangle2D.Float(this.getX(), this.getY(), this.getWidth(), 4).intersects(level.getPlayer().getX(), level.getPlayer().getY() + level.getPlayer().getHeight() - 3, level.getPlayer().getWidth(), 3)) {
    49					level.getPlayer().setVelocityY(-ApoJumpPlatformNormal.NEW_VEC_Y);
    50					level.getPlayer().setY(this.getY() - level.getPlayer().getHeight());
    51					level.addJump();
    52					this.playerJumpOnPlatform();
    53				}else if (level.getPlayer().getX() < 0) {
    54					float x = ApoJumpConstants.GAME_WIDTH + level.getPlayer().getX();
    55					if (new Rectangle2D.Float(this.getX(), this.getY(), this.getWidth(), 4).intersects(x, level.getPlayer().getY() + level.getPlayer().getHeight() - 3, level.getPlayer().getWidth(), 3)) {
    56						level.getPlayer().setVelocityY(-ApoJumpPlatformNormal.NEW_VEC_Y);
    57						level.getPlayer().setY(this.getY() - level.getPlayer().getHeight());
    58						level.addJump();
    59						this.playerJumpOnPlatform();
    60					}
    61				} else if (this.intersects(level.getPlayer())) {
    62					this.playerIntersectsWithPlatform(level);
    63				}
    64			}
    65			if (this.getVelocityX() != 0) {
    66				this.setX(this.getX() + this.getVelocityX() * delta);
    67				if (this.getX() < 0) {
    68					this.setVelocityX(-this.getVelocityX());
    69					this.setX(0);
    70				} else if (this.getX() + this.getWidth() > ApoJumpConstants.GAME_WIDTH) {
    71					this.setVelocityX(-this.getVelocityX());
    72					this.setX(ApoJumpConstants.GAME_WIDTH - this.getWidth());
    73				}
    74			}
    75			if (this.getVelocityY() != 0) {
    76				float change = this.getVelocityY() * delta;
    77				this.curChangeY += change;
    78				this.setY(this.getY() + change);
    79				if (Math.abs(this.curChangeY) >= Math.abs(this.maxVecY)) {
    80					this.setVelocityY(-this.getVelocityY());
    81				}
    82			}
    83		}

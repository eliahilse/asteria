    80		public void blendOut() {
    81			this.isBlendIn = false;
    82			this.startTime = System.currentTimeMillis();
    83			this.timer.start();
    84		}
    85	
    86		public void actionPerformed(ActionEvent e) {
    87			float percent;
    88	
    89			if (this.isBlendIn) {
    90				percent = (System.currentTimeMillis() - this.startTime) / duration;
    91				percent = Math.min(1.0f, percent);
    92			} else {
    93				percent = (System.currentTimeMillis() - this.startTime) / duration;
    94				percent = Math.min(1.0f, percent);
    95				percent = 1.0f - percent;
    96			}
    97	
    98			float alphaValue = percent;
    99	
   100			if (percent >= 1.0) {
   101				this.timer.stop();
   102				// blendOut(); // Einkommentieren damit die animation
   103				// sofort wieder
   104				// ausgeblendet wird
   105			} else if (alphaValue <= 0.0f) {
   106				this.timer.stop();
   107				SwingUtilities.getWindowAncestor(label).dispose();
   108			}
   109	
   110			drawImage(alphaValue);
   111			this.label.setImage(currentImage);
   112			this.label.repaint();
   113		}
   114	
   115		/**
   116		 * Draws Background, then draws image over it
   117		 * 
   118		 * @param alphaValue

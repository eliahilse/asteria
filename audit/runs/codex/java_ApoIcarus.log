   107		public void think(int delta, ApoJumpLevel level) {
   108			super.think(delta);
   109			if (this.bDie) {
   110				level.setWin();
   111			} else {
   112				this.thinkPosition(delta);
   113				this.thinkAutomaticArrow(delta, level);
   114				if (this.getVelocityX() < 0) {
   115					if (this.getX() < -this.getWidth()) {
   116						this.setX(ApoJumpConstants.GAME_WIDTH - this.getWidth());
   117					}
   118				}
   119				if (this.getVelocityX() >= 0) {
   120					if (this.getX() + this.getWidth() >= ApoJumpConstants.GAME_WIDTH) {
   121						this.setX(this.getX() - ApoJumpConstants.GAME_WIDTH);
   122					}
   123				}
   124				
   125				if (this.getY() + this.getHeight() - level.getChangeY() > ApoJumpConstants.GAME_HEIGHT) {
   126					this.bDie = true;
   127				}
   128			}
   129		}
   130		
   131		private void thinkAutomaticArrow(int delta, ApoJumpLevel level) {
   132			if (this.automaticArrow > 0) {
   133				int size = level.getEnemies().size();
   134				Rectangle2D rec = new Rectangle2D.Double(0, level.getChangeY() + 100, ApoJumpConstants.GAME_WIDTH, ApoJumpConstants.GAME_HEIGHT);
   135				for (int i = 0; i < size; i++) {
   136					if (level.getEnemies().get(i).getY() < level.getChangeY() - ApoJumpConstants.GAME_HEIGHT/2) {
   137						break;
   138					} else if (this.automaticArrow > 0) {
   139						if (level.getEnemies().get(i).isBVisible()) {
   140							if (level.getEnemies().get(i).intersects((float)rec.getX(), (float)rec.getY(), (float)rec.getWidth(), (float)rec.getHeight())) {	
   141								int x = (int)(level.getEnemies().get(i).getX() + level.getEnemies().get(i).getWidth()/2);
   142								if (level.getEnemies().get(i).getVelocityX() > 0) {
   143									x = (int)(level.getEnemies().get(i).getX() + level.getEnemies().get(i).getWidth() - 3);
   144								} else if (level.getEnemies().get(i).getVelocityX() < 0) {
   145									x = (int)(level.getEnemies().get(i).getX() + 3);
   146								}
   147								int y = (int)(level.getEnemies().get(i).getY() + level.getEnemies().get(i).getHeight()/2);
   148								if (level.getEnemies().get(i).getVelocityY() > 0) {
   149									y = (int)(level.getEnemies().get(i).getY() + level.getEnemies().get(i).getHeight() - 3);
   150								} else if (level.getEnemies().get(i).getVelocityY() < 0) {
   151									y = (int)(level.getEnemies().get(i).getY() + 3);
   152								}
   153								if (level.makeArrow(x, (int)(y - level.getChangeY()))) {
   154									this.automaticArrow -= 1;							

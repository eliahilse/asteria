   191		private void restart() {
   192			this.countdown = ApoJumpConstants.COUNTDOWN_TIME;
   193			this.getGame().getLevel().init();
   194			this.textField.setBVisible(false);
   195		}
   196	
   197		@Override
   198		public void mouseButtonFunction(String function) {
   199			if (function.equals(ApoJumpStateGame.BUTTON_BACK)) {
   200				this.uploadScore();
   201				this.getGame().setMenu();
   202			} else if (function.equals(ApoJumpStateGame.BUTTON_RETRY)) {
   203				this.uploadScore();
   204				this.restart();
   205			} else if (function.equals(ApoJumpStateGame.BUTTON_UPLOAD)) {
   206				this.uploadScore();
   207			}
   208			this.textField.setBSelect(false);
   209		}

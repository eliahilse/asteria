   109		 * @return korrekte AffineTransform
   110		 */
   111		private static AffineTransform findTranslation(AffineTransform at, BufferedImage bi, double degrees ) {
   112			Point2D p2din, p2dout;
   113			double ytrans, xtrans = 0.0;
   114	
   115			AffineTransform tat = new AffineTransform();
   116	
   117			if(degrees == 180) {
   118				p2din = new Point2D.Double(0, bi.getHeight());
   119			} else {
   120				p2din = new Point2D.Double(0.0, 0.0);
   121			}
   122	
   123			p2dout = at.transform(p2din, null);
   124	
   125			if(degrees == 270) {
   126				xtrans = p2dout.getX();
   127				ytrans = xtrans;
   128			} else {
   129				ytrans = p2dout.getY();
   130				xtrans = ytrans;
   131			}
   132	
   133			tat.translate(-xtrans, -ytrans);
   134	
   135			return tat;
   136		}

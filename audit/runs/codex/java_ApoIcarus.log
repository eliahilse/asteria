     7	
     8	import org.apogames.ApoConstants;
     9	
    10	import apoJump.ApoJumpConstants;
    11	import apoJump.ApoJumpImageContainer;
    12	import apoJump.entity.ApoJumpPlatformNormal;
    13	import apoJump.entity.ApoJumpPlayer;
    14	
    15	public class ApoJumpStateMenu extends ApoJumpState {
    16	
    17		public static final String BUTTON_QUIT = "quit";
    18		public static final String BUTTON_GAME = "game";
    19		public static final String BUTTON_ACHIEVEMENTS = "achievements";
    20		public static final String BUTTON_HIGHSCORE = "highscore";
    21		public static final String BUTTON_HELP = "help";
    22		public static final String BUTTON_OPTIONS = "options";
    23		
    24		private ApoJumpPlayer player;
    25		
    26		private int curTarget;
    27		
    28		private String curFunction;	
    29		
    30		private BufferedImage iBackground;
    31		
    32		public ApoJumpStateMenu(ApoJumpPanel game) {
    33			super(game);
    34		}
    35		
    36		public void init() {
    37			this.getGame().setShouldRepaint(true);
    38			
    39			if (this.player == null) {
    40				BufferedImage iPlayer = ApoJumpImageContainer.iPlayer;
    41				int width = iPlayer.getWidth();
    42				int height = iPlayer.getHeight()/2;
    43				int x = (int)(this.getGame().getButtons()[0].getX() + this.getGame().getButtons()[0].getWidth()/2 - width/2);
    44				int y = (int)(this.getGame().getButtons()[0].getY() - height);
    45				this.player = new ApoJumpPlayer(iPlayer, x, y, width, height);
    46			}
    47			this.player.init();
    48			this.player.setVelocityY(-ApoJumpPlatformNormal.NEW_VEC_Y);
    49			this.curTarget = -1;
    50			if (this.iBackground == null) {
    51				this.makeBackground();
    52			}
    53		}
    54		
    55		private void makeBackground() {
    56			this.iBackground = new BufferedImage(ApoJumpConstants.GAME_WIDTH, ApoJumpConstants.GAME_HEIGHT, BufferedImage.TYPE_INT_RGB);
    57			Graphics2D g = this.iBackground.createGraphics();
    58			
    59			g.setRenderingHint(RenderingHints.KEY_ANTIALIASING, RenderingHints.VALUE_ANTIALIAS_ON);
    60			
    61			this.getGame().renderBackground(g);
    62			
    63			g.drawImage(this.getGame().getImages().getImage("images/title.png", false), 70, 0, null);
    64	
    65			g.dispose();
    66		}
    67	
    68		@Override
    69		public void keyButtonReleased(int button, char character) {
    70			if (this.getGame().getLevel() != null) {
    71				if (button == KeyEvent.VK_ENTER) {
    72					this.getGame().setGame();	
    73				} else if (button == KeyEvent.VK_ESCAPE) {
    74					if (!ApoConstants.B_APPLET) {
    75						System.exit(0);
    76					}
    77				}
    78			}
    79		}
    80	
    81		@Override
    82		public void mouseButtonFunction(String function) {
    83			if (function.equals(ApoJumpStateMenu.BUTTON_QUIT)) {
    84				if (!ApoConstants.B_APPLET) {
    85					System.exit(0);
    86				}
    87			} else {
    88				this.curFunction = function;
    89				this.player.setVelocityX(-ApoJumpConstants.MAX_VEC_X);
    90				this.player.setDirection(1);
    91				this.player.setVelocityY(-ApoJumpConstants.MAX_VEC_Y);
    92				if (this.curFunction.equals(ApoJumpStateMenu.BUTTON_GAME)) {
    93					this.curTarget = 1;
    94				} else if (this.curFunction.equals(ApoJumpStateMenu.BUTTON_HELP)) {
    95					this.curTarget = 2;
    96					this.player.setVelocityX(ApoJumpConstants.MAX_VEC_X);
    97					this.player.setDirection(0);
    98				} else if (this.curFunction.equals(ApoJumpStateMenu.BUTTON_OPTIONS)) {
    99					this.curTarget = 13;
   100					this.player.setVelocityX(ApoJumpConstants.MAX_VEC_X);
   101					this.player.setDirection(0);
   102				} else if (this.curFunction.equals(ApoJumpStateMenu.BUTTON_ACHIEVEMENTS)) {
   103					this.curTarget = 4;
   104				} else if (this.curFunction.equals(ApoJumpStateMenu.BUTTON_HIGHSCORE)) {
   105					this.curTarget = 5;
   106				} else {
   107					this.curTarget = -1;
   108				}
   109			}
   110		}
   111	
   112		@Override
   113		public void mouseButtonReleased(int x, int y) {
   114		}
   115	
   116		private void executeFunction() {
   117			if (this.curFunction.equals(ApoJumpStateMenu.BUTTON_GAME)) {
   118				this.getGame().setGame();
   119			} else if (this.curFunction.equals(ApoJumpStateMenu.BUTTON_OPTIONS)) {
   120				this.getGame().setOptions();
   121			} else if (this.curFunction.equals(ApoJumpStateMenu.BUTTON_HELP)) {
   122				this.getGame().setHelp();
   123			} else if (this.curFunction.equals(ApoJumpStateMenu.BUTTON_ACHIEVEMENTS)) {
   124				this.getGame().setAchievements();
   125			} else if (this.curFunction.equals(ApoJumpStateMenu.BUTTON_HIGHSCORE)) {
   126				this.getGame().setHighscore();
   127			}
   128		}
   129	
   130		@Override
   131		public void think(int delta) {
   132			this.player.thinkPosition(delta);
   133			if (this.curTarget == -1) {
   134				if (this.player.intersects(this.getGame().getButtons()[0])) {
   135					this.player.setVelocityY(-ApoJumpPlatformNormal.NEW_VEC_Y);
   136					this.player.setY(this.getGame().getButtons()[0].getY() - this.player.getHeight());
   137				}
   138			} else {
   139				float middleX = this.getGame().getButtons()[this.curTarget].getX() + this.getGame().getButtons()[this.curTarget].getWidth()/2;
   140				if ((this.player.getX() + this.player.getWidth()/2 + 2 > middleX) && (this.player.getX() + this.player.getWidth()/2 - 2 < middleX)) {
   141					this.player.setVelocityX(0);
   142				}
   143				if (this.player.getVelocityY() > 0) {
   144					if (this.player.intersects(this.getGame().getButtons()[this.curTarget])) {
   145						this.executeFunction();
   146					}
   147				}
   148			}
   149		}
   150		
   151		@Override
   152		public void render(Graphics2D g) {
   153			if (this.iBackground != null) {
   154				g.drawImage(this.iBackground, 0, 0, null);
   155			}
   156			
   157			if (this.player != null) {
   158				this.player.render(g, 0, 0);
   159			}
   160			if (ApoConstants.B_APPLET) {
   161				g.drawImage(ApoJumpImageContainer.iButtonBackground, (int)(this.getGame().getButtons()[0].getX()), (int)(this.getGame().getButtons()[0].getY()), null);
   162			}
   163		}
   164		
   165	}

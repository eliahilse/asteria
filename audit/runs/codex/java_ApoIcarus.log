    11	 */
    12	public final class ApoLibraryGame extends Thread {
    13	
    14	    /** SubGame ID f�r das Spiel */
    15	    public static final int GAME = 0;
    16	    /** SubGame ID f�rs Beenden des Spiels */
    17	    public static final int EXIT = -1;
    18	
    19	    /** n�chstes SubGame wird mit dieser Variable gesetzt */
    20	    private int nextGameID = ApoLibraryGame.GAME;
    21	    /** Screenobjekt des Spiel */
    22	    private ApoScreen screen = null;
    23	    
    24	    private final ApoSubGame game;
    25	
    26	    /**
    27	     * Konstruktor
    28	     * @param title : Titel des Spiels
    29	     * @param displayConfiguration : Displaykonfigurationen
    30	     */
    31	    public ApoLibraryGame(final ApoSubGame game) {
    32	        super();
    33	        this.game = game;
    34	        this.screen = this.game.getScreen();//new ApoScreen(title, displayConfiguration);
    35	    }
    36	
    37	    /** Spiel startet hier */
    38	    @Override
    39	    public void run() {
    40	        while (this.nextGameID != -1) {
    41	            try {
    42	                ApoSubGame subGame = selectGame(this.nextGameID);
    43	                if (subGame == null) {
    44	                    this.nextGameID = -1;
    45	                } else {
    46	                    subGame.start();
    47	                    subGame.join();
    48	                    this.nextGameID = subGame.getNextID();
    49	                }
    50	            } catch (InterruptedException e) {
    51	            }
    52	        }
    53	    }
    54	    
    55	    /**
    56	     * gibt den eigentlichen Screen des Spiels zur�ck
    57	     * @return gibt den eigentlichen Screen des Spiels zur�ck
    58	     */
    59	    public final ApoScreen getScreen() {
    60	    	return this.screen;
    61	    }
    62	
    63		/**
    64		 * mit dieser Methode kann zwischen den einzelnen Subgames hin und hergeschaltet werden
    65		 * @param gameID : GameID f�r das jeweilige SubGameObjekt
    66		 * @return das neue SubGameObjekt
    67		 * @throws InterruptedException
    68		 */
    69	    private ApoSubGame selectGame(int gameID) throws InterruptedException {
    70	        switch (gameID) {
    71	            case ApoLibraryGame.GAME:	return this.game;
    72	            default:					return null;
    73	        }
    74	    }
    75	}

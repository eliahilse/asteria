    12	public class ApoJumpPlatformInvisible extends ApoJumpPlatformNormal {
    13	
    14		private int maxTime;
    15		
    16		private int curTime;
    17		
    18		public ApoJumpPlatformInvisible(BufferedImage background, float x, float y, float width, float height, float startVecX, float startVecY) {
    19			super(background, x, y, width, height, startVecX, startVecY);
    20		}
    21		
    22		public void init() {
    23			super.init();
    24			this.curTime = 0;
    25			this.maxTime = (int)(Math.random() * 1500 + 4000);
    26		}
    27		
    28		public void update(int delta, ApoJumpLevel level) {
    29			if (this.curTime < this.maxTime) {
    30				this.curTime += delta;
    31			}
    32			if (this.curTime >= this.maxTime) {
    33				this.setBVisible(false);
    34			}
    35			if (this.isBVisible()) {
    36				super.update(delta, level);
    37			}
    38		}
    39		
    40		public void render(Graphics2D g, int changeX, int changeY) {
    41			if ((this.getY() - changeY >= 0) && (this.getY() - changeY <= ApoJumpConstants.GAME_HEIGHT) && (this.isBVisible())) {
    42				if (this.getIBackground() == null) {
    43					g.setColor(Color.WHITE);
    44					g.fillRoundRect((int)(this.getX() - changeX), (int)(this.getY() - changeY), (int)(this.getWidth()), (int)(this.getHeight()), 15, 15);
    45					g.setColor(Color.BLACK);
    46					g.drawRoundRect((int)(this.getX() - changeX), (int)(this.getY() - changeY), (int)(this.getWidth()), (int)(this.getHeight()), 15, 15);
    47				} else {
    48					float alpha = 1 - ((float)this.curTime / (float)this.maxTime);
    49					Composite composite = g.getComposite();
    50					AlphaComposite ac = AlphaComposite.getInstance(AlphaComposite.SRC_OVER, alpha);
    51					g.setComposite(ac);
    52					super.render(g, changeX, changeY);
    53					g.setComposite(composite);
    54				}
    55			}
    56		}
    57	
    58	}

    33	
    34		/**
    35		 * gibt zur�ck, ob eine �bergebene Taste derzeit gedr�ckt wird oder nicht
    36		 * @param key : Zu �berpr�fende Taste, ob sie gedr�ckt wird
    37		 * @return TRUE, Taste wird gedr�ckt, else FALSE, Taste wird nicht gedr�ckt
    38		 */
    39		public boolean isPressed(int key) {
    40			if (this.keys.containsKey(key)) {
    41				return this.keys.get(key);
    42			} else {
    43				return false;
    44			}
    45		}
    46	
    47		/**
    48		 * gibt ein Array mit Tasten zur�ck, welche gerade losgelassen wurden, zur�ck
    49		 * @return gibt ein Array mit Tasten zur�ck, welche gerade losgelassen wurden, zur�ck
    50		 */
    51		public synchronized int[][] getReleased() {
    52			if ((this.releasedKeys == null) || (this.releasedKeys.size() <= 0)) {
    53				return new int[0][0];
    54			}
    55			int[][] released = new int[this.releasedKeys.size()][2];
    56			for (int i = 0; i < this.releasedKeys.size(); i++) {
    57				released[i][0] = this.releasedKeys.get(i);
    58				released[i][1] = this.releasedCharKeys.get(i);
    59			}
    60			this.releasedKeys.clear();
    61			this.releasedCharKeys.clear();
    62			return released;
    63		}
    64	
    65		/**
    66		 * gibt ein Array mit Tasten zur�ck, welche gerade gedr�ckt werden, zur�ck
    67		 * @return gibt ein Array mit Tasten zur�ck, welche gerade gedr�ckt werden, zur�ck
    68		 */
    69		public synchronized int[] getPressed() {
    70			if ((this.pressedKeys == null) || (this.pressedKeys.size() <= 0)) {
    71				return new int[0];
    72			}
    73			int[] pressed = new int[this.pressedKeys.size()];
    74			for (int i = 0; i < this.pressedKeys.size(); i++) {
    75				pressed[i] = this.pressedKeys.get(i);
    76			}
    77			return pressed;
    78		}
    79	
    80		public void keyPressed(KeyEvent e) {
    81			this.keys.put(e.getKeyCode(), true);
    82			if (this.pressedKeys.indexOf(e.getKeyCode()) < 0) {
    83				this.pressedKeys.add(e.getKeyCode());
    84			}
    85		}
    86	
    87		public void keyReleased(KeyEvent e) {
    88			this.keys.put(e.getKeyCode(), false);
    89			this.releasedCharKeys.add((int)e.getKeyChar());
    90			this.releasedKeys.add(e.getKeyCode());
    91			this.pressedKeys.remove((Integer) e.getKeyCode());
    92		}
    93	
    94		public void keyTyped(KeyEvent e) {
    95			this.keys.put(e.getKeyCode(), false);
    96			this.releasedCharKeys.add((int)e.getKeyChar());
    97			this.releasedKeys.add(e.getKeyCode());
    98			this.pressedKeys.remove((Integer) e.getKeyCode());
    99		}

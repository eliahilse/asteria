    72		public static BufferedImage rotateImageMethodTwo(BufferedImage inputImage, double degrees ) {
    73			int x,y = 0;
    74			
    75			if ((degrees == 0)||(degrees == 180)||(degrees == 360)){
    76				x = inputImage.getWidth(null);
    77				y = inputImage.getHeight(null);
    78			} else {
    79				x = inputImage.getHeight(null);
    80				y = inputImage.getWidth(null);
    81			}
    82			BufferedImage sourceBI = GraphicsEnvironment.getLocalGraphicsEnvironment().getDefaultScreenDevice().getDefaultConfiguration().createCompatibleImage(x, y, BufferedImage.TRANSLUCENT);
    83			AffineTransform at = new AffineTransform();
    84	
    85			// rotate around image center
    86			at.rotate(Math.toRadians( degrees ), (sourceBI.getWidth() / 2), (sourceBI.getHeight() / 2) );
    87	
    88		    /*
    89		     * translate to make sure the rotation doesn't cut off any image data
    90		     */
    91			AffineTransform translationTransform;
    92			translationTransform = findTranslation( at, sourceBI, degrees );
    93			at.preConcatenate( translationTransform );
    94	
    95	
    96			Graphics2D g = (Graphics2D) sourceBI.getGraphics();
    97			g.setRenderingHint(RenderingHints.KEY_ANTIALIASING, RenderingHints.VALUE_ANTIALIAS_ON);
    98			g.setTransform(at);
    99			g.drawImage(inputImage, 0, 0, null);
   100	
   101			return sourceBI;
   102		}

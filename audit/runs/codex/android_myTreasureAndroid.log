    25		public String solveLevel(String level) {
    26			int[][] levelArray = new int[Integer.valueOf(level.substring(2, 4))][Integer.valueOf(level.substring(0, 2))];
    27			for (int y = 0; y < levelArray.length; y++) {
    28				for (int x = 0; x < levelArray[0].length; x++) {
    29					levelArray[y][x] = Integer.valueOf(level.substring(4 + x + y * levelArray[0].length, 4 + x + y * levelArray[0].length + 1));
    30				}
    31			}
    32			return this.solveLevel(levelArray);
    33		}
    34		
    35		public String solveLevel(final int[][] level) {
    36			String solveString = "no solution in max "+(this.MAX-1)+" steps";
    37			
    38			this.rotateLevel(level, 0);
    39			
    40			ArrayList<String> levelStrings = new ArrayList<String>();
    41			this.noSolutions.clear();
    42			
    43			int count = 1;
    44			boolean bBreak = false;
    45			while ((!bBreak) && (count < this.MAX)) {
    46				this.getSolutionsForGivenSteps(count);
    47				
    48				this.editor.setTestString("Test "+count+" steps");
    49				
    50	//			System.out.println(count+" "+this.solutions.size()+" "+this.solutions.get(0));
    51				
    52				for (int i = 0; i < this.solutions.size(); i++) {
    53					levelStrings.clear();
    54					boolean bSolveCheck = true;
    55					if (count >= this.NOSOLUTIONCHECK) {
    56						for (int j = 0; j < this.noSolutions.size(); j++) {
    57							if (this.noSolutions.get(j).equals(this.solutions.get(i).substring(0, this.noSolutions.get(j).length()))) {
    58								Log.d("solutionCheck",this.noSolutions.size()+" "+this.noSolutions.get(j));
    59								bSolveCheck = false;
    60								break;
    61							}
    62						}
    63					}
    64					if ((bSolveCheck) && (i < this.solutions.size())) {
    65						if (solveLevel(this.getCopy(level), this.solutions.get(i), levelStrings)) {
    66							bBreak = true;
    67							return this.solutions.get(i);
    68						}
    69					}
    70				}
    71				
    72				count += 1;
    73			}
    74			
    75			return solveString;
    76		}
    77		
    78		public final int[][] getCopy(final int[][] original) {
    79			int copy[][] = new int[original.length][original[0].length];
    80			for (int y = 0; y < original.length; y++) {
    81				for (int x = 0; x < original[0].length; x++) {
    82					copy[y][x] = original[y][x];
    83				}
    84			}
    85			return copy;
    86		}
    87		
    88		private void getSolutionsForGivenSteps(final int steps) {
    89			this.solutions.clear();
    90			
    91			this.getSolutionStringForGivenSteps(steps, true, "");
    92			this.getSolutionStringForGivenSteps(steps, false, "");
    93		}
    94		
    95		private void getSolutionStringForGivenSteps(int steps, boolean bLeft, String curString) {
    96			if (bLeft) {
    97				curString += "l";
    98			} else {
    99				curString += "r";
   100			}
   101			if (steps == 1) {
   102				this.solutions.add(curString);
   103			} else {
   104				this.getSolutionStringForGivenSteps(steps - 1, true, curString);
   105				this.getSolutionStringForGivenSteps(steps - 1, false, curString);
   106			}
   107		}
   108		
   109		public boolean solveLevel(final int[][] level, String solveLevel, final ArrayList<String> levelStrings) {
   110			int gravity = 0;
   111			
   112			if (solveLevel.length() > this.NOSOLUTIONCHECK) {
   113				levelStrings.add(this.getLevelString(level));
   114			}
   115			
   116			for (int i = 0; i < solveLevel.length(); i++) {
   117				if (solveLevel.substring(i, i + 1).equals("l")) {
   118					gravity = this.getGravity(gravity, -1);
   119				} else {
   120					gravity = this.getGravity(gravity, +1);
   121				}
   122				rotateLevel(level, gravity);
   123				
   124				if (solveLevel.length() > this.NOSOLUTIONCHECK) {
   125					String levelString = this.getLevelString(level);
   126					for (int j = 0; j < levelStrings.size(); j++) {
   127						if (levelStrings.get(j).equals(levelString)) {
   128							this.noSolutions.add(solveLevel.substring(0, i + 1));
   129							return false;
   130						}
   131					}
   132					
   133					if (solveLevel.length() > 10) {
   134						levelStrings.add(this.getLevelString(level));
   135					}
   136				}
   137			}
   138			
   139			return this.isWin(level);
   140		}

    23		private final MyTreasurePanel panel;
    24		
    25		public MyTreasureMusicPlayer(final MyTreasurePanel panel) {
    26			this.panel = panel;
    27		}
    28	
    29		public void setMenu(boolean bMenu) {
    30			if (bMenu != this.bMenu) {
    31				this.bMenu = bMenu;
    32				this.curFile = -1;
    33				if (this.panel.isMusicOn()) {
    34					this.stop();
    35					this.load();
    36				}
    37			}
    38		}
    39		
    40		public final void load() {
    41			boolean bLoop = false;
    42			if (!this.bMenu) {
    43				int nextString = this.MUSIC_INGAME[(int)(Math.random() * this.MUSIC_INGAME.length)];
    44				while (nextString == this.curFile) {
    45					nextString = this.MUSIC_INGAME[(int)(Math.random() * this.MUSIC_INGAME.length)];
    46				}
    47				this.curFile = nextString;
    48			} else {
    49				this.curFile = MENU;
    50				bLoop = true;
    51			}
    52			
    53	//		BitsLog.d("player", ""+this.curFile);
    54			this.mAudio = MediaPlayer.create(BitsApp.sAppContext, this.curFile);
    55			this.mAudio.setOnCompletionListener(this);
    56			
    57			play(0.6f, bLoop);
    58		}
    59		
    60		public final void release() {
    61			if( this.mAudio != null ) {
    62				if( this.mAudio.isPlaying() == true || this.mAudio.isLooping() == true ) {
    63					this.mAudio.stop();
    64				}
    65				this.mAudio.release();
    66				this.mAudio = null;
    67			}
    68		}
    69	
    70		private final void play(final float volume, final boolean loop) {
    71			if (this.mAudio != null) {
    72				this.stop();
    73			}
    74			if( this.mAudio != null ) {
    75				this.mAudio.setLooping(loop);
    76				this.mAudio.setVolume(volume, volume);
    77				this.mAudio.start();
    78			}
    79		}
    80		
    81		public final void stop( ) {
    82			if( this.mAudio != null ) {
    83				if (this.mAudio.isPlaying() || this.mAudio.isLooping()) {
    84					this.mAudio.stop();
    85				}
    86			}
    87		}
    88	
    89		@Override
    90		public void onCompletion(MediaPlayer mp) {
    91			if (!mp.isLooping()) {
    92				this.load();
    93			}
    94		}
    95	}

    34	public class MyTreasureUserLevels {
    35		
    36		private ArrayList<Integer> sortByUpload;
    37		
    38		private MyTreasureUserlevelsLoad userlevels;
    39		
    40		protected final MyTreasurePanel game;
    41		
    42		public MyTreasureUserLevels(final MyTreasurePanel game) {
    43			this.game = game;
    44			this.sortByUpload = new ArrayList<Integer>();
    45		}
    46		
    47		public void loadUserlevels() {
    48			try {
    49				this.userlevels = MyTreasureUserlevelsLoad.getInstance();
    50				this.userlevels.load();
    51				
    52				if (this.userlevels.getLevels().size() > 0) {
    53					this.sortByUpload();
    54					
    55					MyTreasureLevels.editorLevels = this.getAllLevelsSorted();
    56					
    57					this.game.setUserlevelsVisible();
    58				}
    59			} catch (Exception ex) {
    60				this.sortByUpload = new ArrayList<Integer>();
    61			}
    62		}
    63		
    64		public int getMaxLevel() {
    65			return this.userlevels.getLevels().size();
    66		}
    67		
    68		private String[] getAllLevelsSorted() {
    69			if (this.userlevels.getLevels().size() <= 0) {
    70				return null;
    71			}
    72			int size = this.sortByUpload.size();
    73			String[] levels = new String[size];
    74			for (int level = 0; level < levels.length; level++) {
    75				String curLevel = this.userlevels.getLevels().get(this.sortByUpload.get(level));
    76				levels[level] = curLevel;
    77			}
    78			return levels;
    79		}
    80		
    81		private void sortByUpload() {
    82			this.sortByUpload.clear();
    83			for (int i = 0; i < this.userlevels.getLevels().size(); i++) {
    84				if (!MyTreasureLevels.isIn(this.userlevels.getLevels().get(i))) {
    85					float time = this.userlevels.getTimes().get(i);
    86					boolean bAdd = false;
    87					for (int k = 0; k < this.sortByUpload.size(); k++) {
    88						float sortTime = this.userlevels.getTimes().get(this.sortByUpload.get(k));
    89						if (time > sortTime) {
    90							this.sortByUpload.add(k, i);
    91							bAdd = true;
    92							break;
    93						}
    94					}
    95					if (!bAdd) {
    96						this.sortByUpload.add(i);
    97					}
    98				}
    99			}
   100		}
   101	
   102		public ArrayList<Integer> getSortByUpload() {
   103			return this.sortByUpload;
   104		}
   105		
   106		public boolean isIn(final String level) {
   107			for (int i = 0; i < MyTreasureLevels.MAX_LEVELS; i++) {
   108				if (MyTreasureLevels.isInWithoutSteps(level)) {
   109					return false;
   110				}
   111			}
   112			for (int i = 0; i < this.userlevels.getLevels().size(); i++) {
   113				if (this.userlevels.getLevels().get(i).substring(0, this.userlevels.getLevels().get(i).length() - 4).equals(level.substring(0, level.length() - 4))) {
   114					return false;
   115				}
   116			}
   117			return true;
   118		}
   119		
   120		public boolean addLevel(String level) {
   121			if (this.isIn(level)) {
   122				return MyTreasureUserlevelsLoad.getInstance().save(level);
   123			}
   124			return false;
   125		}
   126		
   127		public String getStatistics(int level) {		
   128			int[] values = new int[4];
   129			values[0] = this.userlevels.getFun().get(this.sortByUpload.get(level));
   130			values[1] = this.userlevels.getCreative().get(this.sortByUpload.get(level));
   131			values[2] = this.userlevels.getEasy().get(this.sortByUpload.get(level));
   132			values[3] = this.userlevels.getHard().get(this.sortByUpload.get(level));
   133			
   134			int max = this.getHighest(-1, values);
   135			int maxTwo = this.getHighest(max, values);
   136			String result = "";
   137			for (int i = 0; i < values.length; i++) {
   138				if ((i != max) && (i != maxTwo)) {
   139					result += "0";
   140				} else {
   141					if (values[i] > 0) {
   142						result += "1";
   143					} else {
   144						result += "0";
   145					}
   146				}
   147			}
   148	
   149			return result;
   150		}
   151		
   152		private int getHighest(int not, int[] values) {
   153			int curValue = 0;
   154			if (not == 0) {
   155				curValue = 1;
   156			}
   157			int max = values[curValue];
   158			for (int i = 0; i < values.length; i++) {
   159				if ((max < values[i]) && (i != not)) {
   160					max = values[i];
   161					curValue = i;
   162				}
   163			}
   164			return curValue;
   165		}
   166		
   167		public int getID(int level) {
   168			return this.userlevels.getId().get(this.sortByUpload.get(level));
   169		}
   170	}

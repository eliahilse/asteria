   142		public String getLevelString(final int[][] level) {
   143			String levelString = "";
   144			String width = String.valueOf(level[0].length);
   145			if (width.length() < 2) {
   146				width = "0" + width;
   147			}
   148			String height = String.valueOf(level.length);
   149			if (height.length() < 2) {
   150				height = "0" + height;
   151			}
   152			levelString = width + height;
   153			for (int y = 0; y < level.length; y += 1) {
   154				for (int x = 0; x < level[0].length; x += 1) {
   155					levelString += String.valueOf(level[y][x]);
   156				}
   157			}
   158			return levelString;
   159		}

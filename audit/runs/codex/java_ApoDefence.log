    88		 * @param BildName = wo steckt das Bild
    89		 * @param bLoad
    90		 * @return das Bild
    91		 */
    92		private BufferedImage getImage(String BildName, boolean bLoad )
    93		{
    94			BufferedImage icon;
    95			
    96			BufferedImage result	= null;
    97			BufferedImage img		= null;
    98			
    99			if ( !bLoad ) 
   100			{
   101				try
   102				{
   103					img = ImageIO.read( ApoDefenceImage.class.getResource( BildName ) );
   104				} catch (IOException e)
   105				{
   106					e.printStackTrace();
   107				}
   108				result = this.gc.createCompatibleImage(img.getWidth(),img.getHeight(), Transparency.TRANSLUCENT);
   109				result.createGraphics().drawImage(img,0,0,null);
   110				icon	= result;
   111				
   112			} else
   113			{
   114				img = getBufferedImage( new ImageIcon(BildName).getImage() );
   115				result = this.gc.createCompatibleImage(img.getWidth(),img.getHeight(), Transparency.TRANSLUCENT);
   116				result.createGraphics().drawImage(img,0,0,null);
   117				icon	= result;
   118			}
   119			return (icon);
   120		}	

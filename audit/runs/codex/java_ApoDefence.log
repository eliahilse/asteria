   239		private void setOptionsArray( int value )
   240		{
   241			for ( int i = 0; i < this.aOptions.length; i++ )
   242			{
   243				if ( i == value )
   244				{
   245					this.aOptions[i]	= true;
   246					this.buttons[i+5].setBVisible( false );
   247				} else
   248				{
   249					this.aOptions[i]	= false;
   250					this.buttons[i+5].setBVisible( true );
   251				}
   252			}
   253		}

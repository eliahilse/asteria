   115				data.writeInt( this.enemyWay.size() );
   116				for ( int i = 0; i < this.enemyWay.size(); i++ )
   117				{
   118					data.writeInt( (int)this.enemyWay.get( i ).getX() );
   119					data.writeInt( (int)this.enemyWay.get( i ).getY() );
   120				}
   121				
   122				data.writeUTF( this.imageString );
   123				
   124				data.writeInt( this.money );
   125				data.writeInt( this.towerCount );
   126				data.writeInt( this.waves );
   127				
   128				data.writeInt( this.enemies.size() );
   129				for ( int i = 0; i < this.enemies.size(); i++ )
   130				{
   131					data.writeInt( this.enemies.get( i ) );
   132				}
   133				
   134				data.close();

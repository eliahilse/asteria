    45		private static byte[] map2 = new byte[128];
    46		static {
    47			for (int i = 0; i < map2.length; i++)
    48				map2[i] = -1;
    49			for (int i = 0; i < 64; i++)
    50				map2[map1[i]] = (byte) i;

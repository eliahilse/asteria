   121	         currentLoopClip.loop(0);
   122	         currentLoopClip=null;
   123	      }
   124	   }
   125	
   126	   public void loop() {
   127	      if (mute) { return; }
   128	      if (currentLoopClip==null) {
   129	         currentLoopClip=getClip();
   130	         if (currentLoopClip!=null) {
   131	            currentLoopClip.loop(Clip.LOOP_CONTINUOUSLY);
   132	         }
   133	      }
   134	   }
   135	
   136	   private Clip getClip() {
   137	      Clip soundClip;
   138	      try {
   139	         if (mixer!=null) {
   140	            soundClip=(Clip) mixer.getLine(dataLineInfo);
   141	         } else {
   142	            soundClip=(Clip) AudioSystem.getLine(dataLineInfo);
   143	         }
   144	         soundClip.open(format, data, 0, data.length);
   145	      } catch (LineUnavailableException e) {
   146	         ok=false;
   147	         return null;
   148	      }
   149	      ok=true;
   150	      lastClip=soundClip;
   151	      return soundClip;
   152	   }
   153	}

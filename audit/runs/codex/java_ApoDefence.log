    58		public void mouseReleased( int x, int y )
    59		{
    60			for ( int i = 0; i < this.buttons.length; i++ )
    61			{
    62				if ( this.buttons[i].getReleased( x, y ) )
    63				{
    64					String function	= this.buttons[i].getFunction();
    65					if ( "Original".equals( function ) )
    66					{
    67						this.setOriginal();
    68					} else if ( "WavesUp".equals( function ) )
    69					{
    70						ApoDefenceConstants.MAX_WAVE++;
    71						if ( ApoDefenceConstants.MAX_WAVE > 300 )
    72							ApoDefenceConstants.MAX_WAVE	= 300;
    73					} else if ( "WavesDown".equals( function ) )
    74					{
    75						ApoDefenceConstants.MAX_WAVE--;
    76						if ( ApoDefenceConstants.MAX_WAVE <= 0  )
    77							ApoDefenceConstants.MAX_WAVE	= 1;
    78					} else if ( "WavesTimeUp".equals( function ) )
    79					{
    80						ApoDefenceConstants.WAVE_TIME++;
    81						if ( ApoDefenceConstants.WAVE_TIME > 30 )
    82							ApoDefenceConstants.WAVE_TIME	= 30;
    83					} else if ( "WavesTimeDown".equals( function ) )
    84					{
    85						ApoDefenceConstants.WAVE_TIME--;
    86						if ( ApoDefenceConstants.WAVE_TIME < 3  )
    87							ApoDefenceConstants.WAVE_TIME	= 3;
    88					} else if ( "MoneyUp".equals( function ) )
    89					{
    90						ApoDefenceConstants.MONEY	+= 100;
    91						if ( ApoDefenceConstants.MONEY > 10000 )
    92							ApoDefenceConstants.MONEY	= 10000;
    93					} else if ( "MoneyDown".equals( function ) )
    94					{
    95						ApoDefenceConstants.MONEY	-= 100;
    96						if ( ApoDefenceConstants.MONEY < 100  )
    97							ApoDefenceConstants.MONEY	= 100;
    98					} else if ( "TowerUp".equals( function ) )
    99					{
   100						ApoDefenceConstants.MAX_TOWERS++;
   101						if ( ApoDefenceConstants.MAX_TOWERS > 100 )
   102							ApoDefenceConstants.MAX_TOWERS	= 100;
   103					} else if ( "TowerDown".equals( function ) )
   104					{
   105						ApoDefenceConstants.MAX_TOWERS--;
   106						if ( ApoDefenceConstants.MAX_TOWERS < 5  )
   107							ApoDefenceConstants.MAX_TOWERS	= 5;
   108					} else if ( "DifficultyDown".equals( function ) )
   109					{
   110						ApoDefenceConstants.DIFFICULTY++;
   111						if ( ApoDefenceConstants.DIFFICULTY > ApoDefenceConstants.DIFFICULTY_EASY )
   112							ApoDefenceConstants.DIFFICULTY	= ApoDefenceConstants.DIFFICULTY_EASY;
   113					} else if ( "DifficultyUp".equals( function ) )
   114					{
   115						ApoDefenceConstants.DIFFICULTY--;
   116						if ( ApoDefenceConstants.DIFFICULTY < ApoDefenceConstants.DIFFICULTY_HARD  )
   117							ApoDefenceConstants.DIFFICULTY	= ApoDefenceConstants.DIFFICULTY_HARD;
   118					} else if ( "EnemiesUp".equals( function ) )
   119					{
   120						ApoDefenceConstants.MAX_ENEMIES++;
   121						if ( ApoDefenceConstants.MAX_ENEMIES > 30 )
   122							ApoDefenceConstants.MAX_ENEMIES	= 30;
   123					} else if ( "EnemiesDown".equals( function ) )
   124					{
   125						ApoDefenceConstants.MAX_ENEMIES--;
   126						if ( ApoDefenceConstants.MAX_ENEMIES < 5  )
   127							ApoDefenceConstants.MAX_ENEMIES	= 5;
   128					}
   129					this.options.repaint();
   130				}
   131			}
   132		}

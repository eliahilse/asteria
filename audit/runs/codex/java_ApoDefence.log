   372		/**
   373		 * wird alle 25 Millisekunden aufgerufen und l�sst die Gegner gehen, 
   374		 * die T�rme feuern, scrollen usw. 
   375		 */
   376		public void think()
   377		{
   378			//long time	= System.nanoTime();
   379			if ( ( this.bMenu ) || ( this.bQuest ) || ( this.bRestart ) )
   380			{
   381				return;
   382			}
   383			else if ( this.bNextWave )
   384			{
   385				this.gameTower.think( this );
   386				this.castle.think( this );
   387				this.research.think( this );
   388				long time		= TimeUnit.NANOSECONDS.toSeconds( System.nanoTime() - this.nextWaveTime );
   389				if ( time > ApoDefenceConstants.WAVE_TIME )
   390				{
   391					this.bNextWave	= false;
   392					this.nextWaveTime	= -1;
   393					this.gameEnemy.makeNewWave( this.waves );
   394				}
   395			} else if ( this.castle.getHealth() < 1 )
   396			{
   397				this.bUpload	= true;
   398				this.bLoose		= true;
   399				this.highscore	= new ApoDefenceHighscore( this.loadSave.getLevel() );
   400				if ( ( this.highscore.canConnect() ) && ( this.main.isOriginal() ) )
   401				{
   402					this.nicknameField.setVisible( true );
   403					this.nicknameField.requestFocus( true );
   404					this.buttons[3].setBVisible( true );
   405					this.highscore.makeEntity();
   406					this.highscore.addEntity( this.nicknameField.getText(), this.loadSave.getLevel(), this.waves, (int)this.points );
   407				} else
   408				{
   409					this.highscore.setBConnect( false );
   410				}
   411			} else if ( this.gameEnemy.getAllEnemy().size() < 1 )
   412			{
   413				if ( this.waves + 1 <= this.maxWaves )
   414				{
   415					this.points			+= 100 * this.waves;
   416					this.setMoney( (int)((float)this.getMoney() + (float)this.waves * 5.0f * ApoDefenceConstants.DIFFICULTY + 30.0f ) );
   417					this.waves			+= 1;
   418					this.bNextWave		= true;
   419					this.nextWaveTime	= System.nanoTime();
   420				} else
   421				{
   422					this.bUpload	= true;
   423					this.points		+= 100 * this.waves;
   424					this.bWin		= true;
   425					this.highscore	= new ApoDefenceHighscore( this.loadSave.getLevel() );
   426					if ( ( this.highscore.canConnect() ) && ( this.main.isOriginal() ) )
   427					{
   428						this.nicknameField.setVisible( true );
   429						this.nicknameField.requestFocus( true );
   430						this.buttons[3].setBVisible( true );
   431						this.highscore.makeEntity();
   432						this.highscore.addEntity( this.nicknameField.getText(), this.loadSave.getLevel(), this.waves, (int)this.points );
   433					} else
   434					{
   435						//System.out.println( "Check" );
   436						this.highscore.setBConnect( false );
   437					}
   438				}
   439			}

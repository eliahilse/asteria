    30		// Mapping table from 6-bit nibbles to Base64 characters.
    31		private static char[] map1 = new char[64];
    32		static {
    33			int i = 0;
    34			for (char c = 'A'; c <= 'Z'; c++)
    35				map1[i++] = c;
    36			for (char c = 'a'; c <= 'z'; c++)
    37				map1[i++] = c;
    38			for (char c = '0'; c <= '9'; c++)
    39				map1[i++] = c;
    40			map1[i++] = '+';
    41			map1[i++] = '/';
    42		}

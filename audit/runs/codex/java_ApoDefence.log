   229		private void makeArray( int x, int y, boolean bButton )
   230		{
   231			if ( bButton )
   232			{
   233				this.aPlayground[y][x]	= ApoDefenceConstants.SAND;
   234				if ( ( x - 1 >= 0 ) )
   235				{
   236					if ( this.aPlayground[y][x-1] == ApoDefenceConstants.EMPTY )
   237						this.aPlayground[y][x-1] = ApoDefenceConstants.LEFT;
   238					else if ( this.aPlayground[y][x-1] == ApoDefenceConstants.UP )
   239						this.aPlayground[y][x-1] = ApoDefenceConstants.LEFT_UP;
   240					else if ( this.aPlayground[y][x-1] == ApoDefenceConstants.DOWN )
   241						this.aPlayground[y][x-1] = ApoDefenceConstants.LEFT_DOWN;
   242					else if ( this.aPlayground[y][x-1] == ApoDefenceConstants.RIGHT )
   243						this.aPlayground[y][x-1] = ApoDefenceConstants.LEFT_RIGHT;
   244				}
   245				if ( ( x + 1 < this.x ) )
   246				{
   247					if ( this.aPlayground[y][x+1] == ApoDefenceConstants.EMPTY )
   248						this.aPlayground[y][x+1] = ApoDefenceConstants.RIGHT;
   249					else if ( this.aPlayground[y][x+1] == ApoDefenceConstants.UP )
   250						this.aPlayground[y][x+1] = ApoDefenceConstants.UP_RIGHT;
   251					else if ( this.aPlayground[y][x+1] == ApoDefenceConstants.DOWN )
   252						this.aPlayground[y][x+1] = ApoDefenceConstants.DOWN_RIGHT;
   253					else if ( this.aPlayground[y][x+1] == ApoDefenceConstants.LEFT )
   254						this.aPlayground[y][x+1] = ApoDefenceConstants.LEFT_RIGHT;
   255				}
   256				if ( ( y - 1 >= 0 ) )
   257				{
   258					if ( this.aPlayground[y-1][x] == ApoDefenceConstants.EMPTY )
   259						this.aPlayground[y-1][x] = ApoDefenceConstants.UP;
   260					else if ( this.aPlayground[y-1][x] == ApoDefenceConstants.DOWN )
   261						this.aPlayground[y-1][x] = ApoDefenceConstants.UP_DOWN;
   262					else if ( this.aPlayground[y-1][x] == ApoDefenceConstants.LEFT )
   263						this.aPlayground[y-1][x] = ApoDefenceConstants.LEFT_UP;
   264					else if ( this.aPlayground[y-1][x] == ApoDefenceConstants.RIGHT )
   265						this.aPlayground[y-1][x] = ApoDefenceConstants.UP_RIGHT;
   266				}
   267				if ( ( y + 1 < this.y ) )
   268				{
   269					if ( this.aPlayground[y+1][x] == ApoDefenceConstants.EMPTY )
   270						this.aPlayground[y+1][x] = ApoDefenceConstants.DOWN;
   271					else if ( this.aPlayground[y+1][x] == ApoDefenceConstants.UP )
   272						this.aPlayground[y+1][x] = ApoDefenceConstants.UP_DOWN;
   273					else if ( this.aPlayground[y+1][x] == ApoDefenceConstants.LEFT )
   274						this.aPlayground[y+1][x] = ApoDefenceConstants.LEFT_DOWN;
   275					else if ( this.aPlayground[y+1][x] == ApoDefenceConstants.RIGHT )
   276						this.aPlayground[y+1][x] = ApoDefenceConstants.DOWN_RIGHT;
   277				}
   278				this.makeBackground();
   279			} else
   280			{
   281				this.aPlayground[y][x]	= ApoDefenceConstants.EMPTY;
   282				
   283				this.makeBackground();
   284			}
   285		}

   141		/**
   142		 * liest eine Datei in das �bergebene String Filesystem
   143		 * @param fileName = von wo wird gelesen
   144		 */
   145		public void readLevel( String fileName )
   146		{
   147			try
   148			{
   149				FileInputStream file		= new FileInputStream( fileName );
   150				BufferedInputStream buff	= new BufferedInputStream( file );
   151				DataInputStream data		= new DataInputStream( buff );
   152				try
   153				{
   154					this.level		= fileName.substring( fileName.lastIndexOf( File.separator ) + 1, fileName.lastIndexOf( "." ) );
   155					
   156					this.x			= data.readInt();
   157					this.y			= data.readInt();
   158					
   159					this.aPlayground	= new int[this.y][this.x];
   160					for ( int i = 0; i < this.y; i++ )
   161					{
   162						for ( int j = 0; j < this.x; j++ )
   163						{
   164							this.aPlayground[i][j]	= data.readInt();
   165						}
   166					}
   167					
   168					int x		= data.readInt();
   169					int y		= data.readInt();
   170					this.pointDefend		= new Point( x, y );
   171					
   172					x			= data.readInt();
   173					y			= data.readInt();
   174					this.pointUpgrade		= new Point( x, y );
   175					
   176					this.enemyWay		= new ArrayList<ApoDefenceDragObject>();
   177					int size			= data.readInt();
   178					for ( int i = 0; i < size; i++ )
   179					{
   180						x			= data.readInt();
   181						y			= data.readInt();
   182						this.enemyWay.add( new ApoDefenceDragObject( x, y, 16, 16 ) );
   183					}
   184					
   185					this.imageString	= data.readUTF();
   186					
   187					this.money			= data.readInt();
   188					this.towerCount		= data.readInt();
   189					this.waves			= data.readInt();
   190					
   191					this.enemies		= new ArrayList<Integer>();
   192					size			= data.readInt();
   193					for ( int i = 0; i < size; i++ )
   194					{
   195						this.enemies.add( data.readInt() );
   196					}
   197					
   198					data.close();
   199				} catch ( EOFException e )
   200				{
   201					System.out.println("Error: "+e);
   202					buff.close();
   203				}
   204				data.close();
   205			} catch ( IOException e )
   206			{
   207				System.out.println("Error: "+e);
   208			}
   209		}

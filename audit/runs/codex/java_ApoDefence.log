    11	public class ApoDefenceSounds
    12	{
    13	
    14	   private static Mixer mixer;
    15	   private byte[] data;
    16	   private AudioFormat format;
    17	   private DataLine.Info dataLineInfo;
    18	   private boolean ok=false;
    19	   private Clip currentLoopClip=null;
    20	   private Clip lastClip=null;

    22	
    23	   static {
    24	      Mixer.Info[] mixers=AudioSystem.getMixerInfo();
    25	      for (int i=0; i<mixers.length; i++) {
    26	         if ("Java Sound Audio Engine".equals(mixers[i].getName())) {
    27	            mixer=AudioSystem.getMixer(mixers[i]);
    28	         }
    29	      }
    30	   }
    31	
    32	   public static void main(String[] args) {
    33	     ApoDefenceSounds s1=new ApoDefenceSounds(new File("sound1.wav"));
    34	     ApoDefenceSounds s2=new ApoDefenceSounds(new File("sound2.wav"));
    35	     ApoDefenceSounds s3=new ApoDefenceSounds(new File("sound3.wav"));
    36	     
    37	     for (int i=0; i<50; i++) {
    38	       double rnd=Math.random();
    39	       if (rnd<0.3) {
    40	         s1.play();
    41	       }
    42	       else {
    43	         if (rnd < 0.6) {
    44	           s2.play();
    45	         }
    46	         else {
    47	           if (rnd < 1) {
    48	             s3.play();
    49	           }
    50	         }
    51	       }
    52	       
    53	       try {
    54	         Thread.sleep(200);
    55	       } catch(Exception e) {
    56	         //egal
    57	       }
    58	     }
    59	     
    60	     while (s1.isRunning()||s2.isRunning()||s3.isRunning()) {
    61	       // Warten, bis auch der letzte fertig ist...
    62	       Thread.yield();
    63	     }
    64	     
    65	     System.exit(0);
    66	   }
    67	
    68	   public ApoDefenceSounds(File sound) {
    69	      try {
    70	         System.out.println("Loading sound from file");
    71	         AudioInputStream soundStream=AudioSystem.getAudioInputStream(sound);
    72	         format=soundStream.getFormat();
    73	
    74	         int len=(int) (format.getFrameSize()*soundStream.getFrameLength());
    75	         data=new byte[len];
    76	         int l=0;
    77	         int lp=0;
    78	         do {
    79	            l=soundStream.read(data, lp, len);
    80	            lp+=l;
    81	         } while (l!=-1);
    82	
    83	         dataLineInfo=new DataLine.Info(Clip.class, format);
    84	         if (!AudioSystem.isLineSupported(dataLineInfo)) {
    85	            System.out.println("Audio-Line not supported!");
    86	         }
    87	      } catch (Exception e) {
    88	         System.out.println("Error loading sound: "+e);
    89	      }
    90	   }
    91	

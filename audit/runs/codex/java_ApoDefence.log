   343		/**
   344		 * �ffnet den Laden Dialog und l�dt das Level
   345		 * @param level: falls NULL �ffne den OpenDialog sonst �ffne den �bergebenen String
   346		 */
   347		public void setLoad( String level )
   348		{
   349			int p	= 0;
   350			if ( level == null )
   351				p = this.fc.showOpenDialog(this);
   352			if(p == 0)
   353			{
   354				String s = "";
   355				if ( level == null )
   356				{
   357					s	= this.fc.getSelectedFile().getPath();
   358				} else
   359				{
   360					s	= level;
   361				}
   362				this.loadSave.readLevel( s );
   363	
   364				ApoDefenceConstants.MONEY		= this.loadSave.getMoney();
   365				ApoDefenceConstants.MAX_TOWERS	= this.loadSave.getTowerCount();
   366				ApoDefenceConstants.MAX_WAVE	= this.loadSave.getWaves();
   367				
   368				this.restart();
   369			}
   370		}

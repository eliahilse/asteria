   228		private void setOptions( boolean bOption )
   229		{
   230			for ( int i = 0; i < 4; i++ )
   231			{
   232				if ( ( bOption ) && ( this.aOptions[i] ) )
   233					this.buttons[i+5].setBVisible( !bOption );

    77		/**
    78		 * Encodes a byte array into Base64 format. No blanks or line breaks are
    79		 * inserted.
    80		 * 
    81		 * @param in
    82		 *            an array containing the data bytes to be encoded.
    83		 * @param iLen
    84		 *            number of bytes to process in <code>in</code>.
    85		 * @return A character array with the Base64 encoded data.
    86		 */
    87		public char[] encode(byte[] in, int iLen) {
    88			int oDataLen = (iLen * 4 + 2) / 3; // output length without padding
    89			int oLen = ((iLen + 2) / 3) * 4; // output length including padding
    90			char[] out = new char[oLen];
    91			int ip = 0;
    92			int op = 0;
    93			while (ip < iLen) {
    94				int i0 = in[ip++] & 0xff;
    95				int i1 = ip < iLen ? in[ip++] & 0xff : 0;
    96				int i2 = ip < iLen ? in[ip++] & 0xff : 0;
    97				int o0 = i0 >>> 2;
    98				int o1 = ((i0 & 3) << 4) | (i1 >>> 4);
    99				int o2 = ((i1 & 0xf) << 2) | (i2 >>> 6);
   100				int o3 = i2 & 0x3F;
   101				out[op++] = map1[o0];
   102				out[op++] = map1[o1];
   103				out[op] = op < oDataLen ? map1[o2] : '=';
   104				op++;
   105				out[op] = op < oDataLen ? map1[o3] : '=';
   106				op++;
   107			}
   108			return out;
   109		}

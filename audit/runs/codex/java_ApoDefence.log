   166		public void send(String name, String map, int level, int points) {
   167			ApoDefenceHighscoreEncrypt base = new ApoDefenceHighscoreEncrypt();
   168			String baseName = base.encodeString(name);
   169			baseName = base.encodeString(baseName);
   170			baseName = base.encodeString(baseName);
   171	
   172			String baseMap = base.encodeString(map);
   173			baseMap = base.encodeString(baseMap);
   174			baseMap = base.encodeString(baseMap);
   175			baseMap = base.encodeString(baseMap);
   176	
   177			String baseLevel = base.encodeString("" + level);
   178			baseLevel = base.encodeString(baseLevel);
   179	
   180			String basePoints = base.encodeString("" + points);
   181			basePoints = base.encodeString(basePoints);
   182			basePoints = base.encodeString(basePoints);
   183			basePoints = base.encodeString(basePoints);
   184			basePoints = base.encodeString(basePoints);
   185	
   186			String day = Integer.toString(Calendar.getInstance().get(
   187					Calendar.DAY_OF_MONTH));
   188			day = base.encodeString(day);
   189			day = base.encodeString(day);
   190	
   191			String url = "http://daporius.drition.net/highscore.php?";
   192			String getUrl = "name=" + baseName + "&map=" + baseMap + "&level="
   193					+ baseLevel + "&points=" + basePoints + "&cor=" + day;
   194	
   195			url = url + getUrl;
   196			// System.out.println(url);
   197	
   198			try {
   199				this.writeConnection = new URL(url);
   200				HttpURLConnection con = (HttpURLConnection) this.writeConnection
   201						.openConnection();
   202				con.setRequestMethod("GET");
   203				new BufferedReader(new InputStreamReader(con.getInputStream()));
   204			} catch (MalformedURLException e) {
   205				e.printStackTrace();
   206			} catch (IOException e) {
   207				e.printStackTrace();
   208			}
   209	
   210		}

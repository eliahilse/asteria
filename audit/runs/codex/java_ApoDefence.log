    91		private void makeEntity(String s) {
    92			s = s.replace("\t", "");
    93			s = s.replace("\n", "");
    94			// System.out.println( s );
    95			while (s.indexOf("<person>") != -1) {
    96				int i = s.indexOf("<person>") + 9;
    97				int h = s.indexOf("</person>");
    98				String sub = s.substring(i, h);
    99				String name = sub.substring(sub.indexOf("<nickname>") + 10, sub
   100						.indexOf("</nickname>"));
   101				// System.out.println( name );
   102				int level = Integer.parseInt(sub.substring(
   103						sub.indexOf("<level>") + 7, sub.indexOf("</level>")));
   104				// System.out.println( level );
   105				String map = sub.substring(sub.indexOf("<map>") + 5, sub
   106						.indexOf("</map>"));
   107				// System.out.println( map );
   108				int points = Integer.parseInt(sub.substring(
   109						sub.indexOf("<point>") + 7, sub.indexOf("</point>")));
   110				// System.out.println( points );
   111				if (map.equals(this.map))
   112					this.addEntity(name, map, level, points);
   113				if (h > 0)
   114					s = s.substring(h + 9);
   115			}
   116	
   117			/*
   118			 * for ( int i = 0; i < this.entity.size(); i++ ) { System.out.println(
   119			 * "Points = " + this.entity.get( i ).getPoints() ); }
   120			 */
   121	
   122		}
   123	
   124		public void addEntity(String name, String map, int level, int points) {
   125			// System.out.println( name );
   126			if (this.entity.size() == 0)
   127				this.entity.add(new ApoDefenceHighscoreEntity(name, map, level,
   128						points));
   129			else {
   130				boolean bAdd = false;
   131				for (int i = 0; i < this.entity.size(); i++) {
   132					if (this.entity.get(i).getPoints() < points) {
   133						bAdd = true;
   134						this.yourPlace = i;
   135						this.entity.add(i, new ApoDefenceHighscoreEntity(name, map,
   136								level, points));
   137						break;
   138					}
   139				}
   140				if (!bAdd) {
   141					this.yourPlace = this.entity.size();
   142					this.entity.add(new ApoDefenceHighscoreEntity(name, map, level,
   143							points));
   144				}
   145			}
   146		}
   147	
   148		public void render(Graphics2D g) {
   149			int x = 60;
   150			int y = 167;
   151			for (int i = 0; i < this.entity.size() && i < 5; i++) {
   152				if ((i == this.yourPlace) || (this.entity.size() == 1))
   153					g.setColor(Color.RED);
   154				else
   155					g.setColor(Color.WHITE);
   156				this.entity.get(i).render(g, x, y, i);
   157				y += 20;
   158			}
   159			if (this.yourPlace >= 5) {
   160				g.setColor(Color.RED);
   161				y += 20;
   162				this.entity.get(this.yourPlace).render(g, x, y, this.yourPlace);
   163			}
   164		}

    57		/**
    58		 * l�dt das Bild aus dem �bergbenen String und wartet bis es fertig geladen ist
    59		 * @param BildString = wo steckt das Bild
    60		 * @param bLoad
    61		 * @return gibt das geladenen Bild zur�ck
    62		 */
    63		public BufferedImage getPic( String BildString, boolean bLoad ) 
    64		{
    65			BufferedImage i;
    66			MediaTracker mt;
    67			mt = new MediaTracker( this.C );// damit alles mit einmal angezeigt wird
    68			
    69			i = getImage( BildString, bLoad );
    70	
    71			mt.addImage(i, 0);
    72	
    73			try
    74			{
    75				// Wait until all pic are load,
    76				mt.waitForAll();
    77			} catch (InterruptedException e) 

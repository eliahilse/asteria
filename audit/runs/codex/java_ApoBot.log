   196				g.setColor(Color.blue);
   197				g.fillRect(x - 3, y + 10, 6, 10);
   198				Polygon poly = new Polygon();
   199				poly.addPoint(x, y);
   200				poly.addPoint(x + 10, y + 10);
   201				poly.addPoint(x - 10, y + 10);
   202				g.fillPolygon(poly);
   203			} else if (dir == 1) {
   204				g.setColor(Color.blue);
   205				g.fillRect(x - 20, y - 3, 10, 6);
   206				Polygon poly = new Polygon();
   207				poly.addPoint(x, y);
   208				poly.addPoint(x - 10, y - 10);
   209				poly.addPoint(x - 10, y + 10);
   210				g.fillPolygon(poly);
   211			} else if (dir == 2) {
   212				g.setColor(Color.blue);
   213				g.fillRect(x - 3, y - 20, 6, 10);
   214				Polygon poly = new Polygon();
   215				poly.addPoint(x, y);
   216				poly.addPoint(x + 10, y - 10);
   217				poly.addPoint(x - 10, y - 10);
   218				g.fillPolygon(poly);
   219			}
   220		}

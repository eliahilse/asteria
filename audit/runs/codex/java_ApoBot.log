    81		 * @param y = The y location in the source image of the pixel to process
    82		 */
    83		private void process(int x, int y) {
    84			int A = this.getSourcePixel(x - 1, y - 1);
    85			int B = this.getSourcePixel(x, y - 1);
    86			int C = this.getSourcePixel(x + 1, y - 1);
    87			int D = this.getSourcePixel(x - 1, y);
    88			int E = this.getSourcePixel(x, y);
    89			int F = this.getSourcePixel(x + 1, y);
    90			int G = this.getSourcePixel(x - 1, y + 1);
    91			int H = this.getSourcePixel(x, y + 1);
    92			int I = this.getSourcePixel(x + 1, y + 1);
    93			int E0 = E;
    94			int E1 = E;
    95			int E2 = E;
    96			int E3 = E;
    97			int E4 = E;
    98			int E5 = E;
    99			int E6 = E;

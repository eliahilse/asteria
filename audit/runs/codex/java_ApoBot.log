   463		/**
   464		 * malt das Objekt
   465		 * @param g
   466		 */
   467		public void render(Graphics2D g, int x, int y) {
   468			if ((this.getIBackground() != null) && (this.isBVisible())) {
   469				g.drawImage(this.iBackground, (int) (this.getX() + x), (int) (this
   470						.getY() + y), (int) (this.getX() + x + this.getWidth()),
   471						(int) (this.getY() + y + this.getHeight()), 0, 0,
   472						(int) this.getWidth(), (int) this.getHeight(), null);
   473				if (this.isBSelect()) {
   474					g.setColor(Color.red);
   475					g.drawRect((int) (this.getX() + x), (int) (this.getY() + y),
   476							(int) (this.getWidth() - 1),
   477							(int) (this.getHeight() - 1));
   478				}
   479			}
   480		}
   481	
   482		/**
   483		 * malt das Objekt
   484		 * @param g = Graphics2D Objekt
   485		 */
   486		public void render(Graphics2D g) {
   487			this.render(g, 0, 0);
   488		}
   489	
   490		/**
   491		 * malt das Objekt
   492		 * @param g = Graphics Objekt
   493		 */
   494		public void render(Graphics g) {
   495			this.render((Graphics2D) g, 0, 0);
   496		}

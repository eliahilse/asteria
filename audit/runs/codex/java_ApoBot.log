   148		 * um ein neues Frame anzuzeigen
   149		 * @param time: Zeit, die seit dem letzten Aufruf dieser Funktion vergangen ist
   150		 */
   151		public void think( int time ) {
   152			this.curTime += time;
   153			while ( this.getCurTime() >= this.getTime() ) {
   154				this.curTime -= this.time;
   155				this.frame += 1;
   156				if ( this.getFrame() >= this.getTiles() ) {

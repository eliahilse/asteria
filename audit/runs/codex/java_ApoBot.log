   323		/**
   324		 * startet den Thread und f�gt Mouse und KeyListeners hinzu wenn es
   325		 * gew�nscht ist
   326		 */
   327		public void start() {
   328			if ((this.thread == null) && (this.bTimer)) {
   329				super.createBufferStrategy(3);
   330				this.strategy = getBufferStrategy();
   331	
   332				this.setBThink(true);
   333	
   334				this.thread = new ApoThread(this, this.WAIT_TIME_THINK, this.WAIT_TIME_RENDER);
   335				this.thread.start();
   336			}
   337			if (this.bMouse) {
   338				this.addMouseListener(this);
   339				this.addMouseMotionListener(this);
   340				this.addMouseWheelListener(this);
   341			}
   342			if (this.bKey) {
   343				this.addFocusListener(this);
   344				if (!ApoConstants.B_APPLET) {
   345					this.addKeyListener(this);
   346				} else {
   347					this.addKeyListener(this);
   348				}
   349			}
   350		}

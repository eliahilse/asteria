   145				g.fillRoundRect( (width)/3 * i, 0, (width)/3 - 1, height - 1, round, round );
   146				
   147				g.setFont( fontOkButton );
   148				int w = g.getFontMetrics().stringWidth( text );
   149				int x = iButton.getWidth()/3;
   150				
   151				if ( i == 1 ) {
   152					g.setColor(over);
   153					g.fillRoundRect( i*x + x/2 - w/2, iButton.getHeight()/2 - h/4 + 1, w, h/2 - 2, 20, 20 );
   154				} else if ( i == 2 ) {
   155					g.setColor(pressed);
   156					g.fillRoundRect( i*x + x/2 - w/2, iButton.getHeight()/2 - h/4 + 1, w, h/2 - 2, 20, 20 );
   157				}
   158				
   159				g.setColor( font );
   160				g.drawString( text, i*x + x/2 - w/2, iButton.getHeight()/2 + h/3 );
   161				
   162				g.setColor( border );
   163				g.drawRoundRect( (width)/3 * i, 0, (width)/3 - 1, height - 1, round, round );
   164			}
   165			
   166			g.dispose();
   167			return iButton;
   168		}

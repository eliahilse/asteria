   989		/**
   990		 * setzt das n�chste Kommand f�r den Spieler
   991		 * @param command : welcher Kommando es ist =)
   992		 */
   993		private void nextCommand(int command) {
   994			//System.out.println("command = "+command);
   995			if (command == ApoBotConstants.FORWARD) {
   996				if (this.canPlayerRun()) {
   997					this.getPlayer().setBRun(true);
   998				}
   999				this.waitTime += 300;
  1000			} else if (command == ApoBotConstants.REDYE) {
  1001				if (this.getLevel().getLevel()[(int)this.getPlayer().getY()][(int)this.getPlayer().getX()].getGround() == ApoBotConstants.GROUND_GOAL) {
  1002					this.getLevel().getLevel()[(int)this.getPlayer().getY()][(int)this.getPlayer().getX()].setGround(ApoBotConstants.GROUND_ORIGINAL);
  1003				} else if (this.getLevel().getLevel()[(int)this.getPlayer().getY()][(int)this.getPlayer().getX()].getGround() == ApoBotConstants.GROUND_ORIGINAL) {
  1004					this.getLevel().getLevel()[(int)this.getPlayer().getY()][(int)this.getPlayer().getX()].setGround(ApoBotConstants.GROUND_GOAL);
  1005				}
  1006				this.makeBackground();
  1007				this.waitTime += 300;
  1008			} else if (command == ApoBotConstants.LEFT) {
  1009				this.getPlayer().setCurDir(this.getPlayer().getCurDir() - 1);
  1010				this.waitTime += 300;
  1011			} else if (command == ApoBotConstants.RIGHT) {
  1012				this.getPlayer().setCurDir(this.getPlayer().getCurDir() + 1);
  1013				this.waitTime += 300;
  1014			} else if (command == ApoBotConstants.JUMP) {
  1015				if (this.canPlayerJump()) {
  1016					this.getPlayer().setBRun(true);				
  1017				} else {
  1018					this.getPlayer().setJumpHeight(0);
  1019				}
  1020				this.getPlayer().setBJump(true);
  1021				this.waitTime += 300;
  1022			}
  1023		}

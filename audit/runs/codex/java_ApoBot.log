    91		/**
    92		 * wird aufgerufen, wenn ein neuer Text gezeigt werden soll
    93		 */
    94		public void nextStep() {
    95			if ((this.step == 5) || (this.step == 6) || (this.step == 7) || (this.step == 9) || (this.step == 11)) {
    96				if (!this.game.isBWin()) {
    97					return;
    98				}
    99			}
   100			if (this.step + 1 < ApoBotConstants.TUTORIAL_SPEECH.length) {
   101				this.step++;
   102				this.curString = ApoBotConstants.TUTORIAL_SPEECH[this.step];
   103				this.curStringInt = 0;
   104				this.curDelta = 0;
   105				if ((this.step == 5) || (this.step == 6) || (this.step == 7) || (this.step == 9) || (this.step == 11)) {
   106					this.game.getButtons()[4].setBVisible(true);
   107					this.game.getButtons()[12].setBVisible(true);				
   108				} else {
   109					this.game.getButtons()[4].setBVisible(false);
   110					this.game.getButtons()[12].setBVisible(false);
   111					this.game.getButtons()[13].setBVisible(false);				
   112				}
   113				if ((this.step == 6) || (this.step == 7) || (this.step == 8) || (this.step == 10)) {
   114					this.game.setButtonFunction("gameLevelRight");
   115				}
   116			} else {
   117				this.game.setMenu();
   118			}
   119		}
   120		
   121		/**
   122		 * wird aufgerufen beim "nachdenken" und erh�ht die Zeichen die gemalt werden vom Text und �berpr�ft, ob das Level
   123		 * gewonnen wurde oder nicht
   124		 * @param delta
   125		 */
   126		public void think(int delta) {
   127			this.curDelta += delta;
   128			if (this.curDelta >= this.MAX_DELTA) {
   129				this.curDelta -= this.MAX_DELTA;
   130				if (this.curStringInt < this.curString.length()) {
   131					this.curStringInt++;
   132				}
   133			}
   134			if ((this.step == 5) || (this.step == 6) || (this.step == 7) || (this.step == 9) || (this.step == 11)) {
   135				if (this.game.isBWin()) {
   136					this.nextStep();
   137				}
   138				this.game.thinkMove(delta);
   139			}
   140		}

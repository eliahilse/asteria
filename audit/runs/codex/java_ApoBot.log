   883		/**
   884		 * k�mmert sich um das "nachdenken" und die Spielerbewegung und welches Kommando ausgef�hrt wird
   885		 */
   886		public void think(int delta) {
   887			super.think(delta);
   888			if (this.bTutorial) {
   889				this.tutorial.think(delta);
   890			} else if (this.bMenu) {
   891				// l�sst den SPieler im Menu zuf�llig laufen
   892				super.centerCamera();
   893				if ((this.getPlayer().isBRun()) || (this.getPlayer().isBJump())) {
   894					this.getPlayer().think(delta);
   895					this.waitTime -= delta;
   896				} else {
   897					if (this.waitTime > 0) {
   898						this.waitTime -= delta;
   899					} else {
   900						int nextCommand = (int)(Math.random() * 100);
   901						if (nextCommand < 50) {
   902							nextCommand = ApoBotConstants.FORWARD;
   903						} else if (nextCommand < 60) {
   904							nextCommand = ApoBotConstants.LEFT;
   905						} else if (nextCommand < 70) {
   906							nextCommand = ApoBotConstants.RIGHT;
   907						} else if (nextCommand < 80) {
   908							nextCommand = ApoBotConstants.REDYE;
   909						} else {
   910							nextCommand = ApoBotConstants.JUMP;
   911						}
   912						if (nextCommand == ApoBotConstants.FORWARD) {
   913							if (!this.canPlayerRun()) {
   914								if (this.canPlayerJump()) {
   915									nextCommand = ApoBotConstants.JUMP;
   916								} else {
   917									nextCommand += 1;
   918								}
   919							}
   920						} else if (nextCommand == ApoBotConstants.REDYE) {
   921							if (this.getLevel().getLevel()[(int)this.getPlayer().getY()][(int)this.getPlayer().getX()].getGround() == ApoBotConstants.GROUND_EMPTY) {
   922								nextCommand += 1;
   923							}
   924						}
   925						this.nextCommand(nextCommand);
   926					}
   927				}
   928			} else if (this.bEditor) {
   929				
   930			} else {
   931				this.thinkMove(delta);
   932			}
   933		}
   934	
   935		/**
   936		 * wird aufgerufen um den Spieler im TUtorial und Spiel zu bewegen
   937		 * @param delta
   938		 */
   939		protected void thinkMove(int delta) {
   940			if (super.isBWin()) {
   941				// wenn das Level gewonnen wurde dann springt der Spieler in der Auswertung hoch und runter
   942				// darum k�mmert sich das hier :D
   943				if (this.bWinUp) {
   944					this.winUp += (float)delta * 0.05f;
   945					if (this.winUp >= 16) {
   946						this.bWinUp = false;
   947					}
   948				} else {
   949					this.winUp -= (float)delta * 0.05f;
   950					if (this.winUp <= 0) {
   951						this.bWinUp = true;
   952					}
   953				}
   954				return;
   955			}
   956			// fals gelaufen wird dann
   957			if (this.bGo) {
   958				// zentriere Kamera und f�hre Kommando aus bzw hole dir neuen Kommando
   959				this.centerCamera();
   960				if ((this.getPlayer().isBRun()) || (this.getPlayer().isBJump())) {
   961					this.getPlayer().think(delta);
   962					this.waitTime -= delta;
   963				} else {
   964					if (this.waitTime > 0) {
   965						this.waitTime -= delta;
   966					} else {
   967						int nextCommand = this.getNextCommand();
   968						if (nextCommand != -1) {
   969							this.levelSteps += 1;
   970							this.totalSteps += 1;
   971							this.curCommand = nextCommand;
   972							this.nextCommand(this.curCommand);
   973						} else {
   974							// falls es keinen Kommando mehr gibt dann �berpr�fe ob das Level gewonnen wurde
   975							if (this.isLevelWin()) {
   976								this.point = 1000 + (this.totalCommand - this.levelCommand) * 15 - this.levelSteps * 3;
   977								this.setBWin(true);
   978								this.bWinUp = true;
   979								this.winUp = 0;
   980							} else {
   981								this.stopGo();
   982							}
   983						}
   984					}
   985				}
   986			}
   987		}

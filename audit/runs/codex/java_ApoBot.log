   374		/**
   375		 * �berpr�ft, wenn sich 2 Entity per Rechteck schneiden,
   376		 * ob sie sich wirklich bildm��ig schneiden 
   377		 * @param entity = andere Entity zur Schnitt�berpr�fung
   378		 * @return TRUE wenn schneiden sich wirklich sonst FALSE
   379		 */
   380		public boolean checkOpaqueColorCollisions(ApoEntity entity) {
   381	
   382			Rectangle2D.Float cut = (Rectangle2D.Float)this.getRec().createIntersection(entity.getRec());
   383	
   384			if ((cut.width < 1) || (cut.height < 1)) {
   385				return false;
   386			}
   387	
   388			// Rechtecke in Bezug auf die jeweiligen Images
   389			Rectangle2D.Float sub_me = getSubRec(this.getRec(), cut);
   390			Rectangle2D.Float sub_him = getSubRec(entity.getRec(), cut);
   391	
   392			BufferedImage img_me = this.getIBackground().getSubimage((int) sub_me.x, (int) sub_me.y, (int) sub_me.width, (int) sub_me.height);
   393			BufferedImage img_him = entity.getIBackground().getSubimage((int) sub_him.x, (int) sub_him.y, (int) sub_him.width, (int) sub_him.height);
   394	
   395			for (int i = 0; i < img_me.getWidth(); i++) {
   396				for (int n = 0; n < img_him.getHeight(); n++) {
   397	
   398					int rgb1 = img_me.getRGB(i, n);
   399					int rgb2 = img_him.getRGB(i, n);
   400	
   401					if (isOpaque(rgb1) && isOpaque(rgb2)) {
   402						return true;
   403					}
   404	
   405				}
   406			}
   407	
   408			return false;
   409		}
   410	
   411		private Rectangle2D.Float getSubRec(Rectangle2D.Float source, Rectangle2D.Float part) {
   412	
   413			// Rechtecke erzeugen
   414			Rectangle2D.Float sub = new Rectangle2D.Float();
   415	
   416			// get X - compared to the Rectangle
   417			if (source.x > part.x) {
   418				sub.x = 0;
   419			} else {
   420				sub.x = part.x - source.x;
   421			}
   422	
   423			if (source.y > part.y) {
   424				sub.y = 0;
   425			} else {
   426				sub.y = part.y - source.y;
   427			}
   428	
   429			sub.width = part.width;
   430			sub.height = part.height;
   431	
   432			return sub;
   433		}
   434	
   435		/**
   436		 * �berpr�ft ob der �bergebene rgb Wert durchsichtig ist oder nicht
   437		 * @param rgb = zu �berpr�fender RGB Wert
   438		 * @return TRUE falls durchsichtig sonst FALSE
   439		 */
   440		private boolean isOpaque(int rgb) {
   441	
   442			int alpha = (rgb >> 24) & 0xff;
   443			// red = (rgb >> 16) & 0xff;
   444			// green = (rgb >> 8) & 0xff;
   445			// blue = (rgb ) & 0xff;
   446	
   447			if (alpha == 0) {
   448				return false;
   449			}
   450	
   451			return true;
   452		}

   128						if (level.getLevel()[y][x].getGround() == ApoBotConstants.GROUND_ORIGINAL) {
   129							g.drawImage(iTile.getSubimage(1 * 32 * ApoBotConstants.SIZE, 0 * ApoBotConstants.SIZE, 32 * ApoBotConstants.SIZE, 25 * ApoBotConstants.SIZE), myX, myY, null); 
   130						} else if (level.getLevel()[y][x].getGround() == ApoBotConstants.GROUND_GOAL) {
   131							g.drawImage(iTile.getSubimage(2 * 32 * ApoBotConstants.SIZE, 0 * ApoBotConstants.SIZE, 32 * ApoBotConstants.SIZE, 25 * ApoBotConstants.SIZE), myX, myY, null); 

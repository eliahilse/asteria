    73	
    74		/**
    75		 * setzt die Zeit, die der Timer immer wartet, auf den �bergebenen Wert
    76		 * @param wait
    77		 */
    78		public void setWait(long wait) {
    79			this.wait = wait;
    80		}
    81	
    82		/**
    83		 * startet den Timer mit der wait Time
    84		 */
    85		public void start()
    86		{
    87			if ( this.timer == null )
    88			{
    89				this.timer		= new Timer();
    90				this.timer.scheduleAtFixedRate( this, this.wait, this.wait );
    91				this.delta = System.nanoTime();
    92			}
    93		}
    94		
    95		/**
    96		 * stoppt den Timer
    97		 */
    98		public void stop()
    99		{
   100			if ( this.timer != null )
   101			{
   102				this.setBRunning( false );
   103				this.timer.cancel();
   104				this.timer		= null;
   105			}
   106		}
   107		
   108		/**
   109		 * gibt zur�ck, ob es gerade gewollt ist den Timer zu nutzen
   110		 * @return TRUE, falls Spiel grad l�uft sonst FALSE
   111		 */
   112		public boolean isBRunning()	{
   113			return this.bRunning;
   114		}
   115	
   116		/**
   117		 * setzt die boolean Variable, die daf�r verantwortlich ist, ob
   118		 * die Run-Methode des Timer l�uft, auf den �bergebenen Wert
   119		 * @param bRunning
   120		 */
   121		public void setBRunning( boolean bRunning )	{
   122			this.bRunning = bRunning;
   123		}
   124		
   125		/**
   126		 * gibt ein PseudoFramePerSecond wieder
   127		 * @return gibt ein PseudoFramePerSecond wieder
   128		 */
   129		public int getFps() {
   130			return (int)this.getWait();
   131		}
   132		
   133		@Override
   134		public void run()
   135		{
   136			if ( this.isBRunning() )
   137			{
   138				long delta = System.nanoTime();
   139				while ( delta - this.delta >= this.wait * 1000000 ) {
   140					this.delta += this.wait * 1000000;
   141					if (( this.game.isBThink()) && (this.isBWait())) {
   142						this.game.think( (int)this.wait );
   143					}
   144				}
   145				if ((this.game.isBRepaint()) && (this.isBRender())) {
   146					this.game.render();
   147				}
   148			}
   149		}

   115				for (int x = 0; x < level.getLevel()[0].length; x++) {
   116					for (int heightLevel = 0; heightLevel <= level.getLevel()[y][x].getHeight(); heightLevel++) {
   117						int myX = startX + x * w + y * w;
   118						int myY = startY - y * w/2 + x * w/2 - heightLevel * w/2;
   119						if (level.getLevel()[y][x].getGround() != ApoBotConstants.GROUND_REAL_EMPTY) {

   385		/**
   386		 * wird aufgerufen, wenn man im Spiel das Level wechselt (aber nicht von 1 zu 2 sondern von easy zu middle z.B.)
   387		 * @param next : int-Variable die entweder +1, 0 oder -1 ist
   388		 */
   389		private void nextLevelChange(int next) {
   390			if (this.curLevelString > -1) {
   391				this.totalSteps = 0;
   392				this.curLevelString += next;
   393				if (this.curLevelString >= ApoBotConstants.LEVELS.length) {
   394					this.curLevelString = 0;;
   395				} else if (this.curLevelString < 0) {
   396					this.curLevelString = ApoBotConstants.LEVELS.length - 1;
   397				}
   398				if (this.curLevelString == 3) {
   399					super.setCurLevel(0);
   400					if ((this.editor.getLevels() == null) || (this.editor.getLevels().size() <= 0)) {
   401						this.nextLevelChange(next);
   402						return;
   403					}
   404					this.io.setLevels(this.editor.getLevels());
   405					this.setLevel(this.io.getLevel(this.getCurLevel()));
   406				} else {
   407					if (ApoConstants.B_APPLET) {
   408						this.loadLevel(ApoBotComponent.APPLET_LEVEL + "/" + ApoBotConstants.LEVELS[this.curLevelString] + ".bot");
   409					} else {
   410						this.loadLevel(System.getProperty("user.dir") + File.separator + "levels" + File.separator + ApoBotConstants.LEVELS[this.curLevelString] + ".bot");
   411					}
   412					this.setLevel(this.io.getLevel(super.getCurLevel()));
   413				}
   414			}
   415		}
   416	
   417		/**
   418		 * wird aufgerufen, wenn man im Spiel das Level wechselt (z.B. von 1 zu 2)
   419		 * @param next : int-Variable die entweder +1, 0 oder -1 ist
   420		 */
   421		private void nextLevel(int next) {
   422			if (super.getCurLevel() > -1) {
   423				super.setCurLevel(super.getCurLevel() + next);
   424				if (super.getCurLevel() < 0) {
   425					super.setCurLevel(this.io.getMaxLevel() - 1);
   426				} else if (super.getCurLevel() >= this.io.getMaxLevel()) {
   427					super.setCurLevel(0);
   428				}
   429				this.setLevel(this.io.getLevel(super.getCurLevel()));
   430			}
   431		}

   261					int myX = startX + x * w + y * w;
   262					int myY = startY - y * w/2 + x * w/2;
   263					Polygon p = new Polygon();
   264					p.addPoint(myX + w, myY);
   265					p.addPoint(myX, myY + w / 2);
   266					p.addPoint(myX + w, myY + w);
   267					p.addPoint(myX + w * 2, myY + w /2);
   268					if (p.intersects(mouseX, mouseY, 1, 1)) {
   269						this.mouseClick(x, y, e.getButton());
   270						break;
   271					}
   272				}
   273			}
   274		}

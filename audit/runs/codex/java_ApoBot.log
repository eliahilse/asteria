    11	
    12	/**
    13	 * Klasse, die sich um das Laden und SPeichern von Levels k�mmert
    14	 * @author Dirk Aporius
    15	 *
    16	 */
    17	public class ApoBotLevelIO extends ApoIO {
    18	
    19		private ArrayList<ApoBotLevel> levels;
    20		
    21		public ApoBotLevelIO() {
    22			this.levels = new ArrayList<ApoBotLevel>();
    23		}
    24		
    25		public ApoBotLevel getLevel(int level) {
    26			if ((level < 0) || (level >= this.levels.size())) {
    27				return null;
    28			}
    29			return this.levels.get(level);
    30		}
    31		
    32		public int getMaxLevel() {
    33			return this.levels.size();
    34		}
    35		
    36		public ArrayList<ApoBotLevel> getLevels() {
    37			return this.levels;
    38		}
    39	
    40		public void setLevels(ArrayList<ApoBotLevel> levels) {
    41			this.levels = levels;
    42		}
    43	
    44		public void addLevel(ApoBotLevel level, int position) {
    45			if ((position <= -1) || (position >= this.levels.size())) {
    46				this.levels.add(level);
    47			} else {
    48				this.levels.add(position, level);
    49			}
    50		}
    51	
    52		public void changeLevel(int position, int next) {
    53			ApoBotLevel level = this.levels.get(position);
    54			this.levels.remove(position);
    55			if (position + next < 0) {
    56				this.levels.add(level);
    57			} else if (position + next >= this.levels.size()) {
    58				this.levels.add(0, level);
    59			} else {
    60				this.levels.add(position + next, level);
    61			}
    62		}
    63		
    64		public void removeLevel(ApoBotLevel level) {
    65			this.levels.remove(level);
    66		}
    67		
    68		public void removeLevel(int position) {
    69			this.levels.remove(position);
    70		}
    71		
    72		@Override
    73		public boolean readLevel(DataInputStream data) throws EOFException,IOException {
    74			this.levels = new ArrayList<ApoBotLevel>();
    75			int size = data.readInt();
    76			for (int i = 0; i < size; i++) {
    77				int ySize = data.readInt();
    78				int xSize = data.readInt();
    79				ApoBotLevelLevel[][] levelLevel = new ApoBotLevelLevel[ySize][xSize];
    80				for (int y = 0; y < ySize; y++) {
    81					for (int x = 0; x < xSize; x++) {
    82						int ground = data.readInt();
    83						int height = data.readInt();
    84						levelLevel[y][x] = new ApoBotLevelLevel(ground, height);
    85					}
    86				}
    87				
    88				int xPoint = data.readInt();
    89				int yPoint = data.readInt();
    90				
    91				int directionView = data.readInt();
    92				
    93				int menuSize = data.readInt();
    94				int[] menu = new int[menuSize];
    95				for (int m = 0; m < menuSize; m++) {
    96					menu[m] = data.readInt();
    97				}
    98			this.levels.add(new ApoBotLevel(levelLevel, new Point(xPoint, yPoint), directionView, menu));	
    99			}
   100			return true;
   101		}
   102	
   103		@Override
   104		public boolean writeLevel(DataOutputStream data) throws IOException {
   105			if ((this.levels == null) && (this.levels.size() <= 0)) {
   106				return false;
   107			}
   108			data.writeInt(this.levels.size());
   109			for (int i = 0; i < this.levels.size(); i++) {
   110				ApoBotLevelLevel[][] levelLevel = this.levels.get(i).getLevel();
   111				data.writeInt(levelLevel.length);
   112				data.writeInt(levelLevel[0].length);
   113				for (int y = 0; y < levelLevel.length; y++) {
   114					for (int x = 0; x < levelLevel[0].length; x++) {
   115						data.writeInt(levelLevel[y][x].getGround());
   116						data.writeInt(levelLevel[y][x].getHeight());
   117					}
   118				}
   119				data.writeInt(this.levels.get(i).getStartPoint().x);
   120				data.writeInt(this.levels.get(i).getStartPoint().y);
   121				
   122				data.writeInt(this.levels.get(i).getDirectionView());
   123				
   124				data.writeInt(3);
   125				data.writeInt(this.levels.get(i).getCommandsMenu());
   126				data.writeInt(this.levels.get(i).getFunctionsOneMenu());
   127				data.writeInt(this.levels.get(i).getFunctionsTwoMenu());
   128			}
   129			return true;
   130		}
   131	
   132	}

   218		public static String getTimeToDraw(int time) {
   219			if (time <= 0)
   220				return "";
   221			String min = String.valueOf(time/1000/60);
   222			String sec = ""+((time/1000)%60);
   223			String msec = ""+((time/10)%100);
   224			if (sec.length()<2) sec = "0"+sec;
   225			if (msec.length()<2) msec = "0"+msec;
   226			String timeString = min+":"+sec+":"+msec;
   227			
   228			return timeString;
   229		}

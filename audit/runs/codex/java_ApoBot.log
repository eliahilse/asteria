    44		 * @param bWait : TRUE, es soll gedacht werden, sonst FALSE
    45		 */
    46		public void setBWait(boolean bWait) {
    47			this.bWait = bWait;
    48		}
    49	
    50		/**
    51		 * gibt zur�ck, ob gemalt werden soll
    52		 * @return TRUE, es soll gemalt werden, sonst FALSE
    53		 */
    54		public boolean isBRender() {
    55			return bRender;
    56		}
    57	
    58		/**
    59		 * setzt den Wert, ob gedacht werden soll, auf den �bergebenen
    60		 * @param bRender : TRUE, es soll gedacht werden, sonst FALSE
    61		 */
    62		public void setBRender(boolean bRender) {
    63			this.bRender = bRender;

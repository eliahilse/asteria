   474			} else {
   475				int x = e.getX();
   476				int y = e.getY();
   477				this.levelCommand = 0;
   478				if (e.getButton() == MouseEvent.BUTTON3) {
   479					// l�scht wieder die Kommandos wenn die Maus dr�ber ist und die rechte Maustaste gedr�ckt wurde
   480					for (int i = 0; i < this.mainCommands.length; i++) {
   481						if (this.mainCommands[i].intersects(x, y)) {
   482							this.mainCommands[i].setCommand(-1);
   483						}
   484						if (this.mainCommands[i].getCommand() != -1) {
   485							this.levelCommand += 1;
   486						}
   487					}
   488					for (int i = 0; i < this.functionOneCommands.length; i++) {
   489						if (this.functionOneCommands[i].intersects(x, y)) {
   490							this.functionOneCommands[i].setCommand(-1);
   491						}
   492						if (this.functionOneCommands[i].getCommand() != -1) {
   493							this.levelCommand += 1;
   494						}
   495					}
   496					for (int i = 0; i < this.functionTwoCommands.length; i++) {
   497						if (this.functionTwoCommands[i].intersects(x, y)) {
   498							this.functionTwoCommands[i].setCommand(-1);
   499						}
   500						if (this.functionTwoCommands[i].getCommand() != -1) {
   501							this.levelCommand += 1;
   502						}
   503					}
   504				} else if (e.getButton() == MouseEvent.BUTTON1) {
   505					// setzt das Kommando wenn die Maus �ber dem Kommando ist
   506					// entweder wenn es per Drag and Drop gezogen wird
   507					// sonst wird das derzeit gehighlighte Kommado genommen
   508					int command = -1;
   509					if (this.curFunction != null) {
   510						if (this.curFunction.equals("forward")) {
   511							command = ApoBotConstants.FORWARD;
   512						} else if (this.curFunction.equals("left")) {
   513							command = ApoBotConstants.LEFT;
   514						} else if (this.curFunction.equals("right")) {
   515							command = ApoBotConstants.RIGHT;
   516						} else if (this.curFunction.equals("jump")) {
   517							command = ApoBotConstants.JUMP;
   518						} else if (this.curFunction.equals("redye")) {
   519							command = ApoBotConstants.REDYE;
   520						} else if (this.curFunction.equals("functionOne")) {
   521							command = ApoBotConstants.FUNCTION_ONE;
   522						} else if (this.curFunction.equals("functionTwo")) {
   523							command = ApoBotConstants.FUNCTION_TWO;
   524						}
   525					}
   526					for (int i = 0; i < this.mainCommands.length; i++) {
   527						if (this.mainCommands[i].intersects(x, y)) {
   528							if ((command == -1) && (this.mainCommands[i].getCommand() == -1)) {
   529								this.mainCommands[i].setCommand(this.curCommandDraw);
   530							} else {
   531								if ((this.mouseX != -1) && (this.mouseY != -1)) {
   532									this.mainCommands[i].setCommand(command);
   533								}
   534								this.mouseX = -1;
   535								this.mouseY = -1;
   536							}
   537							//return;
   538						}
   539						if (this.mainCommands[i].getCommand() != -1) {
   540							this.levelCommand += 1;
   541						}
   542					}
   543					for (int i = 0; i < this.functionOneCommands.length; i++) {
   544						if (this.functionOneCommands[i].intersects(x, y)) {
   545							if ((command == -1) && (this.functionOneCommands[i].getCommand() == -1)) {
   546								this.functionOneCommands[i].setCommand(this.curCommandDraw);
   547							} else {
   548								if ((this.mouseX != -1) && (this.mouseY != -1)) {
   549									if (command != ApoBotConstants.FUNCTION_ONE) {
   550										this.functionOneCommands[i].setCommand(command);
   551									} else {
   552										this.functionOneCommands[i].setCommand(-1);
   553									}
   554									this.mouseX = -1;
   555									this.mouseY = -1;
   556								}
   557							}
   558							//return;
   559						}
   560						if (this.functionOneCommands[i].getCommand() != -1) {
   561							this.levelCommand += 1;
   562						}
   563					}
   564					for (int i = 0; i < this.functionTwoCommands.length; i++) {
   565						if (this.functionTwoCommands[i].intersects(x, y)) {
   566							if ((command == -1) && (this.functionTwoCommands[i].getCommand() == -1)) {
   567								this.functionTwoCommands[i].setCommand(this.curCommandDraw);
   568							} else {
   569								if ((this.mouseX != -1) && (this.mouseY != -1)) {

   872		private boolean isLevelWin() {
   873			for (int y = 0; y < this.getLevel().getLevel().length; y++) {
   874				for (int x = 0; x < this.getLevel().getLevel()[0].length; x++) {
   875					if (this.getLevel().getLevel()[y][x].getGround() == ApoBotConstants.GROUND_ORIGINAL) {

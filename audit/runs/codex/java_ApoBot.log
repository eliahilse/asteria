   433		/**
   434		 * wird aufgerufen, wenn das Mausrad bewegt wird
   435		 */
   436		public void mouseWheelMoved(MouseWheelEvent e) {
   437			int change = e.getWheelRotation();
   438			this.curCommandDraw += change;
   439			if (this.curCommandDraw < ApoBotConstants.FORWARD) {
   440				this.curCommandDraw = ApoBotConstants.FUNCTION_TWO;
   441				if (this.functionTwoCommands.length <= 0) {
   442					this.curCommandDraw = ApoBotConstants.FUNCTION_ONE;
   443					if (this.functionOneCommands.length <= 0) {
   444						this.curCommandDraw = ApoBotConstants.REDYE;				
   445					}
   446				}
   447			} else if (this.curCommandDraw > ApoBotConstants.FUNCTION_TWO) {
   448				this.curCommand = ApoBotConstants.FORWARD;
   449			}
   450			if (this.curCommandDraw >= ApoBotConstants.FUNCTION_ONE) {
   451				if (this.curCommandDraw == ApoBotConstants.FUNCTION_ONE) {
   452					if (this.functionOneCommands.length <= 0) {
   453						this.curCommandDraw = ApoBotConstants.FUNCTION_TWO;				
   454					}
   455				}
   456				if (this.curCommandDraw == ApoBotConstants.FUNCTION_TWO) {
   457					if (this.functionTwoCommands.length <= 0) {
   458						this.curCommandDraw = ApoBotConstants.FORWARD;				
   459					}
   460				}
   461			}
   462			if (this.curCommandDraw > ApoBotConstants.FUNCTION_TWO) {
   463				this.curCommandDraw = ApoBotConstants.FORWARD;
   464			}
   465		}

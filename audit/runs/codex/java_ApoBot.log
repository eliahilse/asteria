   607		private void renderTile(Graphics2D g, int x, int y, int startX, int startY, int heightLevel) {
   608			int w = 16 * ApoBotConstants.SIZE;
   609			int myX = startX + x * w + y * w;
   610			int myY = startY - y * w/2 + x * w/2 - heightLevel * w/2;
   611			if ((myY + 30 < 0) || (myY - 5 > ApoBotConstants.GAME_GAME_HEIGHT) || 
   612				(myX + 35 < 0) || (myX - 5 > ApoBotConstants.GAME_WIDTH) ) {
   613				return;
   614			}
   615			if ((level.getLevel()[y][x].getGround() != ApoBotConstants.GROUND_REAL_EMPTY) && (heightLevel > 0)) {
   616				if (y % 2 == 0) {
   617					g.drawImage(iTile.getSubimage(0 * 32 * ApoBotConstants.SIZE, 0, 32 * ApoBotConstants.SIZE, 25 * ApoBotConstants.SIZE), myX, myY, null); 
   618				} else {
   619					g.drawImage(iTile.getSubimage(4 * 32 * ApoBotConstants.SIZE, 0, 32 * ApoBotConstants.SIZE, 25 * ApoBotConstants.SIZE), myX, myY, null);
   620				}
   621			}
   622			if (level.getLevel()[y][x].getGround() == ApoBotConstants.GROUND_ORIGINAL) {
   623				g.drawImage(this.iTile.getSubimage(1 * 32 * ApoBotConstants.SIZE, 0, 32 * ApoBotConstants.SIZE, 25 * ApoBotConstants.SIZE), myX, myY, null); 
   624			} else if (level.getLevel()[y][x].getGround() == ApoBotConstants.GROUND_GOAL) {
   625				g.drawImage(this.iTile.getSubimage(2 * 32 * ApoBotConstants.SIZE, 0, 32 * ApoBotConstants.SIZE, 25 * ApoBotConstants.SIZE), myX, myY, null); 
   626			}
   627		}

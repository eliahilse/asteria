  1025		/**
  1026		 * �berpr�ft, ob ein Spieler geradeaus laufen darf oder nicht
  1027		 * @return TRUE; SPieler darf laufen, sonst FALSE
  1028		 */
  1029		private boolean canPlayerRun() {
  1030			int x = (int)this.getPlayer().getX();
  1031			int y = (int)this.getPlayer().getY();
  1032			int height = this.getLevel().getLevel()[y][x].getHeight();
  1033			if (this.getPlayer().getCurDir() == ApoBotConstants.DIR_SOUTH_DOWNRIGHT) {
  1034				x += 1;
  1035			} else if (this.getPlayer().getCurDir() == ApoBotConstants.DIR_NORTH_UPLEFT) {
  1036				x -= 1;
  1037			} else if (this.getPlayer().getCurDir() == ApoBotConstants.DIR_WEST_DOWNLEFT) {
  1038				y -= 1;
  1039			} else if (this.getPlayer().getCurDir() == ApoBotConstants.DIR_EAST_UPRIGHT) {
  1040				y += 1;
  1041			}
  1042			if ((x < 0) || (y < 0) || (x >= this.getLevel().getLevel()[0].length) || (y >= this.getLevel().getLevel().length)) {
  1043				return false;
  1044			} else if (this.getLevel().getLevel()[y][x].getGround() == ApoBotConstants.GROUND_REAL_EMPTY) {
  1045				return false;
  1046			}
  1047			if (height == this.getLevel().getLevel()[y][x].getHeight()) {
  1048				return true;
  1049			} else {
  1050				return false;
  1051			}
  1052		}
  1053	
  1054		/**
  1055		 * gibt zur�ck, ob ein Spieler springen darf oder nicht
  1056		 * @return TRUE; Spieler kann eine Stufe h�her springen oder viel tiefer, sonst FALSE (springt auf der Stelle)
  1057		 */
  1058		private boolean canPlayerJump() {
  1059			int x = (int)this.getPlayer().getX();
  1060			int y = (int)this.getPlayer().getY();
  1061			int height = this.getLevel().getLevel()[y][x].getHeight();
  1062			if (this.getPlayer().getCurDir() == ApoBotConstants.DIR_SOUTH_DOWNRIGHT) {
  1063				x += 1;
  1064			} else if (this.getPlayer().getCurDir() == ApoBotConstants.DIR_NORTH_UPLEFT) {
  1065				x -= 1;
  1066			} else if (this.getPlayer().getCurDir() == ApoBotConstants.DIR_WEST_DOWNLEFT) {
  1067				y -= 1;
  1068			} else if (this.getPlayer().getCurDir() == ApoBotConstants.DIR_EAST_UPRIGHT) {
  1069				y += 1;
  1070			}
  1071			if ((x < 0) || (y < 0) || (x >= this.getLevel().getLevel()[0].length) || (y >= this.getLevel().getLevel().length)) {
  1072				return false;
  1073			} else if (this.getLevel().getLevel()[y][x].getGround() == ApoBotConstants.GROUND_REAL_EMPTY) {
  1074				return false;
  1075			}
  1076			if ((height + 1 >= this.getLevel().getLevel()[y][x].getHeight()) && (height != this.getLevel().getLevel()[y][x].getHeight())) {
  1077				this.getPlayer().setJumpHeight((this.getLevel().getLevel()[y][x].getHeight() - height) * 8);
  1078				return true;
  1079			} else {
  1080				return false;
  1081			}
  1082		}

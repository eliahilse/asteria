    64				URL url;
    65				if ( !ApoConstants.B_APPLET )
    66					url = new File( this.getPath() ).toURI().toURL();
    67				else
    68					url = new URL( this.getPath() );
    69				URLClassLoader cl = new URLClassLoader( new URL[] { url } ); 
    70				Class<?> c;
    71				try {
    72					//System.out.println( this.getPath() + "" + this.getClassname() );
    73					c = cl.loadClass( this.getClassname() );
    74				    try {
    75						return c.newInstance();

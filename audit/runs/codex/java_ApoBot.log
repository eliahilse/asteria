     8	 * bestimmten Reihenfolge abl�uft
     9	 * @author Dirk Aporius
    10	 *
    11	 */
    12	public class ApoTimer extends TimerTask
    13	{
    14		private ApoTimerInterface	game;
    15		private boolean				bRunning;
    16		private boolean				bWait;
    17		private boolean				bRender;
    18		private long 				wait;
    19		private long				delta;

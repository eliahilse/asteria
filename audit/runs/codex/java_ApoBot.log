  1126		private void renderFPS(Graphics2D g, float renderTime) {
  1127			g.setColor(Color.black);
  1128			g.setFont(ApoBotConstants.FONT_MENU);
  1129			if (this.bShowFps) {
  1130				super.renderFPS(g, 5, 105);
  1131				g.drawString(""+renderTime, 5, 125);
  1132			}
  1133			// nun kommt die Berechnung, ob die FPS erh�ht werden d�rfen oder nicht
  1134			this.waitTimeRender.add(renderTime);
  1135			if (this.waitTimeRender.size() > 3000 / super.getWAIT_TIME_RENDER()) {
  1136				float all = 0;
  1137				for (int i = 0; i < this.waitTimeRender.size(); i++) {
  1138					all += this.waitTimeRender.get(i);
  1139				}
  1140				if (all / this.waitTimeRender.size() > super.getWAIT_TIME_RENDER()) {
  1141					super.setWAIT_TIME_RENDER((int)(all / this.waitTimeRender.size() + 2));
  1142				} else if ((all / this.waitTimeRender.size() < super.getWAIT_TIME_RENDER() - this.FPS_COUNT - 1) &&
  1143							(super.getWAIT_TIME_RENDER() - this.FPS_COUNT >= 20)){
  1144					super.setWAIT_TIME_RENDER(super.getWAIT_TIME_RENDER() - this.FPS_COUNT);
  1145				} else if ((all / this.waitTimeRender.size() < super.getWAIT_TIME_RENDER() - this.FPS_COUNT - 1)){
  1146					super.setWAIT_TIME_RENDER(20);
  1147				}
  1148				this.waitTimeRender.clear();
  1149			}
  1150		}

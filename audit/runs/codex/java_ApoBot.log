   591		public void mousePressed(MouseEvent e) {
   592			if (super.isBWin()) {
   593				this.nextLevel(+1);
   594				return;
   595			}
   596			super.mousePressed(e);
   597			if (!this.bGo) {
   598				if (e.getButton() == MouseEvent.BUTTON1) {
   599					this.mouseX = e.getX();
   600					this.mouseY = e.getY();
   601					for (int i = 5; i < 12; i++) {
   602						if (super.getButtons()[i].isBPressed()) {
   603							this.iMouse = super.getButtons()[i].getIBackground().getSubimage(0, 0, (int)(super.getButtons()[i].getWidth()), (int)(super.getButtons()[i].getHeight()));
   604							this.curFunction = super.getButtons()[i].getFunction();
   605							return;
   606						}
   607					}
   608					// setzt das gehighlight Kommando auf den Wert wo die Maus grad ist
   609					for (int i = 0; i < this.mainCommands.length; i++) {
   610						if ((this.mainCommands[i].intersects(this.mouseX, this.mouseY)) && (this.mainCommands[i].getCommand() != -1)) {
   611							this.iMouse = super.getButtons()[this.mainCommands[i].getCommand() + 5].getIBackground().getSubimage(0, 0, (int)(super.getButtons()[this.mainCommands[i].getCommand() + 5].getWidth()), (int)(super.getButtons()[this.mainCommands[i].getCommand() + 5].getHeight()));
   612							this.curFunction = super.getButtons()[this.mainCommands[i].getCommand() + 5].getFunction();
   613							this.mainCommands[i].setCommand(-1);
   614							return;
   615						}
   616					}
   617					for (int i = 0; i < this.functionOneCommands.length; i++) {
   618						if ((this.functionOneCommands[i].intersects(this.mouseX, this.mouseY)) && (this.functionOneCommands[i].getCommand() != -1)) {
   619							this.iMouse = super.getButtons()[this.functionOneCommands[i].getCommand() + 5].getIBackground().getSubimage(0, 0, (int)(super.getButtons()[this.functionOneCommands[i].getCommand() + 5].getWidth()), (int)(super.getButtons()[this.functionOneCommands[i].getCommand() + 5].getHeight()));
   620							this.curFunction = super.getButtons()[this.functionOneCommands[i].getCommand() + 5].getFunction();
   621							this.functionOneCommands[i].setCommand(-1);
   622							return;
   623						}
   624					}
   625					for (int i = 0; i < this.functionTwoCommands.length; i++) {
   626						if ((this.functionTwoCommands[i].intersects(this.mouseX, this.mouseY)) && (this.functionTwoCommands[i].getCommand() != -1)) {
   627							this.iMouse = super.getButtons()[this.functionTwoCommands[i].getCommand() + 5].getIBackground().getSubimage(0, 0, (int)(super.getButtons()[this.functionTwoCommands[i].getCommand() + 5].getWidth()), (int)(super.getButtons()[this.functionTwoCommands[i].getCommand() + 5].getHeight()));
   628							this.curFunction = super.getButtons()[this.functionTwoCommands[i].getCommand() + 5].getFunction();
   629							this.functionTwoCommands[i].setCommand(-1);
   630							return;
   631						}
   632					}
   633					this.mouseX = -1;

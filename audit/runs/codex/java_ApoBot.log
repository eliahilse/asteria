   289		@Override
   290		public void setKeyFunction(int function) {
   291			if (this.bTutorial) {
   292				this.tutorial.keyPressed(function);
   293			}
   294			if (function == KeyEvent.VK_F) {
   295				this.bShowFps = !this.bShowFps;
   296			}
   297			if ((this.bTutorial) || (this.bGame) || (this.bEditor)) {
   298				// �berpr�ft, ob gescrollt werden kann mit den Pfeiltasten
   299				int w = 16 * ApoBotConstants.SIZE;
   300				if ((function == KeyEvent.VK_LEFT) || (function == KeyEvent.VK_RIGHT)) {
   301					if (super.isLevelToWidth()) {
   302						if (function == KeyEvent.VK_LEFT) {
   303							super.setCurX(this.getCurX() + 3);
   304						} else if (function == KeyEvent.VK_RIGHT) {
   305							super.setCurX(this.getCurX() - 3);
   306						}
   307						if (this.getCurX() + this.getCurWidth() - 1 * w / 2 >= this.getLevelWidth()) {
   308							this.setCurX(this.getLevelWidth() - this.getCurWidth() + 1 * w / 2 - 1);
   309						}
   310						if (this.getCurX() < -1 * w/2) {
   311							this.setCurX(-1 * w/2 + 1);
   312						}
   313					}
   314				} else if ((function == KeyEvent.VK_DOWN) || (function == KeyEvent.VK_UP)) {
   315					if (super.isLevelToHeight()) {
   316						if (function == KeyEvent.VK_UP) {
   317							super.setCurY(this.getCurY() + 3);
   318						} else if (function == KeyEvent.VK_DOWN) {
   319							super.setCurY(this.getCurY() - 3);
   320						}
   321						if (this.getCurY() + this.getCurHeight() - 2 * w >= this.getLevelHeight()) {
   322							this.setCurY(this.getLevelHeight() - this.getCurHeight() + 2 * w - 1);
   323						}
   324						if (this.getCurY() < -2 * w) {
   325							this.setCurY(-2 * w + 1);
   326						}
   327					}
   328				}
   329			}
   330		}

   682		/**
   683		 * sucht den n�chsten Kommando der gew�hlt wird
   684		 * @return n�chster Kommando
   685		 */
   686		private int getNextCommand() {
   687			int command = -1;
   688			if (this.curInMethod == 1) {
   689				if (curFunctionOneCommand >= this.functionOneCommands.length) {
   690					this.curFunctionOneCommand = -1;
   691					this.curFunctionTwoCommand = -1;
   692					this.curInMethod = 0;
   693					return this.getNextCommand();
   694				}
   695				command = this.functionOneCommands[this.curFunctionOneCommand].getCommand();
   696				//System.out.println("curInMethod "+this.curInMethod+" command: "+command);
   697				if (command == ApoBotConstants.FUNCTION_ONE) {
   698					this.curInMethod = 1;
   699					this.curFunctionOneCommand = 0;
   700				} else if (command == ApoBotConstants.FUNCTION_TWO) {
   701					this.curInMethod = 2;
   702					this.curFunctionTwoCommand = 0;
   703					this.curFunctionOneCommand += 1;
   704				} else if (this.curFunctionOneCommand + 1 >= this.functionOneCommands.length) {
   705					this.curFunctionOneCommand = -1;
   706					if (this.curFunctionTwoCommand < 0) {
   707						this.curInMethod = 0;
   708					} else {
   709						this.curInMethod = 2;
   710					}
   711				} else {
   712					this.curFunctionOneCommand += 1;				
   713				}
   714			} else if (this.curInMethod == 2) {
   715				if (curFunctionTwoCommand >= this.functionTwoCommands.length) {
   716					this.curFunctionOneCommand = -1;
   717					this.curFunctionTwoCommand = -1;
   718					this.curInMethod = 0;
   719					return this.getNextCommand();
   720				}
   721				command = this.functionTwoCommands[this.curFunctionTwoCommand].getCommand();
   722				if (command == ApoBotConstants.FUNCTION_ONE) {
   723					this.curInMethod = 1;
   724					this.curFunctionOneCommand = 0;
   725					this.curFunctionTwoCommand += 1;
   726				} else if (command == ApoBotConstants.FUNCTION_TWO) {
   727					this.curInMethod = 2;
   728					this.curFunctionTwoCommand = 0;
   729				} else if (this.curFunctionTwoCommand + 1 >= this.functionTwoCommands.length) {
   730					this.curInMethod = 0;
   731					this.curFunctionTwoCommand = -1;
   732					if (this.curFunctionOneCommand < 0) {
   733						this.curInMethod = 0;
   734					} else {
   735						this.curInMethod = 1;
   736					}
   737				} else {
   738					this.curFunctionTwoCommand += 1;
   739				}
   740			} else if (this.curInMethod == 0) {
   741				if (this.curMainCommand >= this.mainCommands.length) {
   742					this.curFunctionOneCommand = -1;
   743					this.curFunctionTwoCommand = -1;
   744					return -1;
   745				}
   746				command = this.mainCommands[this.curMainCommand].getCommand();
   747				if (command == ApoBotConstants.FUNCTION_ONE) {
   748					this.curFunctionOneCommand = 0;
   749					this.curInMethod = 1;
   750					this.curMainCommand += 1;
   751				} else if (command == ApoBotConstants.FUNCTION_TWO) {
   752					this.curInMethod = 2;
   753					this.curFunctionTwoCommand = 0;
   754					this.curMainCommand += 1;
   755				} else if (this.curMainCommand + 1 > this.mainCommands.length) {
   756					this.curFunctionOneCommand = -1;
   757					this.curFunctionTwoCommand = -1;
   758					return -1;
   759				} else {
   760					this.curMainCommand += 1;
   761				}
   762			}
   763			if (command == -1) {
   764				return this.getNextCommand();
   765			}
   766			return command;
   767		}

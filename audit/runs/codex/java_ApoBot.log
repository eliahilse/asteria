    26		/**
    27		 * erste Methode um ein Bild zu drehen, bei Angabe des Winkels
    28		 * funktioniert nur perfekt bei Bildern, deren Ma�e width = height ist
    29		 * @param src = Bilder welches gedreht werden soll
    30		 * @param degrees = Winkelangabe
    31		 * @return gedrehtes Bild
    32		 */
    33		public static BufferedImage rotateImage(BufferedImage src, double degrees) {
    34			AffineTransform affineTransform = AffineTransform.getRotateInstance( Math.toRadians(degrees), src.getWidth() / 2, src.getHeight() / 2);
    35			BufferedImage rotatedImage = new BufferedImage(src.getWidth(), src.getHeight(), src.getType());
    36			Graphics2D g = (Graphics2D)rotatedImage.getGraphics();
    37			g.setTransform( affineTransform );
    38			g.drawImage( src, 0, 0, null );
    39			g.dispose();
    40			return rotatedImage;
    41		}
    42		
    43		/**
    44		 * erste Methode um ein Bild zu drehen, bei Angabe des Winkels
    45		 * funktioniert bei allen Bildern
    46		 * @param inputImage = Bilder welches gedreht werden soll
    47		 * @param degrees = Winkelangabe
    48		 * @return gedrehtes Bild
    49		 */
    50		public static BufferedImage rotateImageMethodTwo(BufferedImage inputImage, double degrees ) {
    51			int x,y = 0;
    52			
    53			if ((degrees == 0)||(degrees == 180)||(degrees == 360)){
    54				x = inputImage.getWidth(null);
    55				y = inputImage.getHeight(null);
    56			} else {
    57				x = inputImage.getHeight(null);
    58				y = inputImage.getWidth(null);
    59			}
    60			BufferedImage sourceBI = new BufferedImage(x, y, BufferedImage.TRANSLUCENT);
    61			AffineTransform at = new AffineTransform();
    62	
    63			// rotate around image center
    64			at.rotate(Math.toRadians( degrees ), (sourceBI.getWidth() / 2), (sourceBI.getHeight() / 2) );
    65	
    66		    /*
    67		     * translate to make sure the rotation doesn't cut off any image data
    68		     */
    69			AffineTransform translationTransform;
    70			translationTransform = findTranslation( at, sourceBI, degrees );
    71			at.preConcatenate( translationTransform );
    72	
    73	
    74			Graphics2D g = (Graphics2D) sourceBI.getGraphics();
    75			g.setTransform(at);
    76			g.drawImage(inputImage, 0, 0, null);
    77	
    78			return sourceBI;
    79		}
    80	
    81		/**
    82		 * find proper translations to keep rotated image correctly displayed
    83		 * @param at = AffineTransformObjekt
    84		 * @param bi = BufferedImage
    85		 * @param degrees = Winkel
    86		 * @return korrekte AffineTransform
    87		 */
    88		private static AffineTransform findTranslation(AffineTransform at, BufferedImage bi, double degrees ) {
    89			Point2D p2din, p2dout;
    90			double ytrans, xtrans = 0.0;
    91	
    92			AffineTransform tat = new AffineTransform();
    93	
    94			if(degrees == 180) {
    95				p2din = new Point2D.Double(0, bi.getHeight());
    96			} else {
    97				p2din = new Point2D.Double(0.0, 0.0);
    98			}
    99	
   100			p2dout = at.transform(p2din, null);
   101	
   102			if(degrees == 270) {
   103				xtrans = p2dout.getX();
   104				ytrans = xtrans;
   105			} else {
   106				ytrans = p2dout.getY();
   107				xtrans = ytrans;
   108			}
   109	
   110			tat.translate(-xtrans, -ytrans);
   111	
   112			return tat;
   113		}

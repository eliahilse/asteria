   142		public BufferedImage getButtonWithImage(int width, int height, BufferedImage iPic, Color background, Color border, Color mousePressed, Color mouseReleased) {
   143			BufferedImage iButton = GraphicsEnvironment.getLocalGraphicsEnvironment().getDefaultScreenDevice().getDefaultConfiguration().createCompatibleImage(width,height,BufferedImage.TRANSLUCENT);
   144			Graphics2D g = (Graphics2D)iButton.getGraphics();
   145			
   146			g.setRenderingHint(RenderingHints.KEY_ANTIALIASING, RenderingHints.VALUE_ANTIALIAS_ON);
   147			
   148			int oneWidth = width/3;
   149			int widthPic = 0;
   150			if (iPic != null) {
   151				widthPic = iPic.getWidth();
   152			}
   153			
   154			for ( int i = 0; i < 3; i++ ) {
   155				g.setColor( background );
   156				g.fillRoundRect( (width)/3 * i, 0, (width)/3 - 1, height - 1, 5, 5 );
   157				
   158				if (iPic != null) {
   159					g.drawImage(iPic, oneWidth * i + oneWidth/2 - widthPic/2, height/2 - iPic.getHeight()/2, null);
   160				}
   161				if (i == 0) {
   162					g.setColor(background);
   163				} else if (i == 1) {
   164					g.setColor(mousePressed);
   165				} else {
   166					g.setColor(mouseReleased);
   167				}
   168				g.drawRoundRect((width)/3 * i + 1, 1, (width)/3 - 3, height - 3, 5, 5);
   169				
   170				g.setColor(border);
   171				g.drawRoundRect((width)/3 * i, 0, (width)/3 - 1, height - 1, 5, 5);
   172			}
   173			
   174			g.dispose();
   175			return iButton;
   176		}

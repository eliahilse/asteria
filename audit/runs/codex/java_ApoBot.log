   136			Graphics2D g = (Graphics2D)iButton.getGraphics();
   137			
   138			g.setRenderingHint(RenderingHints.KEY_ANTIALIASING, RenderingHints.VALUE_ANTIALIAS_ON);
   139			
   140			Font fontOkButton = writeFont;
   141			int h = g.getFontMetrics().getHeight();
   142			

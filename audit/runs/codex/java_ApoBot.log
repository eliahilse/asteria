    21		
    22		public ApoTimer( ApoTimerInterface game, long wait ) {
    23			super();
    24			
    25			this.game		= game;
    26			this.wait		= wait;
    27			
    28			this.bRunning	= true;
    29			
    30			this.setBWait(true);
    31			this.setBRender(true);
    32		}
    33	
    34		/**
    35		 * gibt zur�ck, ob gedacht werden soll
    36		 * @return TRUE, es soll gedacht werden, sonst FALSE
    37		 */
    38		public boolean isBWait() {
    39			return this.bWait;
    40		}
    41	
    42		/**

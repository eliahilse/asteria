   332		@Override
   333		public void setMouseFunction(String function) {
   334			if (function.equals("quit")) {
   335				System.exit(0);
   336			} else if (function.equals("menu")) {
   337				this.setMenu();
   338			} else if (function.equals("game")) {
   339				this.setGame();
   340			} else if (function.equals("tutorial")) {
   341				this.setTutorial();
   342			} else if (function.equals("editor")) {
   343				this.setEditor();
   344			} else if (function.equals("forward")) {
   345				this.curCommandDraw = ApoBotConstants.FORWARD;
   346			} else if (function.equals("left")) {
   347				this.curCommandDraw = ApoBotConstants.LEFT;
   348			} else if (function.equals("right")) {
   349				this.curCommandDraw = ApoBotConstants.RIGHT;
   350			} else if (function.equals("jump")) {
   351				this.curCommandDraw = ApoBotConstants.JUMP;
   352			} else if (function.equals("redye")) {
   353				this.curCommandDraw = ApoBotConstants.REDYE;
   354			} else if (function.equals("functionOne")) {
   355				this.curCommandDraw = ApoBotConstants.FUNCTION_ONE;
   356			} else if (function.equals("functionTwo")) {
   357				this.curCommandDraw = ApoBotConstants.FUNCTION_TWO;
   358			} else if (function.equals("go")) {
   359				if (this.bTutorial) {
   360					if (this.tutorial.canGo()) {
   361						this.restart();
   362					}
   363				} else {
   364					this.restart();
   365				}
   366			} else if (function.equals("gameLoad")) {
   367				super.levelLoad(null);
   368			} else if (function.equals("reset")) {
   369				this.reset();
   370			} else if (function.equals("gameLevelLeft")) {
   371				this.nextLevel(-1);
   372			} else if (function.equals("gameLevelRight")) {
   373				this.nextLevel(+1);
   374			} else if (function.equals("gameLevelChangeLeft")) {
   375				this.nextLevelChange(-1);
   376			} else if (function.equals("gameLevelChangeRight")) {
   377				this.nextLevelChange(+1);
   378			} else if (function.equals("stop")) {
   379				this.stopGo();

   136		public static double getAngleBetween2Points( float x1, float y1, float x2, float y2 ) {
   137			double dx = x1 - x2;
   138			double dy = y1 - y2;
   139			double angle = 0.0d;
   140	 
   141			if ( dx == 0.0 ) {
   142				if ( dy == 0.0 ) {
   143					angle = 0.0;
   144				} else if ( dy > 0.0 ) {
   145					angle = Math.PI / 2.0;
   146				} else {
   147					angle = (Math.PI * 3.0) / 2.0;
   148				}
   149			}
   150			else if( dy == 0.0 ) {
   151				if( dx > 0.0 ) {
   152					angle = 0.0;
   153				} else {
   154					angle = Math.PI;
   155				}
   156			} else {
   157				if ( dx < 0.0 ) {
   158					angle = Math.atan( dy/dx ) + Math.PI;
   159				} else if( dy < 0.0 ) {
   160					angle = Math.atan( dy/dx ) + ( 2*Math.PI );
   161				} else {
   162					angle = Math.atan( dy/dx );
   163				}
   164			}
   165			return ( angle * 180 ) / Math.PI;
   166	    }

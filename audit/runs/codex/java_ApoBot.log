    69		/**
    70		 * wird aufgerufen, wenn eine Taste gedr�ckt wurde
    71		 * @param keyCode
    72		 */
    73		public void keyPressed(int keyCode) {
    74			if (keyCode == KeyEvent.VK_ESCAPE) {
    75				this.game.setMenu();
    76			}
    77			if (this.curStringInt >= this.curString.length()) {
    78				if (keyCode == KeyEvent.VK_ENTER) {
    79					if ((this.step == 5) || (this.step == 6) || (this.step == 7) || (this.step == 9) || (this.step == 11)) {
    80					} else {
    81						this.nextStep();
    82					}
    83				}
    84			} else {
    85				if (keyCode == KeyEvent.VK_ENTER) {
    86					this.curStringInt = this.curString.length();
    87				}
    88			}
    89		}

     3	/**
     4	 * A simple implementation of the Scale2x algorithm for scaling raw image data.
     5	 * 
     6	 * @author Kevin Glass
     7	 */
     8	public class ApoRawScale2x {
     9	
    10		/** The src image data */
    11		private int[] srcImage;
    12	
    13		/** The dest image data */
    14		private int[] dstImage;
    15	
    16		/** The width of the source image */
    17		private int width;
    18	
    19		/** The height of the source image */
    20		private int height;
    21	
    22		/**
    23		 * Create a new scaler based on some raw data. Right now it doesn't matter
    24		 * what order the channels in, just that its an int per pixel
    25		 * 
    26		 * @param imageData = The source image data
    27		 * @param dataWidth = The width of the source image
    28		 * @param dataHeight = The height of the source image
    29		 */
    30		public ApoRawScale2x(int[] imageData, int dataWidth, int dataHeight) {
    31			this.width = dataWidth;
    32			this.height = dataHeight;
    33			this.srcImage = imageData;
    34			this.dstImage = new int[imageData.length * 4];
    35		}
    36	
    37		/**
    38		 * Check if two pixels are different. Place holder for maybe some clever
    39		 * code about tolerance checking
    40		 * 
    41		 * @param a = The first pixel value
    42		 * @param b = The second pixel value
    43		 * @return True if the pixels are different
    44		 */
    45		private boolean different(int a, int b) {
    46			return a != b;
    47		}
    48	
    49		/**
    50		 * Set a pixel in the destination image data
    51		 * 
    52		 * @param x = The x location of the pixel to set
    53		 * @param y = The y location of the pixel to set
    54		 * @param p = The value of the pixel to set
    55		 */
    56		private void setDestPixel(int x, int y, int p) {
    57			this.dstImage[x + (y * this.width * 2)] = p;
    58		}
    59	
    60		/**
    61		 * Get a pixel from the source image. This handles bonds checks and resolves
    62		 * to edge pixels
    63		 * 
    64		 * @param x = The x location of the pixel to retrieve
    65		 * @param y = The y location of the pixel to retrieve
    66		 * @return The pixel value at the specified location
    67		 */
    68		private int getSourcePixel(int x, int y) {
    69			x = Math.max(0, x);
    70			x = Math.min(this.width - 1, x);
    71			y = Math.max(0, y);
    72			y = Math.min(this.height - 1, y);
    73	
    74			return srcImage[x + (y * this.width)];
    75		}
    76	
    77		/**
    78		 * Process a specific pixel. This will generate 4 pixels in the destination
    79		 * image based on the scale2x algorithm
    80		 * 
    81		 * @param x = The x location in the source image of the pixel to process
    82		 * @param y = The y location in the source image of the pixel to process
    83		 */
    84		private void process(int x, int y) {
    85			@SuppressWarnings("unused")
    86			int A = this.getSourcePixel(x - 1, y - 1);
    87			int B = this.getSourcePixel(x, y - 1);
    88			@SuppressWarnings("unused")
    89			int C = this.getSourcePixel(x + 1, y - 1);
    90			int D = this.getSourcePixel(x - 1, y);
    91			int E = this.getSourcePixel(x, y);
    92			int F = this.getSourcePixel(x + 1, y);
    93			@SuppressWarnings("unused")
    94			int G = this.getSourcePixel(x - 1, y + 1);
    95			int H = this.getSourcePixel(x, y + 1);
    96			@SuppressWarnings("unused")
    97			int I = this.getSourcePixel(x + 1, y + 1);
    98			int E0 = E;
    99			int E1 = E;
   100			int E2 = E;
   101			int E3 = E;
   102	
   103			if (this.different(B, H) && this.different(D, F)) {
   104				E0 = !this.different(D, B) ? D : E;
   105				E1 = !this.different(B, F) ? F : E;
   106				E2 = !this.different(D, H) ? D : E;
   107				E3 = !this.different(H, F) ? F : E;
   108			}
   109	
   110			this.setDestPixel(x * 2, y * 2, E0);
   111			this.setDestPixel((x * 2) + 1, y * 2, E1);
   112			this.setDestPixel((x * 2), (y * 2) + 1, E2);
   113			this.setDestPixel((x * 2) + 1, (y * 2) + 1, E3);
   114		}
   115	
   116		/**
   117		 * Get the scale image data. Note this is the method that does the work so
   118		 * it might take some time to process.
   119		 * 
   120		 * @return An array of pixels 4 times the size of the input array containing
   121		 *         the smoothly scaled image
   122		 */
   123		public int[] getScaledData() {
   124			for (int x = 0; x < this.width; x++) {
   125				for (int y = 0; y < this.height; y++) {
   126					process(x, y);
   127				}
   128			}
   129			return this.dstImage;
   130		}

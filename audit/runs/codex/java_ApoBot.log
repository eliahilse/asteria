   253		public void mouseReleased(MouseEvent e) {
   254			int mouseX = e.getX();
   255			int mouseY = e.getY();
   256			int w = 16 * ApoBotConstants.SIZE;
   257			int startX = this.game.getStartX();
   258			int startY = this.game.getStartY();
   259			for (int y = this.game.getLevel().getLevel().length - 1; y >= 0; y--) {

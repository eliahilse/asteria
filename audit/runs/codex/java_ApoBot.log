    23	public class ApoSplashScreen implements ActionListener {
    24		// desktop
    25		private final BufferedImage background;
    26	
    27		// Your logo
    28		private final BufferedImage image;
    29	
    30		// actual image
    31		private BufferedImage currentImage;
    32	
    33		private ApoSplashPainter label;
    34	
    35		private final int speed = 1000 / 50;
    36	
    37		/**
    38		 * Duration in Time Mills
    39		 */
    40		private float duration = 1000.0f;
    41	
    42		private long startTime = 0;
    43	
    44		private boolean isBlendIn = true;
    45	
    46		private final Timer timer;
    47	
    48		public ApoSplashScreen(String path) throws IOException,
    49				AWTException {
    50			final URL url = this.getClass().getClassLoader().getResource(path);
    51			this.image = ImageIO.read(url);
    52	
    53			this.currentImage = GraphicsEnvironment.getLocalGraphicsEnvironment().getDefaultScreenDevice().getDefaultConfiguration().createCompatibleImage(this.image.getWidth(), this.image.getHeight());
    54	
    55			final Dimension screenDimension = Toolkit.getDefaultToolkit().getScreenSize();
    56			final int x = (int) (screenDimension.getWidth() / 2 - this.image.getWidth() / 2);
    57			final int y = (int) (screenDimension.getHeight() / 2 - this.image.getHeight() / 2);
    58			final int w = this.image.getWidth();
    59			final int h = this.image.getHeight();
    60	
    61			final Robot robot = new Robot();
    62			final Rectangle rectangle = new Rectangle(x, y, w, h);
    63			this.background = robot.createScreenCapture(rectangle);
    64			drawImage(0f);
    65	
    66			this.label = new ApoSplashPainter();
    67			this.label.setImage(this.background);
    68			final JWindow f = new JWindow(new JFrame());
    69			f.getContentPane().add(this.label);
    70			f.pack();
    71			f.setLocation(x, y);
    72	
    73			this.timer = new Timer(this.speed, this);
    74			this.timer.setCoalesce(true);
    75			this.timer.start();
    76			this.startTime = System.currentTimeMillis();
    77			f.setVisible(true);
    78		}
    79	
    80		public void blendOut() {
    81			this.isBlendIn = false;
    82			this.startTime = System.currentTimeMillis();
    83			this.timer.start();
    84		}
    85	
    86		public void actionPerformed(ActionEvent e) {
    87			float percent;
    88	
    89			if (this.isBlendIn) {
    90				percent = (System.currentTimeMillis() - this.startTime) / duration;
    91				percent = Math.min(1.0f, percent);
    92			} else {
    93				percent = (System.currentTimeMillis() - this.startTime) / duration;
    94				percent = Math.min(1.0f, percent);
    95				percent = 1.0f - percent;
    96			}
    97	
    98			float alphaValue = percent;
    99	
   100			if (percent >= 1.0) {
   101				this.timer.stop();
   102				// blendOut(); // Einkommentieren damit die animation
   103				// sofort wieder
   104				// ausgeblendet wird
   105			} else if (alphaValue <= 0.0f) {
   106				this.timer.stop();
   107				SwingUtilities.getWindowAncestor(label).dispose();
   108			}
   109	
   110			drawImage(alphaValue);
   111			this.label.setImage(currentImage);
   112			this.label.repaint();
   113		}
   114	
   115		/**
   116		 * Draws Background, then draws image over it
   117		 * 
   118		 * @param alphaValue
   119		 */
   120		private void drawImage(float alphaValue) {
   121			final Graphics2D g2d = (Graphics2D) currentImage.getGraphics();
   122			g2d.drawImage(background, 0, 0, null);
   123			g2d.setComposite(AlphaComposite.getInstance(AlphaComposite.SRC_OVER,
   124					alphaValue));
   125			g2d.drawImage(image, 0, 0, null);
   126			g2d.dispose();
   127		}

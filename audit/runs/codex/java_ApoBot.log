   569		private void renderOvertile(Graphics2D g, int playerX, int playerY, int startX, int startY, int startHeight, ApoBotLevel level) {
   570			int startXPlayer = playerX;
   571			if ((!this.getPlayer().isBUp() && (this.getPlayer().isBJump()) && (this.getPlayer().getJumpHeight() != 0)) || 
   572				((this.getPlayer().isBRun()) && (!this.getPlayer().isBUp()))) {
   573				startXPlayer = playerX + 2;
   574			} else if ((this.getPlayer().getCurDir() == ApoBotConstants.DIR_NORTH_UPLEFT) &&
   575					   (this.getPlayer().isBRun()) && (!this.getPlayer().isBJump())) {
   576				startXPlayer = playerX - 1;
   577				if (startXPlayer < 0) {
   578					startXPlayer = 0;
   579				}
   580			}
   581			for (int x = startXPlayer; x < level.getLevel()[0].length; x++) {
   582				int start = playerY;
   583				if (start >= level.getLevel().length) {
   584					start = level.getLevel().length - 1;
   585				}
   586				for (int y = start; y >= 0; y--) {
   587					if ((x == playerX) && (y >= playerY)) {
   588						continue;
   589					}
   590					for (int heightLevel = startHeight + 1; heightLevel <= level.getLevel()[y][x].getHeight(); heightLevel++) {
   591						this.renderTile(g, x, y, startX, startY, heightLevel);
   592					}
   593				}
   594			}
   595			
   596		}

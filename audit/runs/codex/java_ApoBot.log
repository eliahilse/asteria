   178		public BufferedImage getButtonImage( int width, int height, String text, Color background, Color font, Color border, Color over, Color pressed, Font writeFont ) {
   179			BufferedImage iButton = GraphicsEnvironment.getLocalGraphicsEnvironment().getDefaultScreenDevice().getDefaultConfiguration().createCompatibleImage(width,height,BufferedImage.TRANSLUCENT);
   180			Graphics2D g = (Graphics2D)iButton.getGraphics();
   181			
   182			g.setRenderingHint(RenderingHints.KEY_ANTIALIASING, RenderingHints.VALUE_ANTIALIAS_ON);
   183			
   184			Font fontOkButton = writeFont;
   185			int h = g.getFontMetrics().getHeight();
   186			
   187			for ( int i = 0; i < 3; i++ ) {
   188				g.setColor( background );
   189				g.fillRoundRect( (width)/3 * i, 0, (width)/3 - 1, height - 1, 5, 5 );
   190				
   191				g.setFont( fontOkButton );
   192				int w = g.getFontMetrics().stringWidth( text );
   193				int x = iButton.getWidth()/3;
   194				
   195				if ( i == 1 ) {
   196					g.setColor(over);
   197					g.fillRoundRect( i*x + x/2 - w/2, iButton.getHeight()/2 - h/4 + 1, w, h/2 - 2, 20, 20 );
   198				} else if ( i == 2 ) {
   199					g.setColor(pressed);
   200					g.fillRoundRect( i*x + x/2 - w/2, iButton.getHeight()/2 - h/4 + 1, w, h/2 - 2, 20, 20 );
   201				}
   202				
   203				g.setColor( font );
   204				g.drawString( text, i*x + x/2 - w/2, iButton.getHeight()/2 + h/3 );
   205				
   206				g.setColor( border );
   207				g.drawRoundRect( (width)/3 * i, 0, (width)/3 - 1, height - 1, 5, 5 );
   208			}
   209			
   210			g.dispose();
   211			return iButton;
   212		}

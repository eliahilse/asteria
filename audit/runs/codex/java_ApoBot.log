   225		/**
   226		 * erstellt den Backbuffer damit es smooth l�uft
   227		 * 
   228		 */
   229		private void createBackbuffer() {
   230			if (this.backbuffer != null) {
   231				this.backbuffer.flush();
   232				this.backbuffer = null;
   233			}
   234			// GraphicsConfiguration f�r VolatileImage
   235			this.ge = GraphicsEnvironment.getLocalGraphicsEnvironment();
   236			this.gc = this.ge.getDefaultScreenDevice().getDefaultConfiguration();
   237			this.backbuffer = this.gc.createCompatibleVolatileImage(getWidth(),	getHeight());
   238		}
   239	
   240		/**
   241		 * pr�ft, ob der aktuelle Backbuffer noch valide ist sonst erstellt er einen
   242		 * neuen
   243		 * 
   244		 */
   245		private void checkBackbuffer() {
   246			if (this.backbuffer == null) {
   247				this.createBackbuffer();
   248			}
   249			if (this.backbuffer.validate(this.gc) == VolatileImage.IMAGE_INCOMPATIBLE) {
   250				this.createBackbuffer();
   251			}
   252		}
   253	
   254		/**
   255		 * wird vom Thread aufgerufen und k�mmert sich um das neuzeichnen
   256		 */
   257		public void render() {
   258			if (this.strategy == null) {
   259				return;
   260			}
   261			
   262			if (this.bStrategy) {
   263				checkBackbuffer();
   264				Graphics2D g = (Graphics2D) this.backbuffer.getGraphics();
   265				render(g);
   266				g.dispose();
   267	
   268				Graphics g2 = this.strategy.getDrawGraphics();
   269				g2.drawImage(this.backbuffer, 0, 0, this);
   270				g2.dispose();
   271	
   272				if (!this.strategy.contentsLost()) {
   273					this.strategy.show();
   274				} else {
   275					this.strategy = getBufferStrategy();
   276				}
   277			} else {
   278				Graphics2D g = (Graphics2D)this.strategy.getDrawGraphics();
   279				g.clearRect(0, 0, getWidth(), getHeight());
   280				this.render(g);
   281				g.dispose();
   282				if (!this.strategy.contentsLost()) {
   283					this.strategy.show();
   284				} else {
   285					this.strategy = getBufferStrategy();
   286				}
   287			}
   288		}

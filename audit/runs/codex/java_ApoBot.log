   222		private void drawSpeech(Graphics2D g, String s) {
   223			g.setFont(ApoBotConstants.FONT_WIN);
   224			g.setColor(new Color(255, 255, 255));
   225			int y = 55;
   226			g.fillRoundRect(5, y, ApoBotConstants.GAME_GAME_WIDTH - 10, 100, 40, 40);
   227			g.setColor(Color.black);
   228			
   229			int curHeight = 0;
   230			int[] maxLength = new int[] {ApoBotConstants.GAME_GAME_WIDTH - 20, ApoBotConstants.GAME_GAME_WIDTH - 20};
   231			int x = 10;
   232			y += 30;
   233			ArrayList<String> strings = new ArrayList<String>();
   234			strings.add(s);
   235			int cur = 0;
   236			int w = g.getFontMetrics().stringWidth(strings.get(cur));
   237			if (w > maxLength[curHeight]) {
   238				int curPos = strings.get(cur).indexOf(" ");
   239				while ((curPos > -1) && (g.getFontMetrics().stringWidth(strings.get(cur).substring(0, curPos)) < maxLength[curHeight])) {
   240					int nextPos = strings.get(cur).indexOf(" ", curPos + 1);
   241					if (nextPos != -1) {
   242						if (g.getFontMetrics().stringWidth(strings.get(cur).substring(0, nextPos)) >= maxLength[curHeight]) {
   243							String curString = strings.get(cur);
   244							strings.set(cur, curString.substring(0, curPos));
   245							cur++;
   246							if (curHeight == 0) {
   247								curHeight++;
   248							}
   249							strings.add(curString.substring(curPos + 1));
   250							curPos = strings.get(cur).indexOf(" ");
   251						} else {
   252							curPos = nextPos;
   253						}
   254					} else {
   255						String curString = strings.get(cur);
   256						if (g.getFontMetrics().stringWidth( curString ) > maxLength[curHeight]) {
   257							strings.set( cur, curString.substring(0, curPos) );
   258							cur++;
   259							strings.add( curString.substring(curPos + 1));
   260						}
   261						break;
   262					}
   263				}
   264			}
   265			for ( int i = 0; i < strings.size(); i++ ) {
   266				g.drawString(strings.get(i), x, y);
   267				y += 23;
   268			}
   269		}
   270		
   271	}


    35	    public String getExtension(File file) 
    36	    {
    37	        String s = "";
    38	        String s1 = file.getName();
    39	        int i = s1.lastIndexOf(46);
    40	        if(i > 0 && i < s1.length() - 1)
    41	            s = s1.substring(i + 1).toLowerCase();
    42	        return s;
    43	    }
    44	

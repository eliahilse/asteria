   419		public static void saveData(URL codebase, String name, String value) {
   420			String parametersAsString = "SET=&name=" + name + "&value=" + value;
   421			byte[] parameterAsBytes = parametersAsString.getBytes();
   422			URL url;
   423			try {
   424				url = new URL(codebase + "cookies.php");
   425				URLConnection con = url.openConnection();
   426				((HttpURLConnection) con).setRequestMethod("GET");
   427				con.setDoOutput(true);
   428				con.setDoInput(true);
   429				con.setUseCaches(false);
   430		
   431				OutputStream oStream = con.getOutputStream();
   432				oStream.write(parameterAsBytes);
   433				oStream.flush();
   434				// I don't know why this is necessary, but it really seems to be:
   435				BufferedReader iStream = new BufferedReader(new InputStreamReader(con.getInputStream()));
   436				iStream.readLine();
   437				iStream.close();
   438				oStream.close();
   439			} catch (MalformedURLException e) {
   440				e.printStackTrace();
   441			} catch (IOException e) {
   442				e.printStackTrace();
   443			}
   444		}
   445	
   446		public static String loadData(URL codebase, String name) {
   447			String retVal = "";
   448			String parametersAsString = "GET=&name=" + name;
   449			byte[] parameterAsBytes = parametersAsString.getBytes();
   450			URL url;
   451			try {
   452				url = new URL(codebase + "cookies.php");
   453	
   454				URLConnection con = url.openConnection();
   455				((HttpURLConnection) con).setRequestMethod("GET");
   456				con.setDoOutput(true);
   457				con.setDoInput(true);
   458				con.setUseCaches(false);
   459		
   460				OutputStream oStream = con.getOutputStream();
   461				oStream.write(parameterAsBytes);
   462				oStream.flush();
   463		
   464				BufferedReader iStream = new BufferedReader(new InputStreamReader(con.getInputStream()));
   465				retVal = iStream.readLine();
   466				iStream.close();
   467				oStream.close();
   468			} catch (MalformedURLException e) {
   469				e.printStackTrace();
   470			} catch (IOException e) {
   471				e.printStackTrace();
   472			}
   473			return retVal;
   474		}
   475	}


   203			this.getGame().setButtonVisible(ApoNotSoSimpleConstants.BUTTON_GAME);
   204			this.strings = new ArrayList<ApoNotSoSimpleString>();
   205			this.level = level;
   206			this.moves = 0;
   207			this.solution = "";
   208			if (level == -2) {
   209				this.curLevel.restart();
   210			} else if (level == -3) {
   211				this.curLevel = this.userLevels.getLevel(this.userLevels.getCurLevel(), this.sort);
   212				for (int i = 23; i <= 26; i++) {
   213					this.getGame().getButtons()[i].setBVisible(true);
   214				}
   215			} else {
   216				this.curLevel = ApoNotSoSimpleLevelGeneration.getLevel(this.level);
   217				if (this.curLevel == null) {
   218					this.level = 0;
   219					this.curLevel = ApoNotSoSimpleLevelGeneration.getLevel(this.level);	
   220				}
   221			}
   222			this.makeBackground();
   223			this.getGame().setShouldRepaint(true);
   224			this.getGame().render();
   225		}

    49	    public String getDescription() 
    50	    {
    51	    	if ( this.s != null ) {
    52	    		return "Nur "+this.s+"-Dateien";
    53	    	} else if ( this.aString != null ) {
    54	    		String s = "Nur ";
    55	    		for ( int i = 0; i < this.aString.length; i++ ) {
    56	    			s += this.aString[i];
    57	    			if (i < this.aString.length - 1) {
    58	    				s += ", ";
    59	    			}
    60	    		}
    61	    		s += " Dateien";
    62	    		return s;
    63	    	}
    64	    	return "";
    65	    }
    66	
    67	    /**
    68	     * akzeptiert nur die Dateien, die er annehmen soll, alle anderen nimmt er nicht an
    69	     */
    70	    public boolean accept(File file) 
    71	    {
    72	        if(file.isDirectory())
    73	            return true;
    74	        String s = getExtension(file);
    75	        if(s != null) {
    76	        	if ( this.aString != null ) {
    77	        		for ( int i = 0; i < this.aString.length; i++ ) {
    78	        			if ( s.equals( this.aString[i] ) )
    79	        				return true;
    80	        		}
    81	        	}
    82	            return ((s.equals(this.s)));
    83	        } else {
    84	            return false;
    85	        }
    86	    }
    87	        
    88	    public ApoFileFilter() 
    89	    {
    90	    }
    91	}

     9	public class ApoNotSoSimpleUserLevels {
    10	
    11		public static final int SORT_USERNAME = 0;
    12		public static final int SORT_LEVELNAME = 1;
    13		public static final int SORT_SOLUTION = 2;
    14		
    15		public static final String[] SORT_STRING = new String[] {
    16			"username",
    17			"levelname",
    18			"solution"
    19		};
    20		
    21		private ApoHighscore highscore;
    22		
    23		private int curLevel;
    24		
    25		private int[][] sortLevel;
    26		
    27		public ApoNotSoSimpleUserLevels() {
    28			this.highscore = ApoHighscore.getInstance();
    29		}
    30		
    31		public void init() {
    32			this.loadHighscore();
    33		}
    34		
    35		public void loadHighscore() {
    36			Thread t = new Thread(new Runnable() {
    37				@Override
    38				public void run() {
    39					ApoNotSoSimpleUserLevels.this.load();
    40				}
    41	 		});
    42	 		t.start();
    43		}
    44		
    45		public int getCurLevel() {
    46			return this.curLevel;
    47		}
    48	
    49		public void setCurLevel(int curLevel) {
    50			this.curLevel = curLevel;
    51		}
    52	
    53		public void load() {
    54			try {
    55				this.highscore = ApoHighscore.getInstance();
    56				this.curLevel = 0;
    57				if (this.highscore.load()) {
    58					this.sort();
    59				}
    60			} catch (Exception ex) {
    61				this.highscore = null;
    62			}
    63		}
    64		
    65		private void sort() {
    66			this.sortLevel = new int[3][this.highscore.getLevel().size()];
    67			ArrayList<Integer> sortList = new ArrayList<Integer>();
    68			for (int i = 0; i < this.highscore.getUsernames().size(); i++) {
    69				if (sortList.size() == 0) {
    70					sortList.add(i);
    71				} else {
    72					for (int j = 0; j < sortList.size(); j++) {
    73						if (this.highscore.getUsernames().get(i).compareTo(this.highscore.getUsernames().get(sortList.get(j))) < 0) {
    74							sortList.add(j, i);
    75							break;
    76						} else if (j + 1 == sortList.size()) {
    77							sortList.add(i);
    78							break;
    79						}
    80					}
    81				}
    82			}
    83			
    84			ArrayList<Integer> sortListLevel = new ArrayList<Integer>();
    85			for (int i = 0; i < this.highscore.getLevelnames().size(); i++) {
    86				if (sortListLevel.size() == 0) {
    87					sortListLevel.add(i);
    88				} else {
    89					for (int j = 0; j < sortListLevel.size(); j++) {
    90						if (this.highscore.getLevelnames().get(i).compareTo(this.highscore.getLevelnames().get(sortListLevel.get(j))) < 0) {
    91							sortListLevel.add(j, i);
    92							break;
    93						} else if (j + 1 == sortListLevel.size()) {
    94							sortListLevel.add(i);
    95							break;
    96						}
    97					}
    98				}
    99			}
   100			
   101			for (int i = 0; i < this.sortLevel[0].length; i++) {
   102				this.sortLevel[SORT_USERNAME][i] = sortList.get(i);
   103				this.sortLevel[SORT_LEVELNAME][i] = sortListLevel.get(i);
   104				this.sortLevel[SORT_SOLUTION][i] = i;
   105			}
   106		}
   107		
   108		public ApoNotSoSimpleLevel getLevel(int level, int sort) {
   109			this.curLevel = level;
   110			if (this.curLevel < 0) {
   111				this.curLevel = this.highscore.getLevel().size() - 1;
   112			} else if (this.curLevel >= this.highscore.getLevel().size()) {
   113				this.curLevel = 0;
   114			}
   115			if (this.highscore.getLevel().size() <= 0) {
   116				return null;
   117			}
   118			int nextLevel = this.curLevel;
   119			if (sort != ApoNotSoSimpleUserLevels.SORT_SOLUTION) {
   120				nextLevel = sortLevel[sort][this.curLevel];
   121			}
   122			try {
   123				String levelString = this.highscore.getLevel().get(nextLevel);
   124				int layer = Integer.valueOf(levelString.substring(0, 1));
   125				levelString = levelString.substring(1);
   126				byte[][][] levelArray = new byte[layer][3][10];
   127				for (int l = 0; l < levelArray.length; l++) {
   128					for (int y = 0; y < levelArray[0].length; y++) {
   129						for (int x = 0; x < levelArray[0][0].length; x++) {
   130							levelArray[l][y][x] = Byte.valueOf(levelString.substring(0, 2));
   131							levelString = levelString.substring(2);
   132						}
   133					}
   134				}
   135				String levelName = this.highscore.getLevelnames().get(nextLevel);
   136				String[] instructions;
   137				if (layer == 1) {
   138					instructions= new String[2];
   139					instructions[0] = this.highscore.getDescriptions().get(nextLevel);
   140					instructions[1] = "by " + this.highscore.getUsernames().get(nextLevel);
   141				} else {
   142					instructions= new String[3];
   143					instructions[0] = levelName;
   144					instructions[1] = this.highscore.getDescriptions().get(nextLevel);
   145					instructions[2] = "by " + this.highscore.getUsernames().get(nextLevel);
   146				}
   147				return new ApoNotSoSimpleLevel(levelArray, instructions, levelName);
   148			} catch (Throwable ex) {
   149				ex.printStackTrace();
   150				return null;
   151			}
   152		}
   153		
   154		public int getMaxLevels() {
   155			return this.highscore.getLevel().size();
   156		}
   157	}


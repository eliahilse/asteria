   124		private boolean checkKeyReleased(final ApoNewTextfield textField, int button, char character) {
   125			if ((textField != null) && (textField.isBVisible()) && (textField.isBSelect())) {
   126				boolean bShift = false;
   127				if (this.getGame().getKeyboard().isPressed(KeyEvent.VK_CONTROL)) {
   128					if (button == KeyEvent.VK_V) {
   129						String s = ApoHelp.getClipboardContents();
   130						if (s != null) {
   131							for (int i = 0; i < s.length(); i++) {
   132								char chara = s.charAt(i);
   133								textField.addCharacter(button, chara);
   134							}
   135							bShift = true;
   136							this.getGame().render();
   137						}
   138					} else if (button == KeyEvent.VK_C) {
   139						String s = textField.getSelectedString();
   140						if (s != null) {
   141							ApoHelp.setClipboardContents(s);
   142						}
   143						bShift = true;
   144						this.getGame().render();
   145					} else if (button == KeyEvent.VK_X) {
   146						String s = textField.getSelectedString();
   147						if (s != null) {
   148							ApoHelp.setClipboardContents(s);
   149							textField.deleteSelectedString();
   150						}
   151						bShift = true;
   152						this.getGame().render();
   153					}
   154				} else if (this.getGame().getKeyboard().isPressed(KeyEvent.VK_SHIFT)) {
   155					if (button == KeyEvent.VK_LEFT) {
   156						textField.nextSelectedPosition(textField.getPosition() - 1);
   157						bShift = true;
   158						this.getGame().render();
   159					} else if (button == KeyEvent.VK_RIGHT) {
   160						textField.nextSelectedPosition(textField.getPosition() + 1);
   161						bShift = true;
   162						this.getGame().render();
   163					}
   164				}
   165				if (!bShift) {
   166					textField.addCharacter(button, character);
   167					this.getGame().render();
   168				}
   169				return true;
   170			}
   171			return false;
   172		}

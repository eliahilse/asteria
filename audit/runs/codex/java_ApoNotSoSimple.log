   271		private void changeDirection(int direction) {
   272			if (this.curLooseTime <= 0) {
   273				if (this.curLevel != null) {
   274					if (direction == KeyEvent.VK_LEFT) {
   275						if (this.curLevel.changeDirection(ApoNotSoSimpleConstants.PLAYER_DIRECTION_LEFT)) {
   276							this.addMove();
   277							this.solution += "l";
   278						}
   279					} else if (direction == KeyEvent.VK_RIGHT) {
   280						if (this.curLevel.changeDirection(ApoNotSoSimpleConstants.PLAYER_DIRECTION_RIGHT)) {
   281							this.addMove();
   282							this.solution += "r";
   283						}
   284					} else if (direction == KeyEvent.VK_UP) {
   285						if (this.curLevel.changeDirection(ApoNotSoSimpleConstants.PLAYER_DIRECTION_UP)) {
   286							this.addMove();
   287							this.solution += "u";
   288						}
   289					} else if (direction == KeyEvent.VK_DOWN) {
   290						if (this.curLevel.changeDirection(ApoNotSoSimpleConstants.PLAYER_DIRECTION_DOWN)) {
   291							this.addMove();
   292							this.solution += "d";
   293						}
   294					}
   295				}
   296			}
   297		}

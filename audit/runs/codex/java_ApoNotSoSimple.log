   419							}
   420						}
   421					}
   422					if (!this.curLevel.isVisible()) {
   423						this.getGame().playSound(ApoNotSoSimplePanel.SOUND_WIN, -1);
   424						if (this.level >= 0) {
   425							this.getGame().setMaxLevel(this.level + 1);

   344										levelArray[(int)(this.entities[i].get(j).getY()/ApoNotSoSimpleConstants.TILE_SIZE)][(int)(this.entities[i].get(j).getX()/ApoNotSoSimpleConstants.TILE_SIZE)].y = j;									
   345									} else {

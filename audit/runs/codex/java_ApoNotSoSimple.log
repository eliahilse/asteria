   469		/**
   470		 * wird aufgerufen, wenn die Maus losgelassen wird oder die Maus gezogen wird<br />
   471		 * sie setzt dann die Leveltiles, wenn ben�tigt<br />
   472		 * @param bRight : TRUE, rechte Maustaste gedr�ckt, ansonsten FALSE
   473		 */
   474		private void setSelection(final boolean bRight) {
   475			int x = this.curMousePosition.x;
   476			int y = this.curMousePosition.y;
   477			
   478			// falls die Maus �berhaupt �ber dem Level ist
   479			if ((this.curMouseLayer >= 0) && (x >= 0) && (y >= 0) &&
   480				(x < this.level.getLevel()[this.curMouseLayer][0].length) && (y < this.level.getLevel()[this.curMouseLayer].length)) {
   481				if (bRight) {
   482					if ((this.level.getLevel()[this.curMouseLayer][y][x] != ApoNotSoSimpleConstants.LEVEL_FREE) &&
   483						(this.level.getLevel()[this.curMouseLayer][y][x] != ApoNotSoSimpleConstants.LEVEL_PLAYER) &&
   484						(this.level.getLevel()[this.curMouseLayer][y][x] != ApoNotSoSimpleConstants.LEVEL_FINISH)) {
   485						this.level.getLevel()[this.curMouseLayer][y][x] = ApoNotSoSimpleConstants.LEVEL_FREE;
   486						this.makeAndRender();
   487					}
   488				} else if (this.level.getLevel()[this.curMouseLayer][y][x] != this.selection) {
   489					if ((this.selection == ApoNotSoSimpleConstants.LEVEL_FINISH) || (this.selection == ApoNotSoSimpleConstants.LEVEL_PLAYER)) {
   490						for (int sY = 0; sY < this.level.getLevel()[this.curMouseLayer].length; sY++) {
   491							for (int sX = 0; sX < this.level.getLevel()[this.curMouseLayer][0].length; sX++) {
   492								if (this.level.getLevel()[this.curMouseLayer][sY][sX] == this.selection) {
   493									this.level.getLevel()[this.curMouseLayer][sY][sX] = ApoNotSoSimpleConstants.LEVEL_FREE;
   494								}
   495							}
   496						}
   497						this.level.getLevel()[this.curMouseLayer][y][x] = this.selection;
   498						this.makeAndRender();
   499					} else {
   500						if ((this.level.getLevel()[this.curMouseLayer][y][x] != ApoNotSoSimpleConstants.LEVEL_FINISH) && 
   501							(this.level.getLevel()[this.curMouseLayer][y][x] != ApoNotSoSimpleConstants.LEVEL_PLAYER)) {
   502							this.level.getLevel()[this.curMouseLayer][y][x] = this.selection;
   503							this.makeAndRender();
   504						}
   505					}
   506				}
   507			}
   508		}

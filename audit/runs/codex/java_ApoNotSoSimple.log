   256		private void changeVisibleStepFinish() {
   257			for (int i = 0; i < this.entities.length; i++) {
   258				for (int size = 0; size < this.entities[i].size(); size++) {
   259					if (this.entities[i].get(size).getFixedMovement() == ApoNotSoSimpleConstants.PLAYER_DIRECTION_STEP_FINISH) {

    83		@Override
    84		public void run() {
    85			long unprocessedTimeThink = 0;
    86			long unprocessedTimeRender = 0;
    87			long msPerTickThink = (long)(1000.0 / (double)(ApoConstants.FPS_THINK));
    88			long msPerTickRender = (long)(1000.0 / (double)(ApoConstants.FPS_RENDER));
    89			this.frames = 0;
    90			long lastFpsTime = System.currentTimeMillis() - 1000;
    91			this.last = System.currentTimeMillis();
    92			this.isRunning = true;
    93	
    94			// eigentliche Spiellogikschleife
    95			while (this.isRunning) {
    96				long now = System.currentTimeMillis();
    97				long passedTime = now - this.last;
    98				// falls Zeit vergangen ist seit dem letzten Aufruf
    99				if (passedTime > 0) {
   100					unprocessedTimeThink += passedTime;
   101					unprocessedTimeRender += passedTime;
   102					// wenn nachgedacht werden soll dann denke nach
   103					while (unprocessedTimeThink >= msPerTickThink) {
   104						if (unprocessedTimeThink > 10 * msPerTickThink) {
   105							unprocessedTimeThink = 0;
   106						} else {
   107							unprocessedTimeThink -= msPerTickThink;
   108						}
   109						if (!this.bShouldThink) {
   110							unprocessedTimeThink = 0;
   111						} else {
   112							this.think(msPerTickThink);
   113						}
   114					}
   115					// wenn gezeichnet werden soll, dann zeichne neu
   116					if (unprocessedTimeRender >= msPerTickRender) {
   117						unprocessedTimeRender -= msPerTickRender;
   118						if (this.bShouldRepaint) {
   119							this.render();
   120						}
   121					}
   122					this.last = now;
   123				}
   124				// falls eine Sekunde vergangen ist, dann aktualisiere die FPSanzahl
   125				if (System.currentTimeMillis() - lastFpsTime > 1000) {
   126					if (!this.bShouldRepaint) {
   127						this.render();
   128					}
   129					lastFpsTime += 1000;
   130					this.screen.setFps(this.frames);
   131					this.frames = 0;
   132				}
   133	
   134				// leg den Thread f�r 10 Millisekunden schlafen
   135				try {
   136					Thread.sleep(10);
   137				} catch (InterruptedException e) {
   138				}
   139			}
   140		}

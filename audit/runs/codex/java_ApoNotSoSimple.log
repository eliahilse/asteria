   326											if (((this.entities[p.x].get(p.y).getFixedMovement() == ApoNotSoSimpleConstants.PLAYER_DIRECTION_UP) && (this.entities[i].get(j).getFixedMovement() == ApoNotSoSimpleConstants.PLAYER_DIRECTION_DOWN)) ||
   327												((this.entities[p.x].get(p.y).getFixedMovement() == ApoNotSoSimpleConstants.PLAYER_DIRECTION_DOWN) && (this.entities[i].get(j).getFixedMovement() == ApoNotSoSimpleConstants.PLAYER_DIRECTION_UP))) {
   328												this.entities[p.x].get(p.y).setOverAnotherEntity(0);

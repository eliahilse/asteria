   220			for (int p = 0; p < result.length; p++) {
   221				for (int e = 0; e < result[0].length; e++) {
   222					result[p][e] = -1;
   223				}
   224			}
   225			if (!this.bShouldTest) {
   226				return result;
   227			} else {
   228	//			for (int p = 0; p < this.players.length; p++) {
   229					for (int i = 0; i < this.entities.length; i++) {
   230						if (this.visibleEntities[i]) {
   231							for (int size = 0; size < this.entities[i].size(); size++) {
   232								if ((this.entities[i].get(size).isBVisible()) && (!this.entities[i].get(size).isMoving())) {
   233									if (this.players[i].intersects(this.entities[i].get(size))) {
   234										if (this.entities[i].get(size).getFixedMovement() == ApoNotSoSimpleConstants.PLAYER_DIRECTION_FINISH) {
   235	//										if (i == i) {
   236												result[i][i] = this.entities[i].get(size).getFixedMovement();											
   237	//										}
   238										} else if (this.entities[i].get(size).getFixedMovement() == ApoNotSoSimpleConstants.PLAYER_DIRECTION_STEP) {
   239	//										if (i == i) {
   240												this.entities[i].get(size).setBVisible(false);
   241												this.changeVisibleStepFinish();
   242	//										}
   243										} else {
   244											result[i][i] = this.entities[i].get(size).getFixedMovement();
   245										}
   246									}
   247								}
   248							}
   249						}
   250	//				}
   251				}
   252			}
   253			return result;
   254		}

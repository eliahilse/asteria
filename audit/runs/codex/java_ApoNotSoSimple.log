   124		public boolean changeDirection(int direction) {
   125			boolean bChange = false;
   126			if ((direction == ApoNotSoSimpleConstants.PLAYER_DIRECTION_LEFT) ||
   127				(direction == ApoNotSoSimpleConstants.PLAYER_DIRECTION_RIGHT) ||
   128				(direction == ApoNotSoSimpleConstants.PLAYER_DIRECTION_UP) ||
   129				(direction == ApoNotSoSimpleConstants.PLAYER_DIRECTION_DOWN)) {
   130				for (int i = 0; i < this.entities.length; i++) {
   131					if (this.visibleEntities[i]) {
   132						if (this.players[i] != null) {
   133							if (this.players[i].isBVisible()) {
   134								if (this.players[i].isMoving()) {
   135									return false;
   136								}
   137								this.players[i].setNextDirection(direction);
   138								this.players[i].moveNextDirection();
   139								if (this.players[i].isMoving()) {
   140									bChange = true;
   141								}
   142							}
   143						}
   144						if (bChange) {
   145							this.bShouldChange = false;
   146							for (int e = 0; e < this.entities[i].size(); e++) {
   147								this.entities[i].get(e).setMoving();
   148								if ((direction == ApoNotSoSimpleConstants.PLAYER_DIRECTION_UP) ||
   149									(direction == ApoNotSoSimpleConstants.PLAYER_DIRECTION_DOWN)) {
   150									if ((this.entities[i].get(e).getFixedMovement() == ApoNotSoSimpleConstants.PLAYER_DIRECTION_UP) ||
   151										(this.entities[i].get(e).getFixedMovement() == ApoNotSoSimpleConstants.PLAYER_DIRECTION_DOWN) ||
   152										(this.entities[i].get(e).getFixedMovement() == ApoNotSoSimpleConstants.PLAYER_DIRECTION_CHANGEVISIBLE_UP)) {
   153										this.entities[i].get(e).moveNextDirection();
   154									}
   155								}
   156								if ((direction == ApoNotSoSimpleConstants.PLAYER_DIRECTION_LEFT) ||
   157									(direction == ApoNotSoSimpleConstants.PLAYER_DIRECTION_RIGHT)) {
   158									if ((this.entities[i].get(e).getFixedMovement() == ApoNotSoSimpleConstants.PLAYER_DIRECTION_LEFT) ||
   159										(this.entities[i].get(e).getFixedMovement() == ApoNotSoSimpleConstants.PLAYER_DIRECTION_RIGHT)) {
   160										this.entities[i].get(e).moveNextDirection();
   161									}
   162								}
   163							}
   164						}
   165					}
   166				}
   167				return bChange;
   168			}
   169			return false;

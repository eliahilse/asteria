   101				}
   102				
   103				g.fillRect(myX, myY, myWidth, myHeight);
   104				g.setColor(ApoMonoConstants.DARK_BRIGHT[0], ApoMonoConstants.DARK_BRIGHT[1], ApoMonoConstants.DARK_BRIGHT[2], 1f);
   105	
   106				if (this.bLeft) {
   107					g.fillRect(myX - 2, myY, 2, myHeight);
   108					g.fillRect(myX  + myWidth, myY, 2, myHeight - 3);
   109					g.fillRect(myX, myY - 2, myWidth, 2);
   110					g.fillRect(myX, myY + myHeight, myWidth - 2, 2);
   111					g.setLineSize(2.0f * ApoMonoConstants.MAX);
   112					g.drawLine(myX + myWidth - 2, myY + myHeight, myX + myWidth + 5, myY + myHeight + 4);
   113					g.drawLine(myX + myWidth + 1, myY + myHeight - 3, myX + myWidth + 5, myY + myHeight + 4);
   114				} else {
   115					g.fillRect(myX - 2, myY, 2, myHeight - 3);
   116					g.fillRect(myX  + myWidth, myY, 2, myHeight);
   117					g.fillRect(myX, myY - 2, myWidth, 2);
   118					g.fillRect(myX + 3, myY + myHeight, myWidth - 3, 2);
   119					g.setLineSize(2.0f * ApoMonoConstants.MAX);
   120					g.drawLine(myX - 2, myY + myHeight - 3, myX - 5, myY + myHeight + 4);
   121					g.drawLine(myX + 3, myY + myHeight + 1, myX - 5, myY + myHeight + 4);
   122				}
   123				g.setLineSize(1.0f * ApoMonoConstants.MAX);
   124				
   125				this.panel.drawString(g, this.text, (int)(myX + myWidth/2 - w/2), (int)(myY + 1 - 3), ApoMonoPanel.game_font, ApoMonoConstants.DARK_BRIGHT, true);
   126			}

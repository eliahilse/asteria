    59		private void sortByUpload() {
    60			this.sortByUpload.clear();
    61			for (int i = 0; i < this.userlevels.getLevels().size(); i++) {
    62				String s = this.userlevels.getLevels().get(i);
    63				if ((s != null) && (s.length() > 2) && (!ApoMonoLevel.isIn(s))) {
    64					float time = this.userlevels.getTimes().get(i);
    65					boolean bAdd = false;
    66					for (int k = 0; k < this.sortByUpload.size(); k++) {
    67						float sortTime = this.userlevels.getTimes().get(this.sortByUpload.get(k));
    68						if (time > sortTime) {
    69							this.sortByUpload.add(k, i);
    70							bAdd = true;
    71							break;
    72						}
    73					}
    74					if (!bAdd) {
    75						this.sortByUpload.add(i);
    76					}
    77				}
    78			}
    79		}

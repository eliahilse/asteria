   349								for (int y = 0; y < level.length; y++) {
   350									for (int x = 0; x < level[0].length; x++) {
   351										if (this.curSelected != 11) {
   352											if (level[y][x] == this.curSelected) {
   353												this.level[y][x] = 0;
   354											}
   355										} else {
   356											if (level[y][x] == this.curSelected) {
   357												beamer += 1;
   358												if (beamer >= 2) {
   359													level[y][x] = 0;
   360												}
   361											}
   362										}
   363									}
   364								}
   365							}
   366							this.level[myY][myX] = this.curSelected;
   367							
   368							this.canBeTested();
   369							this.setUploadVisible(false);
   370						}
   371					}
   372				}
   373			}
   374		}

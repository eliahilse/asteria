   107			
   108			int max = this.getHighest(-1, values);
   109			int maxTwo = this.getHighest(max, values);
   110			String result = "";
   111			for (int i = 0; i < values.length; i++) {
   112				if ((i != max) && (i != maxTwo)) {
   113					result += "0";
   114				} else {
   115					if (values[i] > 0) {
   116						result += "1";
   117					} else {
   118						result += "0";

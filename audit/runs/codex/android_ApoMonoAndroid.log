   128			g.fillCircle(x + width/2 + 1, y + height/2, 12);
   129			g.setColor(ApoMonoConstants.DARK[0], ApoMonoConstants.DARK[1], ApoMonoConstants.DARK[2], 1f);
   130			g.fillCircle(x + width/2 + 1, y + height/2, 8);
   131			g.setLineSize(1 * ApoMonoConstants.MAX);
   132			g.setColor(ApoMonoConstants.BRIGHT[0], ApoMonoConstants.BRIGHT[1], ApoMonoConstants.BRIGHT[2], 1f);
   133			for (int i = 0; i < 360; i+= 45) {
   134				if (i == 0) {
   135					g.setRotation(0.01f);				
   136				} else {
   137					g.setRotation(i);
   138				}
   139				float posX = x + width/2 + 13 * (float)Math.sin(Math.toRadians(i));
   140				float posY = y + 5f + height/2 - 13 * (float)Math.cos(Math.toRadians(i));
   141				g.fillRect(posX - 2, posY - 10, 5, 10);
   142			}
   143			g.setRotation(0);
   144		}

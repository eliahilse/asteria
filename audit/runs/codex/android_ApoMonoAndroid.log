   506		protected void drawButtons(final BitsGLGraphics g, final BitsGLFont font, final int i, final int valueDif) {
   507			if (this.getButtons()[i].isBVisible()) {
   508				int x = (int)(this.getButtons()[i].getX());
   509				int y = (int)(this.getButtons()[i].getY());
   510				int width = (int)(this.getButtons()[i].getWidth());
   511				int height = (int)(this.getButtons()[i].getHeight());
   512				
   513				g.setColor(ApoMonoConstants.DARK[0], ApoMonoConstants.DARK[1], ApoMonoConstants.DARK[2], 1f);
   514				g.fillRect(x + 2, y + 2, width - 4, height - 4);
   515				ApoMonoPuzzleGame.setDarkerColor(g);
   516				g.fillRect(x + 2, y, width - 4, 2);
   517				g.fillRect(x + 2, y + height - 2, width - 4, 2);
   518				g.fillRect(x, y + 2, 2, height - 4);
   519				g.fillRect(x + width - 2, y + 2, 2, height - 4);
   520				ApoMonoPuzzleGame.setBrighterColor(g);
   521				g.fillRect(x + 4, y + height, width - 4, 2);
   522				g.fillRect(x + width, y + 4, 2, height - 4);
   523				g.fillRect(x + width - 2, y + height - 2, 2, 2);
   524				
   525				String s = this.getButtons()[i].getFunction();
   526				this.drawString(g, s, (int)(x + width/2 - font.getLength(s)/2), y + height/2 - font.mCharCellHeight/2 - valueDif, font, ApoMonoConstants.BRIGHT);
   527			}
   528		}
   529	}


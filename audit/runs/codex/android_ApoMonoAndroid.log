   126		private int getHighest(int not, int[] values) {
   127			int curValue = 0;
   128			if (not == 0) {
   129				curValue = 1;
   130			}
   131			int max = values[curValue];
   132			for (int i = 0; i < values.length; i++) {
   133				if ((max < values[i]) && (i != not)) {
   134					max = values[i];
   135					curValue = i;
   136				}
   137			}
   138			return curValue;
   139		}

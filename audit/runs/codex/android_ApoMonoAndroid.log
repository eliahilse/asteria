   322							} else {
   323								this.withBox = 0;
   324							}
   325							this.add = 0;
   326							if ((previousLevel[y][x] == 51) || (previousLevel[y][x] == 56)) {
   327								this.add = 1;
   328							}
   329						}
   330					}
   331				}
   332				for (int y = 0; y < this.boxes.length; y++) {
   333					for (int x = 0; x < this.boxes[0].length; x++) {
   334						this.boxes[y][x] = previousLevel[y + this.boxes.length][x];
   335					}
   336				}
   337				
   338				if (this.backsteps.size() > 1) {
   339					this.backsteps.remove(this.backsteps.size() - 1);
   340				}

   305		public static String getMd5Digest(String pInput) {
   306			try {
   307				MessageDigest lDigest = MessageDigest.getInstance("MD5");
   308				lDigest.update(pInput.getBytes());
   309				BigInteger lHashInt = new BigInteger(1, lDigest.digest());
   310				return String.format("%1$032X", lHashInt);
   311			} catch(NoSuchAlgorithmException lException) {
   312				throw new RuntimeException(lException);
   313			}
   314		}

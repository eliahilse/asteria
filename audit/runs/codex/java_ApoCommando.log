   331		public static String getClipboardContents() {
   332			String result = "";
   333			Clipboard clipboard = Toolkit.getDefaultToolkit().getSystemClipboard();
   334			Transferable contents = clipboard.getContents(null);
   335			boolean hasTransferableText = (contents != null) && contents.isDataFlavorSupported(DataFlavor.stringFlavor);
   336			if (hasTransferableText) {
   337				try {
   338					result = (String)contents.getTransferData(DataFlavor.stringFlavor);
   339				} catch (UnsupportedFlavorException ex){
   340					//highly unlikely since we are using a standard DataFlavor
   341				} catch (IOException ex) {
   342				}
   343			}
   344			return result;
   345		}

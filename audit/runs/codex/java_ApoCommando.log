   239		public boolean checkLevelLoad(String curString) {
   240			curString = curString.toLowerCase();
   241			if (curString.length() <= 0) {
   242				return false;
   243			}
   244			for (int i = 0; i < ApoMarioMyLevels.LEVEL_STRINGS.length; i++) {
   245				if (curString.equals(ApoMarioMyLevels.LEVEL_STRINGS[i])) {
   246					this.getGame().newLevel(-1, -1, curString);
   247					this.getGame().setGame(false);
   248					return true;
   249				}
   250			}
   251			if ((curString.equals("mandy")) || (curString.equals("antje")) || 
   252				(curString.equals("clemens")) || (curString.equals("jessika"))) {
   253				this.getGame().newLevel(-1, -1, curString);
   254				this.getGame().setGame(false);
   255			}
   256			if (curString.equals("tutorial")) {
   257				this.getGame().newLevel(-1, -1, curString);
   258				this.getGame().setGame(true);
   259			}
   260	
   261			return false;
   262		}

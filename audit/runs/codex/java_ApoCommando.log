     1	package apoCommando.panels;
     2	
     3	import java.awt.Color;
     4	import java.awt.Graphics2D;
     5	import java.util.ArrayList;
     6	
     7	import apoCommando.ApoMarioConstants;
     8	
     9	public class ApoMarioTutorial {
    10		
    11		private final int MAX_DELTA = 20;
    12		
    13		private ApoMarioGame game;
    14		
    15		private int step;
    16		
    17		private String curString;
    18		
    19		private int curStringInt;
    20		
    21		private int curDelta;
    22		
    23		private boolean bTutorial;
    24		
    25		public ApoMarioTutorial(ApoMarioGame game) {
    26			this.game = game;
    27			
    28			this.bTutorial = false;
    29		}
    30		
    31		public boolean isBTutorial() {
    32			return this.bTutorial;
    33		}
    34	
    35		public void setBTutorial(boolean tutorial) {
    36			this.bTutorial = tutorial;
    37			
    38			if (this.bTutorial) {
    39				this.step = 0;
    40				this.curString = ApoMarioConstants.TUTORIAL_SPEECH[this.step];
    41				this.curStringInt = 0;
    42				this.curDelta = 0;
    43			}
    44		}
    45		
    46		private void nextCheck() {
    47			if (this.curStringInt < this.curString.length()) {
    48				this.curStringInt = this.curString.length();
    49			} else {
    50				this.step += 1;
    51				if (this.step >= ApoMarioConstants.TUTORIAL_SPEECH.length) {
    52					this.game.getGame().setAnalysis();
    53				} else {
    54					this.curString = ApoMarioConstants.TUTORIAL_SPEECH[this.step];
    55					this.curStringInt = 0;
    56					this.curDelta = 0;
    57				}
    58			}
    59		}
    60	
    61		public boolean checkCurString(String checkCurString) {
    62			if (this.bTutorial) {
    63				if ((this.step != 4) && (this.step != 6)) {
    64					if (checkCurString.equals("next")) {
    65						this.nextCheck();
    66						return true;
    67					}
    68				}
    69			}
    70			return false;
    71		}
    72		
    73		public boolean think(int delta) {
    74			this.curDelta += delta;
    75			if (this.curDelta >= this.MAX_DELTA) {
    76				this.curDelta -= this.MAX_DELTA;
    77				if (this.curStringInt < this.curString.length()) {
    78					this.curStringInt++;
    79				}
    80			}
    81			if (this.curStringInt >= this.curString.length()) {
    82				if (this.step == 4) {
    83					if (this.game.getGame().getLevel().getPlayer().getX() > 14 * ApoMarioConstants.TILE_SIZE) {
    84						this.nextCheck();
    85						this.game.getGame().getLevel().setBDark(true);
    86					}
    87					return true;
    88				} else if (this.step == 6) {
    89					if (this.game.getGame().getLevel().getPlayer().getX() > 24 * ApoMarioConstants.TILE_SIZE) {
    90						this.nextCheck();
    91						this.game.getGame().getLevel().setBDark(false);
    92					}
    93					return true;
    94				} else if (this.step == 9) {
    95					return true;
    96				} else {
    97				}
    98			}
    99			return false;
   100		}
   101		
   102		public void renderTutorial(Graphics2D g) {
   103			g.setFont(ApoMarioConstants.FONT_DOS_BOX);
   104			g.setColor(Color.WHITE);
   105			this.drawSpeech(g, this.curString.substring(0, this.curStringInt), 16, 40, ApoMarioConstants.GAME_WIDTH - 32);
   106		}
   107		
   108	
   109		private void drawSpeech(Graphics2D g, String s, int x, int y, int width) {
   110			int curHeight = 0;
   111			int[] maxLength = new int[] {width - 4, width - 4, width - 4, width - 4};
   112			ArrayList<String> strings = new ArrayList<String>();
   113			strings.add(s);
   114			int cur = 0;
   115			int w = g.getFontMetrics().stringWidth(strings.get(cur));
   116			if (w > maxLength[curHeight]) {
   117				int curPos = strings.get(cur).indexOf(" ");
   118				while ((curPos > -1) && (g.getFontMetrics().stringWidth(strings.get(cur).substring(0, curPos)) < maxLength[curHeight])) {
   119					int nextPos = strings.get(cur).indexOf(" ", curPos + 1);
   120					if (nextPos != -1) {
   121						if (g.getFontMetrics().stringWidth(strings.get(cur).substring(0, nextPos)) >= maxLength[curHeight]) {
   122							String curString = strings.get(cur);
   123							strings.set(cur, curString.substring(0, curPos));
   124							cur++;
   125							if (curHeight == 0) {
   126								curHeight++;
   127							}
   128							strings.add(curString.substring(curPos + 1));
   129							curPos = strings.get(cur).indexOf(" ");
   130						} else {
   131							curPos = nextPos;
   132						}
   133					} else {
   134						String curString = strings.get(cur);
   135						if (g.getFontMetrics().stringWidth( curString ) > maxLength[curHeight]) {
   136							strings.set( cur, curString.substring(0, curPos) );
   137							cur++;
   138							strings.add( curString.substring(curPos + 1));
   139						}
   140						break;
   141					}
   142				}
   143			}
   144			int h = g.getFontMetrics().getHeight();
   145			for ( int i = 0; i < strings.size(); i++ ) {
   146				g.drawString(strings.get(i), x, y);
   147				y += h;
   148			}
   149		}
   150		

    63		public static BufferedImage rotateImageMethodTwo(BufferedImage inputImage, double degrees ) {
    64			int x,y = 0;
    65			
    66			if ((degrees == 0)||(degrees == 180)||(degrees == 360)){
    67				x = inputImage.getWidth(null);
    68				y = inputImage.getHeight(null);
    69			} else {
    70				x = inputImage.getHeight(null);
    71				y = inputImage.getWidth(null);
    72			}
    73			BufferedImage sourceBI = GraphicsEnvironment.getLocalGraphicsEnvironment().getDefaultScreenDevice().getDefaultConfiguration().createCompatibleImage(x, y, BufferedImage.TRANSLUCENT);
    74			AffineTransform at = new AffineTransform();
    75	
    76			// rotate around image center
    77			at.rotate(Math.toRadians( degrees ), (sourceBI.getWidth() / 2), (sourceBI.getHeight() / 2) );
    78	
    79		    /*
    80		     * translate to make sure the rotation doesn't cut off any image data
    81		     */
    82			AffineTransform translationTransform;
    83			translationTransform = findTranslation( at, sourceBI, degrees );
    84			at.preConcatenate( translationTransform );
    85	
    86	
    87			Graphics2D g = (Graphics2D) sourceBI.getGraphics();
    88			g.setRenderingHint(RenderingHints.KEY_ANTIALIASING, RenderingHints.VALUE_ANTIALIAS_ON);
    89			g.setTransform(at);
    90			g.drawImage(inputImage, 0, 0, null);
    91	
    92			return sourceBI;
    93		}

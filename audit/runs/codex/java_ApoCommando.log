   146		public void checkString() {
   147			if (this.curString.length() > 0) {
   148				this.addCommand(this.curString);
   149				boolean bNew = true;
   150				for (int i = 0; i < this.getGame().getAllCommands().size(); i++) {
   151					if (this.curString.equals(this.getGame().getAllCommands().get(i).getCurString())) {
   152						bNew = false;
   153						this.getGame().getAllCommands().get(i).addCount();
   154						break;
   155					}
   156				}
   157				if (bNew) {
   158					this.getGame().getAllCommands().add(new ApoMarioStats(this.curString));
   159				}
   160				boolean bBreak = false;
   161				if (this.bAchievements) {
   162					if ((this.curString.equals("back")) ||
   163						(this.curString.equals("exit"))) {
   164						this.bStats = false;
   165						this.bAchievements = false;
   166						bBreak = true;
   167					} else if (this.curString.equals("achievements")) {
   168						this.extraString = "Hello ... look where you are";
   169						bBreak = true;
   170					}
   171				} else if (this.bLevel) {
   172					if (this.curString.equals("back")) {
   173						this.bStats = false;
   174						this.bLevel = false;
   175						this.bAchievements = false;
   176						bBreak = true;
   177					} else if (this.curString.indexOf("levelcode") >= 0) {
   178						this.extraString = "Hello ... look where you are";
   179						bBreak = true;
   180					}
   181				} else if (this.bStats) {
   182					if (this.curString.equals("back")) {
   183						this.bStats = false;
   184						this.getGame().getLevel().setBStop(false);
   185						bBreak = true;
   186					} else if (this.curString.equals("stats")) {
   187						this.extraString = "Hello ... you are in the stats ...";
   188						bBreak = true;
   189					}
   190				}
   191				
   192				if (!bBreak) {
   193					if (this.curString.equals("stats")) {
   194						this.getGame().getAchievements().addHiddenWord(this.curString);
   195						this.getGame().getAchievements().addAchievement(ApoMarioAchievements.ACHIEVEMENT_STATS);
   196						this.bStats = true;
   197						this.bAchievements = false;
   198						this.getGame().getLevel().setBStop(true);
   199					}
   200				}
   201				this.checkCurString();
   202				this.curString = "";
   203			}
   204		}

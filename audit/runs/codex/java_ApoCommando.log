   475		public void renderStats(Graphics2D g) {
   476			if (this.bStats) {
   477				g.drawImage(this.iDosStats, ApoMarioConstants.GAME_WIDTH/2 - this.iDosStats.getWidth()/2, ApoMarioConstants.GAME_HEIGHT/2 - this.iDosStats.getHeight()/2, null);
   478				int width = this.iDosStats.getWidth();
   479				int height = this.iDosStats.getHeight();
   480				int x = (ApoMarioConstants.GAME_WIDTH - width)/2 + 10;
   481				int y = (ApoMarioConstants.GAME_HEIGHT - height)/2 + 20;
   482				g.setFont(ApoMarioConstants.FONT_DOS_BOX);
   483				int addY = 15;
   484				g.setColor(Color.WHITE);
   485				int w = g.getFontMetrics().stringWidth("w");
   486				g.drawString("Command", x + 5, y + 20 + 3 * addY);
   487				g.drawString("=", x + 15 + w * 15, y + 20 + 3 * addY);
   488				g.drawLine(x + 5, y + 25 + 3 * addY, x + width - 10, y + 25 + 3 * addY);
   489				for (int i = 0; i < this.getGame().getAllCommands().size(); i++) {
   490					String command = this.getGame().getAllCommands().get(i).getCurString();
   491					int count = this.getGame().getAllCommands().get(i).getCount();
   492					int widthCount = g.getFontMetrics().stringWidth(count+"");
   493					if (i < 15) {
   494						g.drawString(command, x + 5, y + 20 + (5 + i) * addY);
   495						g.drawString(""+count, x + 15 + w * 16 - widthCount, y + 20 + (5 + i) * addY);
   496					} else if (i < 30) {
   497						int newX = x + 10 + w * 17;
   498						if (i == 15) {
   499							g.drawLine(x + 18 + w * 16, y + 20 + 4 * addY, x + 18 + w * 16, y + 20 + 19 * addY);
   500						}
   501						g.drawString(command, newX + 5, y + 20 + (5 + i - 15) * addY);
   502						g.drawString(""+count, newX + 15 + w * 16 - widthCount, y + 20 + (5 + i - 15) * addY);
   503					} else if (i < 45) {
   504						int newX = x + 20 + w * 34;
   505						if (i == 30) {
   506							g.drawLine(x + 28 + w * 33, y + 20 + 4 * addY, x + 28 + w * 33, y + 20 + 19 * addY);
   507						}
   508						g.drawString(command, newX + 5, y + 20 + (5 + i - 30) * addY);
   509						g.drawString(""+count, newX + 15 + w * 16 - widthCount, y + 20 + (5 + i - 30) * addY);
   510					}
   511				}
   512	
   513				int myX = x + g.getFontMetrics().stringWidth("C:\\Stats>");
   514				if (this.bCursor) {
   515					g.drawString(this.curString+"_", myX + 5, y + 20 + 22 * addY);
   516				} else {
   517					g.drawString(this.curString, myX + 5, y + 20 + 22 * addY);
   518				}
   519				this.renderExtraString(g, x + 5, y + 20 + 24 * addY);
   520				
   521				g.drawString("C:\\Stats>Type 'back' to close the stats", x + 5, y + 20 + 21 * addY);
   522				g.drawString("C:\\Stats>", x + 5, y + 20 + 22 * addY);
   523			}
   524		}

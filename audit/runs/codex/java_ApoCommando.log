   216		protected void thinkLevel(int delta) {
   217			this.playerHumanControl();
   218			int change = delta;
   219			for (int i = 0; i < delta; i += change) {
   220				this.getGame().getLevel().think(change);					
   221			}
   222			if (this.bStep) {
   223				int curX = (int)(this.getGame().getLevel().getPlayer().getRec().getX() / ApoMarioConstants.TILE_SIZE);
   224				if (this.startX != curX) {
   225					this.setStop();
   226				}
   227			}
   228		}

    12	public class AudioPlayer implements Runnable {
    13		private static final int EXTERNAL_BUFFER_SIZE = 128000;
    14	
    15		private String path;
    16		
    17		private boolean bStop;
    18		
    19		private boolean bLoop;
    20		
    21		private ApoSoundThread soundThread;
    22		
    23		public AudioPlayer(String path, boolean bLoop) {
    24			this.path = path;
    25			this.bLoop = bLoop;
    26			this.bStop = false;
    27		}
    28	
    29		public void start() {
    30			this.soundThread = new ApoSoundThread(this);
    31			this.soundThread.start();
    32			Thread t = new Thread(this);
    33			t.start();
    34		}
    35		
    36		public boolean isBStop() {
    37			return this.bStop;
    38		}
    39	
    40		public void setBStop(boolean stop) {
    41			this.bStop = stop;
    42		}
    43	
    44		public boolean isBLoop() {
    45			return this.bLoop;
    46		}
    47	
    48		public void setBLoop(boolean loop) {
    49			this.bLoop = loop;
    50		}
    51	
    52		public void run() {
    53			try {
    54				while(this.soundThread.isRunning()) {
    55					do {
    56						AudioInputStream audioInputStream = null;
    57						try {
    58							audioInputStream = AudioSystem.getAudioInputStream(AudioPlayer.class.getResourceAsStream(this.path));
    59						} catch (Exception e) {
    60						}
    61	
    62						AudioFormat audioFormat = audioInputStream.getFormat();
    63					
    64						SourceDataLine line = null;
    65						DataLine.Info info = new DataLine.Info(SourceDataLine.class,audioFormat);
    66						try {
    67							line = (SourceDataLine) AudioSystem.getLine(info);
    68							line.open(audioFormat);
    69						} catch (LineUnavailableException e) {
    70						} catch (Exception e) {
    71						}
    72	
    73						line.start();
    74	
    75						int nBytesRead = 0;
    76						byte[] abData = new byte[EXTERNAL_BUFFER_SIZE];
    77						while ((nBytesRead != -1) && (!this.isBStop())) {
    78							try {
    79								nBytesRead = audioInputStream.read(abData, 0, abData.length);
    80							} catch (IOException e) {
    81							}
    82							if (nBytesRead >= 0) {
    83								line.write(abData, 0, nBytesRead);
    84							}
    85						}
    86						line.drain();
    87						line.close();
    88					} while ((!this.isBStop()) && (this.isBLoop()));
    89					this.soundThread.stop();
    90				}
    91				try {
    92					synchronized(this.soundThread) {
    93						this.soundThread.wait((long)10);
    94					}
    95				} catch(InterruptedException e) {
    96					(this.soundThread).stop();
    97				}
    98			} catch (Exception ex) {
    99				
   100			}
   101		}
   102	
   103	}


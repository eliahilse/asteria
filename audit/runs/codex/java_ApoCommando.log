   311				g.drawString(s, x + 5, y + 20 + 3 * addY);
   312				s = "C:\\Stats>Points: "+this.getGame().getLevel().getPlayer().getPoints() + ", width: " + (int)(this.getGame().getLevel().getPlayer().getX() / ApoMarioConstants.TILE_SIZE) + "/" + this.getGame().getLevel().getWidth();
   313				g.drawString(s, x + 5, y + 20 + 4 * addY);
   314			}
   315			

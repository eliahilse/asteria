    71		private BufferedImage getImage(String pic, boolean bLoad)	{
    72			BufferedImage icon = null;
    73			
    74			BufferedImage img		= null;
    75			
    76			if ( !bLoad ) {
    77				try	{
    78					img = ImageIO.read( this.getClass().getClassLoader().getResource(pic));
    79					//result = this.graphicsConfiguration.createCompatibleImage(img.getWidth(),img.getHeight(), BufferedImage.TYPE_INT_ARGB);
    80					//result.createGraphics().drawImage(img,0,0,null);
    81					icon	= img;
    82				} catch (IOException e) {
    83					e.printStackTrace();
    84					return null;
    85				} catch (NullPointerException ex) {
    86					return  null;
    87				}
    88			} else {
    89				try {
    90					if ( ApoConstants.B_APPLET ) {
    91						img = ImageIO.read(new URL(pic));
    92					} else {
    93						img = ImageIO.read(new File(pic));
    94					}
    95					//result = this.graphicsConfiguration.createCompatibleImage(img.getWidth(),img.getHeight(), BufferedImage.TYPE_INT_ARGB);
    96					//result.createGraphics().drawImage(img,0,0,null);
    97					icon	= img;
    98				} catch (MalformedURLException e) {
    99					System.out.println("Konnte das Bild "+pic+" nicht laden");
   100					return null;
   101				} catch (IOException e) {
   102					System.out.println("Konnte das Bild "+pic+" nicht laden");
   103					return null;
   104				}
   105			}
   106			return (icon);
   107		}

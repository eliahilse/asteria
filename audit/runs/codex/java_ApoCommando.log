   309		private void renderLevelWidthStatistics(Graphics2D g) {
   310			g.setFont(ApoMarioConstants.FONT_STATISTICS);
   311			int difWidth = 20;
   312			int levelWidth = ApoMarioConstants.GAME_WIDTH - difWidth * 2;
   313			float maxWidth = -1;
   314			if (this.getLevel() != null) {
   315				ApoMarioPlayer player = this.getLevel().getPlayer();
   316				if (player.isBVisible()) {
   317					float marioWidth = (player.getX() * 100f / (this.getLevel().getWidth() * ApoMarioConstants.TILE_SIZE));
   318					if (maxWidth < marioWidth) {
   319						maxWidth = marioWidth;
   320					}
   321					g.setColor(Color.RED);
   322					g.drawString("M", difWidth + levelWidth * marioWidth / 100, ApoMarioConstants.GAME_HEIGHT - 5);
   323				}
   324				int distance = 15 * ApoMarioConstants.SIZE;
   325				for (int i = 0; i < levelWidth / distance; i++) {
   326					int width = i * distance;
   327					if ((float)width / (float)levelWidth < maxWidth / 100f) {
   328						g.setColor(Color.GREEN);
   329					} else {
   330						g.setColor(Color.BLACK);
   331					}
   332					g.fillRect(difWidth + width, ApoMarioConstants.GAME_HEIGHT - 10, 5, 5);
   333				}
   334				String s = "F";
   335				int w = g.getFontMetrics().stringWidth(s);
   336				
   337				g.drawString(s, difWidth + levelWidth - w, ApoMarioConstants.GAME_HEIGHT - 5);
   338			}
   339		}

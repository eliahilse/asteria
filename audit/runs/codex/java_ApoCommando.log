   201		public void changeCamera() {
   202			float x = this.getGame().getLevel().getPlayer().getX();
   203			if (x > 0) {
   204				float changeX = x - ApoMarioConstants.GAME_WIDTH/2;
   205				if (changeX < 0) {
   206					changeX = 0;
   207				} else if (changeX + ApoMarioConstants.GAME_WIDTH >= this.getGame().getLevel().getWidth() * ApoMarioConstants.TILE_SIZE) {
   208					changeX = this.getGame().getLevel().getWidth() * ApoMarioConstants.TILE_SIZE - ApoMarioConstants.GAME_WIDTH;
   209				}
   210				if (changeX != this.getGame().getChangeX()) {
   211					this.getGame().setChangeX(changeX);
   212				}
   213			}
   214		}

   120		public void keyButtonReleased(int button, char character) {
   121			if (this.bAchievements) {
   122				if (button == KeyEvent.VK_UP) {
   123					if (this.curAchievement > 0) {
   124						this.curAchievement -= 1;
   125					}
   126				} else if (button == KeyEvent.VK_DOWN) {
   127					if (this.getGame().getAchievements().getAchievements().size() >= this.MAX_ACHIEVMENTS) {
   128						if (this.curAchievement + this.MAX_ACHIEVMENTS < this.getGame().getAchievements().getAchievements().size()) {
   129							this.curAchievement += 1;
   130						}
   131					}
   132				}
   133			}
   134		}

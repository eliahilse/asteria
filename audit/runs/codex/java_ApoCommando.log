   232		public static String getTimeToDraw(int time) {
   233			if (time <= 0)
   234				return "";
   235			String min = String.valueOf(time/1000/60);
   236			String sec = ""+((time/1000)%60);
   237			String msec = ""+((time/10)%100);
   238			if (sec.length()<2) sec = "0"+sec;
   239			if (msec.length()<2) msec = "0"+msec;
   240			String timeString = min+":"+sec+":"+msec;
   241			
   242			return timeString;
   243		}

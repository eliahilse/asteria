   269		@Override
   270		public void render(Graphics2D g) {
   271			g.setRenderingHint(RenderingHints.KEY_ANTIALIASING, RenderingHints.VALUE_ANTIALIAS_OFF);
   272			if (this.getGame().getLevel() != null) {
   273				this.getGame().getLevel().render(g, (int)this.getGame().getChangeX(), (int)this.getGame().getChangeY());

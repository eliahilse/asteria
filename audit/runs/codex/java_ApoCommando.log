   223		public boolean checkLevelCode(String curString) {
   224			curString = curString.toLowerCase();
   225			if (curString.length() <= 0) {
   226				return false;
   227			}
   228			if (curString.startsWith("levelcode")) {
   229				this.getGame().getAchievements().addHiddenWord(this.curString);
   230				this.getGame().getAchievements().addAchievement(ApoMarioAchievements.ACHIEVEMENT_LEVELCODE);
   231				this.bStats = false;
   232				this.bAchievements = false;
   233				this.bLevel = true;
   234				return true;
   235			}
   236			return false;
   237		}

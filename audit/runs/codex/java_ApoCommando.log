    97		 * @param at = AffineTransformObjekt
    98		 * @param bi = BufferedImage
    99		 * @param degrees = Winkel
   100		 * @return korrekte AffineTransform
   101		 */
   102		private static AffineTransform findTranslation(AffineTransform at, BufferedImage bi, double degrees ) {
   103			Point2D p2din, p2dout;
   104			double ytrans, xtrans = 0.0;
   105	
   106			AffineTransform tat = new AffineTransform();
   107	
   108			if(degrees == 180) {
   109				p2din = new Point2D.Double(0, bi.getHeight());
   110			} else {
   111				p2din = new Point2D.Double(0.0, 0.0);
   112			}
   113	
   114			p2dout = at.transform(p2din, null);
   115	
   116			if(degrees == 270) {
   117				xtrans = p2dout.getX();
   118				ytrans = xtrans;
   119			} else {
   120				ytrans = p2dout.getY();
   121				xtrans = ytrans;
   122			}
   123	
   124			tat.translate(-xtrans, -ytrans);
   125	
   126			return tat;
   127		}

   526		public void renderAchievements(Graphics2D g) {
   527			if (this.bAchievements) {
   528				g.drawImage(this.iDosStats, ApoMarioConstants.GAME_WIDTH/2 - this.iDosStats.getWidth()/2, ApoMarioConstants.GAME_HEIGHT/2 - this.iDosStats.getHeight()/2, null);
   529				int width = this.iDosStats.getWidth();
   530				int height = this.iDosStats.getHeight();
   531				int x = (ApoMarioConstants.GAME_WIDTH - width)/2 + 10;
   532				int y = (ApoMarioConstants.GAME_HEIGHT - height)/2 + 20;
   533				g.setFont(ApoMarioConstants.FONT_DOS_BOX);
   534				int addY = 15;
   535				g.setColor(Color.WHITE);
   536				g.drawString("C:\\Achievements>load ... ("+this.getGame().getAchievements().getAchievements().size()+" / "+ApoMarioAchievements.ACHIEVEMENT_MAX+") achievements", x + 5, y + 20 + 3 * addY);
   537				for (int i = this.curAchievement; i < this.getGame().getAchievements().getAchievements().size() && i < this.curAchievement + this.MAX_ACHIEVMENTS; i++) {

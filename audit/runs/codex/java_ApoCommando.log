   150		public static double getAngleBetween2Points( float x1, float y1, float x2, float y2 ) {
   151			double dx = x1 - x2;
   152			double dy = y1 - y2;
   153			double angle = 0.0d;
   154	 
   155			if ( dx == 0.0 ) {
   156				if ( dy == 0.0 ) {
   157					angle = 0.0;
   158				} else if ( dy > 0.0 ) {
   159					angle = Math.PI / 2.0;
   160				} else {
   161					angle = (Math.PI * 3.0) / 2.0;
   162				}
   163			}
   164			else if( dy == 0.0 ) {
   165				if( dx > 0.0 ) {
   166					angle = 0.0;
   167				} else {
   168					angle = Math.PI;
   169				}
   170			} else {
   171				if ( dx < 0.0 ) {
   172					angle = Math.atan( dy/dx ) + Math.PI;
   173				} else if( dy < 0.0 ) {
   174					angle = Math.atan( dy/dx ) + ( 2*Math.PI );
   175				} else {
   176					angle = Math.atan( dy/dx );
   177				}
   178			}
   179			return ( angle * 180 ) / Math.PI;

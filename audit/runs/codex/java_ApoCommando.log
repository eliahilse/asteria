   175			}
   176	
   177			int[][] keyReleased = this.keyboard.getReleased();
   178			if (keyReleased != null) {
   179				for (int i = 0; i < keyReleased.length; i++) {
   180					this.keyReleased(keyReleased[i][0], (char)(keyReleased[i][1]));
   181				}
   182			}
   183	
   184			if (this.mouse.isDragged()) {
   185				this.mouseDragged(this.mouse.getX(), this.mouse.getY(), this.mouse.hasClicked(ApoMouse.LEFT));
   186			} else if (this.mouse.hasClicked(ApoMouse.LEFT)) {
   187				this.mousePressed(this.mouse.getX(), this.mouse.getY(), true);
   188			} else if (this.mouse.hasClicked(ApoMouse.RIGHT)) {
   189				this.mousePressed(this.mouse.getX(), this.mouse.getY(), false);
   190			} else if (this.mouse.isMoved()) {
   191				this.mouseMoved(this.mouse.getX(), this.mouse.getY());
   192			}
   193			boolean[] mouseReleased = this.mouse.getReleased();
   194			if (mouseReleased[ApoMouse.LEFT]) {
   195				this.mouseReleased(this.mouse.getX(), this.mouse.getY(), true);
   196			} else if (mouseReleased[ApoMouse.RIGHT]) {
   197				this.mouseReleased(this.mouse.getX(), this.mouse.getY(), false);
   198			}
   199			this.think(delta);
   200		}

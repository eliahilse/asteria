   269				return false;
   270			}
   271			if (curString.startsWith("dif ")) {
   272				String number = curString.substring(4);
   273				try {
   274					int x = Integer.parseInt(number);
   275					if ((x > 4) || (x < 1)) {
   276						return false;
   277					}
   278					ApoMarioConstants.DIFFICULTY = x;
   279					this.getGame().newLevel(50 * (ApoMarioConstants.DIFFICULTY - 1) + 50, (ApoMarioConstants.DIFFICULTY - 1) * 50, null);
   280					this.iDosBox = this.getBackgroundImageWithRect();
   281					return true;
   282				} catch (NumberFormatException ex) {
   283				}
   284			}
   285			return false;
   286		}

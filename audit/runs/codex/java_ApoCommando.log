   230		private void playerHumanControl() {
   231			if (!this.bStop) {
   232				if (this.getGame().getLevel().getPlayer().getDirection() == ApoMarioEntity.LEFT) {
   233					if (this.getGame().getLevel().getPlayer().isBSpeed()) {
   234						this.getGame().getLevel().getPlayer().setGoalVecX(-ApoMarioConstants.PLAYER_MAX_VEC_X_FAST - ApoMarioConstants.DIFFICULTY * ApoMarioConstants.PLAYER_MAX_VEC_X_DIF_FAST);
   235					} else {
   236						this.getGame().getLevel().getPlayer().setGoalVecX(-ApoMarioConstants.PLAYER_MAX_VEC_X_NORMAL - ApoMarioConstants.DIFFICULTY * ApoMarioConstants.PLAYER_MAX_VEC_X_DIF_NORMAL);
   237					}
   238				} else {
   239					if (this.getGame().getLevel().getPlayer().isBSpeed()) {
   240						this.getGame().getLevel().getPlayer().setGoalVecX(ApoMarioConstants.PLAYER_MAX_VEC_X_FAST + ApoMarioConstants.DIFFICULTY * ApoMarioConstants.PLAYER_MAX_VEC_X_DIF_FAST);
   241					} else {
   242						this.getGame().getLevel().getPlayer().setGoalVecX(ApoMarioConstants.PLAYER_MAX_VEC_X_NORMAL + ApoMarioConstants.DIFFICULTY * ApoMarioConstants.PLAYER_MAX_VEC_X_DIF_NORMAL);
   243					}
   244				}
   245			}
   246		}

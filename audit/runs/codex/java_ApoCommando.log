    52				return null;
    53			}
    54			mt.addImage(i, 0);
    55	
    56			try {
    57				// Wait until all pic are load,
    58				mt.waitForAll();
    59			} catch (InterruptedException e) {
    60				// nothing
    61			}
    62			return i;
    63		}

    87		public BufferedImage getStatsImage() {
    88			int width = ApoMarioConstants.GAME_WIDTH - 25 * ApoMarioConstants.SIZE;
    89			int height = ApoMarioConstants.GAME_HEIGHT - 30 * ApoMarioConstants.SIZE;
    90			
    91			BufferedImage iStats = new BufferedImage(width, height, BufferedImage.TYPE_INT_ARGB_PRE);
    92			Graphics2D g = (Graphics2D)iStats.getGraphics();
    93			g.setRenderingHint(RenderingHints.KEY_ANTIALIASING, RenderingHints.VALUE_ANTIALIAS_ON);
    94	
    95			g.setColor(new Color(196, 215, 234));
    96			g.fillRoundRect(0, 0, width - 1, height - 1, 15, 15);			
    97			g.setColor(Color.BLACK);
    98			g.setStroke(new BasicStroke(2));
    99			g.drawRoundRect(0, 0, width - 1, height - 1, 15, 15);			
   100			
   101			int x = 10;
   102			int y = 20;
   103			g.fillRect(x, y, width - 20, height - 25);
   104			
   105			g.setRenderingHint(RenderingHints.KEY_ANTIALIASING, RenderingHints.VALUE_ANTIALIAS_OFF);
   106			g.setFont(ApoMarioConstants.FONT_DOS_BOX);
   107			int addY = 15;
   108			g.setColor(Color.WHITE);
   109			g.drawString("ApoCommando (version "+ApoMarioConstants.VERSION+")", x + 5, y + 20);
   110			g.drawString("Copyright (c) 2011 Apo-Games. All Rights reserved.", x + 5, y + 20 + 1 * addY);
   111			
   112			g.dispose();
   113			return iStats;
   114		}

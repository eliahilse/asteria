   254			
   255			g.setColor(new Color(196, 215, 234));
   256			g.fillRoundRect(0, 0, width - 1, height - 1, 15, 15);			
   257			g.setColor(Color.BLACK);
   258			g.setStroke(new BasicStroke(2));
   259			g.drawRoundRect(0, 0, width - 1, height - 1, 15, 15);			
   260			
   261			int x = 10;
   262			int y = 20;
   263			g.fillRect(x, y, width - 20, height - 25);
   264			
   265			g.dispose();
   266			return iDosBox;
   267		}

   206		public boolean checkAchievements(String curString) {
   207			curString = curString.toLowerCase();
   208			if (curString.length() <= 0) {
   209				return false;
   210			}
   211			if (curString.startsWith("achievement")) {
   212				this.curAchievement = 0;
   213				this.getGame().getAchievements().addHiddenWord(this.curString);
   214				this.getGame().getAchievements().addAchievement(ApoMarioAchievements.ACHIEVEMENT_ACHIEVEMENT);
   215				this.bStats = false;
   216				this.bAchievements = true;
   217				this.bLevel = false;
   218				return true;
   219			}
   220			return false;
   221		}

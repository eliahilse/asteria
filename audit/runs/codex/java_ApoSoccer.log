   110						this.game.getReplay().saveReplay(System.getProperty("user.dir") + File.separator +"replays"+File.separator+file+"_"+this.analysis.get(i).getHomeAIClass()+"-"+this.analysis.get(i).getVisitorAIClass()+"="+this.analysis.get(i).getScoreHome()+"_"+this.analysis.get(i).getScoreVisitor());
   111					}

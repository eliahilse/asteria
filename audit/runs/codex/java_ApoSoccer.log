   831			if ((!this.isBStartGame()) || (!ApoSoccerConstants.B_DEBUG)) {
   832				return;
   833			}
   834			int x = e.getX();
   835			int y = e.getY();
   836			for (int i = this.visualInformation.size() - 1; i >= 0; i--) {
   837				if (this.visualInformation.get(i).isOver(x, y, -this.curX + ApoSoccerConstants.BOARD_WIDTH, -this.curY + ApoSoccerConstants.BOARD_HEIGHT)) {
   838					this.centerEntity = this.visualInformation.get(i).getEntity();
   839					return;
   840				}
   841			}
   842	
   843		}

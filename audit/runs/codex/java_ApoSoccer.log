    88					result.createGraphics().drawImage(img,0,0,null);
    89					icon	= result;
    90				} catch (IOException e) {
    91					e.printStackTrace();
    92					return null;
    93				} catch (NullPointerException ex) {
    94					return  null;
    95				}
    96			} else {
    97				try {

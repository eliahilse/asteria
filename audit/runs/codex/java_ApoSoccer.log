   308		public boolean playStep(ApoTeam home, ApoTeam visitor, ApoBall ball, int delta, int addCurStep) {
   309			if (this.getCurStep() >= this.ball.size()) {
   310				return false;
   311			}
   312			
   313			this.setEntityPosition(home.getPlayer(ApoSoccerConstants.DEFENDER_ONE), this.homeDefenderOne, delta);
   314			this.setEntityPosition(home.getPlayer(ApoSoccerConstants.DEFENDER_TWO), this.homeDefenderTwo, delta);
   315			this.setEntityPosition(home.getPlayer(ApoSoccerConstants.FORWARD), this.homeForward, delta);

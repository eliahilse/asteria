   854		private void thinkMouseButton() {
   855			if (this.curMouseFunction == null) {
   856				return;
   857			}
   858			String function = this.curMouseFunction;
   859			this.curMouseFunction = null;
   860			if ((this.analysisFrame != null) && (this.analysisFrame.isBAnalysisTable())) {
   861				return;
   862			} else if (function.equals("quit")) {
   863				if (this.properties != null) {
   864					this.properties.setBBirdEyeView(ApoSoccerConstants.B_LITTLE_GAME);
   865					this.properties.setBDebug(ApoSoccerConstants.B_DEBUG);
   866					this.properties.writeProperties();
   867				}
   868				System.exit(0);
   869			} else if (function.equals("play")) {
   870				this.startGame();
   871			} else if (function.equals("stop")) {
   872				this.stopGame();
   873			} else if (function.equals("pause")) {
   874				this.bPause = !this.bPause;
   875				if (this.bPause) {
   876					this.bNextStep = false;
   877					this.setButtonVisible(ApoSoccerConstants.BUTTON_GAME_PAUSE);
   878				} else {
   879					if (this.replay.isBReplayPlay()) {
   880						this.setButtonVisible(ApoSoccerConstants.BUTTON_REPLAY);					
   881					} else {
   882						this.setButtonVisible(ApoSoccerConstants.BUTTON_GAME);
   883					}
   884				}
   885			} else if (function.equals("replayPlay")) {
   886				this.startReplay();
   887			} else if (function.equals("replaySave")) {
   888				this.replay.saveReplay();
   889			} else if (function.equals("replayLoad")) {
   890				if (this.replay.loadReplay()) {
   891					super.getButtons()[3].setBVisible(true);
   892				}
   893			} else if (function.equals("loadHomeAI")) {
   894				this.loadPlayer(true, null);
   895			} else if (function.equals("loadVisitorAI")) {
   896				this.loadPlayer(false, null);
   897			} else if (function.equals("playGameWithoutRepaint")) {
   898				this.playGameWithoutRepaint();
   899			} else if (function.equals("menu")) {
   900				this.setMenu();
   901			} else if (function.equals("soundOn")) {
   902				if (ApoSoccerConstants.B_MUSIC) {
   903					super.setBSound(true);
   904					this.homeTeam.setSpeechOn();
   905					this.visitorTeam.setSpeechOn();
   906					if (ApoConstants.B_APPLET) {
   907						this.setButtonVisible(ApoSoccerConstants.BUTTON_MENU_APPLET);
   908					} else {
   909						this.setButtonVisible(ApoSoccerConstants.BUTTON_MENU);
   910					}
   911				}
   912			} else if (function.equals("soundOff")) {
   913				super.setBSound(false);
   914				if (ApoConstants.B_APPLET) {
   915					this.setButtonVisible(ApoSoccerConstants.BUTTON_MENU_APPLET);
   916				} else {
   917					this.setButtonVisible(ApoSoccerConstants.BUTTON_MENU);
   918				}
   919			} else if (function.equals("debugChange")) {
   920				this.debugChange();
   921			} else if (function.equals("littleChange")) {
   922				this.littleGameChange();
   923			} else if (function.equals("previousAIVisitorApplet")) {
   924				this.curVisitorAIApplet--;
   925				if (this.curVisitorAIApplet < 0) {
   926					this.curVisitorAIApplet = 6;
   927				}
   928				this.loadAI(true, this.curVisitorAIApplet);
   929			} else if (function.equals("nextAIVisitorApplet")) {
   930				this.curVisitorAIApplet++;
   931				if (this.curVisitorAIApplet > 6) {
   932					this.curVisitorAIApplet = 0;
   933				}
   934				this.loadAI(true, this.curVisitorAIApplet);
   935			} else if (function.equals("previousAIHomeApplet")) {
   936				this.curHomeAIApplet--;
   937				if (this.curHomeAIApplet < 0) {
   938					this.curHomeAIApplet = 6;
   939				}
   940				this.loadAI(false, this.curHomeAIApplet);
   941			} else if (function.equals("nextAIHomeApplet")) {
   942				this.curHomeAIApplet++;
   943				if (this.curHomeAIApplet > 6) {
   944					this.curHomeAIApplet = 0;
   945				}
   946				this.loadAI(false, this.curHomeAIApplet);
   947			} else if (function.equals("playerXOne")) {
   948				for (int i = 0; i < this.homeTeam.getPlayers().size(); i++) {
   949					this.homeTeam.getPlayer(i).setBPlayerHuman(false);
   950					this.visitorTeam.getPlayer(i).setBPlayerHuman(false);
   951				}
   952				if (this.playerHuman != 1) {
   953					this.homeTeam.getPlayer(ApoSoccerConstants.FORWARD).setBPlayerHuman(true);
   954					this.playerHuman = 1;
   955					this.setHumanPlayer(ApoSoccerConstants.ONE_HUMAN_PLAYER);
  1190					this.setButtonVisible(ApoSoccerConstants.BUTTON_MENU);
  1191				}
  1192			}
  1193			this.simulate.startSimulate();
  1194			return true;

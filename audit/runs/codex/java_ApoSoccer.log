   339		private boolean setEntityPosition(ApoSoccerEntity entity, ArrayList<ApoFloatPoint> point, int delta) {
   340			entity.setX(point.get(this.getCurStep()).x);
   341			entity.setY(point.get(this.getCurStep()).y);
   342			entity.setSpeed(5);
   343			if (this.getCurStep() + 1 < point.size()) {
   344				entity.setLineOfSight((int)entity.getAngleBetweenTwoPoints(point.get(this.getCurStep() + 1).x, point.get(this.getCurStep() + 1).y));
   345			}
   346			entity.think(delta);
   347			if (entity instanceof ApoBall) {
   348				if (this.getCurStep() + 1 < point.size()) {
   349					if (Math.abs(point.get(this.getCurStep()).getX() - point.get(this.getCurStep() + 1).getX()) > 15) {
   350						this.bGoal = true;
   351						if (point.get(this.getCurStep()).getX() < ApoSoccerConstants.FIELD_WIDTH/2) {
   352							if (ApoSoccerConstants.LEFT_GOAL_REC.intersects(entity.getX() - entity.getWidth(), entity.getY() - entity.getWidth(), entity.getWidth() * 2, entity.getHeight() * 2)) {
   353								this.bHomeGoal = true;
   354							} else {
   355								this.bGoal = false;
   356							}
   357						} else if (point.get(this.getCurStep()).getX() > ApoSoccerConstants.FIELD_WIDTH/2) {
   358							if (ApoSoccerConstants.RIGHT_GOAL_REC.intersects(entity.getX() - entity.getWidth(), entity.getY() - entity.getWidth(), entity.getWidth() * 2, entity.getHeight() * 2)) {	
   359								this.bHomeGoal = false;
   360							} else {
   361								this.bGoal = false;
   362							}
   363						}
   364					} else {
   365						this.bGoal = false;
   366						this.bHomeGoal = false;
   367					}
   368				}
   369			}
   370			return true;
   371		}

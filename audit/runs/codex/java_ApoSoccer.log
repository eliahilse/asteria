   177		 * @param player : Spieler
   178		 * @param p : Punkt, wo der Spieler hinsoll
   179		 * @param bLeft : Boolean Variable, die angibt ob der links oder rechts dann spielt
   180		 */
   181		private void halfTimeChange(ApoPlayer player, Point p, boolean bLeft) {
   182			player.setStartX(p.x);
   183			player.setStartY(p.y);
   184			player.setBLeft(!bLeft);
   185			if (player.isBLeft()) {
   186				player.setStartLineOfSight(0);
   187			} else {
   188				player.setStartLineOfSight(180);
   189			}
   190			if (this.bHome) {
   191				player.setBKickOff(false);
   192			} else {
   193				player.setBKickOff(true);
   194			}
   195		}

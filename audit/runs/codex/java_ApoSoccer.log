   130		private boolean setTable(int end) {
   131			ArrayList<ApoSoccerAnalysisTable> table = new ArrayList<ApoSoccerAnalysisTable>();
   132			for (int i = 0; i < end; i++) {
   133				String homeTeam = this.analysis.get(i).getHomeAIClass();
   134				if (table.size() <= 0) {
   135					table.add(new ApoSoccerAnalysisTable(homeTeam));
   136					table.get(table.size() - 1).addScore(this.analysis.get(i).getScoreHome(), this.analysis.get(i).getScoreVisitor());
   137				} else {
   138					for (int tab = 0; tab < table.size(); tab++) {
   139						if (homeTeam.equals(table.get(tab).getName())) {
   140							table.get(tab).addScore(this.analysis.get(i).getScoreHome(), this.analysis.get(i).getScoreVisitor());
   141							break;
   142						} else if (tab == table.size() - 1) {
   143							table.add(new ApoSoccerAnalysisTable(homeTeam));
   144							table.get(table.size() - 1).addScore(this.analysis.get(i).getScoreHome(), this.analysis.get(i).getScoreVisitor());						
   145							break;
   146						}
   147					}
   148				}
   149				
   150				String visitorTeam = this.analysis.get(i).getVisitorAIClass();
   151				if (table.size() <= 0) {
   152					table.add(new ApoSoccerAnalysisTable(visitorTeam));
   153					table.get(table.size() - 1).addScore(this.analysis.get(i).getScoreVisitor(), this.analysis.get(i).getScoreHome());
   154				} else {
   155					for (int tab = 0; tab < table.size(); tab++) {
   156						if (visitorTeam.equals(table.get(tab).getName())) {
   157							table.get(tab).addScore(this.analysis.get(i).getScoreVisitor(), this.analysis.get(i).getScoreHome());
   158							break;
   159						} else if (tab == table.size() - 1) {
   160							table.add(new ApoSoccerAnalysisTable(visitorTeam));
   161							table.get(table.size() - 1).addScore(this.analysis.get(i).getScoreVisitor(), this.analysis.get(i).getScoreHome());						
   162							break;
   163						}
   164					}
   165				}
   166			}
   167			
   168			this.table = new ArrayList<ApoSoccerAnalysisTable>();
   169			while (table.size() > 0) {
   170				int maxI = 0;
   171				for (int i = 1; i < table.size(); i++) {
   172					if (table.get(i).getPoints() > table.get(maxI).getPoints()) {
   173						maxI = i;
   174					} else if (table.get(i).getPoints() == table.get(maxI).getPoints()) {
   175						int difI = table.get(i).getOwnGoal() - table.get(i).getEnemyGoal();
   176						int difMaxI = table.get(maxI).getOwnGoal() - table.get(maxI).getEnemyGoal();
   177						if (difI > difMaxI) {
   178							maxI = i;
   179						} else if (difI == difMaxI) {
   180							if (table.get(i).getOwnGoal() > table.get(maxI).getOwnGoal()) {
   181								maxI = i;
   182							}
   183						}
   184					}
   185				}
   186				this.table.add(table.get(maxI).getCopy());
   187				table.remove(maxI);
   188			}
   189			this.frame.makeTable();
   190			
   191			return true;
   192		}

   998		private void pauseWaitChange(int next) {
   999			if (this.waitPause < 0) {
  1000				if (next > 0) {
  1001					this.waitPause += 5;
  1002				} else if (next < 0) {
  1003					this.waitPause -= 5;
  1004				}
  1005				if (this.waitPause >= 0) {
  1006					this.waitPause = ApoSoccerConstants.WAIT_TIME_THINK;
  1007				} else if (this.waitPause < -11) {
  1008					this.waitPause = ApoSoccerConstants.WAIT_TIME_THINK * 100;
  1009				}
  1010			} else {
  1011				if (next > 0) {
  1012					this.waitPause *= 10;
  1013				} else if (next < 0) {
  1014					this.waitPause /= 10;
  1015				}
  1016				if (this.waitPause > ApoSoccerConstants.WAIT_TIME_THINK * 100) {
  1017					this.waitPause = -10;
  1018				} else if (this.waitPause < ApoSoccerConstants.WAIT_TIME_THINK) {
  1019					this.waitPause = -5;
  1020				}
  1020				}
  1021			}
  1022		}

    95				this.frame.getTextAreaGames().append(help.size()+" KI's k�mpfen in "+this.GAMES+" Saisons("+this.analysis.size()+" Partien insgesamt). Replayspeicherung ist "+this.B_WITH_REPLAY+"\n");
    96				
    97				for (int i = 0; i < this.analysis.size(); i++) {

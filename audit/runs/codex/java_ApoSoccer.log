    20		public ApoSoccerProperties() {
    21			this.homeAIPath = null;
    22			this.visitorAIPath = null;
    23			this.bBirdEyeView = false;
    24			this.bDebug = false;
    25		}
    26		
    27		public boolean loadProperties() {
    28			try {
    29				BufferedReader buffer = new BufferedReader(new FileReader(this.FILE_NAME));
    30				try {
    31					while (true) {
    32						String s = buffer.readLine();
    33						if (s.indexOf("HomeAI: ") != -1) {
    34							this.setHomeAIPath(s.replace("HomeAI: ", ""));
    35						} else if (s.indexOf("VisitorAI: ") != -1) {
    36							this.setVisitorAIPath(s.replace("VisitorAI: ", ""));
    37						} else if (s.indexOf("BirdEyeView: ") != -1) {
    38							String bool = s.replace("BirdEyeView: ", "");
    39							this.setBBirdEyeView(Boolean.parseBoolean(bool));
    40						} else if (s.indexOf("Debug: ") != -1) {
    41							String bool = s.replace("Debug: ", "");
    42							this.setBDebug(Boolean.parseBoolean(bool));
    43						}
    44					}
    45				} catch (Exception e) {
    46				}
    47				buffer.close();
    48			} catch (FileNotFoundException e) {
    49				return false;
    50			} catch (IOException e) {
    51				return false;
    52			}
    53			return true;
    54		}
    55	
    56		public boolean writeProperties() {
    57			try {
    58				BufferedWriter buffer = new BufferedWriter(new FileWriter(this.FILE_NAME));
    59				try {
    60					buffer.write("//Properties for ApoSoccer//");
    61					buffer.newLine();
    62					if (this.homeAIPath != null) {
    63						buffer.write("HomeAI: "+this.getHomeAIPath());
    64						buffer.newLine();
    65					}
    66					if (this.visitorAIPath != null) {
    67						buffer.write("VisitorAI: "+this.getVisitorAIPath());
    68						buffer.newLine();
    69					}
    70					buffer.write("BirdEyeView: "+String.valueOf(this.isBBirdEyeView()));
    71					buffer.newLine();
    72					buffer.write("Debug: "+String.valueOf(this.isBDebug()));
    73					buffer.newLine();
    74					buffer.close();
    75				} catch (Exception e) {
    76					System.out.println(e);
    77				}
    78			} catch (FileNotFoundException e) {
    79				return false;
    80			} catch (IOException e) {
    81				return false;
    82			}
    83			return true;
    84		}
    85		

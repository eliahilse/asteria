    19	
    20		public void loadSound(String name, String path) {
    21	
    22			if (this.sounds.containsKey(name)) {
    23				return;
    24			}
    25			URL sound_url = getClass().getClassLoader().getResource(path);
    26			this.sounds.put(name, (AudioClip) Applet.newAudioClip(sound_url));
    27		}
    28	
    29		public void playSound(String name) {
    30			AudioClip audio = this.sounds.get(name);
    31			audio.play();
    32		}
    33	
    34		public void loopSound(String name) {
    35			AudioClip audio = this.sounds.get(name);
    36			this.loopingClips.add(audio);
    37			audio.loop();
    38		}
    39	
    40		public void stopLoopingSound() {
    41			for (AudioClip c : this.loopingClips) {
    42				c.stop();
    43			}
    44		}
    45	
    46	}

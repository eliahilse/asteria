   140		public boolean halfTime() {
   141			boolean bLeft = this.team.get(0).isBLeft();
   142			if (bLeft) {
   143				this.halfTimeChange(this.team.get(ApoSoccerConstants.DEFENDER_ONE), ApoSoccerConstants.DEFENDER_ONE_RIGHT, bLeft);
   144				this.halfTimeChange(this.team.get(ApoSoccerConstants.DEFENDER_TWO), ApoSoccerConstants.DEFENDER_TWO_RIGHT, bLeft);
   145				this.halfTimeChange(this.team.get(ApoSoccerConstants.GOALKEEPER), ApoSoccerConstants.GOALKEEPER_RIGHT, bLeft);
   146				this.team.get(ApoSoccerConstants.GOALKEEPER).setWalkableArea(ApoSoccerConstants.RIGHT_GOALKEEPER_REC);
   147				this.halfTimeChange(this.team.get(ApoSoccerConstants.FORWARD), ApoSoccerConstants.FORWARD_RIGHT, bLeft);
   148				this.team.get(ApoSoccerConstants.FORWARD).setWalkableArea(ApoSoccerConstants.LEFT_SIDE_REC);
   149			} else {
   150				this.halfTimeChange(this.team.get(ApoSoccerConstants.DEFENDER_ONE), ApoSoccerConstants.DEFENDER_ONE_LEFT, bLeft);
   151				this.halfTimeChange(this.team.get(ApoSoccerConstants.DEFENDER_TWO), ApoSoccerConstants.DEFENDER_TWO_LEFT, bLeft);
   152				this.halfTimeChange(this.team.get(ApoSoccerConstants.GOALKEEPER), ApoSoccerConstants.GOALKEEPER_LEFT, bLeft);
   153				this.team.get(ApoSoccerConstants.GOALKEEPER).setWalkableArea(ApoSoccerConstants.LEFT_GOALKEEPER_REC);
   154				this.halfTimeChange(this.team.get(ApoSoccerConstants.FORWARD), ApoSoccerConstants.FORWARD_LEFT, bLeft);
   155				this.team.get(ApoSoccerConstants.FORWARD).setWalkableArea(ApoSoccerConstants.RIGHT_SIDE_REC);
   156			}
   157			for (int i = 0; i < this.team.size(); i++) {
   158				this.team.get(i).setHalfTime();
   159			}
   160			return true;
   161		}

   466		/**
   467		 * laed eine KI, wobei �bergeben wird um welchen Spieler es sich handelt und welche KI geladen werden soll
   468		 * @param player : Integervariable die angibt, welcher Spieler es ist
   469		 * @param ai : Integervariable die angibt, welche KI geladen werden soll
   470		 */
   471		public void loadPlayer(final int player, int ai, final boolean bSave) {
   472			ApoSkunkmanAI myAI = null;
   473			if (ai == ApoSkunkmanConstants.AI_LEFTRIGHT) {
   474				myAI = new ApoAILeftRight();
   475			} else if (ai == ApoSkunkmanConstants.AI_RUNNER) {
   476				myAI = new ApoAIRunner();
   477			} else if (ai == ApoSkunkmanConstants.AI_STINKY) {
   478				myAI = new StinkerMain();
   479			} else {
   480				ai = ApoSkunkmanConstants.AI_HUMAN;
   481				myAI = null;
   482			}
   483			this.game.getCurAI()[player] = ai;
   484			this.getLevel().getPlayers()[player].setAi(myAI, "", this);
   485			if (bSave) {
   486				if (player == 0) {
   487					ApoSkunkmanConstants.AI_ONE = String.valueOf(ai);
   488				} else if (player == 1) {
   489					ApoSkunkmanConstants.AI_TWO = String.valueOf(ai);
   490				} else if (player == 2) {
   491					ApoSkunkmanConstants.AI_THREE = String.valueOf(ai);
   492				} else if (player == 3) {
   493					ApoSkunkmanConstants.AI_FOUR = String.valueOf(ai);
   494				}
   495				ApoSkunkmanConstants.saveProperties();
   496			}
   497			this.makeBackground(true, false, false, false);
   498		}

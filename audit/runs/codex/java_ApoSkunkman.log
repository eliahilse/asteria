    35			c = loadClass(this.name);
    36			Object o;
    37			try {
    38				o = c.newInstance();
    39				if (o instanceof ApoSkunkmanAI) {
    40					ai = (ApoSkunkmanAI)o;
    41				}
    42			} catch (InstantiationException e) {

   402		/**
   403		 * handelt die Keyboardeingaben eines Menschen und steuert ihn
   404		 * @param delta : Zeit, die seit dem letzten Aufruf vergangen ist
   405		 * @param playerInt : gibt an um welchen Spieler es sich handelt
   406		 * @param left : welcher Button soll �berpr�ft werden, wenn der Spieler nach links gehen soll
   407		 * @param right : welcher Button soll �berpr�ft werden, wenn der Spieler nach rechts gehen soll
   408		 * @param up : welcher Button soll �berpr�ft werden, wenn der Spieler nach oben gehen soll
   409		 * @param down : welcher Button soll �berpr�ft werden, wenn der Spieler nach unten gehen soll
   410		 * @param lay : welcher Button soll �berpr�ft werden, wenn der Spieler ein Stinktier legen soll
   411		 */
   412		private void thinkHumanPlayer(final int delta, final int playerInt, final int left, final int right, final int up, final int down, final int lay) {
   413			if ((this.getGame().getLevel().getMaxPlayers() > playerInt) && (this.getGame().getLevel().getPlayers()[playerInt].isBVisible()) && 
   414				(this.getGame().getLevel().getPlayers()[playerInt].getAi() == null)) {
   415				ApoSkunkmanPlayer player = this.getGame().getLevel().getPlayers()[playerInt];
   416				if (!player.isMoving()) {
   417					if (this.getGame().getKeyboard().isPressed(left)) {
   418						player.setDirection(ApoSkunkmanConstants.PLAYER_DIRECTION_LEFT);
   419						if (this.getGame().getLevel().canPlayerGoLeft(player)) {
   420							player.setNextDirection(ApoSkunkmanConstants.PLAYER_DIRECTION_LEFT);
   421						}
   422					} else if (this.getGame().getKeyboard().isPressed(right)) {
   423						player.setDirection(ApoSkunkmanConstants.PLAYER_DIRECTION_RIGHT);
   424						if (this.getGame().getLevel().canPlayerGoRight(player)) {
   425							player.setNextDirection(ApoSkunkmanConstants.PLAYER_DIRECTION_RIGHT);
   426						}
   427					} else if (this.getGame().getKeyboard().isPressed(down)) {
   428						player.setDirection(ApoSkunkmanConstants.PLAYER_DIRECTION_DOWN);
   429						if (this.getGame().getLevel().canPlayerGoDown(player)) {
   430							player.setNextDirection(ApoSkunkmanConstants.PLAYER_DIRECTION_DOWN);
   431						}
   432					} else if (this.getGame().getKeyboard().isPressed(up)) {
   433						player.setDirection(ApoSkunkmanConstants.PLAYER_DIRECTION_UP);
   434						if (this.getGame().getLevel().canPlayerGoUp(player)) {
   435							player.setNextDirection(ApoSkunkmanConstants.PLAYER_DIRECTION_UP);
   436						}
   437					}
   438					if ((this.getGame().getKeyboard().isPressed(lay)) || (this.releasedKeys.contains(lay))) {
   439						int x = (int)(player.getX() / ApoSkunkmanConstants.TILE_SIZE);
   440						int y = (int)(player.getY() / ApoSkunkmanConstants.TILE_SIZE);
   441						if ((!player.isMoving()) && (player.canLaySkunkman()) && (this.getGame().getLevel().getLevel()[y][x] == null)) {
   442							player.setLaySkunkman(true);//this.getGame().getLevel().layBomb(x, y, player.getPlayer());
   443						}
   444					}
   445				}
   446			}
   447		}

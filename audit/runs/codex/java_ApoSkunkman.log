     1	package apoSkunkman.game;
     2	
     3	import java.io.DataInputStream;
     4	import java.io.DataOutputStream;
     5	import java.io.EOFException;
     6	import java.io.IOException;
     7	
     8	import org.apogames.ApoIO;
     9	
    10	import apoSkunkman.ApoSkunkmanConstants;
    11	import apoSkunkman.entity.ApoSkunkmanBush;
    12	import apoSkunkman.entity.ApoSkunkmanStone;
    13	
    14	/**
    15	 * Klasse zum Laden und Speichern von EditorLevels
    16	 * @author Dirk Aporius
    17	 *
    18	 */
    19	public class ApoSkunkmanEditorIO extends ApoIO {
    20	
    21		/** Integervariable die angibt, das diese Position mit einem Stein besetzt ist */
    22		public static final byte STONE = 0;
    23		/** Integervariable die angibt, das diese Position frei ist */
    24		public static final byte FREE = 1;
    25		/** Integervariable die angibt, das diese Position mit einem Busch besetzt ist */
    26		public static final byte BUSH = 2;
    27		/** Integervariable die angibt, das diese Position mit Spieler 1 besetzt ist */
    28		public static final byte PLAYER_ONE = 3;
    29		/** Integervariable die angibt, das diese Position mit Spieler 2 besetzt ist */
    30		public static final byte PLAYER_TWO = 4;
    31		/** Integervariable die angibt, das diese Position mit Spieler 3 besetzt ist */
    32		public static final byte PLAYER_THREE = 5;
    33		/** Integervariable die angibt, das diese Position mit Spieler 4 besetzt ist */
    34		public static final byte PLAYER_FOUR = 6;
    35		
    36		/** Das Levelobjekt */
    37		private final ApoSkunkmanPanel panel;
    38		
    39		public ApoSkunkmanEditorIO(final ApoSkunkmanPanel panel) {
    40			this.panel = panel;
    41		}
    42		
    43		@Override
    44		public boolean readLevel(DataInputStream data) throws EOFException, IOException {
    45			this.panel.getLevel().setType(ApoSkunkmanConstants.LEVEL_TYPE_EDITOR);
    46			this.panel.getLevel().setTime(data.readInt());
    47			for (int i = 0; i < ApoSkunkmanConstants.PLAYER_MAX_PLAYER; i++) {
    48				int x = data.readByte();
    49				int y = data.readByte();
    50				this.panel.getLevel().getPlayers()[i].setX(x * ApoSkunkmanConstants.TILE_SIZE);
    51				this.panel.getLevel().getPlayers()[i].setY(y * ApoSkunkmanConstants.TILE_SIZE);
    52			}
    53			for (int y = 1; y < this.panel.getLevel().getLevel().length - 1; y++) {
    54				for (int x = 1; x < this.panel.getLevel().getLevel()[0].length - 1; x++) {
    55					byte type = data.readByte();
    56					if (type == ApoSkunkmanEditorIO.FREE) {
    57						this.panel.getLevel().getLevel()[y][x] = null;
    58					} else if (type == ApoSkunkmanEditorIO.STONE) {
    59						this.panel.getLevel().getLevel()[y][x] = this.panel.getLevel().makeStone(x, y);
    60					} else if (type == ApoSkunkmanEditorIO.BUSH) {
    61						int goodie = data.readByte();
    62						ApoSkunkmanBush bush = this.panel.getLevel().makeBush(x, y, goodie);
    63						this.panel.getLevel().getLevel()[y][x] = bush;
    64					}
    65				}
    66			}
    67			int x = data.readByte();
    68			int y = data.readByte();
    69			this.panel.getLevel().getGoalX().x = (x);
    70			this.panel.getLevel().getGoalX().y = (y);
    71			
    72			return false;
    73		}
    74	
    75		@Override
    76		public boolean writeLevel(DataOutputStream data) throws IOException {
    77			data.writeInt(this.panel.getLevel().getTime());
    78			for (int i = 0; i < ApoSkunkmanConstants.PLAYER_MAX_PLAYER; i++) {
    79				byte x = (byte)(this.panel.getLevel().getPlayers()[i].getX() / ApoSkunkmanConstants.TILE_SIZE);
    80				byte y = (byte)(this.panel.getLevel().getPlayers()[i].getY() / ApoSkunkmanConstants.TILE_SIZE);
    81				data.writeByte(x);
    82				data.writeByte(y);
    83			}
    84			for (int y = 1; y < this.panel.getLevel().getLevel().length - 1; y++) {
    85				for (int x = 1; x < this.panel.getLevel().getLevel()[0].length - 1; x++) {
    86					if (this.panel.getLevel().getLevel()[y][x] == null) {
    87						data.writeByte(ApoSkunkmanEditorIO.FREE);
    88					} else if (this.panel.getLevel().getLevel()[y][x] instanceof ApoSkunkmanStone) {
    89						data.writeByte(ApoSkunkmanEditorIO.STONE);
    90					} else if (this.panel.getLevel().getLevel()[y][x] instanceof ApoSkunkmanBush) {
    91						data.writeByte(ApoSkunkmanEditorIO.BUSH);
    92						data.writeByte((byte)(((ApoSkunkmanBush)(this.panel.getLevel().getLevel()[y][x])).getGoodie()));
    93					}
    94				}
    95			}
    96			byte x = (byte)(this.panel.getLevel().getGoalX().x);
    97			byte y = (byte)(this.panel.getLevel().getGoalX().y);
    98			data.writeByte(x);
    99			data.writeByte(y);
   100			return false;
   101		}
   102	
   103	}


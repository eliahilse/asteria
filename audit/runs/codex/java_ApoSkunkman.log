   115		/**
   116		 * erstellt aus dem Hilfsobjekt das Level
   117		 * @param level : Level
   118		 */
   119		public final void makeLevelFromHelp(ApoSkunkmanLevel level) {
   120			if (this.help != null) {
   121				if (level.getGame().getEditor().getLevel() == null) {
   122					level.getGame().getEditor().setEditorLevel();
   123					level.getGame().getEditor().makeEditorLevel();
   124				}
   125				level.setType(ApoSkunkmanConstants.LEVEL_TYPE_EDITOR);
   126				level.setTime(this.help.getTime());
   127				for (int i = 0; i < ApoSkunkmanConstants.PLAYER_MAX_PLAYER; i++) {
   128					level.getPlayers()[i].setX(this.help.getPlayerArray()[i].x * ApoSkunkmanConstants.TILE_SIZE);
   129					level.getPlayers()[i].setY(this.help.getPlayerArray()[i].y * ApoSkunkmanConstants.TILE_SIZE);
   130				}
   131				for (int y = 1; y < level.getLevel().length - 1; y++) {
   132					for (int x = 1; x < level.getLevel()[0].length - 1; x++) {
   133						byte levelType = this.help.getLevelArray()[y][x][0];
   134	
   135						if (levelType == ApoSkunkmanEditorIO.FREE) {
   136							level.getLevel()[y][x] = null;
   137						} else if (levelType == ApoSkunkmanEditorIO.STONE) {
   138							level.getLevel()[y][x] = level.makeStone(x, y);
   139						} else if (levelType == ApoSkunkmanEditorIO.BUSH) {
   140							int goodie = this.help.getLevelArray()[y][x][1];
   141							ApoSkunkmanBush levelBush = level.makeBush(x, y, goodie);
   142							level.getLevel()[y][x] = levelBush;
   143						}
   144					}
   145				}
   146				level.getGoalX().x = (this.help.getGoalX().x);
   147				level.getGoalX().y = (this.help.getGoalX().y);
   148				level.getGame().getEditor().makeEditorLevel();
   149				level.getGame().getEditor().setEditorLevel();
   150			}
   151		}

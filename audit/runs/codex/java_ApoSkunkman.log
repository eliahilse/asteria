   548		public void saveReplay() {
   549			if (this.getFileChooserReplay().showSaveDialog(this.screen.getComponent()) == JFileChooser.APPROVE_OPTION) {
   550				String path = this.getFileChooserReplay().getSelectedFile().getPath();
   551				if (path.indexOf(this.getFileFilterReplay().getLevelName()) == -1) {
   552					path = path + this.getFileFilterReplay().getLevelName();
   553				}
   554				if (this.level.getType() == ApoSkunkmanConstants.LEVEL_TYPE_EDITOR) {
   555					this.level.getReplay().setEditorLevelString("Editor");
   556				} else {
   557					this.level.getReplay().setEditorLevelString("");
   558				}
   559				this.replayIO.writeLevel(path, this.level.getReplay());
   560			}
   561		}

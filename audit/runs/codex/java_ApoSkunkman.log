   414		/**
   415		 * laedt eine PlayerAI
   416		 * @param player = fuer welchen Spieler
   417		 * @param s = falls != NULL dann lade den uebergeben String
   418		 * @throws ClassNotFoundException
   419		 * @throws NoSuchMethodException
   420		 * @throws InstantiationException
   421		 * @throws IllegalAccessException
   422		 * @throws InvocationTargetException
   423		 */
   424		public void loadPlayer(final int player, final String s) {
   425			if (ApoConstants.B_APPLET) {
   426				return;
   427			}
   428			this.level.setReplayShowing(false);
   429			try {
   430				String res = null;
   431				String source = null;
   432				String playerName = null;
   433				String className = null;
   434				if (s == null) {
   435					if (this.getFileChooser().showOpenDialog(this.screen.getComponent()) == JFileChooser.APPROVE_OPTION) {
   436						res = this.getFileChooser().getSelectedFile().getPath();
   437						className = res.substring(res.lastIndexOf("."));
   438						res = res.substring(0, res.lastIndexOf("."));
   439						source = res.substring(0, res.lastIndexOf(File.separator)) + File.separator;
   440						res = res.substring(res.lastIndexOf(File.separator) + 1);
   441					} else {
   442						return;
   443					}
   444					if ((res == null) || (res.length() <= 0)) {
   445						return;    	
   446					}
   447					playerName	= res;
   448					this.loadPlayer(player, source, playerName, className);
   449				} else {
   450					try {
   451						int ai = Integer.valueOf(s);
   452						this.loadPlayer(player, ai, true);
   453					} catch (Exception ex) {
   454						res	= s;
   455				    	playerName = res.substring(res.lastIndexOf("\\") + 1, res.lastIndexOf("."));
   456						source = res.substring(0,res.lastIndexOf("\\") + 1);
   457						className = res.substring(res.lastIndexOf("."));
   458						this.loadPlayer(player, source, playerName, className);
   459					}
   460				}
   461			} catch (Exception ex) {
   462				this.loadPlayer(player, ApoSkunkmanConstants.AI_RUNNER, true);
   463			}
   464		}

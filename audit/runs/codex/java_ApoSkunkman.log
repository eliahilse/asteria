   270				if (bLayDown) {
   271					this.playerArray[player].add(ApoSkunkmanReplay.LEFT_LAY);
   272				} else {
   273					this.playerArray[player].add(ApoSkunkmanReplay.LEFT);
   274				}
   275			} else if (nextDirection == ApoSkunkmanConstants.PLAYER_DIRECTION_RIGHT) {
   276				if (bLayDown) {
   277					this.playerArray[player].add(ApoSkunkmanReplay.RIGHT_LAY);
   278				} else {
   279					this.playerArray[player].add(ApoSkunkmanReplay.RIGHT);
   280				}

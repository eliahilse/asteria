   396				this.thinkHumanPlayer(delta, 0, ApoSkunkmanConstants.PLAYER_ONE_LEFT, ApoSkunkmanConstants.PLAYER_ONE_RIGHT, ApoSkunkmanConstants.PLAYER_ONE_UP, ApoSkunkmanConstants.PLAYER_ONE_DOWN, ApoSkunkmanConstants.PLAYER_ONE_LAY);
   397				this.thinkHumanPlayer(delta, 1, ApoSkunkmanConstants.PLAYER_TWO_LEFT, ApoSkunkmanConstants.PLAYER_TWO_RIGHT, ApoSkunkmanConstants.PLAYER_TWO_UP, ApoSkunkmanConstants.PLAYER_TWO_DOWN, ApoSkunkmanConstants.PLAYER_TWO_LAY);

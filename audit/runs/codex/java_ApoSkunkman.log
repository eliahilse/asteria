   500		/**
   501		 * laed einen Spieler, wobei uebergeben wird welcher Spieler es ist, wie der Pfad lautet und wie die KI lautet
   502		 * @param player : Integervariable die angibt, welcher Spieler es ist
   503		 * @param path : Der Pfad wo die KI drinliegt
   504		 * @param classname : Der Klassenname
   505		 * @return immer TRUE
   506		 */
   507		private boolean loadPlayer(int player, String path, String classname, String classN) {
   508	    	ApoSkunkmanAI apoSkunkmanAI = null;
   509			if ((classN != null) && (classN.length() > 0) && (classN.indexOf(".class") != -1)) {
   510				if (!ApoConstants.B_APPLET) {
   511					try {
   512						apoSkunkmanAI = (ApoSkunkmanAI)(new ApoSkunkmanClassLoader(path, classname).getAI());
   513					} catch (Exception ex) {
   514						if (player == 0) {
   515							this.loadPlayer(player, ApoSkunkmanConstants.AI_HUMAN, true);
   516						} else {
   517							this.loadPlayer(player, ApoSkunkmanConstants.AI_RUNNER, true);						
   518						}
   519						return true;
   520					}
   521				}
   522			}
   523			try {
   524	        	if (apoSkunkmanAI != null) {
   525	        		this.getLevel().getPlayers()[player].setAi(apoSkunkmanAI, path, this);
   526	        		if (player == 0) {
   527	        			ApoSkunkmanConstants.AI_ONE = path + classname + classN;
   528	       			} else if (player == 1) {
   529	       				ApoSkunkmanConstants.AI_TWO = path + classname + classN;
   530	       			} else if (player == 2) {
   531	       				ApoSkunkmanConstants.AI_THREE = path + classname + classN;
   532	       			} else if (player == 3) {
   533	       				ApoSkunkmanConstants.AI_FOUR = path + classname + classN;
   534	       			}
   535	        		ApoSkunkmanConstants.saveProperties();
   536	        	}
   537			} catch (SecurityException e) {
   538				e.printStackTrace();
   539			} catch (IllegalArgumentException e) {
   540				e.printStackTrace();
   541			}
   542			return true;
   543		}

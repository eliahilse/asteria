   295		public final void receiveStep(ApoSkunkmanLevel level, int playerInt) {
   296			if (this.step[playerInt] >= this.playerArray[playerInt].size()) {
   297				System.out.println("Replaybug or old version replay");
   298			} else {
   299				int nextStep = this.playerArray[playerInt].get(this.step[playerInt]);
   300				ApoSkunkmanPlayer player = level.getPlayers()[playerInt];
   301				if ((nextStep == ApoSkunkmanReplay.DOWN) || (nextStep == ApoSkunkmanReplay.DOWN_LAY)) {
   302					player.setNextDirection(ApoSkunkmanConstants.PLAYER_DIRECTION_DOWN);
   303				} else if ((nextStep == ApoSkunkmanReplay.UP) || (nextStep == ApoSkunkmanReplay.UP_LAY)) {
   304					player.setNextDirection(ApoSkunkmanConstants.PLAYER_DIRECTION_UP);
   305				} else if ((nextStep == ApoSkunkmanReplay.LEFT) || (nextStep == ApoSkunkmanReplay.LEFT_LAY)) {
   306					player.setNextDirection(ApoSkunkmanConstants.PLAYER_DIRECTION_LEFT);
   307				} else if ((nextStep == ApoSkunkmanReplay.RIGHT) || (nextStep == ApoSkunkmanReplay.RIGHT_LAY)) {
   308					player.setNextDirection(ApoSkunkmanConstants.PLAYER_DIRECTION_RIGHT);
   309				}
   310				if ((nextStep == ApoSkunkmanReplay.STAND_LAY) || (nextStep == ApoSkunkmanReplay.DOWN_LAY) ||
   311					(nextStep == ApoSkunkmanReplay.UP_LAY) || (nextStep == ApoSkunkmanReplay.LEFT_LAY) ||
   312					(nextStep == ApoSkunkmanReplay.RIGHT_LAY)) {
   313					player.setLaySkunkman(true);
   314				} else {
   315					player.setLaySkunkman(false);
   316				}
   317				this.step[playerInt] += 1;
   318			}
   319		}

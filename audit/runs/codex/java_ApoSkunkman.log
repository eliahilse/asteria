    52		@SuppressWarnings({"deprecation"})
    53		public Class<?> loadClass(String name) throws ClassNotFoundException {
    54			Class<?> c;
    55			try {
    56				c = findLoadedClass(name);
    57	
    58				if (c == null) {
    59					// Convert class name argument to filename
    60					// Convert package names into subdirectories
    61					String filename = name.replace('.', File.separatorChar)	+ ".class";
    62					try {
    63						byte data[] = loadClassData(filename);
    64						c = defineClass(data, 0, data.length);
    65					} catch (IOException e) {
    66						// tritt auf, wenn die Datei nicht gefunden wurde
    67					} catch (NoClassDefFoundError e) {
    68						// tritt auf, wenn die Datei gefunden wurde,
    69						// aber eine Klasse enthaelt, die nicht dem Dateinamen
    70						// enspricht (Windows findet Dateien
    71						// auch bei falscher Gross-Klein-Schreibung)
    72					}
    73				}
    74	
    75				// Since all support classes of loaded class use same class loader
    76				// must check subclass cache of classes for things like Object
    77				if (c == null) {
    78					try {
    79						c = findSystemClass(name);
    80					} catch (Exception e) {
    81					}
    82				}
    83	
    84				if (c == null) {
    85					throw new ClassNotFoundException(name);
    86				}
    87	
    88			} catch (Throwable ex) {
    89				throw new ClassNotFoundException(name);
    90			}
    91	
    92			return c;
    93		}
    94	
    95		private byte[] loadClassData(String filename) throws IOException {
    96	
    97			// Create a file object relative to directory provided
    98			File f = new File(this.root, filename);
    99			
   100			// Get size of class file
   101			int size = (int) f.length();
   102			
   103			// Reserve space to read
   104			byte buff[] = new byte[size];
   105	
   106			// Get stream to read from
   107			FileInputStream fis = new FileInputStream(f);
   108			DataInputStream dis = new DataInputStream(fis);
   109	
   110			// Read in data
   111			dis.readFully(buff);
   112	
   113			// close stream
   114			dis.close();
   115	
   116			// return data
   117			return buff;

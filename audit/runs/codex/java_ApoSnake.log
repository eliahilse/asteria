   157		public static double getAngleBetween2Points( float x1, float y1, float x2, float y2 ) {
   158			double dx = x1 - x2;
   159			double dy = y1 - y2;
   160			double angle = 0.0d;
   161	 
   162			if ( dx == 0.0 ) {
   163				if ( dy == 0.0 ) {
   164					angle = 0.0;
   165				} else if ( dy > 0.0 ) {
   166					angle = Math.PI / 2.0;
   167				} else {
   168					angle = (Math.PI * 3.0) / 2.0;
   169				}
   170			}
   171			else if( dy == 0.0 ) {
   172				if( dx > 0.0 ) {
   173					angle = 0.0;
   174				} else {
   175					angle = Math.PI;
   176				}
   177			} else {
   178				if ( dx < 0.0 ) {
   179					angle = Math.atan( dy/dx ) + Math.PI;
   180				} else if( dy < 0.0 ) {
   181					angle = Math.atan( dy/dx ) + ( 2*Math.PI );
   182				} else {
   183					angle = Math.atan( dy/dx );
   184				}
   185			}
   186			return ( angle * 180 ) / Math.PI;

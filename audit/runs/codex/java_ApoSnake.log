   595		private final void a(int x, int y, int add, int snake) {		
   596			for (int j = 0; j < players.length; j++) {
   597				for (int l = 1; l < players[j].size(); l++) {
   598					ApoSnakeEntity entity = this.players[j].get(l);
   599					int otherColor = entity.getColor();
   600					int otherX = entity.getX();
   601					int otherY = entity.getY();
   602					if ((otherX == x) && (otherY == y)) {
   603						int minus = 1;
   604						if (add > 0) {
   605							minus = 0;
   606						}
   607						if (snake != j) {
   608							minus = 0;
   609						}
   610						for (int f = players[j].size() - 1 - minus; f >= l; f--) {
   611							entity = players[j].get(f);
   612							int removeX = entity.getX();
   613							int removeY = entity.getY();
   614							level[removeY][removeX] = 19 + otherColor;
   615							players[j].remove(f);
   616						}
   617						break;
   618					}
   619				}
   620			}
   621	
   622			level[y][x] = 0;
   623		}

   253		@Override
   254		public void think(int delta) {
   255			time += 10;
   256			if (time % 800 == 0) {
   257				bBlink = !bBlink;
   258			}
   259			
   260			if (level[0][0] == -1) {
   261				this.loadLevel(this.bEditor);
   262			}  else {
   263				int curX = -1, curY = -1;
   264				int addLeft = 0;
   265				for (int y = 0; y < level.length/2; y++) {
   266					for (int x = 0; x < level[y].length; x++) {
   267						if (level[y][x] == curSelect) {
   268							curX = x;
   269							curY = y;
   270						}
   271					}
   272				}
   273				
   274				if ((pressed[KeyEvent.VK_N]) || (pressed[KeyEvent.VK_P]) || (pressed[KeyEvent.VK_R])) {
   275					return;
   276				} else if (p[2] == 1) {
   277					return;
   278				} else if ((addX == 0) && (addY == 0) && (curShootX < 0) && (!bFall)) {
   279					ladder = new boolean[level.length][level[0].length];
   280					for (int x = 0; x < level[0].length; x++) {
   281						int addFall = 0;
   282						int addFallPlayer = 0;
   283						for (int y = level.length - 1; y >= 0; y--) {
   284							if (level[y][x] == 0) {
   285								addFallPlayer = addFall = 0;
   286							}
   287							if ((level[y][x] == 1) && ((x != goalX) || (y != goalY))) {
   288								addFall += 1;
   289								addFallPlayer += 1;
   290							}
   291							if ((x == goalX) && (y == goalY)) {
   292								addFallPlayer += 1;
   293							} else if ((((level[y][x] >= 5) && (level[y][x] <= 8)) && (addFall > 0)) || (((level[y][x] == 2) || (level[y][x] == 3)) && (addFallPlayer > 0) && (!ladder[y][x]))) {
   294								if (level[y][x] != 5) {
   295									addFall = addFallPlayer;
   296								}
   297								level[y + 16 + addFall][x] = addFall * 30;
   298								level[y + addFall][x] = level[y][x];
   299								level[y][x] = 1;
   300								bFall = true;
   301							} else if (level[y][x] == 6) {
   302								int count = 0;
   303								int play = 0;
   304								for (int above = y - 1; above >= 0; above--) {
   305									if (level[above][x] == 0) {
   306										break;
   307									}
   308									if ((level[above][x] == 2) || (level[above][x] == 3)) {
   309										play += 1;
   310									}
   311									if ((level[above][x] >= 5) || (play > 1)) {
   312										count = -1;
   313										break;
   314									}
   315									count += 1;
   316								}
   317								if (count > 0) {
   318									for (int above = y; above >= y - count; above--) {
   319										ladder[above][x] = true;
   320									}
   321								}
   322							}
   323	
   324						}
   325					}
   326					if (bFall) {
   327					} else
   328					// mouse clicked
   329						
   330					if (p[3] >= 0) {
   331						if ((p[3] > 0) && (p[3] < 480) && (p[4] > changeY) && (p[4] < 480 + changeY)) {
   332							int levelX = p[3] / 30;
   333							int levelY = (p[4] - changeY) / 30;
   334							if ((level[levelY][levelX] == 5) || (level[levelY][levelX] == 8) || (level[levelY][levelX] == 6)) {
   335								int goalShootX = p[3];
   336								int goalShootY = p[4] - changeY;
   337								for (int y = 0; y < level.length/2; y++) {
   338									for (int x = 0; x < level[y].length; x++) {
   339										if (level[y][x] == curSelect) {
   340											curShootX = x * 30 + 15;
   341											curShootY = y * 30 + 15;
   342											if (levelX == x) {
   343												curShootX = -1;
   344											}
   345										}
   346									}
   347								}
   348								
   349								if (curShootX > 0) {
   350									if (levelX < curX) {
   351										add = 2;
   352									} else {
   353										add = 0;
   354									}
   355									int ins = (int)(Math.abs(goalShootX - curShootX) + Math.abs(goalShootY - curShootY));
   356									vecX = (goalShootX - curShootX) / (float)(ins) * 2;
   357									vecY = (goalShootY - curShootY) / (float)(ins) * 2;
   358								}
   359							}
   360						}
   361						p[3] = -1;
   362					} else {
   363						int addUp = 0;
   364						// check the cursor keys and space
   365						if (pressed[KeyEvent.VK_SPACE]) {
   366							pressed[KeyEvent.VK_SPACE] = false;
   367							curSelect += 1;
   368							if (curSelect > 3) {
   369								curSelect = 2;
   370							}
   371						}
   372						if (pressed[KeyEvent.VK_LEFT]) {
   373							pressed[KeyEvent.VK_LEFT] = false;
   374							addLeft = -1;
   375							add = 2;
   376						} else if (pressed[KeyEvent.VK_RIGHT]) {
   377							pressed[KeyEvent.VK_RIGHT] = false;
   378							addLeft = 1;
   379							add = 0;
   380						} else if (pressed[KeyEvent.VK_UP]) {
   381							pressed[KeyEvent.VK_UP] = false;
   382							addUp = -1;
   383						} else if (pressed[KeyEvent.VK_DOWN]) {
   384							pressed[KeyEvent.VK_DOWN] = false;
   385							addUp = 1;
   386						}
   387						if (addUp != 0) {
   388							if ((ladder[curY + addUp][curX]) && (level[curY + addUp][curX] != 6)) {
   389								addY = addUp * -30;
   390								level[curY][curX] = 1;
   391								level[curY+addUp][curX] = curSelect;
   392							}
   393						}
   394						if (addLeft != 0) {
   395							if ((curX + addLeft >= 0) && (curX + addLeft < level[curY].length)) {
   396								if ((level[curY][curX + addLeft] == 1) || ((curY == goalY) && (curX + addLeft == goalX))) {
   397									level[curY][curX] = 1;
   398									addX = -addLeft * 30;
   399									level[curY][curX + addLeft] = curSelect;
   400									addY = 0;
   401								} else if ((curY - 1 >= 0) && (level[curY - 1][curX] == 1) && (((level[curY - 1][curX + addLeft] == 1) || ((curY - 1 == goalY) && (curX + addLeft == goalX))))) {
   402									level[curY][curX] = 1;
   403									level[curY-1][curX + addLeft] = curSelect;
   404									addX = -addLeft * 30;
   405									addY = 30;
   406								}
   407							}
   408						}
   409					}
   410				} else if (bFall) {
   411					bFall = false;
   412					for (int y = level.length - 1; y >= level.length/2; y--) {
   413						for (int x = 0; x < level[0].length; x++) {
   414							if (level[y][x] > 0) {
   415								level[y][x] -= 1;
   416								bFall = true;
   417							}
   418						}
   419					}
   420					if (!bFall) {
   421						if (level[goalY][goalX] == curSelect) {
   422							this.solvedLevel();
   423						}
   424					}
   425				} else if (curShootX >= 0) {
   426					curShootX += vecX;
   427					curShootY += vecY;
   428					if ((level[(int)(curShootY/30)][(int)(curShootX/30)] == 0) || (level[(int)(curShootY/30)][(int)(curShootX/30)] == 6) || (level[(int)(curShootY/30)][(int)(curShootX/30)] == 7) || (level[(int)(curShootY/30)][(int)(curShootX/30)] == 5) || (level[(int)(curShootY/30)][(int)(curShootX/30)] == 8)) {
   429						if (level[(int)(curShootY/30)][(int)(curShootX/30)] == 8) {
   430							level[(int)(curShootY/30)][(int)(curShootX/30)] = level[curY][curX];
   431							level[curY][curX] = 8;
   432						}
   433						if ((level[(int)(curShootY/30)][(int)(curShootX/30)] == 5) || (level[(int)(curShootY/30)][(int)(curShootX/30)] == 6)) {
   434							int cur = level[(int)(curShootY/30)][(int)(curShootX/30)];
   435							if (cur == 6) ladder = new boolean[level.length][level[0].length];
   436							addLeft = 1;
   437							if (vecX > 0) {
   438								addLeft = -1;
   439							}
   440							if (curSelect == 3) {
   441								addLeft = -addLeft;
   442							}
   443							curX = (int)(curShootX/30);
   444							curY = (int)(curShootY/30);
   445							if (addLeft != 0) {
   446								if ((curX + addLeft >= 0) && (curX + addLeft < level[curY].length)) {
   447									if (level[curY][curX + addLeft] == 1) {
   448										level[curY][curX] = 1;
   449										addX = -addLeft * 30;
   450										wallX = curX + addLeft;
   451										wallY = curY;
   452										level[curY][curX + addLeft] = cur;
   453										addY = 0;
   454									}
   455								}
   456							}
   457						}
   458						curShootX = -1;
   459						curShootY = -1;
   460					}
   461					
   462				} else {
   463					if (addY > 0) {
   464						addY -= 2;
   465					} else if (addX > 0) {
   466						addX -= 1;
   467					} else if (addX < 0) {
   468						addX += 1;
   469					} else if (addY < 0) {
   470						addY += 1;
   471					}
   472					if ((addY == 0) && (addX == 0)) {
   473						if (wallX >= 0) {
   474							wallX = -1;
   475						}
   476						if (level[goalY][goalX] == curSelect) {
   477							this.solvedLevel();
   478						}
   479					}
   480				}
   481			}
   482		}
   483		
   484		private void solvedLevel() {
   485			for (int i = 0; i < this.pressed.length; i++) {
   486				if (this.pressed[i]) {
   487					this.curPressed = i;
   488					break;
   489				}
   490			}
   491			p[2] = 1;
   492		}

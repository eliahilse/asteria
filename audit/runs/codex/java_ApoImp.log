   307		@Override
   308		public void render(Graphics2D g) {
   309			super.getGame().renderSnow(g);
   310			
   311			final int changeY = 30;
   312			g.setColor(new Color(150, 150, 190));
   313			g.fillRect(0, 0, 480, changeY);
   314			g.fillRect(0, changeY + 480, 480, 80 - changeY);
   315			g.setColor(new Color(40, 40, 80));
   316			g.drawRect(0, 0, 479, changeY);
   317			g.drawRect(0, changeY + 480, 479, 79 - changeY);
   318			
   319			g.setColor(ApoImpConstants.c2);
   320			String s = "ApoElf - Editor";
   321			g.setFont(g.getFont().deriveFont(20f).deriveFont(1));
   322			g.drawString(s, 10, 25);
   323			
   324			g.setFont(g.getFont().deriveFont(20f).deriveFont(1));
   325			for (int i = 0; i < this.buttons.length; i++) {
   326				this.buttons[i].render(g);
   327				if (i == 0) {
   328					g.setColor(ApoImpConstants.c2);
   329					g.fillRect((int)(this.buttons[i].getX() + 5), (int)(this.buttons[i].getY() + 5), 24, 24);
   330				} else if (i == 2) {
   331					this.drawPlayer(g, (int)(this.buttons[i].getX() + 2), (int)(this.buttons[i].getY() + 2), i);
   332				} else if (i == 3) {
   333					this.drawPlayer(g, (int)(this.buttons[i].getX() + 2), (int)(this.buttons[i].getY() + 2), i);
   334				} else if (i == 4) {
   335					this.drawGoal(g, (int)(this.buttons[i].getX() + 2), (int)(this.buttons[i].getY() + 2));
   336				} else if (i == 8) {
   337					this.drawBeamer(g, (int)(this.buttons[i].getX() + 2), (int)(this.buttons[i].getY() + 2));
   338				} else if (i > 4) {
   339					this.drawPresent(g, (int)(this.buttons[i].getX() + 2), (int)(this.buttons[i].getY() + 2), i);
   340				}
   341				if (i == this.curSelect) {
   342					g.setColor(Color.RED);
   343					g.drawRect((int)(this.buttons[i].getX()), (int)(this.buttons[i].getY()), (int)(this.buttons[i].getWidth()), (int)(this.buttons[i].getHeight()));
   344				}
   345			}
   346			
   347			for (int y = -level.length; y < level.length; y++) {
   348				for (int x = 0; x < level[0].length; x++) {
   349					if (y < 0) {
   350						if (level[y + level.length][x] != 0) {
   351							g.setColor(new Color(150, 150, 190));
   352							g.fillRect(x * 30, changeY + (y + level.length) * 30, 30, 30);
   353						}
   354						g.setColor(Color.BLACK);
   355						g.drawRect(x * 30, changeY + (y + level.length) * 30, 30, 30);
   356						continue;
   357					}
   358					if (level[y][x] != 0) {
   359						g.setColor(Color.BLACK);
   360						if (level[y-1][x] == 0) g.drawLine(x * 30, changeY + y * 30, (x + 1) * 30, changeY + y * 30);
   361						if (level[y+1][x] == 0) g.drawLine(x * 30, changeY + (y + 1) * 30, (x + 1) * 30, changeY + (y + 1) * 30);
   362						if (level[y][x-1] == 0) g.drawLine(x * 30, changeY + y * 30, (x + 0) * 30, changeY + (y + 1) * 30);
   363						if (level[y][x+1] == 0) g.drawLine((x + 1) * 30, changeY + y * 30, (x + 1) * 30, changeY + (y + 1) * 30);
   364						
   365						if (level[y][x] == 4) {
   366							/** Render das Ziel */							
   367							this.drawGoal(g, x * 30, y * 30 + changeY);
   368						}
   369						int addPX = 0;
   370						int addPY = 0;
   371						if (level[y][x] == 8) {
   372							this.drawBeamer(g, x * 30, y * 30 + changeY);
   373						}
   374						if ((level[y][x] >= 5) && (level[y][x] <= 7)) {
   375							this.drawPresent(g, x * 30, y * 30 + changeY, level[y][x]);
   376						}
   377						if ((level[y][x] == 2) || (level[y][x] == 3)) {
   378							int curX = x * 30 + addPX;
   379							int curY = changeY + y * 30 + addPY;
   380							this.drawPlayer(g, curX, curY, level[y][x]);
   381						}
   382					}
   383				}
   384			}
   385			
   386			if (this.uploadString != null) {
   387				this.uploadString.render(g, 0, 0);
   388			}
   389			
   390			if (this.curLevelX >= 0) {
   391				Composite composite = g.getComposite();
   392				g.setComposite(AlphaComposite.getInstance(AlphaComposite.SRC_OVER, (float)(128f/255f)));
   393				
   394				int i = this.curSelect;
   395				if (i == 0) {
   396					g.setColor(ApoImpConstants.c2);
   397					g.fillRect(this.curLevelX * 30, this.curLevelY * 30 + 30, 30, 30);
   398				} else if (i == 1) {
   399					g.setColor(ApoImpConstants.c);
   400					g.fillRect(this.curLevelX * 30, this.curLevelY * 30 + 30, 30, 30);
   401				} else if (i == 2) {
   402					this.drawPlayer(g, this.curLevelX * 30, this.curLevelY * 30 + 30, 2);
   403				} else if (i == 3) {
   404					this.drawPlayer(g, this.curLevelX * 30, this.curLevelY * 30 + 30, 3);
   405				} else if (i == 4) {
   406					this.drawGoal(g, this.curLevelX * 30, this.curLevelY * 30 + 30);
   407				} else if (i == 8) {
   408					this.drawBeamer(g, this.curLevelX * 30, this.curLevelY * 30 + 30);
   409				} else {
   410					this.drawPresent(g, this.curLevelX * 30, this.curLevelY * 30 + 30, i);
   411				}
   412				
   413				g.setComposite(composite);
   414			}
   415		}

   516							g.fillRect(x * 30 + 22, changeY + (y + level.length/2) * 30, 2, 30);
   517							g.fillRect(x * 30 + 7, changeY + (y + level.length/2) * 30 + 5, 16, 3);
   518							g.fillRect(x * 30 + 7, changeY + (y + level.length/2) * 30 + 15, 16, 3);
   519							g.fillRect(x * 30 + 7, changeY + (y + level.length/2) * 30 + 25, 16, 3);
   520						}
   521						if ((curShootX > 0) && (x == level[0].length - 1) && (y == -1)) {
   522							g.setColor(Color.RED);
   523							if (curSelect == 3) {
   524								g.setColor(Color.BLUE);
   525							}
   526							g.fillOval((int)(curShootX - 3), (int)(curShootY - 3 + changeY), 6, 6);
   527							g.setColor(Color.BLACK);
   528							g.drawOval((int)(curShootX - 3), (int)(curShootY - 3 + changeY), 6, 6);
   529						}
   530						continue;
   531					}
   532					if (level[y][x] != 0) {
   533						g.setColor(Color.BLACK);
   534						if (level[y-1][x] == 0) g.drawLine(x * 30, changeY + y * 30, (x + 1) * 30, changeY + y * 30);
   535						if (level[y+1][x] == 0) g.drawLine(x * 30, changeY + (y + 1) * 30, (x + 1) * 30, changeY + (y + 1) * 30);
   536						if (level[y][x-1] == 0) g.drawLine(x * 30, changeY + y * 30, (x + 0) * 30, changeY + (y + 1) * 30);
   537						if (level[y][x+1] == 0) g.drawLine((x + 1) * 30, changeY + y * 30, (x + 1) * 30, changeY + (y + 1) * 30);
   538						
   539						if ((x == goalX) && (y == goalY)) {
   540							/** Render das Ziel */							
   541							g.setColor(new Color(26, 157, 26));
   542							for (int i = 0; i < 20; i += 2) {
   543								g.fillRect(x * 30 + i/2 + 5, y * 30 + changeY + 25 - i, 20 - i, 2);
   544							}
   545							g.setColor(new Color(78, 58, 11));
   546							g.fillRect(x * 30 + 13, y * 30 + changeY + 25, 4, 5);
   547							
   548							g.setColor(new Color(228, 255, 0));
   549							g.fillRect(x * 30 + 11, y * 30 + changeY + 3, 8, 2);
   550							g.fillRect(x * 30 + 14, y * 30 + changeY, 2, 8);
   551							
   552							Color c = new Color(220, 40, 40);
   553							if (bBlink) {
   554								c = new Color(255 - c.getRed(), 255 - c.getGreen(), 255 - c.getBlue());
   555							}
   556							g.setColor(c);
   557							g.fillRect(x * 30 + 10, y * 30 + changeY + 25 - 4, 2, 2);
   558							g.fillRect(x * 30 + 18, y * 30 + changeY + 25 - 6, 2, 2);
   559							g.fillRect(x * 30 + 12, y * 30 + changeY + 25 - 11, 2, 2);
   560						}
   561						int addPX = 0;
   562						int addPY = -level[y+16][x];
   563						if (level[y][x] == 8) {
   564							if ((x == wallX) && (y == wallY)) {
   565								addPX += addX;
   566								addPY += addY;
   567							}
   568							g.setColor(new Color(40, 60, 80));
   569							g.fillRect(x * 30 + 8 + addPX, changeY + y * 30 + 10 + addPY, 14, 20);
   570							g.fillRect(x * 30 + 14 + addPX, changeY + y * 30 + addPY, 3, 3);
   571							g.fillRect(x * 30 + 15 + addPX, changeY + y * 30 + 3 + addPY, 1, 7);
   572							g.setColor(Color.WHITE);
   573							g.fillRect(x * 30 + 10 + addPX, changeY + y * 30 + 13 + addPY, 4, 2);
   574							g.fillRect(x * 30 + 16 + addPX, changeY + y * 30 + 13 + addPY, 4, 2);
   575							
   576						}
   577						if ((level[y][x] >= 5) && (level[y][x] <= 7)) {
   578							if ((x == wallX) && (y == wallY)) {
   579								addPX += addX;
   580								addPY += addY;
   581							}
   582							
   583							g.setColor(new Color(70, 195, 50));
   584							if (level[y][x] == 7) {
   585								g.setColor(new Color(195, 50, 70));								
   586							}
   587							if (level[y][x] == 6) {
   588								g.setColor(new Color(100, 120, 245));					
   589							}
   590							g.fillRect(x * 30 + 3 + addPX, changeY + y * 30 + 4 + addPY, 24, 24);
   591							g.setColor(Color.BLACK);
   592							g.drawRect(x * 30 + 3 + addPX, changeY + y * 30 + 4 + addPY, 24, 24);
   593							g.setColor(new Color(167, 73, 70));
   594							if (level[y][x] == 7) {
   595								g.setColor(new Color(73, 70, 167));								
   596							}
   597							if (level[y][x] == 6) {
   598								g.setColor(new Color(7, 50, 7));						
   599							}
   600							g.fillRect(x * 30 + 4 + addPX, changeY + y * 30 + 4 + addPY + 11, 23, 4);
   601							g.fillRect(x * 30 + 3 + addPX + 10, changeY + y * 30 + 5 + addPY, 4, 23);
   602							g.fillRect(x * 30 + 3 + addPX + 7, changeY + y * 30 + 4 + addPY - 3, 3, 3);
   603							g.fillRect(x * 30 + 3 + addPX + 14, changeY + y * 30 + 4 + addPY - 3, 3, 3);
   604							g.fillRect(x * 30 + 3 + addPX + 10, changeY + y * 30 + 4 + addPY - 2, 4, 2);
   605						}
   606						if ((level[y][x] == 2) || (level[y][x] == 3)) {
   607							if (level[y][x] == curSelect) {
   608								if (wallX < 0) {
   609									addPX = addX;
   610									addPY += addY;
   611								}
   612							}
   613							for (int i = 0; i < 2; i++) {
   614								int curX = x * 30 + addPX;
   615								int curY = changeY + y * 30 + addPY;
   616								if (i == 1) {
   617									if (level[y][x] != curSelect) {
   618										break;
   619									}
   620									curX = 5;
   230		}

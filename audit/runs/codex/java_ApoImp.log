   306		@Override
   307		protected void render(final Graphics2D g) {
   308			long t = System.nanoTime();
   309			if (this.iBackground != null) {
   310				g.drawImage(this.iBackground, 0, 0, null);
   311				this.background.renderHouseLightAndSled(g);
   312			}
   313			if (this.model != null) {
   314				g.setRenderingHint(RenderingHints.KEY_ANTIALIASING, RenderingHints.VALUE_ANTIALIAS_ON);
   315				this.model.render(g);
   316			}
   317			super.renderButtons(g);
   318			if (this.model != null) {
   319				this.model.drawOverlay(g);
   320			}
   321			this.renderFPS(g);
   322			this.renderTime = (int)(System.nanoTime() - t);
   323		}

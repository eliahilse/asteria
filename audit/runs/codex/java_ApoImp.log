    76		@Override
    77		public void run() {
    78			long unprocessedTimeThink = 0;
    79			long unprocessedTimeRender = 0;
    80			long msPerTickThink = (long)(1000.0 / (double)(ApoConstants.FPS_THINK));
    81			long msPerTickRender = (long)(1000.0 / (double)(ApoConstants.FPS_RENDER));
    82			this.frames = 0;
    83			long lastFpsTime = System.currentTimeMillis() - 1000;
    84			this.last = System.currentTimeMillis();
    85			this.isRunning = true;
    86	
    87			// eigentliche Spiellogikschleife
    88			while (this.isRunning) {
    89				long now = System.currentTimeMillis();
    90				long passedTime = now - this.last;
    91				// falls Zeit vergangen ist seit dem letzten Aufruf
    92				if (passedTime > 0) {
    93					unprocessedTimeThink += passedTime;
    94					unprocessedTimeRender += passedTime;
    95					// wenn nachgedacht werden soll dann denke nach
    96					while (unprocessedTimeThink >= msPerTickThink) {
    97						if (unprocessedTimeThink > 10 * msPerTickThink) {
    98							unprocessedTimeThink = 0;
    99						} else {
   100							unprocessedTimeThink -= msPerTickThink;
   101						}
   102						if (!this.bShouldThink) {
   103							unprocessedTimeThink = 0;
   104						} else {
   105							this.think(msPerTickThink);
   106						}
   107					}
   108					// wenn gezeichnet werden soll, dann zeichne neu
   109					if (unprocessedTimeRender >= msPerTickRender) {
   110						unprocessedTimeRender -= msPerTickRender;
   111						if (this.bShouldRepaint) {
   112							this.render();
   113						}
   114					}
   115					this.last = now;
   116				}
   117				// falls eine Sekunde vergangen ist, dann aktualisiere die FPSanzahl
   118				if (System.currentTimeMillis() - lastFpsTime > 1000) {
   119					if (!this.bShouldRepaint) {
   120						this.render();
   121					}
   122					lastFpsTime += 1000;
   123					this.screen.setFps(this.frames);
   124					this.frames = 0;
   125				}
   126	
   127				// leg den Thread f�r 10 Millisekunden schlafen
   128				try {
   129					Thread.sleep(10);
   130				} catch (InterruptedException e) {
   131				}
   132			}
   133		}

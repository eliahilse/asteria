   253		@Override
   254		public void mouseButtonReleased(int x, int y, boolean bRight) {
   255			if ((x > 30) && (x < 450) && (y > 60) && (y < 480)) {
   256				int lX = curLevelX = x / 30;
   257				int lY = curLevelY = (y - 30) / 30;
   258				int add = 0;
   259				if (level[lY][lX] != this.curSelect)  {
   260					if ((this.curSelect == 2) || (this.curSelect == 3) || (this.curSelect == 4)) {
   261						for (int ny = 0; ny < level.length; ny++) {
   262							for (int nx = 0; nx < level[ny].length; nx++) {
   263								if (level[ny][nx] == this.curSelect) {
   264									level[ny][nx] = 1;
   265								}
   266							}
   267						}
   268					}
   269					level[lY][lX] = this.curSelect + add;
   270					super.getGame().getButtons()[8].setBVisible(false);
   271					this.couldTestLevel();
   272					super.getGame().render();
   273				}
   274			} else {
   275				curLevelX = -1;
   276				for (int i = 0; i < this.buttons.length; i++) {
   277					if (this.buttons[i].intersects(x, y)) {
   278						if (i != this.curSelect) {
   279							this.curSelect = i;
   280							super.getGame().render();
   281						}
   282					}
   283				}
   284			}
   285		}

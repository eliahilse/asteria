   193		public void loadLevel(boolean bEditor) {
   194			if (bEditor) {
   195				if (p[2] > 0) {
   196					super.getGame().setEditor();
   197					super.getGame().save();
   198				} else {
   199					this.loadLevel(bEditor, this.curLevel);
   200				}
   201			} else {
   202				String l = "";
   203				if (this.bUserlevel) {
   204					if (p[0] >= ApoImpLevel.editorLevels.length) {
   205						p[0] = 0;
   206					}
   207					if (p[0] < 0) {
   208						p[0] = ApoImpLevel.editorLevels.length - 1;
   209					}
   210					l = ApoImpLevel.editorLevels[p[0]];
   211				} else {
   212					if (p[0] >= ApoImpLevel.levels.length) {
   213						p[0] = 0;
   214					}
   215					if (p[0] < 0) {
   216						p[0] = ApoImpLevel.levels.length - 1;
   217					}
   218					l = ApoImpLevel.levels[p[0]];
   219				}
   220				if (l.length() > 0) {
   221					this.loadLevel(this.bEditor, l);
   222				}
   223			}
   224		}

   175		/**
   176		 * wird aufgerufen wenn nachgedacht werden soll
   177		 * und gibt zur�ck, ob �berhaupt nachgedacht werden soll oder nicht
   178		 * @param delta : Zeit die seit dem letzten Aufruf vergangen ist in Millisekunden
   179		 * @return TRUE, Spiel wurde geupdatet ansonsten FALSE
   180		 */
   181		private final boolean think(long delta) {
   182			if (this.bShouldThink) {
   183				long time = System.nanoTime();
   184				this.update(delta);
   185				this.thinkTime = System.nanoTime() - time;
   186				return true;
   187			}
   188			return false;
   189		}

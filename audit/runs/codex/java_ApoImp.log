   283		public void think(final long delta) {
   284			long t = System.nanoTime();
   285			
   286			this.background.think((int)delta);
   287			
   288			for (int i = 0; i < snow.length; i += 4) {
   289				if ((snow[i+1] <= 0) || (snow[i+1] > 560)) {
   290					snow[i] = (int)(Math.random() * 470 + 1);
   291					snow[i+1] = 1;
   292					snow[i+2] = 0.004f + (float)(Math.random() * 0.004f);
   293					snow[i+3] = (float)(Math.random() * 0.1f) + 0.01f;
   294				} else {
   295					snow[i] += snow[i+2];
   296					snow[i+1] += snow[i+3];
   297				}
   298			}
   299			
   300			if (this.model != null) {
   301				this.model.think((int)delta);
   302			}
   303			this.thinkTime = (int) (System.nanoTime() - t);
   304		}
   305	
   306		@Override
   307		protected void render(final Graphics2D g) {
   308			long t = System.nanoTime();
   309			if (this.iBackground != null) {
   310				g.drawImage(this.iBackground, 0, 0, null);
   311				this.background.renderHouseLightAndSled(g);
   312			}
   313			if (this.model != null) {
   314				g.setRenderingHint(RenderingHints.KEY_ANTIALIASING, RenderingHints.VALUE_ANTIALIAS_ON);
   315				this.model.render(g);
   316			}
   317			super.renderButtons(g);
   318			if (this.model != null) {
   319				this.model.drawOverlay(g);
   320			}
   321			this.renderFPS(g);
   322			this.renderTime = (int)(System.nanoTime() - t);
   323		}

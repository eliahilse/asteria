   226		public void loadLevel(boolean bEditor, String l) {
   227			this.curLevel = l;
   228			level = new int[(l.length() / 14 + 2) * 2][16];
   229			ladder = new boolean[level.length][level[0].length];
   230			for (int y = 0; y < (level.length - 4)/2; y++) {
   231				for (int x = 0; x < level[0].length - 2; x++) {
   232					char c = l.charAt(y * 14 + x);
   233					level[y+1][x+1] = Integer.valueOf(c) - 48;
   234					if (level[y+1][x+1] == 4) {
   235						goalX = x+1;
   236						goalY = y+1;
   237					}
   238				}
   239			}
   240			curSelect = 2;
   241			addX = addY = p[1] = p[2] = p[3] = p[4] = 0;
   242			pressed = new boolean[256];
   243			bFall = false;
   244			bStart = true;
   245			
   246			this.bEditor = bEditor;
   247			if (this.bEditor) {
   248				this.getGame().getButtons()[9].setBVisible(false);
   249				this.getGame().getButtons()[10].setBVisible(false);
   250			}
   251		}

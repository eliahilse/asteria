   342	
   343				g.drawString("draw time: " + this.renderTime + " ns", 5, ApoImpConstants.GAME_HEIGHT - 25);
   344				g.drawString("draw time: " + (this.renderTime / 1000000) + " ms", 5, ApoImpConstants.GAME_HEIGHT - 15);
   345				g.drawString("FPS: " + super.getFPS(), 5, ApoImpConstants.GAME_HEIGHT - 5);
   346			}
   347		}

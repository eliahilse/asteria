   222		public void couldTestLevel() {
   223			int playerCount = 0;
   224			boolean bGoal = false;
   225			for (int y = 0; y < level.length; y++) {
   226				for (int x = 0; x < level[y].length; x++) {
   227					if ((level[y][x] == 2) || (level[y][x] == 3)) {
   228						playerCount += 1;
   229					}
   230					if (level[y][x] == 4) {
   231						bGoal = true;
   232					}
   233				}
   234			}
   235			if ((playerCount == 2) && (bGoal)) {
   236				this.getGame().getButtons()[5].setBVisible(true);
   237			} else {
   238				this.getGame().getButtons()[5].setBVisible(false);
   239			}
   240		}

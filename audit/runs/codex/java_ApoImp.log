   135		public boolean mouseMoved(int x, int y) {
   136			if ((x > 30) && (x < 450) && (y > 60) && (y < 480)) {
   137				curLevelX = x / 30;
   138				curLevelY = (y - 30) / 30;
   139			} else {
   140				curLevelX = -1;
   141			}
   142			boolean bOver = false;
   143			if (this.buttons != null) {
   144				for (int i = 0; i < this.buttons.length; i++) {
   145					if (this.buttons[i].getMove(x, y)) {
   146						bOver = true;
   147						if (!super.getGame().shouldRepaint()) {
   148							this.getGame().render();
   149						}
   150						break;
   151					} else if (this.buttons[i].isBOver()) {
   152						bOver = true;
   153					}
   154				}
   155			}
   156			if (bOver) {
   157				if (!this.bHandCursor) {
   158					this.getGame().getScreen().getComponent().setCursor(Cursor.getPredefinedCursor(Cursor.HAND_CURSOR));
   159					this.bHandCursor = true;
   160				}
   161			} else {
   162				if (this.bHandCursor) {
   163					this.getGame().getScreen().getComponent().setCursor(Cursor.getPredefinedCursor(Cursor.DEFAULT_CURSOR));
   164					this.bHandCursor = false;
   165				}
   166			}
   167			return true;
   168		}

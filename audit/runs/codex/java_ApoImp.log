   102		private String getLevelString() {
   103			String s = "";
   104			for (int y = 0; y < level.length - 2; y++) {
   105				for (int x = 0; x < level[0].length - 2; x++) {
   106					if (level[y+1][x+1] < 10) {
   107						s += String.valueOf(level[y+1][x+1]);
   108					} else {
   109						char c = (char)(level[y+1][x+1] + 87);
   110						s += String.valueOf(c);
   111					}
   112				}
   113			}
   114			return s;
   115		}

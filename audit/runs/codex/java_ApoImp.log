   453			g.fillRect((int)(curX) + 10, (int)(curY) + 20, 12, 2);
   454			g.fillRect((int)(curX) + 12, (int)(curY) + 22, 8, 2);
   455			g.fillRect((int)(curX) + 10, (int)(curY) + 16, 10, 2);

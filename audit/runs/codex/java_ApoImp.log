    91		public void createEmptyLevel(String l) {
    92			
    93			level = new int[l.length() / 14 + 2][16];
    94			for (int y = 0; y < level.length - 2; y++) {
    95				for (int x = 0; x < level[0].length - 2; x++) {
    96					char c = l.charAt(y * 14 + x);
    97					level[y+1][x+1] = Integer.valueOf(c) - 48;
    98				}
    99			}
   100		}

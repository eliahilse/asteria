    88		@Override
    89		public void keyButtonReleased(int button, char character) {
    90			if (button < 256) {
    91				pressed[button] = false;
    92			}
    93			bStart = true;
    94			if (button == KeyEvent.VK_ESCAPE) {
    95				this.quit();
    96			}
    97			if (p[2] > 0) {
    98				boolean bSolved = false;
    99				if (this.curPressed != button) {
   100					bSolved = true;
   101				} else {
   102					this.curPressed = -1;
   103				}
   104				if (bSolved) {
   105					this.loadNextLevel(+1);
   106					return;
   107				}
   108			} else if (button == KeyEvent.VK_L) {
   109				if (!ApoConstants.B_APPLET) {
   110					String s = ApoHelp.getClipboardContents();
   111					String oldLevel = this.curLevel;
   112					try {
   113						this.loadLevel(true, s);
   114						this.getGame().createEmptyLevel(s);
   115					} catch (Exception ex) {
   116						this.loadLevel(bEditor, oldLevel);
   117					}
   118				}
   119			} else if ((button == KeyEvent.VK_N) || (button == KeyEvent.VK_P) || (button == KeyEvent.VK_R)) {
   120				int add = 0;
   121				if (button == KeyEvent.VK_N) {
   122					add = 1;
   123				} else if (button == KeyEvent.VK_P)	{
   124					add = -1;
   125				}
   126				if ((add != 0) && (this.bEditor)) {
   127					return;
   128				}
   129				this.loadNextLevel(add);
   130				return;
   131			}
   132		}

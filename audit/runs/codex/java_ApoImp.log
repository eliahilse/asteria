   484		private void solvedLevel() {
   485			for (int i = 0; i < this.pressed.length; i++) {
   486				if (this.pressed[i]) {
   487					this.curPressed = i;
   488					break;
   489				}
   490			}
   491			p[2] = 1;
   492		}

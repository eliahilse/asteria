   495		public void render(Graphics2D g) {
   496			super.getGame().renderSnow(g);
   497			g.setColor(new Color(150, 150, 190));
   498			g.fillRect(0, 0, 480, changeY);
   499			g.fillRect(0, changeY + 480, 480, 80 - changeY);
   500			g.setColor(new Color(40, 40, 80));
   501			g.drawRect(0, 0, 479, changeY);
   502			g.drawRect(0, changeY + 480, 479, 79 - changeY);
   503	
   504			g.setFont(g.getFont().deriveFont(20f).deriveFont(1));
   505			
   506			for (int y = -level.length/2; y < level.length/2; y++) {
   507				for (int x = 0; x < level[0].length; x++) {
   508					if (y < 0) {
   509						if (level[y + level.length/2][x] != 0) {
   510							g.setColor(new Color(150, 150, 190));
   511							g.fillRect(x * 30, changeY + (y + level.length/2) * 30, 30, 30);
   512						}
   513						if (ladder[y + level.length/2][x]) {

   473		public static void saveData(final URL codebase, final String name, final String value) {
   474			Thread t = new Thread() {
   475				public void run() {
   476					String parametersAsString = "SET=&name=" + name + "&value=" + value;
   477					byte[] parameterAsBytes = parametersAsString.getBytes();
   478					URL url;
   479					try {
   480						url = new URL(codebase + "cookies.php");
   481						URLConnection con = url.openConnection();
   482						((HttpURLConnection) con).setRequestMethod("GET");
   483						con.setDoOutput(true);
   484						con.setDoInput(true);
   485						con.setUseCaches(false);
   486				
   487						OutputStream oStream = con.getOutputStream();
   488						oStream.write(parameterAsBytes);
   489						oStream.flush();
   490						
   491						BufferedReader iStream = new BufferedReader(new InputStreamReader(con.getInputStream()));
   492						iStream.readLine();
   493						iStream.close();
   494						oStream.close();
   495					} catch (MalformedURLException e) {
   496						e.printStackTrace();
   497					} catch (IOException e) {
   498						e.printStackTrace();
   499					}
   500				}
   501			};
   502			t.start();
   503		}

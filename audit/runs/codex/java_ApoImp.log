   459		private void drawGoal(Graphics2D g, int x, int y) {
   460			g.setColor(new Color(26, 157, 26));
   461			for (int i = 0; i < 20; i += 2) {
   462				g.fillRect(x + i/2 + 5, y + 25 - i, 20 - i, 2);
   463			}
   464			g.setColor(new Color(78, 58, 11));
   465			g.fillRect(x + 13, y + 25, 4, 5);

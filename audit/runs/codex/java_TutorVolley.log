    62						c = findSystemClass (name);
    63					} catch (Exception e)
    64					{
    65					}
    66				}
    67	
    68				if (c == null)
    69				{
    70					throw new ClassNotFoundException (name);
    71				}
    72				if (resolve)
    73					resolveClass (c);
    74	
    75			} catch(Throwable ex)
    76			{
    77				throw new ClassNotFoundException (name);
    78			}
    79	
    80			return c;
    81		}
    82	
    83		private byte[] loadClassData (String filename) 
    84		throws IOException
    85		{
    86	
    87			// Create a file object relative to directory provided
    88			File f = new File (root, filename);
    89			
    90			//System.out.println("f = "+f.toString());
    91	
    92			// Get size of class file
    93			int size = (int)f.length();
    94	
    95			// Reserve space to read
    96			byte buff[] = new byte[size];
    97	
    98			// Get stream to read from
    99			FileInputStream fis = new FileInputStream(f);
   100			DataInputStream dis = new DataInputStream (fis);
   101	
   102			// Read in data
   103			dis.readFully (buff);
   104	
   105			// close stream
   106			dis.close();
   107	
   108			// return data
   109			return buff;
   110		}

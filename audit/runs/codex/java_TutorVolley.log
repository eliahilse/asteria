   410		/**
   411		 * malt die Zeit
   412		 * @param g
   413		 */
   414		private void drawTime( Graphics2D g )
   415		{
   416			g.drawImage( this.iTime, 163, 7, this );
   417			long time		= TimeUnit.NANOSECONDS.toMillis( System.nanoTime() - this.time );
   418			String min = ""+( time/1000/60);
   419			String sec = ""+(( time/1000)%60);
   420			String msec = ""+(( time/10)%100);
   421			if (sec.length()<2) sec = "0"+sec;
   422			if (msec.length()<2) msec = "0"+msec;
   423			String timeString = min+":"+sec+":"+msec;
   424			int w	= g.getFontMetrics().stringWidth( timeString );
   425			g.drawString( timeString, 200 - w/2, 20 );
   426			if ( 	( !this.tutorVolleyPlayer[0].getName().equals( "Mensch" ) ) &&
   427					( !this.tutorVolleyPlayer[1].getName().equals( "Mensch" ) ) )
   428			{
   429				String s	= "ThinkCount = "+this.thinkCount;
   430				w	= g.getFontMetrics().stringWidth( s );
   431				g.drawString( s, 200 - w/2, 40 );
   432			}
   433		}

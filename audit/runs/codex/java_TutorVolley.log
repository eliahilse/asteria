   181		protected void think( int value )
   182		{
   183			if ( value == TutorVolleyPanelGame.BALL )
   184				this.thinkBall();
   185			else
   186				this.thinkPlayer( value - 1 );
   187			for ( int i = this.tutorVolleySnow.size() - 1; i >= 0; i-- )
   188			{
   189				this.tutorVolleySnow.get( i ).think();
   190				if ( this.tutorVolleySnow.get( i ).getY() >= this.getHeight() - 50 )
   191				{
   192					this.tutorVolleySnow.remove( i );
   193					int x	= (int)(Math.random() * (this.getWidth()+50)) - 50;
   194					this.tutorVolleySnow.add( new TutorVolleySnow( null, x, 0.0D, 3, 3 ) );
   195				} else if ( this.tutorVolleySnow.get( i ).getX() > this.getWidth() )
   196				{
   197					this.tutorVolleySnow.remove( i );
   198					int x	= (int)(Math.random() * (this.getWidth()+50)) - 50;
   199					this.tutorVolleySnow.add( new TutorVolleySnow( null, x, 0.0D, 3, 3 ) );
   200				}
   201			}
   202		}

    23				} else if ( player.getXMiddle() - 15 > ball.getXMiddle() )
    24				{
    25					player.setDirection( TutorVolleyPlayer.DIR_LEFT );
    26					return false;
    27				}
    28				return true;
    29			}
    30			if ( ball.getXMiddle() > player.getXMiddle() - 15 )
    31			{
    32				player.setDirection( TutorVolleyPlayer.DIR_RIGHT );
    33			} else if ( ( ball.getXMiddle() < player.getXMiddle() + 15 ) )
    34			{
    35				player.setDirection( TutorVolleyPlayer.DIR_LEFT );
    36			}

     9	
    10	public class ApoMarcPaddleAI {
    11		
    12		public void think(ApoMarcGame game, ApoMarcPlayer player, int delta) {
    13			ApoMarcPaddle paddle = game.getPaddle();
    14	//		if (player.getDifficulty() == ApoMarcConstants.DIFFICULTY_MARC) {
    15				if ((paddle.getY() < ApoMarcConstants.GAME_HEIGHT/2) && (paddle.getSpeed() == 0)) {
    16					int angle = (int)(ApoHelp.getAngleBetween2Points(paddle.getXMiddle(), paddle.getY(), player.getXMiddle(), player.getY() + player.getWidth()/2));
    17					player.setLos(angle);
    18					player.setSpeed(0.01f);
    19					player.setNewSpeedAndPosition(delta, game, player);
    20				} else {
    21					int angle = (int)(ApoHelp.getAngleBetween2Points(ApoMarcConstants.GAME_WIDTH/2, 60, player.getXMiddle(), player.getY() + player.getWidth()/2));
    22					player.setLos(angle);
    23					player.setSpeed(0.01f);
    24					if (!(new Rectangle2D.Float(ApoMarcConstants.GAME_WIDTH/2 - player.getWidth()/2 - 5, 60 - player.getWidth()/2 - 5, player.getWidth() + 10, player.getWidth() + 10)).contains(player.getX(), player.getY(), player.getWidth(), player.getWidth())) {
    25						player.setNewSpeedAndPosition(delta, game, player);
    26					}
    27				}
    28	//		}
    29		}
    30		
    31	}

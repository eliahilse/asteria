   141			if (this.buttons != null) {
   142				for (int i = 0; i < this.buttons.length; i++) {
   143					if (this.buttons[i].getPressed(x, y)) {
   144						if (!super.shouldRepaint()) {
   145							this.render();
   146						}
   147						break;
   148					}
   149				}
   150			}
   151		}

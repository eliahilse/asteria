   343		/**
   344		 * draws a string
   345		 * @param g
   346		 * @param s
   347		 * @param x
   348		 * @param y
   349		 * @param width
   350		 */
   351		public static void drawSpeech(Graphics2D g, String s, int x, int y, int width) {
   352			int curHeight = 0;
   353			int[] maxLength = new int[] {width - 4, width - 4, width - 4, width - 4};
   354			ArrayList<String> strings = new ArrayList<String>();
   355			strings.add(s);
   356			int cur = 0;
   357			int w = g.getFontMetrics().stringWidth(strings.get(cur));
   358			if (w > maxLength[curHeight]) {
   359				int curPos = strings.get(cur).indexOf(" ");
   360				while ((curPos > -1) && (g.getFontMetrics().stringWidth(strings.get(cur).substring(0, curPos)) < maxLength[curHeight])) {
   361					int nextPos = strings.get(cur).indexOf(" ", curPos + 1);
   362					if (nextPos != -1) {
   363						if (g.getFontMetrics().stringWidth(strings.get(cur).substring(0, nextPos)) >= maxLength[curHeight]) {
   364							String curString = strings.get(cur);
   365							strings.set(cur, curString.substring(0, curPos));
   366							cur++;
   367							if (curHeight == 0) {
   368								curHeight++;
   369							}
   370							strings.add(curString.substring(curPos + 1));
   371							curPos = strings.get(cur).indexOf(" ");
   372						} else {
   373							curPos = nextPos;
   374						}
   375					} else {
   376						String curString = strings.get(cur);
   377						if (g.getFontMetrics().stringWidth( curString ) > maxLength[curHeight]) {
   378							strings.set( cur, curString.substring(0, curPos) );
   379							cur++;
   380							strings.add( curString.substring(curPos + 1));
   381						}
   382						break;
   383					}
   384				}
   385			}
   386			int h = g.getFontMetrics().getHeight();
   387			for ( int i = 0; i < strings.size(); i++ ) {
   388				g.drawString(strings.get(i), x, y);
   389				y += h;
   390			}
   391		}
   392	}

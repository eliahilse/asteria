   196		/**
   197		 * wird aufgerufen, wenn das Spiel gezeichnet werden soll<br />
   198		 * Es unterscheidet dabei, ob es sich um eine normale Swingkomponente handelt, die einfach repaintet wird<br />
   199		 * oder um eine BufferStrategy, die anders gemalt wird<br />
   200		 */
   201		public void render() {
   202			if (this.screen.getBufferStrategy() != null) {
   203				long time = System.nanoTime();
   204				this.render(this.screen.getGraphics2D());
   205				this.screen.update();
   206				this.addFrame();
   207				this.renderTime = System.nanoTime() - time;
   208			} else {
   209				long time = System.nanoTime();
   210				this.render((Graphics2D)(this.offscreenGraphics));
   211	            this.addFrame();
   212	            
   213	            if (this.getScreen().getComponent() != null) {
   214	            	Graphics g = this.getScreen().getComponent().getGraphics();
   215	            	if (this.offscreenImage != null) {
   216	            		g.drawImage(this.offscreenImage, 0, 0, null);
   217	            	}
   218	            	g.dispose();
   219	            }
   220				this.renderTime = System.nanoTime() - time;
   221			}
   222		}

   116		/**
   117		 * der WiedergabeThread
   118		 */
   119		public void run() 
   120		{
   121			do{
   122			try {
   123				resetKorrektur = 0;
   124				AudioInputStream in = AudioSystem.getAudioInputStream(AudioFormat.Encoding.PCM_SIGNED, AudioSystem.getAudioInputStream(song));
   125				AudioFormat audioFormat = in.getFormat();
   126				SourceDataLine line = (SourceDataLine) AudioSystem.getLine(new DataLine.Info(SourceDataLine.class, audioFormat));
   127			    line.open(audioFormat);
   128			    FloatControl gainControl = (FloatControl)line.getControl(FloatControl.Type.MASTER_GAIN);
   129			    line.start();
   130			    //songLaenge = song.length();
   131			    sampleSizeInBits = audioFormat.getSampleSizeInBits();	
   132			    
   133			    if (in.getFrameLength() == -1){
   134			    	songTime.setTime(songLaenge/sampleSizeInBits - timeZoneKorrektur);
   135			    }
   136			    else{
   137			    	songTime.setTime((in.getFrameLength()/(long)audioFormat.getFrameRate())*1000 - timeZoneKorrektur);
   138			    }
   139			    
   140			    in.mark(in.available());
   141			    while ((true)&&(!stop)){
   142			    	isPlaying = true;
   143			    	int gainLevel= (int) ((int)gainControl.getMinimum()+((gainControl.getMaximum()-gainControl.getMinimum())/100*gainPercent));
   144			    	gainControl.setValue(gainLevel);
   145			    	if (!pause){
   146				    	int n = in.read(buffer, 0, buffer.length);
   147				    	if ((n < 0)||(stop)) {
   148				        	break;
   149				        }
   150				    	if (reset) {
   151				    		resetKorrektur =  line.getMicrosecondPosition()/1000;
   152				    		in.reset();
   153				    		reset = false;
   154				    	}
   155				    	time.setTime(line.getMicrosecondPosition()/1000 - timeZoneKorrektur - resetKorrektur);
   156				    	line.write(buffer, 0, n);
   157			    	}
   158			      }
   159			      line.drain();
   160			      line.close();
   161			      in.close();
   162				} catch (UnsupportedAudioFileException e) {
   163				    System.out.println("nicht unterst�tztes Format");
   164				} catch (IOException e) {
   165					System.out.println("Datei nicht gefunden" + e );
   166				} catch (LineUnavailableException e) {
   167					System.out.println("Soundkartenfehler");
   168				}
   169			}while (loopPlay && !stop);
   170			isPlaying = false;
   171		}

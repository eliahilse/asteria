    19	public class ApoMidiPlayer {
    20	
    21		// Midi meta event
    22		public static final int END_OF_TRACK_MESSAGE = 47;
    23	
    24		private Sequencer sequencer;
    25		private Synthesizer synthesizer;
    26	
    27		private boolean paused;
    28	
    29		/**
    30		 * Creates a new MidiPlayer object.
    31		 */
    32		public ApoMidiPlayer() {
    33			try {
    34				MidiDevice.Info[] info = MidiSystem.getMidiDeviceInfo();
    35				for (int i = 0; i < info.length; i++) {
    36					if (info[i].getName().indexOf("Sequence") != -1) {
    37						this.sequencer = (Sequencer) MidiSystem.getMidiDevice(info[i]);
    38					} else if (info[i].getName().indexOf("Synthe") != -1) {
    39						this.synthesizer = (Synthesizer) MidiSystem.getMidiDevice(info[i]);
    40					}
    41				}
    42				if (this.sequencer != null) {
    43					this.sequencer.open();
    44				}
    45				if (this.synthesizer != null) {
    46					this.synthesizer.open();
    47				}
    48				if ((this.sequencer != null) && (this.synthesizer != null)) {
    49					Receiver synthReceiver = synthesizer.getReceiver();
    50					Transmitter seqTransmitter = sequencer.getTransmitter();
    51					seqTransmitter.setReceiver(synthReceiver);
    52				}
    53			} catch (MidiUnavailableException ex) {
    54				this.sequencer = null;
    55				this.synthesizer = null;
    56			}
    57		}
    58	
    59		/**
    60		 * Loads a sequence from the file system. Returns null if an error occurs.
    61		 */
    62		public Sequence getSequence(String filename) {
    63			try {
    64				return getSequence(new FileInputStream(filename));
    65			} catch (IOException ex) {
    66				ex.printStackTrace();
    67				return null;
    68			}
    69		}
    70	
    71		/**
    72		 * Loads a sequence from an input stream. Returns null if an error occurs.
    73		 */
    74		public Sequence getSequence(InputStream is) {
    75			try {
    76				if (!is.markSupported()) {
    77					is = new BufferedInputStream(is);
    78				}
    79				Sequence s = MidiSystem.getSequence(is);
    80				is.close();
    81				return s;
    82			} catch (InvalidMidiDataException ex) {
    83				ex.printStackTrace();
    84				return null;
    85			} catch (IOException ex) {
    86				ex.printStackTrace();
    87				return null;
    88			}
    89		}
    90	
    91		/**
    92		 * Plays a sequence, optionally looping. This method returns immediately.
    93		 * The sequence is not played if it is invalid.
    94		 */
    95		public void play(Sequence sequence, boolean loop) {
    96			if ((this.sequencer != null) && (sequence != null) && (this.sequencer.isOpen())) {
    97				try {
    98					this.sequencer.setSequence(sequence);
    99					this.sequencer.start();
   100				} catch (InvalidMidiDataException ex) {
   101					System.out.println(ex.getMessage());
   102				}
   103			}
   104		}
   105	
   106		/**
   107		 * Stops the sequencer and resets its position to 0.
   108		 */
   109		public void stop() {
   110			if ((this.sequencer != null) && (this.sequencer.isOpen())) {
   111				this.sequencer.stop();
   112				this.sequencer.setMicrosecondPosition(0);
   113			}
   114		}
   115	
   116		/**
   117		 * Closes the sequencer.
   118		 */
   119		public void close() {
   120			if ((this.sequencer != null) && (this.sequencer.isOpen())) {
   121				this.sequencer.close();
   122			}
   123		}
   124	
   125		/**
   126		 * Gets the sequencer.
   127		 */
   128		public Sequencer getSequencer() {
   129			return this.sequencer;
   130		}
   131	
   132		/**
   133		 * Sets the paused state. Music may not immediately pause.
   134		 */
   135		public void setPaused(boolean paused) {
   136			if ((this.paused != paused) && (this.sequencer != null) && (this.sequencer.isOpen())) {
   137				this.paused = paused;
   138				if (paused) {
   139					this.sequencer.stop();
   140				} else {
   141					this.sequencer.start();
   142				}
   143			}
   144		}
   145	
   146		/**
   147		 * Returns the paused state.
   148		 */
   149		public boolean isPaused() {
   150			return this.paused;
   151		}
   152	
   153		/**
   154		 * set Volume off the midi
   155		 * Must be between 0 and 100
   156		 * @param volume : between 0 and 100
   157		 */
   158		public void setVolume(int volume) {
   159			try {
   160				MidiChannel[] channels = this.synthesizer.getChannels();
   161				double gain = (float) volume / 100f;
   162				for (int i = 0; i < channels.length; i++) {
   163					channels[i].controlChange(7, (int) (gain * 127.0));
   164				}
   165			} catch (Exception e) {
   166				System.out.println(e.getMessage());
   167			}
   168		}

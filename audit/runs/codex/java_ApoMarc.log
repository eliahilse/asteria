   130					this.bHandCursor = true;
   131				}
   132			} else {
   133				if (this.bHandCursor) {
   134					this.screen.getComponent().setCursor(Cursor.getPredefinedCursor(Cursor.DEFAULT_CURSOR));
   135					this.bHandCursor = false;
   136				}
   137			}
   138		}

   180		/**
   181		 * wird aufgerufen wenn nachgedacht werden soll
   182		 * und gibt zur�ck, ob �berhaupt nachgedacht werden soll oder nicht
   183		 * @param delta : Zeit die seit dem letzten Aufruf vergangen ist in Millisekunden
   184		 * @return TRUE, Spiel wurde geupdatet ansonsten FALSE
   185		 */
   186		private final boolean think(long delta) {
   187			if (this.bShouldThink) {
   188				long time = System.nanoTime();
   189				this.update(delta);
   190				this.thinkTime = System.nanoTime() - time;
   191				return true;
   192			}
   193			return false;
   194		}

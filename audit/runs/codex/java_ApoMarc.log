    83					URL connection = new URL(fileName);
    84					data = new DataInputStream(connection.openStream());
    85				}
    86				try	{
    87					this.readLevel( data );
    88				} catch ( EOFException e ) {
    89				}
    90				data.close();
    91			} catch ( IOException e ) {
    92				System.out.println("Error: "+e);
    93				return false;
    94			}
    95			return true;
    96		}

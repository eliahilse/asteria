   230		/**
   231		 * �berpr�ft, ob diese Entity sich mit den �bergebenen Werten schneidet
   232		 * @param x : x-Wert des Mittelpunktes der mit �berpr�ft werden soll
   233		 * @param y : y-Wert des Mittelpunktes der mit �berpr�ft werden soll
   234		 * @param radius : Radius der zu �berpr�fenden Werte
   235		 * @return TRUE, falls sie sich schneiden, sonst FALSE
   236		 */
   237		public boolean intersects(float x, float y, float radius) {
   238			float newX = ((x - (this.getX() + this.getWidth()/2))*(x - (this.getX() + this.getWidth()/2)));
   239			float newY = ((y - (this.getY() + this.getWidth()/2))*(y - (this.getY() + this.getWidth()/2)));
   240			float newRadius = ((radius + this.getWidth()/2)*(radius + this.getWidth()/2));
   241			if ( newX + newY <= newRadius ) {
   242				return true;
   243			}
   244			return false;
   245		}

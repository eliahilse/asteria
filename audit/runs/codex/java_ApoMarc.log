    16	/**
    17	 * Klasse, die ein BufferedImage l�dt
    18	 * @author Dirk Aporius
    19	 *
    20	 */
    21	public class ApoImage extends Component implements ImageObserver {
    22		
    23		private static final long serialVersionUID = 1L;
    24		
    25		private Component component;
    26		
    27		/**
    28		 * Konstruktor
    29		 */
    30		public ApoImage() {
    31			this.component = this;
    32		}
    33		
    34		/**
    35		 * l�dt das Bild aus dem �bergbenen String und wartet bis es fertig geladen ist
    36		 * @param BildString = wo steckt das Bild
    37		 * @param bLoad = TRUE wenn extern laden, FALSE wenn Image in der JAR
    38		 * @return gibt das geladenen Bild zur�ck
    39		 */
    40		public BufferedImage getPic(String pic, boolean bLoad) 
    41		{
    42			BufferedImage i;
    43			MediaTracker mt;
    44			mt = new MediaTracker(this.component);// damit alles mit einmal angezeigt wird
    45			
    46			try {
    47				i = getImage(pic, bLoad);
    48				if (i == null) {
    49					return null;
    50				}
    51			} catch (IllegalArgumentException ex) {
    52				return null;
    53			}
    54			mt.addImage(i, 0);
    55	
    56			try {
    57				// Wait until all pic are load,
    58				mt.waitForAll();
    59			} catch (InterruptedException e) {
    60				// nothing
    61			}
    62			return i;
    63		}
    64		
    65		/**
    66		 * l�dt das Bild aus einem �bergebenen String
    67		 * @param BildName = wo steckt das Bild
    68		 * @param bLoad
    69		 * @return das Bild
    70		 */
    71		private BufferedImage getImage(String pic, boolean bLoad)	{
    72			BufferedImage icon = null;
    73			
    74			BufferedImage img		= null;
    75			
    76			if ( !bLoad ) {
    77				try	{
    78					img = ImageIO.read(this.getClass().getClassLoader().getResource(pic));
    79					icon	= img;
    80				} catch (IOException e) {
    81					e.printStackTrace();
    82					return null;
    83				} catch (NullPointerException ex) {
    84					return  null;
    85				}
    86			} else {
    87				try {
    88					if ( ApoConstants.B_APPLET ) {
    89						img = ImageIO.read(new URL(pic));
    90					} else {
    91						img = ImageIO.read(new File(pic));
    92					}
    93					//result = this.graphicsConfiguration.createCompatibleImage(img.getWidth(),img.getHeight(), BufferedImage.TYPE_INT_ARGB);
    94					//result.createGraphics().drawImage(img,0,0,null);
    95					icon	= img;
    96				} catch (MalformedURLException e) {
    97					System.out.println("Konnte das Bild "+pic+" nicht laden");
    98					return null;
    99				} catch (IOException e) {
   100					System.out.println("Konnte das Bild "+pic+" nicht laden");
   101					return null;
   102				}
   103			}
   104			return (icon);
   105		}
   106		
   107	}

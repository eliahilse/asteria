    11	public class ApoMidi {
    12	
    13		private ArrayList<Sequence> songs = new ArrayList<Sequence>();
    14		private Sequencer sequencer;
    15		
    16		public void addSong(String s) {
    17			try {
    18				if (this.sequencer == null) {
    19					this.sequencer = MidiSystem.getSequencer();
    20					this.sequencer.open();
    21				}
    22				this.songs.add(MidiSystem.getSequence(ApoMidi.class.getResourceAsStream(s)));
    23			} catch (Exception ex) {
    24				this.sequencer = null;
    25				this.songs.clear();
    26				System.out.println("Ex mit "+ex.getMessage());
    27			}
    28		}
    29	
    30		public void startMusic(int song) {
    31			this.stopMusic();
    32			if ((song < 0) || (song > this.songs.size()) || (this.songs.size() <= 0)) {
    33				return;
    34			}
    35			if (this.sequencer != null) {
    36				try {
    37					this.sequencer.open();
    38					this.sequencer.setSequence((Sequence) null);
    39					this.sequencer.setSequence(this.songs.get(song));
    40					this.sequencer.setLoopCount(Sequencer.LOOP_CONTINUOUSLY);
    41					this.sequencer.start();
    42				} catch (Exception e) {
    43				}
    44			}
    45		}
    46	
    47		public void stopMusic() {
    48			if (this.sequencer != null) {
    49				try {
    50					this.sequencer.stop();
    51					this.sequencer.close();
    52				} catch (Exception e) {
    53				}
    54			}
    55		}
    56	
    57		public void setVolume(int volume) {
    58			try {
    59				if (this.sequencer instanceof Synthesizer) {
    60					MidiChannel[] channels = ((Synthesizer)(this.sequencer)).getChannels();
    61					double gain = (float) volume / 100f;
    62					for (int i = 0; i < channels.length; i++) {
    63						channels[i].controlChange(7, (int) (gain * 127.0));
    64					}
    65					System.out.println("Check");
    66				}
    67			} catch (Exception e) {
    68				System.out.println(e.getMessage());
    69			}
    70		}
    71	}

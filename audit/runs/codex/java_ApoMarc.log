    11		public static final int MAX_NO_MOVEMENT = 10000;
    12		
    13		private int curTime;
    14		
    15		private boolean bFirstTouch;
    16		
    17		public ApoMarcPaddle(float x, float y, float width, Color myColor, Rectangle2D.Float collisionRec) {
    18			super(x, y, width, myColor, false, collisionRec);
    19			
    20			this.init();
    21		}
    22		
    23		public void init() {
    24			super.init();
    25			
    26			super.setSpeed(0);
    27			super.setMinWidth(1);

   180		public static ArrayList<ApoFloatPoint> getCircleCuts(float x1, float y1, float radius1, float x2, float y2, float radius2) {
   181			ArrayList<ApoFloatPoint> results = new ArrayList<ApoFloatPoint>();
   182	
   183			double resultX1 = -10000, resultX2 = -10000, resultY1 = -10000, resultY2 = -10000;
   184	
   185			if ((x2 == x1) && (y2 == y1)) {
   186				return results;
   187			} else {
   188				double c1 = ((radius1 * radius1) - (radius2 * radius2) - (x1 * x1) + (x2 * x2) - (y1 * y1) + (y2 * y2)) / (2.0 * x2 - 2.0 * x1);
   189				double c2 = (y1 - y2) / (x2 - x1);
   190				double k1 = 1.0 + (1.0 / Math.pow(c2, 2.0));
   191				double k2 = 2.0 * x1 + (2.0 * y1) / (c2) + (2.0 * c1) / Math.pow(c2, 2.0);
   192				double k3 = x1 * x1 + (c1 * c1) / (c2 * c2) + (2.0 * y1 * c1) / (c2) + (y1 * y1) - (radius1 * radius1);
   193				System.out.println("resultX1: "+resultX1);
   194				resultX1 = ((k2 / k1) / 2.0) + Math.sqrt((Math.pow((k2 / k1), 2.0) / 4.0) - (k3 / k1));
   195				System.out.println("resultX1: "+resultX1);
   196				resultX2 = (k2 / k1) / 2.0 - Math.sqrt((Math.pow((k2 / k1), 2.0) / 4.0) - (k3) / (k1));
   197				resultY1 = 1.0 / (c2) * resultX1 - (c1 / c2);
   198				resultY2 = 1.0 / (c2) * resultX2 - (c1 / c2);
   199			}
   200			
   201			if ((resultX1 != -10000) && (resultY1 != -10000)) {
   202				System.out.println("resultX1: "+resultX1);
   203				results.add(new ApoFloatPoint((float)(resultX1), (float)(resultY1)));
   204			}
   205			if ((resultX2 != -10000) && (resultY2 != -10000)) {
   206				results.add(new ApoFloatPoint((float)(resultX2), (float)(resultY2)));
   207			}
   208			return results;
   209		}

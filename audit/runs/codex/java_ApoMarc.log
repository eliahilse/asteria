   172		/**
   173		 * setzt den Wert, ob neu gezeichnet werden soll auf den �bergebenen
   174		 * @param shouldRepaint : TRUE Spiel soll immer neu gezeichnet werden, FALSE Spiel soll nur neu gezeichnet werden, wenn man �ber einen Button f�hrt
   175		 */
   176		public void setShouldRepaint(boolean shouldRepaint) {
   177			this.bShouldRepaint = shouldRepaint;

   188		public BufferedImage getButtonWithImage(int width, int height, BufferedImage iPic, Color background, Color border, Color mousePressed, Color mouseReleased) {
   189			BufferedImage iButton = GraphicsEnvironment.getLocalGraphicsEnvironment().getDefaultScreenDevice().getDefaultConfiguration().createCompatibleImage(width,height,BufferedImage.TRANSLUCENT);
   190			Graphics2D g = (Graphics2D)iButton.getGraphics();
   191			
   192			g.setRenderingHint(RenderingHints.KEY_ANTIALIASING, RenderingHints.VALUE_ANTIALIAS_ON);
   193			
   194			int oneWidth = width/3;
   195			int widthPic = 0;
   196			if (iPic != null) {
   197				widthPic = iPic.getWidth();
   198			}
   199			
   200			for ( int i = 0; i < 3; i++ ) {
   201				g.setColor( background );
   202				g.fillRoundRect( (width)/3 * i, 0, (width)/3 - 1, height - 1, 5, 5 );
   203				
   204				if (iPic != null) {
   205					g.drawImage(iPic, oneWidth * i + oneWidth/2 - widthPic/2, height/2 - iPic.getHeight()/2, null);
   206				}
   207				if (i == 0) {
   208					g.setColor(background);
   209				} else if (i == 1) {
   210					g.setColor(mousePressed);
   211				} else {
   212					g.setColor(mouseReleased);
   213				}
   214				g.drawRoundRect((width)/3 * i + 1, 1, (width)/3 - 3, height - 3, 5, 5);
   215				
   216				g.setColor(border);
   217				g.drawRoundRect((width)/3 * i, 0, (width)/3 - 1, height - 1, 5, 5);
   218			}
   219			
   220			g.dispose();
   221			return iButton;
   222		}

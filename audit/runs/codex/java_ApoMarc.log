   139		public void setNewSpeedAndPosition(int delta, ApoMarcGame game, ApoMarcPlayer player) {
   140			float oldX = this.getX();
   141			float oldY = this.getY();
   142			
   143			float radius = (float)player.getSpeed() * delta * 30;
   144			double alpha = player.getLos();
   145			if (alpha > 360) {
   146				alpha = 360 - alpha;
   147			} else if (alpha < 0) {
   148				alpha = 360 + alpha;
   149			}
   150			if (radius > 0.001f) {
   151				float newX = player.getX() + player.getWidth()/2 + radius * (float)Math.cos(Math.toRadians(alpha));
   152				float newY = player.getY() + player.getWidth()/2 + radius * (float)Math.sin(Math.toRadians(alpha));
   153				this.setX(newX - player.getWidth()/2);
   154				this.setY(newY - player.getWidth()/2);
   155				float next = 0.000002f * delta;
   156				this.setSpeed(player.getSpeed() - next);
   157				
   158				if (!this.collisionRec.contains(this.getX(), this.getY(), this.getWidth(), this.getWidth())) {
   159					this.setX(oldX);
   160					this.setY(oldY);
   161				}
   162			} else {
   163				this.setSpeed(0);
   164			}
   165		}

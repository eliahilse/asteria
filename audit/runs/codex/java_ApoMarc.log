    73		 * @param bURL: TRUE = Level aus dem Internet laden, sonst von der Festplatte
    74		 */
    75		public boolean readLevel(boolean bURL, String fileName) {
    76			try {
    77				DataInputStream data;
    78				if (!bURL) {
    79					FileInputStream file		= new FileInputStream(fileName);
    80					BufferedInputStream buff	= new BufferedInputStream(file);

    41		@Override
    42		public void thinkEntity(int delta, ApoMarcGame game) {
    43			if (this.getY() + this.getWidth() < 0) {
    44				game.getPlayers()[1].addOnePoint();
    45				this.setNewPaddle(true);
    46			} else if (this.getY() > ApoMarcConstants.GAME_HEIGHT) {
    47				game.getPlayers()[0].addOnePoint();
    48				this.setNewPaddle(false);
    49			}
    50			float oldX = this.getX();
    51			float oldY = this.getY();
    52			
    53			super.setNewSpeedAndPosition(delta, game, this);
    54	
    55			float newX = this.getX();
    56			float newY = this.getY();
    57			
    58			if ((oldX != newX) || (oldY != newY)) {
    59				for (int i = 0; i < game.getWalls().length; i++) {
    60					if (game.getWalls()[i].intersects(this)) {
    61						ApoMarcWall wall = game.getWalls()[i];
    62						wall.nextColor();
    63						if (this.getSpeed() != 0) {
    64							if (wall.getHeight() > wall.getWidth()) {
    65								if ((super.getLos() >= 90) && (super.getLos() <= 270)) {
    66									if (super.getLos() < 180) {
    67										float dif = super.getLos() - 90;
    68										this.setLos(90 - dif);
    69									} else {
    70										float dif = 270 - super.getLos();
    71										this.setLos(270 + dif);
    72									}
    73									wall.makeEffects((int)(this.getX()), (int)(this.getY() + this.getWidth()/2));
    74								} else {
    75									if (super.getLos() < 180) {
    76										this.setLos(180 - super.getLos());
    77									} else {
    78										float dif = 270 - super.getLos();
    79										this.setLos(270 + dif);
    80									}
    81									wall.makeEffects((int)(this.getX() + this.getWidth()), (int)(this.getY() + this.getWidth()/2));
    82								}
    83	
    84								this.setPaddleBackWall(wall, this);
    85							} else {
    86								if (super.getLos() >= 180) {
    87									if (super.getLos() >= 270) {
    88										this.setLos(360 - super.getLos());
    89									} else {
    90										float dif = 180 - super.getLos();
    91										this.setLos(180 + dif);
    92									}
    93									wall.makeEffects((int)(this.getX() + this.getWidth()/2), (int)(this.getY()));
    94								} else {
    95									if (super.getLos() < 90) {
    96										this.setLos(360 - super.getLos());
    97									} else {
    98										float dif = 180 - super.getLos();
    99										this.setLos(180 + dif);
   100									}
   101									wall.makeEffects((int)(this.getX() + this.getWidth()/2), (int)(this.getY() + this.getWidth()));
   102								}
   103								this.setPaddleBackWall(wall, this);
   104								if (game.getWalls()[i].intersects(this)) {
   105									if ((super.getLos() >= 90) && (super.getLos() <= 270)) {
   106										if (super.getLos() < 180) {
   107											float dif = super.getLos() - 90;
   108											this.setLos(90 - dif);
   109										} else {
   110											float dif = 270 - super.getLos();
   111											this.setLos(270 + dif);
   112										}
   113										wall.makeEffects((int)(this.getX()), (int)(this.getY() + this.getWidth()/2));
   114									} else {
   115										if (super.getLos() < 180) {
   116											this.setLos(180 - super.getLos());
   117										} else {
   118											float dif = 270 - super.getLos();
   119											this.setLos(270 + dif);
   120										}
   121										wall.makeEffects((int)(this.getX() + this.getWidth()), (int)(this.getY() + this.getWidth()/2));
   122									}
   123								}
   124							}
   125						}
   126					}
   127				}
   128				if (super.checkPlayerIntersects(game, 0)) {
   129					this.makeEffects((int)(this.getX() + this.getWidth()/2), (int)(this.getY() + this.getWidth()));
   130				}
   131			}
   132			if (super.getX() < 10) {
   133				super.setX(10);
   134			} else if (super.getX() + super.getWidth() > ApoMarcConstants.GAME_WIDTH - 10) {
   135				super.setX(ApoMarcConstants.GAME_WIDTH - 10 - super.getWidth());
   136			}
   137			if (!this.bFirstTouch) {
   138				this.curTime += delta;
   139				if (super.getSpeed() != 0) {
   140					this.curTime = 0;
   141				}
   142				if (this.curTime > ApoMarcPaddle.MAX_NO_MOVEMENT) {
   143					if (this.getY() + this.getWidth()/2 < ApoMarcConstants.GAME_HEIGHT/2) {
   144						game.getPlayers()[1].addOnePoint();
   145						this.setNewPaddle(true);
   146					} else {
   147						game.getPlayers()[0].addOnePoint();
   148						this.setNewPaddle(false);
   149					}
   150				}
   151			}
   152		}
   153		
   154		public void littleMinSize() {
   155			super.littleMinSize();
   156			super.setBRepeat(true);
   157		}
   158		
   159		private void setNewPaddle(boolean bAbove) {
   160			this.setSpeed(0);
   161			this.setMyColor(this.getMyOrgColor());
   162			this.setX(ApoMarcConstants.GAME_WIDTH/2 - this.getWidth()/2);
   163			this.setY(ApoMarcConstants.GAME_HEIGHT/2 + 30);
   164			if (bAbove) {
   165				this.setY(ApoMarcConstants.GAME_HEIGHT/2 - 30 - this.getWidth());	
   166			}
   167			this.bFirstTouch = true;
   168		}
   169	
   170	}

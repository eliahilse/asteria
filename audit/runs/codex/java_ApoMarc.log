    12	 */
    13	public class ApoCopy {
    14	
    15		/**
    16		 * Konstruktor
    17		 */
    18		public ApoCopy() {
    19		}
    20		
    21		/**
    22		 * kopiert ein komplettes Verzeichnis (ohne Unterverzeichnisse)
    23		 * in einen �bergebenen Bereich
    24		 * @param pSrcDirectory = String mit Pfadangabe zum Ordner, welcher kopiert werden 
    25		 * @param pCopyDirectory = String mit Pfadangabe zum Ordner, wohin kopiert werden soll
    26		 */
    27		public void copyDirectory( String pSrcDirectory, String pCopyDirectory ) {
    28			File srcDirectory = new File(pSrcDirectory);
    29			if (!srcDirectory.exists()) {
    30				return;
    31			}
    32			File copyDirectory = new File( pCopyDirectory );
    33			if (!copyDirectory.exists()) {
    34				copyDirectory.mkdirs();
    35			}
    36			File[] files = srcDirectory.listFiles();
    37			for ( int i = 0; i < files.length; i++ ) {
    38				if (!files[i].isDirectory()) {
    39					String fileName = files[i].getPath().substring(files[i].getPath().lastIndexOf(File.separator));
    40					if(!new File(pCopyDirectory + File.separator + fileName).exists()) {
    41						this.copyFile(files[i].getPath(), pCopyDirectory + File.separator + fileName);
    42					}
    43				}
    44			}
    45		}
    46		
    47		/**
    48		 * kopiert eine Datei in ein anderes �bergebenes Verzeichnis
    49		 * @param pSrcFile = String mit Pfadangabe zur Datei, welche kopiert werden soll
    50		 * @param pCopyFile = String mit Pfadangabe zur Datei, wohin kopiert werden soll
    51		 */
    52		public void copyFile( String pSrcFile, String pCopyFile ) {
    53			FileInputStream fis = null;
    54			FileOutputStream fos = null;
    55			
    56			try {
    57				fis = new FileInputStream(pSrcFile);
    58				fos = new FileOutputStream(pCopyFile);
    59				
    60				byte[] buffer = new byte[0xFFFF];
    61				for ( int len; (len = fis.read(buffer)) != -1; ) {
    62					fos.write(buffer, 0, len);
    63				}
    64			} catch (IOException e) {
    65				e.printStackTrace();
    66			} finally {
    67				if ( fis != null ) {
    68					try { fis.close(); } catch (IOException e) { e.printStackTrace(); }
    69				}
    70				if ( fos != null ) {
    71					try { fos.close(); } catch (IOException e) { e.printStackTrace(); }
    72				}
    73			}
    74		}
    75		
    76	}

    15	
    16	public class AudioPlayer implements Runnable {
    17		private static final int EXTERNAL_BUFFER_SIZE = 128000;
    18	
    19		private final boolean BInJAR = true;
    20		
    21		private String path;
    22		
    23		private boolean bStop;
    24		
    25		private boolean bLoop;
    26		
    27		private ApoSoundThread soundThread;
    28		
    29		public AudioPlayer(String path, boolean bLoop) {
    30			this.path = path;
    31			this.bLoop = bLoop;
    32			this.bStop = false;
    33		}
    34	
    35		public void start() {
    36			this.soundThread = new ApoSoundThread(this);
    37			this.soundThread.start();
    38			Thread t = new Thread(this);
    39			t.start();
    40		}
    41		
    42		public boolean isBStop() {
    43			return this.bStop;
    44		}
    45	
    46		public void setBStop(boolean stop) {
    47			this.bStop = stop;
    48		}
    49	
    50		public boolean isBLoop() {
    51			return this.bLoop;
    52		}
    53	
    54		public void setBLoop(boolean loop) {
    55			this.bLoop = loop;
    56		}
    57	
    58		public void run() {
    59			try {
    60				while(this.soundThread.isRunning()) {
    61					do {
    62						AudioInputStream audioInputStream = null;
    63						try {
    64							if (this.BInJAR) {
    65								audioInputStream = AudioSystem.getAudioInputStream(AudioFormat.Encoding.PCM_SIGNED, AudioSystem.getAudioInputStream(this.getClass().getResource(this.path)));
    66							} else {
    67								if (ApoConstants.B_APPLET) {
    68									audioInputStream = AudioSystem.getAudioInputStream(new URL("http://www.apo-games.de/apoPongBeat" + this.path));
    69								} else {
    70									audioInputStream = AudioSystem.getAudioInputStream(new File(System.getProperty("user.dir") + this.path.replace("/", File.separator)));	
    71								}
    72							}
    73						} catch (Exception e) {
    74							System.out.println("Fehler: "+e.getMessage()+" "+this.path+" "+e.getCause());
    75						}
    76	
    77						AudioFormat audioFormat = audioInputStream.getFormat();
    78					
    79						SourceDataLine line = null;
    80						DataLine.Info info = new DataLine.Info(SourceDataLine.class,audioFormat);
    81						try {
    82							line = (SourceDataLine) AudioSystem.getLine(info);
    83							line.open(audioFormat);
    84						} catch (LineUnavailableException e) {
    85						} catch (Exception e) {
    86						}
    87	
    88						line.start();
    89	
    90						int nBytesRead = 0;
    91						byte[] abData = new byte[EXTERNAL_BUFFER_SIZE];
    92						while ((nBytesRead != -1) && (!this.isBStop())) {
    93							try {
    94								nBytesRead = audioInputStream.read(abData, 0, abData.length);
    95							} catch (IOException e) {
    96							}
    97							if (nBytesRead >= 0) {
    98								line.write(abData, 0, nBytesRead);
    99							}
   100						}
   101						line.drain();
   102						line.close();
   103					} while ((!this.isBStop()) && (this.isBLoop()));
   104					this.soundThread.stop();
   105				}
   106				try {
   107					/*synchronized(this.soundThread)*/ {
   108						this.soundThread.wait((long)10);
   109					}
   110				} catch(InterruptedException e) {
   111					(this.soundThread).stop();
   112				}
   113			} catch (Exception ex) {
   114				
   115			}
   116		}
   117	
   118	}

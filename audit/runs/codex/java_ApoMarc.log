   107		public boolean setNewPosition(float newX, float newY, ApoMarcGame game) {
   108			float oldX = this.getX();
   109			float oldY = this.getY();
   110			
   111			if (newY < ApoMarcConstants.GAME_HEIGHT/2) {
   112				return false;
   113			}
   114			if (newY + this.getWidth() > ApoMarcConstants.GAME_HEIGHT - 10) {
   115				return false;
   116			}
   117			this.setX(newX);
   118			this.setY(newY);
   119			for (int i = 0; i < game.getWalls().length; i++) {
   120				if (game.getWalls()[i].intersects(this)) {
   121					this.setX(oldX);
   122					this.setY(oldY);
   123					return false;
   124				}
   125			}
   126			if (!this.collisionRec.contains(this.getX(), this.getY(), this.getWidth(), this.getWidth())) {
   127				this.setX(oldX);
   128				this.setY(oldY);
   129				return false;
   130			}
   131			float maxSpeed = (Math.abs(oldX - newX) + Math.abs(oldY - newY)) * 0.015f;
   132			if (this.checkPlayerIntersects(game, maxSpeed)) {
   133				this.makeEffects((int)(game.getPaddle().getXMiddle()), (int)(game.getPaddle().getY() + game.getPaddle().getWidth()/2));
   134				game.getPaddle().setBFirstTouch(false);
   135			}
   136			return true;
   137		}

   148		public static double getAngleBetween2Points( float x1, float y1, float x2, float y2 ) {
   149			double dx = x1 - x2;
   150			double dy = y1 - y2;
   151			double angle = 0.0d;
   152	 
   153			if ( dx == 0.0 ) {
   154				if ( dy == 0.0 ) {
   155					angle = 0.0;
   156				} else if ( dy > 0.0 ) {
   157					angle = Math.PI / 2.0;
   158				} else {
   159					angle = (Math.PI * 3.0) / 2.0;
   160				}
   161			}
   162			else if( dy == 0.0 ) {
   163				if( dx > 0.0 ) {
   164					angle = 0.0;
   165				} else {
   166					angle = Math.PI;
   167				}
   168			} else {
   169				if ( dx < 0.0 ) {
   170					angle = Math.atan( dy/dx ) + Math.PI;
   171				} else if( dy < 0.0 ) {
   172					angle = Math.atan( dy/dx ) + ( 2*Math.PI );
   173				} else {
   174					angle = Math.atan( dy/dx );
   175				}
   176			}
   177			return ( angle * 180 ) / Math.PI;
   178	    }

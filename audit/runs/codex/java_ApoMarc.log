   149		public BufferedImage getButtonImage( int width, int height, String text, Color background, Color font, Color border, Color over, Color pressed, Font writeFont, int round ) {
   150			BufferedImage iButton = new BufferedImage(width,height,BufferedImage.TYPE_INT_ARGB_PRE);
   151			Graphics2D g = (Graphics2D)iButton.getGraphics();
   152			
   153			g.setRenderingHint(RenderingHints.KEY_ANTIALIASING, RenderingHints.VALUE_ANTIALIAS_ON);
   154			
   155			Font fontOkButton = writeFont;
   156			g.setFont(fontOkButton);
   157			int h = g.getFontMetrics().getHeight();
   158			
   159			for ( int i = 0; i < 3; i++ ) {
   160				g.setColor( background );
   161				g.fillRoundRect( (width)/3 * i, 0, (width)/3 - 1, height - 1, round, round );
   162				
   163				g.setFont( fontOkButton );
   164				int w = g.getFontMetrics().stringWidth( text );
   165				int x = iButton.getWidth()/3;
   166				
   167				g.setColor( font );
   168				g.drawString( text, i*x + x/2 - w/2, iButton.getHeight()/2 + h/3 );
   169				
   170				Stroke stroke = g.getStroke();
   171				g.setStroke(new BasicStroke(3));
   172				if ( i == 1 ) {
   173					g.setColor(over);
   174				} else if ( i == 2 ) {
   175					g.setColor(pressed);
   176				} else {
   177					g.setColor( border );
   178				}
   179				g.drawRoundRect( (width)/3 * i + 1, 1, (width)/3 - 3, height - 3, round, round );
   180				
   181				g.setStroke(stroke);
   182			}
   183			
   184			g.dispose();
   185			return iButton;
   186		}

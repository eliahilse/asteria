    59		public BufferedImage getImageMouseOver(BufferedImage iOriginal, int searchColor, Color drawColor, int w) {
    60			int width = iOriginal.getWidth();
    61			int height = iOriginal.getHeight();
    62			BufferedImage iSelect = GraphicsEnvironment.getLocalGraphicsEnvironment().getDefaultScreenDevice().getDefaultConfiguration().createCompatibleImage( width, height, BufferedImage.TRANSLUCENT );
    63			Graphics2D g	= (Graphics2D)iSelect.getGraphics();
    64	
    65			g.setRenderingHint(RenderingHints.KEY_ANTIALIASING, RenderingHints.VALUE_ANTIALIAS_ON);
    66			
    67			g.drawImage(iOriginal, 0, 0, null);
    68			
    69			g.setColor(drawColor);
    70			int color = searchColor;
    71			for (int y = 0; y < height; y++) {
    72				for (int x = 0; x < width; x++) {
    73					if (x + 1 < iOriginal.getWidth()) {
    74						if ((iOriginal.getRGB(x + 1, y) != color) &&
    75							(iOriginal.getRGB(x, y) == color)) {
    76							g.fillRect(x - w/2, y, w, 1);
    77						}
    78					}
    79					if ((x - 1 >= 0)) {
    80						if ((iOriginal.getRGB(x, y) == color) &&
    81							(iOriginal.getRGB(x - 1, y) != color)) {
    82							g.fillRect(x, y, w, 1);
    83						}
    84					} 
    85					if ((y - 1 >= 0)) {
    86						if ((iOriginal.getRGB(x, y) == color) &&
    87							(iOriginal.getRGB(x, y - 1) != color)) {
    88							g.fillRect(x, y, 1, w);
    89						}
    90					}
    91					if (y + 1 < height) {
    92						if ((iOriginal.getRGB(x, y + 1) != color) &&
    93							(iOriginal.getRGB(x, y) == color)) {
    94							g.fillRect(x, y - w/2, 1, w);
    95						}
    96					}
    97				}
    98			}
    99					
   100			g.dispose();
   101			
   102			return iSelect;
   103		}

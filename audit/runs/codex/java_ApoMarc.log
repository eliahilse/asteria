    40		/**
    41		 * erste Methode um ein Bild zu drehen, bei Angabe des Winkels
    42		 * funktioniert nur perfekt bei Bildern, deren Ma�e width = height ist
    43		 * @param src = Bilder welches gedreht werden soll
    44		 * @param degrees = Winkelangabe
    45		 * @return gedrehtes Bild
    46		 */
    47		public static BufferedImage rotateImage(BufferedImage src, double degrees) {
    48			AffineTransform affineTransform = AffineTransform.getRotateInstance( Math.toRadians(degrees), src.getWidth() / 2, src.getHeight() / 2);
    49			BufferedImage rotatedImage = GraphicsEnvironment.getLocalGraphicsEnvironment().getDefaultScreenDevice().getDefaultConfiguration().createCompatibleImage(src.getWidth(), src.getHeight(), BufferedImage.TRANSLUCENT);
    50			Graphics2D g = (Graphics2D)rotatedImage.getGraphics();
    51			g.setRenderingHint(RenderingHints.KEY_ANTIALIASING, RenderingHints.VALUE_ANTIALIAS_ON);
    52			g.setTransform( affineTransform );
    53			g.drawImage( src, 0, 0, null );
    54			g.dispose();
    55			return rotatedImage;
    56		}
    57		
    58		/**
    59		 * erste Methode um ein Bild zu drehen, bei Angabe des Winkels
    60		 * funktioniert bei allen Bildern
    61		 * @param inputImage = Bilder welches gedreht werden soll
    62		 * @param degrees = Winkelangabe
    63		 * @return gedrehtes Bild
    64		 */
    65		public static BufferedImage rotateImageMethodTwo(BufferedImage inputImage, double degrees ) {
    66			int x,y = 0;
    67			
    68			if ((degrees == 0)||(degrees == 180)||(degrees == 360)){
    69				x = inputImage.getWidth(null);
    70				y = inputImage.getHeight(null);
    71			} else {
    72				x = inputImage.getHeight(null);
    73				y = inputImage.getWidth(null);
    74			}
    75			BufferedImage sourceBI = GraphicsEnvironment.getLocalGraphicsEnvironment().getDefaultScreenDevice().getDefaultConfiguration().createCompatibleImage(x, y, BufferedImage.TRANSLUCENT);
    76			AffineTransform at = new AffineTransform();
    77	
    78			at.rotate(Math.toRadians( degrees ), (sourceBI.getWidth() / 2), (sourceBI.getHeight() / 2) );
    79	
    80			AffineTransform translationTransform;
    81			translationTransform = findTranslation( at, sourceBI, degrees );
    82			at.preConcatenate( translationTransform );
    83	
    84	
    85			Graphics2D g = (Graphics2D) sourceBI.getGraphics();
    86			g.setRenderingHint(RenderingHints.KEY_ANTIALIASING, RenderingHints.VALUE_ANTIALIAS_ON);
    87			g.setTransform(at);
    88			g.drawImage(inputImage, 0, 0, null);
    89	
    90			return sourceBI;
    91		}
    92	
    93		/**
    94		 * find proper translations to keep rotated image correctly displayed
    95		 * @param at = AffineTransformObjekt
    96		 * @param bi = BufferedImage
    97		 * @param degrees = Winkel
    98		 * @return korrekte AffineTransform
    99		 */
   100		private static AffineTransform findTranslation(AffineTransform at, BufferedImage bi, double degrees ) {
   101			Point2D p2din, p2dout;
   102			double ytrans, xtrans = 0.0;
   103	
   104			AffineTransform tat = new AffineTransform();
   105	
   106			if(degrees == 180) {
   107				p2din = new Point2D.Double(0, bi.getHeight());
   108			} else {
   109				p2din = new Point2D.Double(0.0, 0.0);
   110			}
   111	
   112			p2dout = at.transform(p2din, null);
   113	
   114			if(degrees == 270) {
   115				xtrans = p2dout.getX();
   116				ytrans = xtrans;
   117			} else {
   118				ytrans = p2dout.getY();
   119				xtrans = ytrans;
   120			}
   121	
   122			tat.translate(-xtrans, -ytrans);
   123	
   124			return tat;
   125		}

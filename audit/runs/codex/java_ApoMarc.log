   275		@Override
   276		public void renderEntity(Graphics2D g) {
   277			int startX = (int)(this.getX());
   278			int startY = (int)(this.getY());
   279			int width = (int)(this.getWidth());
   280			
   281			Color color = super.getMyColor();
   282			Stroke stroke = g.getStroke();
   283			g.setStroke(new BasicStroke(3));
   284			int add = 254;
   285			try {
   286				add = 255 / this.getCurWidth();
   287			} catch (Exception ex) {
   288				add = 254;
   289			}
   290			for (int j = 0; j < this.getCurWidth(); j++) {
   291				int alpha = 255 - (j + 1) * add;
   292				if (alpha < 0) {
   293					alpha = 0;
   294				}
   295				g.setColor(new Color(color.getRed(), color.getGreen(), color.getBlue(), alpha));
   296				g.drawOval(startX - (j+1) - 3, startY - (j+1) - 3, width + (j * 2) + 3, width + (j * 2) + 3);
   297				g.drawOval(startX + (j+1), startY + (j+1), width - (j * 2) - 7, width - (j * 2) - 7);
   298			}
   299			
   300			g.setStroke(stroke);
   301			g.setColor(Color.WHITE);
   302			g.setStroke(new BasicStroke(5));
   303			g.drawOval(startX - 2, startY - 2, width - 1, width - 1);
   304			g.setStroke(stroke);
   305		}

   207				window.createBufferStrategy(2);
   208				this.bufferStrategy = window.getBufferStrategy();
   209				
   210				this.component = window;
   211			} else {
   212				ApoCanvas window = new ApoCanvas();
   213				
   214				int width = this.displayConfiguration.getWidth();
   215				int height = this.displayConfiguration.getHeight();
   216				window.setPreferredSize(new Dimension(width, height));
   217				window.setBackground(Color.BLACK);
   218		
   219				this.addWindowListener(this.frame);
   220				this.frame.setResizable(false);
   221				this.frame.setIgnoreRepaint(false);
   222				this.frame.add(window);
   223				this.frame.pack();
   224				this.frame.setLocationRelativeTo(null);
   225				this.frame.setEnabled(true);
   226				this.frame.setVisible(true);
   227				
   228				this.component = window;

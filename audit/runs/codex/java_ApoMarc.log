     1	package org.apogames.input;
     2	
     3	import java.awt.event.KeyListener;
     4	import java.awt.event.KeyEvent;
     5	import java.util.ArrayList;
     6	import java.util.TreeMap;
     7	
     8	public final class ApoKeyboard implements KeyListener {
     9	
    10		public static final int UP = KeyEvent.VK_UP;
    11		public static final int DOWN = KeyEvent.VK_DOWN;
    12		public static final int RIGHT = KeyEvent.VK_RIGHT;
    13		public static final int LEFT = KeyEvent.VK_LEFT;
    14		public static final int FIRE = KeyEvent.VK_CONTROL;
    15		public static final int ALTFIRE = KeyEvent.VK_ALT;
    16		public static final int ESCAPE = KeyEvent.VK_ESCAPE;
    17	
    18		private TreeMap<Integer, Boolean> keys = null;
    19		private ArrayList<Integer> releasedKeys = new ArrayList<Integer>();
    20		private ArrayList<Integer> pressedKeys = new ArrayList<Integer>();
    21	
    22		public ApoKeyboard() {
    23			this.keys = new TreeMap<Integer, Boolean>();
    24			this.releasedKeys = new ArrayList<Integer>();
    25			this.pressedKeys = new ArrayList<Integer>();
    26		}
    27	
    28		public boolean isPressed(int key) {
    29			if (this.keys.containsKey(key)) {
    30				return this.keys.get(key);
    31			} else {
    32				return false;
    33			}
    34		}
    35	
    36		public synchronized int[] getReleased() {
    37			if ((this.releasedKeys == null) || (this.releasedKeys.size() <= 0)) {
    38				return new int[0];
    39			}
    40			int[] released = new int[this.releasedKeys.size()];
    41			for (int i = 0; i < this.releasedKeys.size(); i++) {
    42				released[i] = this.releasedKeys.get(i);
    43			}
    44			this.releasedKeys.clear();
    45			return released;
    46		}
    47	
    48		public synchronized int[] getPressed() {
    49			if ((this.pressedKeys == null) || (this.pressedKeys.size() <= 0)) {
    50				return new int[0];
    51			}
    52			int[] pressed = new int[this.pressedKeys.size()];
    53			for (int i = 0; i < this.pressedKeys.size(); i++) {
    54				pressed[i] = this.pressedKeys.get(i);
    55			}
    56			return pressed;
    57		}
    58	
    59		public void keyPressed(KeyEvent e) {
    60			this.keys.put(e.getKeyCode(), true);
    61			if (this.pressedKeys.indexOf(e.getKeyCode()) < 0) {
    62				this.pressedKeys.add(e.getKeyCode());
    63			}
    64		}
    65	
    66		public void keyReleased(KeyEvent e) {
    67			this.keys.put(e.getKeyCode(), false);
    68			this.releasedKeys.add(e.getKeyCode());
    69			this.pressedKeys.remove((Integer) e.getKeyCode());
    70		}
    71	
    72		public void keyTyped(KeyEvent e) {
    73	
    74		}
    75	}

   194		public boolean setPaddleBackPlayer(ApoMarcPlayer player, ApoMarcPaddle paddle) {
   195			int count = 0;
   196			float los = paddle.getLos() + 180;
   197			while (los > 360) {
   198				los -= 360;
   199			}
   200			while ((player.intersects(paddle.getX() + paddle.getWidth()/2, paddle.getY() + paddle.getWidth()/2, paddle.getWidth()/2)) && (count < 20)) {
   201				float radiusOne = 0.5f;
   202				count++;
   203				paddle.setX(paddle.getX() - radiusOne * (float)Math.cos(Math.toRadians(los)) );
   204				paddle.setY(paddle.getY() - radiusOne * (float)Math.sin(Math.toRadians(los)) );
   205			}
   206			return true;
   207		}

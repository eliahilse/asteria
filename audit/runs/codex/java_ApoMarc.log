   119		public void setBRepeat(boolean repeat) {
   120			this.bRepeat = repeat;
   121			if (this.bRepeat) {
   122				this.add = 1;
   123				this.curWidth = this.minWidth;
   124			}
   125			if (!ApoMarcConstants.LIGHTS) {
   126				this.add = 1;
   127				this.curWidth = this.minWidth;
   128				this.bRepeat = false;
   129			}
   130		}
   131	
   132		public void think(long delta, ApoMarcGame game) {
   133			super.think((int)delta);
   134			if (this.effects.size() > 0) {
   135				for (int i = this.effects.size() - 1; i >= 0; i--) {
   136					try {
   137						this.effects.get(i).think((int)delta);
   138						if (!this.effects.get(i).isBVisible()) {
   139							this.effects.remove(i);
   140						}
   141					} catch (Exception ex) {	
   142					}
   143				}
   144			}
   145			if (this.bRepeat) {
   146				this.curTime += delta;
   147				if (this.curTime >= this.maxTime) {
   148					this.curTime -= this.maxTime;
   149					this.curWidth += this.add;
   150					if (this.curWidth < this.minWidth) {
   151						this.littleMinSize();
   152					} else if (this.curWidth > this.maxWidth) {
   153						this.add = -1;
   154					}
   155				}
   156			}
   157			this.thinkEntity((int)delta, game);
   158		}
   159		
   160		public void littleMinSize() {
   161			this.add = 1;
   162		}
   163	
   164		public abstract void thinkEntity(int delta, ApoMarcGame game);
   165		
   166		public void render(Graphics2D g, int changeX, int changeY) {
   167			try {
   168				if (this.effects.size() > 0) {
   169					for (int i = this.effects.size() - 1; i >= 0; i--) {
   170						this.effects.get(i).render(g, changeX, changeY);
   171					}
   172				}
   173			} catch (Exception ex) {	
   174			}
   175			this.renderEntity(g);
   176		}
   177		
   178		public abstract void renderEntity(Graphics2D g);

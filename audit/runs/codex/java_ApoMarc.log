    82	
    83			if (this.mouse.isDragged()) {
    84				this.mouseDragged(this.mouse.getX(), this.mouse.getY());
    85			} else if (this.mouse.hasClicked(ApoMouse.LEFT)) {
    86				this.mousePressed(this.mouse.getX(), this.mouse.getY(), true);
    87			} else if (this.mouse.hasClicked(ApoMouse.RIGHT)) {
    88				this.mousePressed(this.mouse.getX(), this.mouse.getY(), false);
    89			} else if (this.mouse.isMoved()) {
    90				this.mouseMoved(this.mouse.getX(), this.mouse.getY());
    91			}
    92			boolean[] mouseReleased = this.mouse.getReleased();
    93			if (mouseReleased[ApoMouse.LEFT]) {
    94				this.mouseReleased(this.mouse.getX(), this.mouse.getY(), true);
    95			} else if (mouseReleased[ApoMouse.RIGHT]) {
    96				this.mouseReleased(this.mouse.getX(), this.mouse.getY(), false);
    97			}
    98			this.think(delta);
    99		}

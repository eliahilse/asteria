    81			g.setColor(Color.DARK_GRAY);
    82			g.drawRoundRect(startX, startY, width, height, 20, 20);		
    83			g.drawLine(startX + width, startY + 40, startX + width + 120, startY + 40);
    84			
    85			g.setColor(Color.BLACK);
    86			g.setFont(new Font(Font.SANS_SERIF, Font.PLAIN, 20));
    87			String s = "time";
    88			g.drawString(s, startX + width + 10, startY + 35);
    89	
    90			g.drawLine(startX + width, startY + 320, startX + width + 80, startY + 320);
    91			s = "level";
    92			g.drawString(s, startX + width + 10, startY + 315);
    93			
    94			g.setStroke(stroke);
    95			
    96			if (this.level != null) {
    97				g.drawImage(this.level.getIBackground(), ApoSimpleSudokuGame.startX, ApoSimpleSudokuGame.startY, null);

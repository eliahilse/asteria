   247		@Override
   248		public void mouseButtonFunction(String function) {
   249			if (ApoSimpleSudokuGame.MENU.equals(function)) {
   250				this.stopGame();
   251			} else if (ApoSimpleSudokuGame.RESTART.equals(function)) {
   252				this.init(this.levelInt);
   253			} else if (ApoSimpleSudokuGame.NEXT.equals(function)) {
   254				this.nextLevel();
   255			}
   256			if (!this.getGame().shouldRepaint()) {
   257				this.getGame().render();
   258			}
   259		}

   186		@Override
   187		public void mouseReleased(int x, int y, boolean right) {
   188			if (this.level != null) {
   189				if (this.level.isWin()) {
   190				} else if ((x >= ApoSimpleSudokuGame.startX) && (y >= ApoSimpleSudokuGame.startY) && 
   191					(x < ApoSimpleSudokuGame.startX + ApoSimpleSudokuGame.width) && (y < ApoSimpleSudokuGame.startY + ApoSimpleSudokuGame.height)) {
   192					if (this.level.mouseReleased(x, y, right)) {
   193						this.getGame().render();
   194						this.checkWin();
   195					}
   196				}
   197			}
   198		}

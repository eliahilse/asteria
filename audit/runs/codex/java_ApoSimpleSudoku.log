    43				int change = 50;
    44				
    45				g.setColor(ApoSimpleSudokuLevel.c);
    46				g.fillRect(7, ApoSimpleSudokuConstants.GAME_HEIGHT/2 - change, ApoSimpleSudokuConstants.GAME_WIDTH - 14, 2 * change);
    47				
    48				g.setColor(Color.DARK_GRAY);
    49				g.drawRoundRect(5, 5, ApoSimpleSudokuConstants.GAME_WIDTH - 12, ApoSimpleSudokuConstants.GAME_HEIGHT - 12, 20, 20);
    50				
    51				g.drawLine(7, ApoSimpleSudokuConstants.GAME_HEIGHT/2 - change, ApoSimpleSudokuConstants.GAME_WIDTH - 2 * 5, ApoSimpleSudokuConstants.GAME_HEIGHT/2 - change);
    52				g.drawLine(7, ApoSimpleSudokuConstants.GAME_HEIGHT/2 + change, ApoSimpleSudokuConstants.GAME_WIDTH - 2 * 5, ApoSimpleSudokuConstants.GAME_HEIGHT/2 + change);
    53				
    54				g.setColor(Color.BLACK);
    55				g.setFont(new Font(Font.SANS_SERIF, Font.BOLD, 36));
    56				String text = "Apo-Sudoku";
    57				
    58				int width = ApoSimpleSudokuConstants.GAME_WIDTH - 12;
    59				int h = g.getFontMetrics().getHeight();
    60				int circleRadius = h + 2;
    61				Stroke basicStroke = new BasicStroke(3);
    62				int lineWidth = 5;
    63				int[] nextYSet = new int[text.length()];
    64				for (int i = 0; i < nextYSet.length; i++) {
    65					nextYSet[i] = (int)(Math.random() * (80 - circleRadius - 4)) + 2 + 10;
    66				}
    67				int startX = (int)(width/2 - (text.length()/2f)*(circleRadius) - ((text.length()-1)/2f)*(lineWidth)) + 5;
    68				int nextWidth = circleRadius + lineWidth;
    69				for (int t = 0; t < text.length(); t++) {
    70					String s = String.valueOf(text.charAt(t));
    71					int w = g.getFontMetrics().stringWidth(s);
    72					g.setStroke(basicStroke);
    73					g.setColor(ApoSimpleSudokuConstants.BROWN);
    74					g.fillOval(startX + 1, ApoSimpleSudokuConstants.GAME_HEIGHT/2 - change + nextYSet[t], circleRadius - 1, circleRadius - 1);
    75					g.setColor(Color.BLACK);
    76					g.drawOval(startX + 1, ApoSimpleSudokuConstants.GAME_HEIGHT/2 - change + nextYSet[t], circleRadius - 1, circleRadius - 1);
    77					if (t != text.length() - 1) {
    78						g.drawLine(startX + circleRadius + 1, ApoSimpleSudokuConstants.GAME_HEIGHT/2 - change + nextYSet[t] + circleRadius/2 - 1, startX + circleRadius + 1 + lineWidth, ApoSimpleSudokuConstants.GAME_HEIGHT/2 - change + nextYSet[t + 1] + circleRadius/2 - 1);
    79					}
    80					g.setStroke(stroke);
    81					int realHeight = h - 2*g.getFontMetrics().getDescent();
    82					g.setColor(Color.WHITE);
    83					g.drawString(s, startX + circleRadius/2 - w/2, ApoSimpleSudokuConstants.GAME_HEIGHT/2 - change + nextYSet[t] + circleRadius/2 + realHeight/2);
    84					startX += nextWidth;
    85				}
    86				
    87				g.setStroke(stroke);
    88				
    89				g.dispose();
    90			}
    91		}

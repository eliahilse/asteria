   341			Clipboard clipboard = Toolkit.getDefaultToolkit().getSystemClipboard();
   342			Transferable contents = clipboard.getContents(null);
   343			boolean hasTransferableText = (contents != null) && contents.isDataFlavorSupported(DataFlavor.stringFlavor);
   344			if (hasTransferableText) {
   345				try {
   346					result = (String)contents.getTransferData(DataFlavor.stringFlavor);

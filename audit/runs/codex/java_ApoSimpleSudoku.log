   104		 * @param at = AffineTransformObjekt
   105		 * @param bi = BufferedImage
   106		 * @param degrees = Winkel
   107		 * @return korrekte AffineTransform
   108		 */
   109		private static AffineTransform findTranslation(AffineTransform at, BufferedImage bi, double degrees ) {
   110			Point2D p2din, p2dout;
   111			double ytrans, xtrans = 0.0;
   112	
   113			AffineTransform tat = new AffineTransform();
   114	
   115			if(degrees == 180) {
   116				p2din = new Point2D.Double(0, bi.getHeight());
   117			} else {
   118				p2din = new Point2D.Double(0.0, 0.0);
   119			}
   120	
   121			p2dout = at.transform(p2din, null);
   122	
   123			if(degrees == 270) {
   124				xtrans = p2dout.getX();
   125				ytrans = xtrans;
   126			} else {
   127				ytrans = p2dout.getY();
   128				xtrans = ytrans;
   129			}
   130	
   131			tat.translate(-xtrans, -ytrans);
   132	
   133			return tat;
   134		}

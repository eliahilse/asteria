   135		private void makeWinImage() {
   136			this.getGame().getButtons()[10].setBVisible(true);
   137			this.iWin = new BufferedImage(ApoSimpleSudokuConstants.GAME_WIDTH, ApoSimpleSudokuConstants.GAME_HEIGHT, BufferedImage.TYPE_INT_RGB);
   138			Graphics2D g = this.iWin.createGraphics();
   139			
   140			g.setRenderingHint(RenderingHints.KEY_ANTIALIASING, RenderingHints.VALUE_ANTIALIAS_ON);
   141			
   142			this.renderIngame(g);
   143			
   144			Stroke stroke = g.getStroke();
   145			g.setStroke(new BasicStroke(5));
   146			
   147			int width = ApoSimpleSudokuGame.width + 10;
   148			int height = ApoSimpleSudokuGame.height + 10;
   149			int realWidth = 300;
   150			int realHeight = 200;
   151			int startX = width/2 - realWidth/2;
   152			int startY = height/2 - realHeight/2;
   153			g.setColor(new Color(255, 255, 255, 200));
   154			g.fillRoundRect(startX, startY, realWidth, realHeight, 20, 20);
   155			g.setColor(Color.DARK_GRAY);
   156			g.drawRoundRect(startX, startY, realWidth, realHeight, 20, 20);
   157			
   158			g.setStroke(stroke);
   159			g.setFont(ApoSimpleSudokuConstants.FONT_LEVEL_CHOOSER);
   160			g.setColor(Color.BLACK);
   161			String s = "Congratulation";
   162			int w = g.getFontMetrics().stringWidth(s);
   163			g.drawString(s, width/2 - w/2, startY + 35);
   164			
   165			s = "You solved the level in";
   166			w = g.getFontMetrics().stringWidth(s);
   167			g.drawString(s, width/2 - w/2, startY + 95);
   168			
   169			s = ApoHelp.getTimeToDraw((int)((System.nanoTime() - this.time)/1000000))+" minutes";
   170			w = g.getFontMetrics().stringWidth(s);
   171			g.drawString(s, width/2 - w/2, startY + 120);
   172			
   173			g.dispose();
   174		}

   176		private void checkWin() {
   177			if (this.level.isWin()) {
   178				this.getGame().solveLevel(this.levelInt);
   179				this.makeWinImage();
   180				this.time = System.nanoTime() - this.time;
   181				super.getGame().setCursor(Cursor.getPredefinedCursor(Cursor.DEFAULT_CURSOR));
   182				this.getGame().render();
   183			}
   184		}

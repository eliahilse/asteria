   108		@Override
   109		public void keyButtonReleased(int button, char character) {
   110			if (button == KeyEvent.VK_ESCAPE) {
   111				this.stopGame();
   112				this.getGame().render();
   113			} else if (button == KeyEvent.VK_R) {
   114				this.init(this.levelInt);
   115				this.getGame().render();
   116			} else if (button == KeyEvent.VK_N) {
   117				this.nextLevel();
   118				this.getGame().render();
   119			} else if (button == KeyEvent.VK_ENTER) {
   120				if (this.getGame().getButtons()[10].isBVisible()) {
   121					this.nextLevel();
   122					this.getGame().render();
   123				}
   124			} else if (button == KeyEvent.VK_P) {
   125				this.previousLevel();
   126				this.getGame().render();
   127			} else {
   128				if (this.level.keyButtonReleased(button, character)) {
   129					this.getGame().render();
   130					this.checkWin();
   131				}
   132			}
   133		}

    52		public static BufferedImage rotateImage(BufferedImage src, double degrees) {
    53			AffineTransform affineTransform = AffineTransform.getRotateInstance( Math.toRadians(degrees), src.getWidth() / 2, src.getHeight() / 2);
    54			BufferedImage rotatedImage = GraphicsEnvironment.getLocalGraphicsEnvironment().getDefaultScreenDevice().getDefaultConfiguration().createCompatibleImage(src.getWidth(), src.getHeight(), BufferedImage.TRANSLUCENT);
    55			Graphics2D g = (Graphics2D)rotatedImage.getGraphics();
    56			g.setRenderingHint(RenderingHints.KEY_ANTIALIASING, RenderingHints.VALUE_ANTIALIAS_ON);
    57			g.setTransform( affineTransform );
    58			g.drawImage( src, 0, 0, null );
    59			g.dispose();
    60			return rotatedImage;
    61		}
    62		
    63		/**
    64		 * erste Methode um ein Bild zu drehen, bei Angabe des Winkels
    65		 * funktioniert bei allen Bildern
    66		 * @param inputImage = Bilder welches gedreht werden soll
    67		 * @param degrees = Winkelangabe
    68		 * @return gedrehtes Bild
    69		 */
    70		public static BufferedImage rotateImageMethodTwo(BufferedImage inputImage, double degrees ) {
    71			int x,y = 0;
    72			
    73			if ((degrees == 0)||(degrees == 180)||(degrees == 360)){
    74				x = inputImage.getWidth(null);
    75				y = inputImage.getHeight(null);
    76			} else {
    77				x = inputImage.getHeight(null);
    78				y = inputImage.getWidth(null);
    79			}
    80			BufferedImage sourceBI = GraphicsEnvironment.getLocalGraphicsEnvironment().getDefaultScreenDevice().getDefaultConfiguration().createCompatibleImage(x, y, BufferedImage.TRANSLUCENT);
    81			AffineTransform at = new AffineTransform();
    82	
    83			// rotate around image center
    84			at.rotate(Math.toRadians( degrees ), (sourceBI.getWidth() / 2), (sourceBI.getHeight() / 2) );
    85	
    86		    /*
    87		     * translate to make sure the rotation doesn't cut off any image data
    88		     */
    89			AffineTransform translationTransform;
    90			translationTransform = findTranslation( at, sourceBI, degrees );
    91			at.preConcatenate( translationTransform );
    92	
    93	
    94			Graphics2D g = (Graphics2D) sourceBI.getGraphics();
    95			g.setRenderingHint(RenderingHints.KEY_ANTIALIASING, RenderingHints.VALUE_ANTIALIAS_ON);
    96			g.setTransform(at);
    97			g.drawImage(inputImage, 0, 0, null);
    98	
    99			return sourceBI;
   100		}

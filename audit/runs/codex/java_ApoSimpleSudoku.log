    67			super.makeBackground(ApoSimpleSudokuConstants.GAME_WIDTH, ApoSimpleSudokuConstants.GAME_HEIGHT);
    68			Graphics2D g = super.getBackground().createGraphics();
    69			
    70			g.setRenderingHint(RenderingHints.KEY_ANTIALIASING, RenderingHints.VALUE_ANTIALIAS_ON);
    71			
    72			Stroke stroke = g.getStroke();
    73			g.setStroke(new BasicStroke(5));
    74			
    75			int startX = ApoSimpleSudokuGame.startX - 5;
    76			int startY = ApoSimpleSudokuGame.startY - 5;
    77			int width = ApoSimpleSudokuGame.width + 10;
    78			int height = ApoSimpleSudokuGame.height + 10;
    79			g.setColor(new Color(220, 220, 220));

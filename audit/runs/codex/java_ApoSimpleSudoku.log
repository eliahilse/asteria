   213				double c2 = (y1 - y2) / (x2 - x1);
   214				double k1 = 1.0 + (1.0 / Math.pow(c2, 2.0));
   215				double k2 = 2.0 * x1 + (2.0 * y1) / (c2) + (2.0 * c1) / Math.pow(c2, 2.0);
   216				double k3 = x1 * x1 + (c1 * c1) / (c2 * c2) + (2.0 * y1 * c1) / (c2) + (y1 * y1) - (radius1 * radius1);
   217				System.out.println("resultX1: "+resultX1);
   218				resultX1 = ((k2 / k1) / 2.0) + Math.sqrt((Math.pow((k2 / k1), 2.0) / 4.0) - (k3 / k1));
   219				System.out.println("resultX1: "+resultX1);
   220				resultX2 = (k2 / k1) / 2.0 - Math.sqrt((Math.pow((k2 / k1), 2.0) / 4.0) - (k3) / (k1));
   221				resultY1 = 1.0 / (c2) * resultX1 - (c1 / c2);
   222				resultY2 = 1.0 / (c2) * resultX2 - (c1 / c2);
   223			}
   224			
   225			if ((resultX1 != -10000) && (resultY1 != -10000)) {
   226				System.out.println("resultX1: "+resultX1);
   227				results.add(new ApoFloatPoint((float)(resultX1), (float)(resultY1)));
   228			}
   229			if ((resultX2 != -10000) && (resultY2 != -10000)) {
   230				results.add(new ApoFloatPoint((float)(resultX2), (float)(resultY2)));
   231			}
   232			return results;
   233		}

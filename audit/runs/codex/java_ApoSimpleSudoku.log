    79		@Override
    80		public void run() {
    81			long unprocessedTimeThink = 0;
    82			long unprocessedTimeRender = 0;
    83			long msPerTickThink = (long)(1000.0 / (double)(ApoSimpleSudokuConstants.FPS_THINK));
    84			long msPerTickRender = (long)(1000.0 / (double)(ApoSimpleSudokuConstants.FPS_RENDER));
    85			this.frames = 0;
    86			long lastFpsTime = System.currentTimeMillis() - 1000;
    87			this.last = System.currentTimeMillis();
    88			this.isRunning = true;
    89	
    90			// eigentliche Spiellogikschleife
    91			while (this.isRunning) {
    92				try {
    93					long now = System.currentTimeMillis();
    94					long passedTime = now - this.last;
    95					// falls Zeit vergangen ist seit dem letzten Aufruf
    96					if (passedTime > 0) {
    97						unprocessedTimeThink += passedTime;
    98						unprocessedTimeRender += passedTime;
    99						// wenn nachgedacht werden soll dann denke nach
   100						while (unprocessedTimeThink >= msPerTickThink) {
   101							if (unprocessedTimeThink > 10 * msPerTickThink) {
   102								unprocessedTimeThink = 0;
   103							} else {
   104								unprocessedTimeThink -= msPerTickThink;
   105							}
   106							if (!this.bShouldThink) {
   107								unprocessedTimeThink = 0;
   108							} else {
   109								this.think(msPerTickThink);
   110							}
   111						}
   112						// wenn gezeichnet werden soll, dann zeichne neu
   113						if (unprocessedTimeRender >= msPerTickRender) {
   114							unprocessedTimeRender -= msPerTickRender;
   115							if (this.bShouldRepaint) {
   116								this.render();
   117							}
   118						}
   119						this.last = now;
   120					}
   121					// falls eine Sekunde vergangen ist, dann aktualisiere die FPSanzahl
   122					if (System.currentTimeMillis() - lastFpsTime > 1000) {
   123						if (!this.bShouldRepaint) {
   124							this.render();
   125						}
   126						lastFpsTime += 1000;
   127						this.screen.setFps(this.frames);
   128						this.frames = 0;
   129					}
   130		
   131					// leg den Thread f�r 2 Millisekunden schlafen
   132					try {
   133						Thread.sleep(2);
   134					} catch (InterruptedException e) {
   135					}
   136				} catch (Exception ex) {
   137					
   138				}
   139			}
   140		}

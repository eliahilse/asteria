   220		
   221		public boolean mouseMoved(int x, int y) {
   222			if (this.level != null) {
   223				if (this.level.isWin()) {
   224				} else if ((x >= ApoSimpleSudokuGame.startX) && (y >= ApoSimpleSudokuGame.startY) && 
   225					(x < ApoSimpleSudokuGame.startX + ApoSimpleSudokuGame.width) && (y < ApoSimpleSudokuGame.startY + ApoSimpleSudokuGame.height)) {
   226					int value = this.level.mouseMoved(x, y);
   227					if (value == 1) {
   228						super.getGame().setCursor(Cursor.getPredefinedCursor(Cursor.HAND_CURSOR));
   229						super.getGame().render();
   230					} else if (value == 2) {
   231						if (!super.getGame().getCursor().equals(Cursor.getPredefinedCursor(Cursor.DEFAULT_CURSOR))) {
   232							super.getGame().setCursor(Cursor.getPredefinedCursor(Cursor.DEFAULT_CURSOR));
   233							super.getGame().render();
   234						}
   235					}
   236				} else {
   237					this.level.mouseMoved(-1, -1);
   238					if (!super.getGame().getCursor().equals(Cursor.getPredefinedCursor(Cursor.DEFAULT_CURSOR))) {
   239						super.getGame().setCursor(Cursor.getPredefinedCursor(Cursor.DEFAULT_CURSOR));
   240						super.getGame().render();
   241					}
   242				}
   243			}
   244			return false;
   245		}

    69		public boolean isNextBlocked(ApoStarzLevel level) {
    70			if (this.getVecX() != 0) {
    71				int newX = (int)((this.getX() + this.getVecX()) / ApoStarzConstants.TILE_SIZE);
    72				int oldX = this.getStarzX();
    73				if (this.getVecX() > 0) {
    74					newX = (int)((this.getX() + this.getWidth() - 1 + this.getVecX()) / ApoStarzConstants.TILE_SIZE);
    75					oldX = (int)((this.getX() + this.getWidth() - 1) / ApoStarzConstants.TILE_SIZE);
    76				}
    77				if (oldX != newX) {
    78					if ((level.getLevel()[this.getStarzY()][oldX] == ApoStarzConstants.FIRE) &&
    79						(level.getEntities()[this.getStarzY()][oldX].isBVisible())) {
    80						level.getEntities()[this.getStarzY()][oldX].setBVisible(false);
    81						this.setBVisible(false);
    82						this.setBFalling(false);
    83						level.getLevel()[this.getStarzY()][oldX] = ApoStarzConstants.EMPTY;
    84					} else if ((level.getLevel()[this.getStarzY()][newX] != ApoStarzConstants.EMPTY) &&
    85						(level.getLevel()[this.getStarzY()][newX] != ApoStarzConstants.FIRE)) {
    86						
    87						this.setBFalling(false);
    88						this.setX(oldX * ApoStarzConstants.TILE_SIZE);
    89						return true;
    90					} else if ((level.getLevel()[this.getStarzY()][oldX] == ApoStarzConstants.FIRE) &&
    91							   (level.getEntities()[this.getStarzY()][oldX].isBVisible())) {
    92						level.getEntities()[this.getStarzY()][oldX].setBVisible(false);
    93						this.setBVisible(false);
    94						this.setBFalling(false);
    95						level.getLevel()[this.getStarzY()][oldX] = ApoStarzConstants.EMPTY;
    96					} else {
    97						if (level.getLevel()[this.getStarzY()][newX] != ApoStarzConstants.FIRE) {
    98							level.getLevel()[this.getStarzY()][newX] = level.getLevel()[this.getStarzY()][oldX];
    99						}
   100						level.getLevel()[this.getStarzY()][oldX] = ApoStarzConstants.EMPTY;
   101						return false;
   102					}
   103				}
   104			} else if (this.getVecY() != 0) {
   105				int newY = (int)((this.getY() + this.getVecY()) / ApoStarzConstants.TILE_SIZE);
   106				int oldY = this.getStarzY();
   107				if (this.getVecY() > 0) {
   108					newY = (int)((this.getY() + this.getHeight() - 1 + this.getVecY()) / ApoStarzConstants.TILE_SIZE);
   109					oldY =(int)((this.getY() + this.getHeight() - 1) / ApoStarzConstants.TILE_SIZE);
   110				}
   111				if (oldY != newY) {
   112					if ((level.getLevel()[oldY][this.getStarzX()] == ApoStarzConstants.FIRE) &&
   113							   (level.getEntities()[oldY][this.getStarzX()].isBVisible())) {
   114						level.getEntities()[oldY][this.getStarzX()].setBVisible(false);
   115						this.setBVisible(false);
   116						this.setBFalling(false);
   117						level.getLevel()[oldY][this.getStarzX()] = ApoStarzConstants.EMPTY;
   118					} else if ((level.getLevel()[newY][this.getStarzX()] != ApoStarzConstants.EMPTY) &&
   119						(level.getLevel()[newY][this.getStarzX()] != ApoStarzConstants.FIRE)) {
   120							this.setBFalling(false);
   121							this.setY(oldY * ApoStarzConstants.TILE_SIZE);
   122							return true;
   123					} else {
   124						if (level.getLevel()[newY][this.getStarzX()] != ApoStarzConstants.FIRE) {
   125							level.getLevel()[newY][this.getStarzX()] = level.getLevel()[oldY][this.getStarzX()];
   126						}
   127						level.getLevel()[oldY][this.getStarzX()] = ApoStarzConstants.EMPTY;
   128						return false;
   129					}
   130				}
   131			}
   132			return false;
   133		}

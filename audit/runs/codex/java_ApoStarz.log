   550		public void mouseReleased(MouseEvent e) {
   551			super.mouseReleased(e);
   552			int[] cor = this.getCoordinatesForMouse(e);
   553			if ((cor[0] > 0) && (cor[0] < this.level.getWidth() - 1) && 
   554				(cor[1] > 0) && (cor[1] < this.level.getHeight() - 1)) {
   555				int x = cor[0];
   556				int y = cor[1];
   557				if ((x == this.pressedX) && (y == this.pressedY)) {
   558					if (e.getButton() == MouseEvent.BUTTON1) {

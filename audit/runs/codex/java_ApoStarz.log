    80		 * @param x = The x location in the source image of the pixel to process
    81		 * @param y = The y location in the source image of the pixel to process
    82		 */
    83		private void process(int x, int y) {
    84			int A = this.getSourcePixel(x - 1, y - 1);
    85			int B = this.getSourcePixel(x, y - 1);
    86			int C = this.getSourcePixel(x + 1, y - 1);
    87			int D = this.getSourcePixel(x - 1, y);
    88			int E = this.getSourcePixel(x, y);
    89			int F = this.getSourcePixel(x + 1, y);
    90			int G = this.getSourcePixel(x - 1, y + 1);
    91			int H = this.getSourcePixel(x, y + 1);
    92			int I = this.getSourcePixel(x + 1, y + 1);
    93			int E0 = E;
    94			int E1 = E;
    95			int E2 = E;
    96			int E3 = E;
    97			int E4 = E;
    98			int E5 = E;
    99			int E6 = E;
   100			int E7 = E;
   101			int E8 = E;
   102	
   103			if (different(B, H) && different(D, F)) {
   104				E0 = !different(D, B) ? D : E;
   105				E1 = ((!different(D, B)) && different(E, C))
   106						|| ((!different(B, F)) && different(E, A)) ? B : E;
   107				E2 = !different(B, F) ? F : E;
   108				E3 = ((!different(D, B)) && different(E, G))
   109						|| ((!different(D, H)) && different(E, A)) ? D : E;
   110				E4 = E;
   111				E5 = ((!different(B, F)) && different(E, I))
   112						|| ((!different(H, F)) && different(E, C)) ? F : E;
   113				E6 = !different(D, H) ? D : E;
   114				E7 = ((!different(D, H)) && different(E, I))
   115						|| ((!different(H, F)) && different(E, G)) ? H : E;
   116				E8 = !different(H, F) ? F : E;
   117			}
   118	
   119			setDestPixel((x * 3), (y * 3), E0);
   120			setDestPixel((x * 3) + 1, (y * 3), E1);
   121			setDestPixel((x * 3) + 2, (y * 3), E2);
   122			setDestPixel((x * 3), (y * 3) + 1, E3);
   123			setDestPixel((x * 3) + 1, (y * 3) + 1, E4);
   124			setDestPixel((x * 3) + 2, (y * 3) + 1, E5);
   125			setDestPixel((x * 3), (y * 3) + 2, E6);
   126			setDestPixel((x * 3) + 1, (y * 3) + 2, E7);
   127			setDestPixel((x * 3) + 2, (y * 3) + 2, E8);
   128		}
   129	
   130		/**
   131		 * Get the scale image data. Note this is the method that does the work so
   132		 * it might take some time to process.
   133		 * 
   134		 * @return An array of pixels 9 times the size of the input array containing
   135		 *         the smoothly scaled image
   136		 */
   137		public int[] getScaledData() {
   138			for (int x = 0; x < this.width; x++) {
   139				for (int y = 0; y < this.height; y++) {
   140					process(x, y);
   141				}
   142			}
   143	
   144			return this.dstImage;
   145		}
   146	}


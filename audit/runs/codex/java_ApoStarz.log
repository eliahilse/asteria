  1194		/**
  1195		 * gibt den String mit der Zeitangabe zur�ck
  1196		 * @return gibt den String mit der Zeitangabe zur�ck
  1197		 */
  1198		private String getTimeToDraw(int time) {
  1199			if (time <= 0)
  1200				return "";
  1201			String min = String.valueOf(time/1000/60);
  1202			String sec = ""+((time/1000)%60);
  1203			String msec = ""+((time/10)%100);
  1204			if (sec.length()<2) sec = "0"+sec;
  1205			if (msec.length()<2) msec = "0"+msec;
  1206			String timeString = min+":"+sec+":"+msec;
  1207			
  1208			return timeString;
  1209		}

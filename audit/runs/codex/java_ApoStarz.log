   436		 * �berpr�ft ob der �bergebene rgb Wert durchsichtig ist oder nicht
   437		 * @param rgb = zu �berpr�fender RGB Wert
   438		 * @return TRUE falls durchsichtig sonst FALSE
   439		 */
   440		private boolean isOpaque(int rgb) {
   441	
   442			int alpha = (rgb >> 24) & 0xff;
   443			// red = (rgb >> 16) & 0xff;
   444			// green = (rgb >> 8) & 0xff;
   445			// blue = (rgb ) & 0xff;
   446	
   447			if (alpha == 0) {
   448				return false;
   449			}
   450	
   451			return true;
   452		}

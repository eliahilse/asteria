   102		private int[][] getLevelInt() {
   103			int[][] level = new int[this.originalEntities.length][this.originalEntities[0].length];
   104			for (int i = 0; i < level.length; i++) {
   105				for (int j = 0;  j < level[0].length; j++) {
   106					if (this.entities[i][j] == null) {
   107						level[i][j] = ApoStarzConstants.EMPTY;
   108					} else if (this.entities[i][j] instanceof ApoStarzBlock) {
   109						if (this.entities[i][j].isBCanFall()) {
   110							level[i][j] = ApoStarzConstants.BLOCK_FALLING;
   111						} else {
   112							level[i][j] = ApoStarzConstants.BLOCK;
   113						}
   114					} else if (this.entities[i][j] instanceof ApoStarzStar) {
   115						level[i][j] = ApoStarzConstants.STAR;
   116					} else if (this.entities[i][j] instanceof ApoStarzGoal) {
   117						level[i][j] = ApoStarzConstants.GOAL;
   118					} else if ((this.entities[i][j] instanceof ApoStarzFire) && (this.entities[i][j].isBVisible())) {
   119						level[i][j] = ApoStarzConstants.FIRE;
   120					}
   121				}
   122			}
   123			for (int falling = 0; falling < this.fallingEntities.size(); falling++) {
   124				if (this.fallingEntities.get(falling).isBVisible()) {
   125					int x = this.fallingEntities.get(falling).getStarzX();
   126					int y = this.fallingEntities.get(falling).getStarzY();
   127					if (this.fallingEntities.get(falling) instanceof ApoStarzBlock) {
   128						level[y][x] = ApoStarzConstants.BLOCK_FALLING;
   129					} else if (this.fallingEntities.get(falling) instanceof ApoStarzStar) {
   130						//System.out.println("x = "+x+" y = "+y+" f = "+falling);
   131						level[y][x] = ApoStarzConstants.STAR;
   132					}
   133				}
   134			}
   135			return level;
   136		}

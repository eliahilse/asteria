   574				(cor[1] > 0) && (cor[1] < this.level.getHeight() - 1)) {
   575				int x = cor[0];
   576				int y = cor[1];
   577				this.pressedX = x;
   578				this.pressedY = y;
   579				this.setX = cor[0] * ApoStarzConstants.TILE_SIZE + cor[2];
   580				this.setY = cor[1] * ApoStarzConstants.TILE_SIZE + cor[3];
   581				if (this.bLeftMouse) {
   582					this.level.addEntity(x, y, this.curImage, true);
   583				} else {
   584					this.level.addEntity(x, y, ApoStarzConstants.EMPTY, true);
   585				}

   525				(cor[1] > 0) && (cor[1] < this.level.getHeight() - 1)) {
   526				this.setX = cor[0] * ApoStarzConstants.TILE_SIZE + cor[2];
   527				this.setY = cor[1] * ApoStarzConstants.TILE_SIZE + cor[3];

     8	public class ApoRawScale2x {
     9	
    10		/** The src image data */
    11		private int[] srcImage;
    12	
    13		/** The dest image data */
    14		private int[] dstImage;
    15	
    16		/** The width of the source image */
    17		private int width;
    18	

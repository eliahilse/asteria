   591		
   592		private int[] getCoordinatesForMouse(MouseEvent e) {
   593			int[] returnInt = new int[4];
   594			int curMouseX = e.getX();
   595			int curMouseY = e.getY();
   596			if (curMouseX <= ApoStarzConstants.GAME_GAME_WIDTH) {
   597				int curX = (ApoStarzConstants.GAME_GAME_WIDTH - ApoStarzConstants.TILE_SIZE * this.level.getWidth()) / 2;
   598				int curY = (ApoStarzConstants.GAME_HEIGHT - ApoStarzConstants.TILE_SIZE * this.level.getHeight()) / 2;
   599				curMouseX -= curX;
   600				curMouseY -= curY;
   601				returnInt[0] = curMouseX / ApoStarzConstants.TILE_SIZE;
   602				returnInt[1] = curMouseY / ApoStarzConstants.TILE_SIZE;
   603				returnInt[2] = curX;
   604				returnInt[3] = curY;
   605			} else {
   606				returnInt[0] = -1;
   607				returnInt[1] = -1;
   608			}
   609			return returnInt;
   610		}

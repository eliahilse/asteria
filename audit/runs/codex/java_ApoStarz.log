   533		public void mousePressed(MouseEvent e) {
   534			super.mousePressed(e);
   535			int[] cor = this.getCoordinatesForMouse(e);
   536			if ((cor[0] > 0) && (cor[0] < this.level.getWidth() - 1) && 
   537				(cor[1] > 0) && (cor[1] < this.level.getHeight() - 1)) {
   538				this.pressedX = cor[0];
   539				this.pressedY = cor[1];
   540				if (e.getButton() == MouseEvent.BUTTON1) {
   541					this.bLeftMouse = true;

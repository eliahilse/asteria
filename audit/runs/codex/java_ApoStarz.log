   163		private void drawSpeech(Graphics2D g, String s) {
   164			g.setColor(Color.black);
   165			g.setFont(ApoStarzConstants.FONT_NORMAL);
   166			
   167			int curHeight = 0;
   168			int[] maxLength = new int[] {250, 300};
   169			int x = 142;
   170			int y = 30;
   171			ArrayList<String> strings = new ArrayList<String>();
   172			strings.add(s);
   173			int cur = 0;
   174			int w = g.getFontMetrics().stringWidth(strings.get(cur));
   175			if (w > maxLength[curHeight]) {
   176				int curPos = strings.get(cur).indexOf(" ");
   177				while ((curPos > -1) && (g.getFontMetrics().stringWidth(strings.get(cur).substring(0, curPos)) < maxLength[curHeight])) {
   178					int nextPos = strings.get(cur).indexOf(" ", curPos + 1);
   179					if (nextPos != -1) {
   180						if (g.getFontMetrics().stringWidth(strings.get(cur).substring(0, nextPos)) >= maxLength[curHeight]) {
   181							String curString = strings.get(cur);
   182							strings.set(cur, curString.substring(0, curPos));
   183							cur++;
   184							if (curHeight == 0) {
   185								curHeight++;
   186							}
   187							strings.add(curString.substring(curPos + 1));
   188							curPos = strings.get(cur).indexOf(" ");
   189						} else {
   190							curPos = nextPos;
   191						}
   192					} else {
   193						String curString = strings.get(cur);
   194						if (g.getFontMetrics().stringWidth( curString ) > maxLength[curHeight]) {
   195							strings.set( cur, curString.substring(0, curPos) );
   196							cur++;
   197							strings.add( curString.substring(curPos + 1));
   198						}
   199						break;
   200					}
   201				}
   202			}
   203			for ( int i = 0; i < strings.size(); i++ ) {
   204				g.drawString(strings.get(i), x, y);
   205				y += 20;
   206			}
   207		}
   208	}


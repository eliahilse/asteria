   261		public boolean makeLevel(ApoStarzEntity[][] entities, boolean bSolve) {
   262			if (!bSolve) {
   263				this.originalEntities = entities;
   264			}
   265			
   266			this.level = new int[entities.length][entities[0].length];
   267			for (int i = 0; i < this.level.length; i++) {
   268				for (int j = 0;  j < this.level[0].length; j++) {
   269					if (entities[i][j] == null) {
   270						this.level[i][j] = ApoStarzConstants.EMPTY;
   271					} else if (entities[i][j] instanceof ApoStarzBlock) {
   272						if (entities[i][j].isBCanFall()) {
   273							this.level[i][j] = ApoStarzConstants.BLOCK_FALLING;
   274						} else {
   275							this.level[i][j] = ApoStarzConstants.BLOCK;
   276						}
   277					} else if (entities[i][j] instanceof ApoStarzStar) {
   278						this.level[i][j] = ApoStarzConstants.STAR;
   279					} else if (entities[i][j] instanceof ApoStarzGoal) {
   280						this.level[i][j] = ApoStarzConstants.GOAL;
   281					} else if (entities[i][j] instanceof ApoStarzFire) {
   282						this.level[i][j] = ApoStarzConstants.FIRE;
   283					}
   284				}
   285			}
   286			
   287			if (!bSolve) {
   288				this.setCurDirection(ApoStarzConstants.SOUTH);
   289			}
   290			
   291			return true;
   292		}

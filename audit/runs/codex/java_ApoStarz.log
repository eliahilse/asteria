   117					ApoStarzConstants.highscore.addHighscore(this.curLevelString, this.curSolution.length(), this.curSolution, true);
   118				}
   119			}
   120			if (!ApoConstants.B_APPLET) {
   121				ApoStarzConstants.highscore.writeLevel(System.getProperty("user.dir") + File.separator + "levels" + File.separator + "highscore.hig");
   122			} else {

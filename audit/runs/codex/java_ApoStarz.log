   565		private void thinkKeyLogic() {
   566			if (this.curKey == ApoStarzConstants.EMPTY) {
   567				return;
   568			}
   569			int keyCode = this.curKey;
   570			if (this.bTutorial) {
   571				this.tutorial.keyPressed(keyCode);
   572			} else if ((this.bTime) && (this.bTimeEnd)) {
   573				if (keyCode == KeyEvent.VK_ENTER) {
   574					this.setTimeMode();
   575				}
   576			} else if ((!this.level.isBFalling()) && (!this.level.isBWin()) && (!this.level.isBLost()) && (!this.bHighscore)) {
   577				if (keyCode == KeyEvent.VK_LEFT) {
   578					this.rotateLevel(-1);
   579					this.curSolution += "l";
   580				}
   581				if (keyCode == KeyEvent.VK_RIGHT) {
   582					this.rotateLevel(1);
   583					this.curSolution += "r";
   584				}
   585			} else if ((this.level.isBWin()) || (this.level.isBLost())) {
   586				if (keyCode == KeyEvent.VK_ENTER) {
   587					if (this.bHighscore) {
   588						this.nextLevelHighscore(+1);
   589					} else if (this.bTime) {
   590						this.setTimeMode();
   591					} else if (this.level.isBWin()) {
   592						if (this.steps > 0) {
   593							ApoStarzConstants.highscore.addHighscore(this.level.getLevelString(), this.steps, this.curSolution, false);
   594							if (!ApoConstants.B_APPLET) {
   595								ApoStarzConstants.highscore.writeLevel(System.getProperty("user.dir") + File.separator+ "levels" + File.separator + "highscore.hig");
   596							} else {
   597								ApoStarzConstants.highscore.writeLevel(ApoStarzGame.APPLET_LEVEL + "highscore.hig");			
   598							}
   599							this.nextLevel();
   600						} else {
   601							this.level.setBWin(false);
   602						}
   603					} else if (this.level.isBLost()) {
   604						this.restart();
   605					}
   606				}
   607			}
   608		}

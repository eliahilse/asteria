   132		private void getLevelSolution(ApoStarzLevel level, String solution) {
   133			if (level.isBWin()) {
   134				//System.out.println("win with "+solution);
   135				if (this.curSolution.length() > solution.length()) {
   136					this.curSolution = solution;
   137					return;
   138				}
   139			} else if (level.isBLost()) {
   140				return;
   141			} else if ((solution.length() >= this.curHighscore) || (solution.length() > ApoStarzSolver.MAX_DEPTH) || (this.curSolution.length() < solution.length())) {
   142				//System.out.println("too long with "+solution);
   143				return;
   144			} else {
   145				ApoStarzLevel levelCopy = level.getCopy();
   146				//links
   147				levelCopy.setCurDirection(level.getCurDirection() + 1);
   148				levelCopy.thinkSolver();
   149				String leftSolution = solution + "l";
   150				this.getLevelSolution(levelCopy, leftSolution);
   151				
   152				levelCopy = level.getCopy();
   153				//links
   154				levelCopy.setCurDirection(level.getCurDirection() - 1);
   155				levelCopy.thinkSolver();
   156				String rightSolution = solution + "r";
   157				this.getLevelSolution(levelCopy, rightSolution);
   158			}
   159		}

    86		public void actionPerformed(ActionEvent e) {
    87			float percent;
    88	
    89			if (this.isBlendIn) {
    90				percent = (System.currentTimeMillis() - this.startTime) / duration;
    91				percent = Math.min(1.0f, percent);
    92			} else {

   322					
   323					if (key == BitsKeyEvent.KEY_DEL) {
   324						this.textfield.deleteValue();
   325					}
   326					if(key == BitsKeyEvent.KEY_ENTER) {
   327						if (this.textfield.isSelect()) {
   328							BitsInput.getInstance().setVirtualKeyboardVisible(false);
   329						}
   330						this.textfield.setSelect(false);
   331						this.savePreferences();
   332					}
   333				} else {
   334					super.getModel().onKeyUp(key, event);
   335				}
   336			}
   337			
   338			return true;
   339		}

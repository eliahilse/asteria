   168		private void initFromBuffer(byte[] buffer) {
   169			if(!MidiUtil.bytesEqual(buffer, IDENTIFIER, 0, 4)) {
   170				System.out.println("File identifier not MThd. Exiting");
   171				mType = 0;
   172				mTrackCount = 0;
   173				mResolution = DEFAULT_RESOLUTION;
   174				return;
   175			}
   176			
   177			mType 			= MidiUtil.bytesToInt(buffer, 8, 2);
   178			mTrackCount		= MidiUtil.bytesToInt(buffer, 10, 2);
   179			mResolution 	= MidiUtil.bytesToInt(buffer, 12, 2);
   180		}
   181	}


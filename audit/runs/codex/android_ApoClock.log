   127		public void addTrack(MidiTrack T, int pos) {
   128			
   129			if(pos > mTracks.size()) {
   130				pos = mTracks.size();
   131			}
   132			else if(pos < 0) {
   133				pos = 0;
   134			}
   135			
   136			mTracks.add(pos, T);
   137			mTrackCount = mTracks.size();
   138			mType = mTrackCount > 1 ? 1 : 0;
   139		}
   140		
   141		public void removeTrack(int pos) {
   142			if(pos < 0 || pos >= mTracks.size()) {
   143				return;
   144			}
   145			mTracks.remove(pos);
   146			mTrackCount = mTracks.size();
   147			mType = mTrackCount > 1 ? 1 : 0;
   148		}

    47		public MidiFile(int resolution) {
    48			this(resolution, new ArrayList<MidiTrack>());
    49		}
    50		
    51		public MidiFile(int resolution, ArrayList<MidiTrack> tracks) {
    52			
    53			mResolution = resolution >= 0 ? resolution : DEFAULT_RESOLUTION;
    54			
    55			mTracks = tracks != null ? tracks : new ArrayList<MidiTrack>();
    56			mTrackCount = tracks.size();
    57			mType = mTrackCount > 1 ? 1 : 0;
    58		}
    59		
    60		public MidiFile(File fileIn) throws FileNotFoundException, IOException {
    61			this(new FileInputStream(fileIn));
    62		}
    63		
    64		public MidiFile(InputStream rawIn) throws IOException {
    65			
    66			BufferedInputStream in = new BufferedInputStream(rawIn);
    67			
    68			byte[] buffer = new byte[HEADER_SIZE];
    69			in.read(buffer);
    70			
    71			initFromBuffer(buffer);
    72			
    73			mTracks = new ArrayList<MidiTrack>();
    74			for(int i = 0; i < mTrackCount; i++) {
    75				mTracks.add(new MidiTrack(in));
    76			}
    77		}
    78		
    79		public void setType(int type) {
    80			if(type < 0) {
    81				type = 0;
    82			}
    83			else if(type > 2) {
    84				type = 1;
    85			}
    86			else if(type == 0 && mTrackCount > 1) {
    87				type = 1;
    88			}
    89			mType = type;
    90		}
    91		public int getType() {
    92			return mType;
    93		}

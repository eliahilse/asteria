    15	import android.content.Context;
    16	import android.util.Log;
    17	
    18	/**
    19	 * Convenience class extending PlayerThreadOLD, handling all the file operations,
    20	 * accepting Android resource ids for MOD/XM song files.
    21	 *	                  
    22	 * <p>   <b>Typical call order:</b>
    23	 * <br>   <code>mrp = MODResourcePlayerOLD(); // get player instance (in topmost activity, etc.)</code>
    24	 * <br>	  <code>mrp.LoadMODResource(R.raw.coolsong);  // load MOD/XM data into player</code>
    25	 * <br>   <code>mrp.start();   // start thread (playing song)</code>
    26	 * <br>
    27	 * 	<b>then when changing songs (new game level or transition to another sub-activity, etc.):</b> 
    28	 * 	<br>  <code>mrp.PausePlay();</code>
    29	 *  <br>  <code>mrp.LoadMODResource(R.raw.newcoolsong);</code>
    30	 *  <br>  <code>mrp.UnPausePlay();</code>
    31	 *  <br> <code>// repeat...</code>
    32	 * 
    33	 * @author    P.A. Casey (crow) Peculiar-Games.com
    34	 *              
    35	 * @version   1.0
    36	 *  
    37	 */
    38	public class MODResourcePlayer extends PlayerThread {
    39	
    40		//
    41		// prefix for Log output
    42		private final static String LOGPREFIX = "MODRESPLAYER";
    43		
    44		// application context, for accessing the resources (specifically the
    45		// R.raw. resources which are MOD music files)
    46		private Context mContext;
    47		
    48		//private PlayerThreadOLD playerthr = null;
    49	
    50		private InputStream mModfileInStream;
    51		private byte[] modData = null;
    52		private int modsize;    // holds the size in bytes of the mod file
    53	
    54		/**
    55		 * Allocates a MOD/XM/etc. song Player object that can handle Android resource
    56		 * files (typically the songs are stored in the res/raw project directory
    57		 * and conform to Android build process rules, lower-case names, etc.)
    58		 * <p>
    59		 * <b>Note about extensions:</b> developers using Eclipse as an IDE should note
    60		 * that it allows the .xm file extension but may be fussy about other tracker
    61		 * format extensions.
    62		 *	                          	
    63		 * The cont argument is the application context which allows MODResourcePlayerOLD to
    64		 * load resources directly.
    65		                          
    66		@param  cont application Context
    67		 *  
    68		 */
    69		public MODResourcePlayer(Context cont) {
    70			// get super class (PlayerThreadOLD) with default rate
    71			super(0);
    72			
    73			mContext = cont;
    74			
    75			// full volume
    76	        setVolume(255);
    77		}
    78		
    79		/**
    80		 * Load a MOD/XM/etc. song file from an Android resource.
    81		 * <p>
    82		 * <b>Note about extensions:</b> developers using Eclipse as an IDE should note
    83		 * that it allows the .xm file extension but may be fussy about other tracker
    84		 * format extensions.
    85		 *	                          	
    86		 * The modresource argument is the resource id for the MOD/XM song file, e.g. R.raw.coolsong
    87		                          
    88		@param  modresource Android resource id for a MOD/XM/etc. (tracker format) song file
    89		 *  
    90		 */
    91		public boolean LoadMODResource(int modresource) {
    92			int currfilesize = 0;
    93			
    94			// unload any mod file we have currently loaded
    95			UnLoadMod();
    96			
    97			// get an input stream for the MOD file resource
    98	        mModfileInStream = 	mContext.getResources().openRawResource(modresource);
    99	        try {
   100				currfilesize = mModfileInStream.available();
   101			} catch (IOException e) {
   102				Log.w(LOGPREFIX, "Can't get the file size for MOD file resource!");
   103				return false;
   104			}
   105			
   106			// if the mod file data buffer has yet to be allocated or is too small
   107			// we need to get a new one
   108			if (modData == null || modData.length < currfilesize) {
   109				// allocate a new buffer that can hold the current MOD file data
   110		        modData = new byte[currfilesize];
   111			}
   112			
   113	        // could use better error checking
   114	        try {
   115	        	modsize = mModfileInStream.read(modData,0, currfilesize);
   116	    		Log.v(LOGPREFIX, "read in "+modsize+" bytes from the mod file");
   117	        } catch (IOException e) {
   118				// Auto-generated catch block
   119	        	// may need better error handling here...
   120				e.printStackTrace();
   121			}
   122	
   123	        // load it into the player
   124	        LoadMODData(modData);
   125			
   126			return true;
   127		}
   128		
   129	
   130	
   131		/**
   132		 * Stop playing the song, close down the player and <code>join()</code> the player thread.
   133		 * <p>
   134		 * Typically called in the application's (Activity's) <code>onPause()</code> method 
   135		 */
   136		public void StopAndClose() {
   137	        
   138			PausePlay();
   139			
   140	    	boolean retry = true;
   141	
   142	    	// now close and join() the mod player thread
   143	    	StopThread();
   144	        while (retry) {
   145	        	try {
   146	        		join();
   147	        		retry = false;
   148	        	} catch (InterruptedException e) {
   149	        		// keep trying to close the player thread
   150	        	}
   151	        }
   152	        PlayerThread.CloseLIBMODPLUG();
   153	
   154	        InvalidatePlayer();
   155		}
   156		
   157	}


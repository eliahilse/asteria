   410						int y = (int)(this.getButtons()[i].getY());
   411						int width = (int)(this.getButtons()[i].getWidth());
   412						int height = (int)(this.getButtons()[i].getHeight());
   413						
   414						g.setColor(160, 160, 160, 255);
   415						g.fillRect(x, y, width, height);
   416						g.setColor(48f/255f, 48f/255f, 48f/255f, 1.0f);
   417						g.drawRect(x, y, width, height);
   418						
   419						this.drawString(g, this.getButtons()[i].getFunction(), x + width/2, y + height/2 - font.mCharCellHeight/2, font);
   420					}
   421				}
   422			}
   423		}

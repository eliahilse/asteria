   129		public void insertNote(int channel, int pitch, int velocity, long tick, long duration) {
   130			
   131			insertEvent(new NoteOn(tick, channel, pitch, velocity));
   132			insertEvent(new NoteOn(tick + duration, channel, pitch, 0));
   133		}
   134		
   135		@SuppressWarnings({ "rawtypes", "unchecked" })
   136		public void insertEvent(MidiEvent newEvent) {
   137			
   138			if(newEvent == null) {
   139				return;
   140			}
   141			
   142			if(mClosed) {
   143				System.err.println("Error: Cannot add an event to a closed track.");
   144				return;
   145			}
   146			
   147			MidiEvent prev = null, next = null;
   148			
   149			// floor() and ceiling() are not supported on Android before API Level 9 (Gingerbread)
   150			try {
   151				Class treeSet = Class.forName("java.util.TreeSet");
   152				Method floor = treeSet.getMethod("floor", Object.class);
   153				Method ceiling = treeSet.getMethod("ceiling", Object.class);
   154				
   155				prev = (MidiEvent)floor.invoke(mEvents, newEvent);
   156				next = (MidiEvent)ceiling.invoke(mEvents, newEvent);
   157				
   158			} catch(Exception e) {
   159				// methods are not supported - must perform linear search
   160				Iterator<MidiEvent> it = mEvents.iterator();
   161				
   162				while(it.hasNext()) {
   163					next = it.next();
   164					
   165					if(next.getTick() > newEvent.getTick()) {
   166						break;
   167					}
   168					
   169					prev = next;
   170					next = null;
   171				}
   172			}
   173			
   174			mEvents.add(newEvent);
   175			mSizeNeedsRecalculating = true;
   176			
   177			// Set its delta time based on the previous event (or itself if no previous event exists)
   178			if(prev != null) {
   179				newEvent.setDelta(newEvent.getTick() - prev.getTick());
   180			} else {
   181				newEvent.setDelta(newEvent.getTick());
   182			}
   183			
   184			// Update the next event's delta time relative to the new event.
   185			if(next != null) {
   186				next.setDelta(next.getTick() - newEvent.getTick());
   187			}
   188			
   189			mSize += newEvent.getSize();
   190			
   191			if(newEvent.getClass().equals(EndOfTrack.class)) {
   192				if(next != null) {
   193					throw new IllegalArgumentException("Attempting to insert EndOfTrack before an existing event. Use closeTrack() when finished with MidiTrack.");
   194				}
   195				mClosed = true;
   196			}
   197		}
   198		
   199		public boolean removeEvent(MidiEvent E) {
   200			
   201			Iterator<MidiEvent> it = mEvents.iterator();
   202			MidiEvent prev = null, curr = null, next = null;
   203	
   204			while(it.hasNext()) {
   205				next = it.next();
   206				
   207				if(E.equals(curr)) {
   208					break;
   209				}
   210				
   211				prev = curr;
   212				curr = next;
   213				next = null;
   214			}
   215			
   216			if(next == null) {
   217				// Either the event was not found in the track,
   218				// or this is the last event in the track.
   219				// Either way, we won't need to update any delta times
   220				return mEvents.remove(curr);
   221			}
   222			
   223			if(!mEvents.remove(curr)) {
   224				return false;
   225			}
   226			
   227			if(prev != null) {
   228				next.setDelta(next.getTick() - prev.getTick());
   229			} else {
   230				next.setDelta(next.getTick());
   231			}
   232			return true;
   233		}
   234		
   235		public void closeTrack() {
   236			long lastTick = 0;
   237			if(mEvents.size() > 0) {
   238				MidiEvent last = mEvents.last();
   239				lastTick = last.getTick() + 1;
   240			}
   241			EndOfTrack eot = new EndOfTrack(lastTick, 0);
   242			insertEvent(eot);
   243		}

   394			g.setColor(colorBack[0], colorBack[1], colorBack[2], colorBack[3]);
   395			g.setFont(font);
   396			g.drawText(s, x - w/2 + 1, y + 2 - font.mCharCellHeight/6);
   397			g.setColor(colorFront[0], colorFront[1], colorFront[2], colorFront[3]);

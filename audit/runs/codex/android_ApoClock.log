   150		public void writeToFile(File outFile) throws FileNotFoundException, IOException {
   151					
   152			FileOutputStream fout = new FileOutputStream(outFile);
   153			
   154			fout.write(IDENTIFIER);
   155			fout.write(MidiUtil.intToBytes(6, 4));
   156			fout.write(MidiUtil.intToBytes(mType, 2));
   157			fout.write(MidiUtil.intToBytes(mTrackCount, 2));
   158			fout.write(MidiUtil.intToBytes(mResolution, 2));
   159			
   160			for(MidiTrack T : mTracks) {
   161				T.writeToFile(fout);
   162			}
   163			
   164			fout.flush();
   165			fout.close();
   166		}

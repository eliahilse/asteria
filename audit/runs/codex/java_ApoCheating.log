   991		/**
   992		 * 	 This method draws a volatile image and returns it or possibly a
   993		 	newly created volatile image object. Subsequent calls to this method
   994		 	should always use the returned volatile image.
   995		 	If the contents of the image is lost, it is recreated using orig.
   996	     	img may be null, in which case a new volatile image is created.
   997		 */
   998	    public VolatileImage drawVolatileImage( Graphics2D g, VolatileImage img,
   999	    										int x, int y, Image orig) {
  1000	        final int MAX_TRIES = 100;
  1001	        for (int k=0; k<MAX_TRIES; k++) {
  1002	            if (img != null) {
  1003	                // Draw the volatile image
  1004	                //g.drawImage(img, x, y, null);
  1005	            	g.drawImage( img, 0 + x, 0 + y, this );
  1006	            	
  1007	                // Check if it is still valid
  1008	                if (!img.contentsLost()) {
  1009	                    return img;
  1010	                }
  1011	            } else {
  1012	                // Create the volatile image
  1013	                img = g.getDeviceConfiguration().createCompatibleVolatileImage(
  1014	                    orig.getWidth(null), orig.getHeight(null));
  1015	            }
  1016	    
  1017	            // Determine how to fix the volatile image
  1018	            switch (img.validate(g.getDeviceConfiguration()))
  1019	            {
  1020	            	case VolatileImage.IMAGE_OK:
  1021	            		// This should not happen
  1022	            		break;
  1023	            	case VolatileImage.IMAGE_INCOMPATIBLE:
  1024	            		// Create a new volatile image object;
  1025	            		// this could happen if the component was moved to another device
  1026	            		img.flush();
  1027	            		img = g.getDeviceConfiguration().createCompatibleVolatileImage(
  1028	            				orig.getWidth(null), orig.getHeight(null));
  1029	            	case VolatileImage.IMAGE_RESTORED:
  1030	            		// Copy the original image to accelerated image memory
  1031	            		Graphics2D gc = (Graphics2D)img.createGraphics();
  1032	            		gc.drawImage(orig, 0, 0, null);
  1033	            		gc.dispose();
  1034	            		break;
  1035	            }
  1036	        }
  1037	    
  1038	        // The image failed to be drawn after MAX_TRIES;
  1039	        // draw with the non-accelerated image
  1040	        g.drawImage(orig, x, y, null);
  1041	        return img;
  1042	    }

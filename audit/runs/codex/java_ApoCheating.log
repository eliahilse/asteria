   131		
   132	    /**
   133	     * Hilfsmethode f�r Umwandlung des Bildes
   134	     * @param image
   135	     * @return ob das Bild einen Alpha-Wert hat
   136	     */
   137	    private boolean hasAlpha(Image image) 
   138	    {
   139	        if (image instanceof BufferedImage) 
   140	        {
   141	            BufferedImage bImage = (BufferedImage) image;
   142	            return bImage.getColorModel().hasAlpha();
   143	        }
   144	
   145	        PixelGrabber pixelGrabber = new PixelGrabber(image, 0, 0, 1, 1, false);
   146	        try 
   147	        {
   148	            pixelGrabber.grabPixels();
   149	        } catch (InterruptedException e) 
   150	        {}
   151	
   152	        ColorModel colorModel = pixelGrabber.getColorModel();
   153	        return colorModel.hasAlpha();
   154	    }
   155	
   156	    /**
   157	     *  Umwandlung eines Image in ein BufferedImage
   158	     * @param image
   159	     * @return das BufferedImage
   160	     */
   161	    private BufferedImage toBufferedImage(Image image) 
   162	    {
   163	        if (image instanceof BufferedImage) 
   164	        {
   165	            return (BufferedImage) image;
   166	        }
   167	
   168	        image = new ImageIcon(image).getImage();
   169	
   170	        boolean hasAlpha = hasAlpha(image);
   171	
   172	        BufferedImage bImage = null;
   173	        GraphicsEnvironment ge = GraphicsEnvironment
   174	                .getLocalGraphicsEnvironment();
   175	        try 
   176	        {
   177	            int transparency = Transparency.OPAQUE;
   178	            if (hasAlpha)
   179	                transparency = Transparency.BITMASK;
   180	
   181	            GraphicsDevice gs = ge.getDefaultScreenDevice();
   182	            GraphicsConfiguration gc = gs.getDefaultConfiguration();
   183	            bImage = gc.createCompatibleImage(image.getWidth(null), image
   184	                    .getHeight(null), transparency);
   185	        } catch (HeadlessException e) 
   186	        {}
   187	
   188	        if (bImage == null) 
   189	        {
   190	            int type = BufferedImage.TYPE_INT_RGB;
   191	            if (hasAlpha)
   192	                type = BufferedImage.TYPE_INT_ARGB;
   193	            bImage = new BufferedImage(image.getWidth(null), image
   194	                    .getHeight(null), type);
   195	        }
   196	
   197	        Graphics g = bImage.createGraphics();
   198	
   199	        g.drawImage(image, 0, 0, this);
   200	        g.dispose();
   201	        return bImage;
   202	    }

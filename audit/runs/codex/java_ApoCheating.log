   684		private boolean movePlayer( ApoCheatingPlayer player, int x, int y )
   685		{
   686			boolean bCollision	= false;
   687			
   688			int newX	= x / 32;
   689			int newY	= y / 32;
   690			if ( this.aPlayground[newY][newX] >= ApoCheatingConstants.DESK_UP_LEFT )
   691				bCollision	= true;
   692			newX	= (x+player.getWidth()-6) / 32;
   693			newY	= y / 32;
   694			if ( this.aPlayground[newY][newX] >= ApoCheatingConstants.DESK_UP_LEFT )
   695				bCollision	= true;
   696			newX	= (x+player.getWidth()-6) / 32;
   697			newY	= (y+player.getHeight()-6) / 32;
   698			if ( this.aPlayground[newY][newX] >= ApoCheatingConstants.DESK_UP_LEFT )
   699				bCollision	= true;
   700			newX	= (x) / 32;
   701			newY	= (y+player.getHeight()-6) / 32;
   702			if ( this.aPlayground[newY][newX] >= ApoCheatingConstants.DESK_UP_LEFT )
   703				bCollision	= true;
   704			for ( int j = 0; j < this.extra.size(); j++ )
   705			{
   706				if ( bCollision )
   707					break;
   708				if ( this.extra.get( j ).isHitting( player, x, y ) )
   709				{
   710					bCollision	= true;
   711					break;
   712				}
   713			}
   714			for ( int j = 0; j < this.goal.size(); j++ )
   715			{
   716				if ( bCollision )
   717					break;
   718				if ( this.goal.get( j ).isHitting( player, x, y ) )
   719				{
   720					bCollision	= true;
   721					break;
   722				}
   723			}
   724			return bCollision;
   725		}

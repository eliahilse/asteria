   973			{
   974				String newMessage = message.substring( 0, i+1 );
   975				message			= message.substring( i+1 );
   976				newW	= g.getFontMetrics().stringWidth( currentMessage + newMessage );
   977				
   978				if ( newW > 420 )
   979				{
   980					g.drawString( currentMessage, 30, 120 + y );
   981					currentMessage	= "";

   116		public void expansionPoint( Point p, int x, int y )
   117		{
   118			Point newPoint	= new Point( p.x + x, p.y + y );
   119			if ( 	( newPoint.x < this.aWay[0].length ) && 
   120					( newPoint.y < this.aWay.length ) &&
   121					( newPoint.x >= 0 ) && 
   122					( newPoint.y >= 0 ) &&
   123					( this.aWay[newPoint.y][newPoint.x] )  )
   124			{
   125				int cost	=  this.aSearch[p.y][p.x].getCost() + this.aSearch[newPoint.y][newPoint.x].getCost() + 1;
   126				if ( ( !this.isInOpenList( newPoint ) ) && ( !this.isInClosedList( newPoint ) ) )
   127				{
   128					this.aSearch[newPoint.y][newPoint.x].setCost( cost );
   129					this.aSearch[newPoint.y][newPoint.x].setPrevious( p );
   130					this.addToOpenList( newPoint );                
   131				} else if ( this.isInClosedList( newPoint ) )
   132				{
   133					if ( this.aSearch[p.y][p.x].getCost() > cost )
   134					{
   135						this.aSearch[newPoint.y][newPoint.x].setCost( cost );
   136						this.aSearch[newPoint.y][newPoint.x].setPrevious( p );
   137						this.closedList.remove( newPoint );
   138						this.addToOpenList( newPoint );
   139	                }
   140	            } else if ( this.isInOpenList( newPoint ) )
   141	            {
   142	            	if ( this.aSearch[p.y][p.x].getCost() > cost )
   143					{
   144	            		this.aSearch[newPoint.y][newPoint.x].setCost( cost );
   145	            		this.aSearch[newPoint.y][newPoint.x].setPrevious( p );
   146	            		this.openList.remove( newPoint );
   147	            		this.addToOpenList( newPoint );
   148					}
   149	            }
   150			}
   151		}

   727		private void finish()
   728		{
   729			for ( int j = 0; j < this.player.size(); j++ )
   730			{
   731				if ( ( this.player.size() > 1 ) && ( this.player.get( j ).getDetected() >= 100 ) )
   732				{
   733					this.bFinish	= true;
   734					this.bThread	= false;
   735					this.iWin		= this.getIWin();
   736					//this.apoCheatingTimer.setBRunning( false );
   737					if ( j == 0 )
   738						this.playerWin	= this.player.get( j+1 ).getPlayer();
   739					else
   740						this.playerWin	= this.player.get( j-1 ).getPlayer();
   741					if ( this.apoCheatingHudPanel != null )
   742					{
   743						this.apoCheatingHudPanel.setReloadButton( true );
   744					}
   745					return;
   746				}
   747				else if ( ( this.player.size() == 1 ) && ( this.player.get(j ).getDetected() >= 100 ) )
   748				{
   749					this.bFinish	= true;
   750					this.playerWin	= -1;
   751					this.bThread	= false;
   752					this.iWin		= this.getIWin();
   753					//this.apoCheatingTimer.setBRunning( false );

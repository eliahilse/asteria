   771					else if ( this.finish.get( i ).isOnFinish( this.player.get( j ) ) )
   772					{
   773						this.player.get( j ).setBFinish( true );
   774						break;
   775					}
   776					else
   777					{
   778						this.player.get( j ).setBFinish( false );
   779					}
   780				}
   781			}
   782		}

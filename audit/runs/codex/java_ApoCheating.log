   189					if ( cost > current.getCompleteCost() )
   190					{
   191						//System.out.println("openList x = "+point.x+" y = "+point.y);
   192						this.openList.add(i+1, point);
   193						break;
   194					} else if (i == 0)
   195					{
   196						//System.out.println("openList x = "+point.x+" y = "+point.y);
   197						this.openList.add(0, point);
   198						break;
   199					}
   200				}
   201			}

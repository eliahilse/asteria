   104		private void makeView( ApoCheatingTeacher teacher, boolean bNew )
   105		{
   106			boolean bFirst	= false;
   107			if ( (bNew) || ( this.startX == null ) || ( this.startY == null ) || ( this.currentX == null ) )
   108			{
   109				bFirst			= true;
   110				this.startX		= this.currentX		= new int[4];
   111				this.startY		= this.currentY		= new int[4];
   112				this.startX[0]	= this.startX[3]	= this.currentX[0]	= this.currentX[3]	= (int)teacher.getX() + teacher.getWidth() / 2;
   113				this.startY[0]	= this.startY[3]	= this.currentY[0]	= this.currentY[3]	= (int)teacher.getY() + teacher.getHeight() / 2;
   114			}
   115			int x				= 0;
   116			int y				= 0;
   117			int dir				= (int)this.currentDir;
   118			dir 				+= this.width/2;
   119			if ( dir > 360 )
   120				dir 			-= 360;
   121			x				= (int)(this.currentX[0] + this.height * Math.cos( Math.toRadians( dir )) );
   122			y				= (int)(this.currentY[0] + this.height * Math.sin( Math.toRadians( dir )) );
   123			this.currentX[1]	= (int)(x);
   124			this.currentY[1]	= (int)(y);
   125			
   126			dir				= (int)this.currentDir;
   127			dir 			-= this.width/2;
   128			if ( dir < 0 )
   129				dir 		= 360 + dir;
   130			x				= (int)(this.currentX[0] + this.height * Math.cos( Math.toRadians( dir )) );
   131			y				= (int)(this.currentY[0] + this.height * Math.sin( Math.toRadians( dir )) );
   132			this.currentX[2]	= (int)(x);
   133			this.currentY[2]	= (int)(y);
   134			if ( bFirst )
   135			{
   136				this.startX[1]	= this.currentX[1];
   137				this.startY[1]	= this.currentY[1];
   138				this.startX[2]	= this.currentX[2];
   139				this.startY[2]	= this.currentY[2];
   140			}
   141		}

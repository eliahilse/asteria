    28		
    29		public ApoCheatingFinish( BufferedImage iDetect, BufferedImage iEntity, int x, int y, int width, int height, int player )
    30		{
    31			super( iDetect, iEntity, x, y, width, height, ApoCheatingConstants.FINISH );
    32			
    33			this.bFinish		= false;
    34			this.player			= player;
    35		}
    36		
    37		private BufferedImage getIFinish( Color color )
    38		{
    39			BufferedImage iFinish = GraphicsEnvironment.getLocalGraphicsEnvironment().getDefaultScreenDevice().getDefaultConfiguration().createCompatibleImage( 22, 22, Transparency.TRANSLUCENT );
    40			
    41			Graphics2D g = (Graphics2D)iFinish.getGraphics();
    42			
    43			g.setRenderingHint(RenderingHints.KEY_ANTIALIASING, RenderingHints.VALUE_ANTIALIAS_ON);
    44			
    45			Composite clone = g.getComposite();
    46			
    47			g.setColor( color );
    48			g.setComposite( AlphaComposite.getInstance( AlphaComposite.SRC_OVER, 0.45f ) );
    49			g.fillOval( 0, 0, iFinish.getWidth() - 1, iFinish.getHeight() - 1 );
    50			
    51			Stroke cloneStroke = g.getStroke();
    52			
    53			g.setColor( Color.BLACK );
    54			g.setStroke( new BasicStroke( 2 ) );
    55			g.drawOval( 0, 0, iFinish.getWidth() - 1, iFinish.getHeight() - 1 );
    56			
    57			g.setComposite( clone );
    58			g.setStroke( cloneStroke );
    59			
    60			g.dispose();
    61			
    62			return iFinish;
    63		}
    64		
    65		protected void init()
    66		{
    67			super.init();
    68			this.bFinish		= false;
    69			
    70			if ( this.iFinish == null ) {
    71				this.iFinish = this.getIFinish( Color.BLACK );
    72				this.iFinishReady = this.getIFinish( Color.BLUE );
    73			}
    74		}
    75		
    76		protected boolean isFinish( ApoCheatingPlayer player )
    77		{
    78			if ( ( player.getCheated() >= 100 ) && ( player.getPlayer() == this.player ) )
    79			{
    80				this.bFinish	= true;
    81				return (new Rectangle( (int)this.getX(), (int)this.getY(), 1, 1 )).intersects( new Rectangle( (int)player.getX() + player.getWidth()/2 - 3, (int)player.getY() + player.getHeight()/2 - 3, 7, 7 ) );
    82			}
    83			else
    84				return false;
    85		}
    86		
    87		protected boolean isOnFinish( ApoCheatingPlayer player )
    88		{
    89			if ( player.getPlayer() == this.player )
    90			{

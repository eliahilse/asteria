   658		private void move()
   659		{
   660			for ( int i = 0; i < this.player.size(); i++ )
   661			{
   662				boolean bCollision	= false;
   663				int x	= (int)(this.player.get( i ).getX() + 2 + this.player.get( i ).getLeftDirection()*this.player.get( i ).getSpeed());
   664				int y	= (int)(this.player.get( i ).getY() + 2 + this.player.get( i ).getUpDirection()*this.player.get( i ).getSpeed());
   665				bCollision	= this.movePlayer( this.player.get( i ), x, y );
   666				if ( !bCollision )
   667					this.player.get( i ).setNewXAndY( true, true );
   668				else if ( ( this.player.get( i ).getLeftDirection() != ApoCheatingConstants.EMPTY ) &&
   669						  ( this.player.get( i ).getUpDirection() != ApoCheatingConstants.EMPTY ) )
   670				{
   671					bCollision	= this.movePlayer( this.player.get( i ), x, (int)(this.player.get( i ).getY() + 2) );
   672					if ( !bCollision )
   673						this.player.get( i ).setNewXAndY( true, false );
   674					else
   675					{
   676						bCollision	= this.movePlayer( this.player.get( i ), (int)(this.player.get( i ).getX() + 2), y );
   677						if ( !bCollision )
   678							this.player.get( i ).setNewXAndY( false, true );
   679					}
   680				}
   681			}
   682		}

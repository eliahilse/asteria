    36		protected void init()
    37		{
    38			currentTicks	= 0;
    39			currentX		= this.startX;
    40			currentY		= this.startY;
    41		}
    42		
    43		protected boolean next( ApoCheatingTeacher teacher )
    44		{
    45			if ( 	( ( this.currentX == this.finishX ) &&
    46					  ( this.currentY == this.finishY ) ) &&
    47					( this.currentTicks == this.maxTicks ) )
    48			{
    49				//System.out.println("Check mit x = "+this.finishX+" y = "+this.finishY);
    50				this.currentX		= this.startX;
    51				this.currentY		= this.startY;
    52				this.currentTicks	= 0;
    53				return false;
    54			}
    55			else
    56			{
    57				if ( ( this.currentX != this.finishX ) ||
    58					 ( this.currentY != this.finishY ) )
    59				{
    60					if ( teacher.getY() != this.currentY )
    61						teacher.setY( this.currentY );
    62					if ( teacher.getX() != this.currentX )
    63						teacher.setX( this.currentX );
    64					double speed		= 0;
    65	
    66					{
    67						if ( this.startY < this.finishY )
    68							speed		= this.speed;
    69						else if ( this.startY > this.finishY )
    70							speed		= -this.speed;
    71						this.currentY	+= speed;
    72						if ( ( speed < 0 ) && ( this.currentY < this.finishY ) )
    73							this.currentY	= this.finishY;
    74						else if ( ( speed > 0 ) && ( this.currentY > this.finishY ) )
    75							this.currentY	= this.finishY;
    76						teacher.setY( this.currentY );
    77					}
    78					{
    79						if ( this.startX < this.finishX )
    80							speed		= this.speed;
    81						else if ( this.startX > this.finishX )
    82							speed		= -this.speed;
    83						this.currentX	+= speed;
    84						if ( ( speed < 0 ) && ( this.currentX < this.finishX ) )
    85							this.currentX	= this.finishX;
    86						else if ( ( speed > 0 ) && ( this.currentX > this.finishX ) )
    87							this.currentX	= this.finishX;
    88						teacher.setX( this.currentX );
    89					}
    90				}
    91				if ( this.currentTicks != this.maxTicks )
    92					this.currentTicks	+= 1;
    93			}
    94			return true;
    95		}

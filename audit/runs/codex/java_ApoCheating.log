    56		public boolean next( ApoCheatingTeacher teacher )
    57		{
    58			if ( 	( this.maxTicks == this.currentTicks ) )
    59			{
    60				System.arraycopy( this.currentX, 0, this.startX, 0, this.startX.length );
    61				System.arraycopy( this.currentY, 0, this.startY, 0, this.startY.length );
    62				this.currentDir		= startDir;
    63				this.currentTicks	= 0;
    64				return false;
    65			} else
    66			{
    67				if ( 	( (int)teacher.getX() != this.currentX[0] ) ||
    68						( (int)teacher.getY() != this.currentY[0] ) )
    69				{
    70					this.currentX[0] = this.currentX[3] = (int)teacher.getX() + teacher.getHeight() / 2;
    71					this.currentY[0] = this.currentY[3] = (int)teacher.getY() + teacher.getHeight() / 2;
    72				}
    73				this.currentDir		+= this.speed;
    74				if ( this.currentDir < 0 )
    75					this.currentDir	= 360.0D;
    76				else if ( this.currentDir > 360.0D )
    77					this.currentDir	-= 360.0D;
    78				if ( this.startDir < this.endDir )
    79				{
    80					
    81					if ( this.currentDir < this.startDir )
    82						this.speed	= -this.speed;
    83					else if ( this.currentDir > this.endDir )
    84						this.speed	= -this.speed;
    85				} else
    86				{
    87					double oldDir	= this.currentDir - this.speed;
    88					if ( ( this.currentDir > this.endDir ) && ( oldDir <= this.endDir ) )
    89						this.speed	= -this.speed;
    90					else if ( ( this.currentDir < this.startDir ) && ( oldDir >= this.startDir ) )
    91						this.speed	= -this.speed;
    92				}
    93				this.makeView( teacher );
    94				this.currentTicks	+= 1;
    95			}
    96			return true;
    97		}

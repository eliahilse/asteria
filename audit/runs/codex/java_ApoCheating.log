    10		
    11		public ApoCheatingTeacherWay( int startX, int startY, int finishX, int finishY, double speed, int maxTicks )
    12		{
    13			this.finishX		= finishX;
    14			this.finishY		= finishY;
    15			this.startX			= startX;
    16			this.startY			= startY;
    17			this.speed			= Math.abs( speed );
    18			this.currentX		= startX;
    19			this.currentY		= startY;
    20			this.maxTicks		= maxTicks;
    21			int x				= (int)Math.abs( ( this.finishX - this.startX ) / this.speed );
    22			int y				= (int)Math.abs( ( this.finishY - this.startY ) / this.speed );
    23			if ( this.maxTicks < 0 )
    24			{
    25				if ( x > y )
    26					this.maxTicks	= x-1;
    27				else
    28					this.maxTicks	= y-1;
    29				this.maxTicks	= 0;
    30			}
    31			this.currentTicks	= 0;
    32			//System.out.print( "startX = "+this.currentX+" startY = "+this.currentY+" ");
    33			//System.out.println( "finishX = "+this.finishX+" finishY = "+this.finishY);
    34		}

   345						this.buttons[i].setBOver( false );
   346					} else if ( "Load".equals( function ) )
   347					{
   348						this.load();
   349						this.buttons[i].setBOver( false );
   350					} else if ( "Play".equals( function ) )
   351					{
   352						this.play();
   353					} else if ( "Stop".equals( function ) )
   354					{
   355						this.stop();
   356					} else if ( "Reload".equals( function ) )
   357					{
   358						this.reload();
   359					} else if ( "Next".equals( function ) )
   360					{
   361						this.next();
   362					} else if ( "nextLevel".equals( function ) )
   363					{
   364						this.next();
   365					} else if ( "previousLevel".equals( function ) )
   366					{
   367						this.previous();
   368					} else if ( "Random".equals( function ) )
   369					{
   370						this.setRandom();
   371					} else if ( "Original".equals( function ) )
   372					{
   373						this.setOriginal();
   374					} else if ( "New".equals( function ) )
   375					{
   376						this.setNew();
   377					} else if ( "On".equals( function ) )
   378					{
   379						this.setDetect( true );
   380						break;
   381					} else if ( "Off".equals( function ) )
   382					{
   383						this.setDetect( false );

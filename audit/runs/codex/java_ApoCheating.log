   113					red = 255;
   114				if ( redPlayer > 255 )
   115					redPlayer = 255;
   116				int blue	= this.cheatColor.getBlue();
   117				int green	= this.cheatColor.getGreen() - (int)this.plus;
   118				int greenPlayer	= player.getCheatColor().getGreen() - (int)this.plus;

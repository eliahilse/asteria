   175		@SuppressWarnings("unchecked")
   176		private void addToOpenList(Point point )
   177		{
   178			double cost	= this.aSearch[point.y][point.x].getCompleteCost();
   179			if ( this.openList.isEmpty() )
   180			{
   181				//System.out.println("openList x = "+point.x+" y = "+point.y);

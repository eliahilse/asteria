   758				for ( int i = 0; i < this.finish.size(); i++ )
   759				{
   760					if ( this.finish.get( i ).isFinish( this.player.get( j ) ) )
   761					{
   762						this.bFinish	= true;
   763						this.playerWin	= this.player.get( j ).getPlayer();
   764						this.bThread	= false;
   765						this.iWin		= this.getIWin();
   766						//this.apoCheatingTimer.setBRunning( false );
   767						if ( this.apoCheatingHudPanel != null )
   768							this.apoCheatingHudPanel.setReloadButton( true );
   769						return;

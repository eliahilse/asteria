    34	public final class 
    35	BitsXmi2Mid {
    36	
    37		private static final int XMI_TAG_FORM = 1179603533;
    38		private static final int XMI_TAG_XDIR = 1480870226;
    39		private static final int XMI_TAG_INFO = 1229866575;
    40		private static final int XMI_TAG_CAT  = 1128354848;
    41		private static final int XMI_TAG_XMID = 1481460036;
    42		private static final int XMI_TAG_EVNT = 1163284052;
    43	//	private int 							mTrackCount = 0;
    44		
    45		public static final boolean 
    46		convert( 
    47				final byte[] xmiData, 
    48				final float tempo, 
    49				final String midFile ) {
    50			
    51			if( xmiData == null ) {
    52				BitsLog.e("BitsXmi2Mid - convert", "The given xmiData or midFile is null.");
    53				return false;
    54			}
    55			if( midFile.equals("") == true ) {
    56				BitsLog.e("BitsXmi2Mid - convert", "The given midFile is null.");
    57				return false;
    58			}
    59			if( tempo <= 0) {
    60				BitsLog.e("BitsXmi2Mid - convert", "The given tempo is <= 0.");
    61				return false;
    62			}
    63			
    64			final ArrayList<BitsXmiNote> notes = new ArrayList<BitsXmiNote>();
    65			final ByteBuffer buffer = ByteBuffer.wrap(xmiData);
    66			boolean done = false;
    67			
    68			while( true ) {
    69				if( done == true ) {
    70					break;
    71				}
    72				
    73				
    74				int chunkTag 	= buffer.getInt();
    75				int chunkLength = buffer.getInt();
    76				int chunkType 	= buffer.getInt();
    77				
    78				//read number of tracks in XMI file
    79				if( chunkTag == XMI_TAG_FORM && chunkType == XMI_TAG_XDIR ) { //"FORM" and "XDIR"
    80					chunkTag = buffer.getInt(); //"INFO"
    81					chunkLength = buffer.getInt(); //length
    82					
    83					if( chunkTag == XMI_TAG_INFO ) {
    84						buffer.getShort();//this.mTrackCount =  BitsUtils.toLittleEndian(this.mBuffer.getShort()); //number of tracks in file
    85					}
    86					
    87					continue; //move on
    88				}
    89				
    90				if( chunkTag == XMI_TAG_CAT && chunkType == XMI_TAG_XMID ) { //"CAT " and "XMID"
    91					continue; //move on
    92				}
    93	
    94				if( chunkTag == XMI_TAG_FORM && chunkType == XMI_TAG_XMID ) { //"FORM" and "XMID"
    95	//				for( int t = 0; t < this.mTrackCount; t++ ) { //cycle through the tracks
    96						while( true ) { //read [TIMB], [RBRN], ..., EVNT
    97							chunkTag 	= buffer.getInt(); //chunk
    98							chunkLength = buffer.getInt(); //length
    99							
   100							if( chunkTag != XMI_TAG_EVNT ) {
   101								buffer.position( buffer.position() + chunkLength ); //skip this chunk!
   102							} else { //last and only "EVNT" chunk
   103								buffer.position( buffer.position() + 4 ); chunkLength -= 4; //unknown
   104								
   105								int time = 0;		
   106								while(chunkLength > 0) {
   107									int eventType = buffer.get() & 0xFF; chunkLength--;
   108									
   109									if( (eventType & 0x80) != 0) { //is value > 127 -> type
   110										
   111										BitsXmiNote note = new BitsXmiNote();
   112										note.mTimeIndex = time;
   113										note.mType = eventType;
   114										
   115										switch (eventType & 0xF0) {
   116											case 0x80:
   117											case 0x90:
   118											case 0xA0:
   119											case 0xB0:
   120											case 0xE0:
   121												note.mData1 = buffer.get() & 0xFF; chunkLength--;
   122												note.mData2 = buffer.get() & 0xFF; chunkLength--;
   123												if (0x90 == (eventType & 0xF0)) {
   124													int data1 = note.mData1;
   125													notes.add(note);
   126													
   127													note = new BitsXmiNote();
   128													note.mType = eventType;
   129													
   130													int eventLength = 0;
   131													eventType = buffer.get() & 0xFF; chunkLength--;
   132													while((eventType & 0x80) != 0) {
   133														eventLength = (eventLength << 7) | (eventType & 0x7f);
   134														eventType = buffer.get() & 0xFF; chunkLength--;
   135													}
   136													eventLength = (eventLength << 7) | (eventType & 0x7f);
   137	
   138													note.mTimeIndex = time + eventLength;
   139													note.mData1 = data1;
   140													note.mData2 = 0;
   141												}
   142												break;
   143											case 0xC0:
   144											case 0xD0:	
   145												note.mData1 = buffer.get() & 0xFF; chunkLength--;
   146												note.mData2 = 0;
   147												break;							
   148											case 0xF0:
   149												if (0xFF == eventType) {
   150													note.mData1 = buffer.get() & 0xFF; chunkLength--;
   151													note.mData2 = buffer.get() & 0xFF; chunkLength--;
   152													if (0x51 == note.mData1) {
   153														int tempo2 = 0;
   154														for (int i = 0; i < note.mData2; i++) {
   155															tempo2 = tempo2 << 8;
   156															int temp = buffer.get() & 0xFF; chunkLength--;
   157															tempo2 |= temp;
   158														}
   159	
   160	//													if (0 == tempo) {
   161	//														tempo = tempo2;
   162	//													}
   163													} else {
   164														chunkLength -= note.mData2;
   165													}
   166												}
   167												break;
   168										}
   169										
   170										notes.add(note);
   171									} else {
   172										time += eventType;
   173									}
   174								}
   175								buffer.clear();
   176								done = true;
   177								break; //stop while-loop
   178							}
   179						}
   180	//				}
   181				}
   182			}
   183			
   184	        final MidiTrack tempoTrack = new MidiTrack();
   185	        final MidiTrack noteTrack = new MidiTrack();
   186	        final TimeSignature ts = new TimeSignature();
   187	        ts.setTimeSignature(4, 4, TimeSignature.DEFAULT_METER, TimeSignature.DEFAULT_DIVISION);
   188	        final Tempo t = new Tempo();
   189	        t.setBpm(tempo);
   190	        tempoTrack.insertEvent(ts);
   191	        tempoTrack.insertEvent(t);
   192	
   193	        int oldTime = 0;
   194	        int oldVelocity = 0;
   195	        final ArrayList<BitsXmiNote> noteList = notes;
   196	        final int size = notes.size();
   197	        for(int i = 0; i < size; i++) {
   198	        	final BitsXmiNote note = noteList.get(i);
   199	        	
   200	        	//0xA0: Polyphonic key pressure
   201	//        	if( (note.mType & 0xF0) == 160 ) {
   202	//        		
   203	//        	}
   204	        	
   205	        	//0xB0: Controller
   206	        	if( (note.mType & 0xF0) == 176 ) {
   207	        		final Controller c = new Controller(note.mTimeIndex, (note.mType - (note.mType & 0xF0)), note.mData1, note.mData2);
   208	        		noteTrack.insertEvent(c);
   209	        		continue;
   210	        	}
   211	        	
   212	        	//0xC0: Instrument change
   213	        	if( (note.mType & 0xF0) == 192 ) {
   214	        		final ProgramChange pc = new ProgramChange(note.mTimeIndex, (note.mType - (note.mType & 0xF0)), note.mData1);
   215	        		noteTrack.insertEvent(pc);
   216	        		continue;
   217	        	}
   218	        	
   219	        	//0x90: Note on || 0x80: Note off -> data2 == 0!
   220	            if( (note.mType & 0xF0) == 144 ) {
   221	              	if( (note.mData2 & 0xF0) != 0 ) {
   222	               		oldTime = note.mTimeIndex;
   223	               		oldVelocity = note.mData2;
   224	               	} else {
   225	                   	noteTrack.insertNote( (note.mType - (note.mType & 0xF0)), note.mData1, oldVelocity, oldTime, note.mTimeIndex - oldTime);
   226	               	}
   227	              	continue;
   228	            }
   229	        }
   230	        
   231	        final ArrayList<MidiTrack> tracks = new ArrayList<MidiTrack>();
   232	        tracks.add(tempoTrack);
   233	        tracks.add(noteTrack);
   234	        
   235	        final MidiFile midi = new MidiFile(MidiFile.DEFAULT_RESOLUTION, tracks);
   236	        
   237	        File output = new File( midFile );
   238	        try {
   239	        	midi.writeToFile(output);
   240	        } catch(IOException e) {
   241	        	BitsLog.e( e, "BitsXmi2Mid - convert", "Unable to save the midi file: " + midFile);
   242	        	return false;
   243	        }
   244	        
   245	        return true;
   246		}
   247	}


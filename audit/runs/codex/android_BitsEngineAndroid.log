   569			if (Environment.MEDIA_MOUNTED.equals(state)) {
   570				externalStorageReadable = true;
   571			} else { 
   572				if (Environment.MEDIA_MOUNTED_READ_ONLY.equals(state)) {
   573					externalStorageReadable = true;
   574				} else {
   575					externalStorageReadable = false;				
   576				}
   577			}
   578			return externalStorageReadable;

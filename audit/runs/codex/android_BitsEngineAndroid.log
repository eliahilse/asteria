   127	    /**
   128	     * This method creates an android bitmap via a given byte array.
   129	     * 
   130	     * @param bytes
   131	     * @param offset
   132	     * @param length
   133	     * @return An android bitmap object.
   134	     */
   135	    public final BitsBitmap 
   136	    getBitmap( 
   137	    		final byte[] bytes,
   138	    		final int offset, 
   139	    		final int length ) {
   140	    	
   141	    	if( bytes == null ) {
   142	    		BitsLog.e("BitsGLFactory - getBitmap", "The given byte array is Null!");
   143	    		throw new NullPointerException("The given byte array is Null!");
   144	    	}
   145	    	
   146			if( this.mBitmapFactoryOptions.inJustDecodeBounds == true ) {
   147				BitsLog.d( "BitsGLFactory - getBitmap", "Loading bitmaps size via byte array." );
   148				BitmapFactory.decodeByteArray( 
   149						bytes, 
   150						offset, 
   151						length, 
   152						this.mBitmapFactoryOptions );
   153				
   154				return null;
   155			} else {
   156		    	BitsLog.d( "BitsGLFactory - getBitmap", "Loading bitmap via byte array." );
   157				final BitsBitmap bitmap =  new BitsBitmap( BitmapFactory.decodeByteArray( 
   158						bytes, 
   159						offset, 
   160						length, 
   161						this.mBitmapFactoryOptions ) );
   162				
   163				return bitmap;
   164			}
   165	    }

    16	
    17	package com.leff.midi.util;
    18	
    19	import java.io.IOException;
    20	import java.io.InputStream;
    21	
    22	public class VariableLengthInt {
    23	
    24		private int mValue;
    25		private byte[] mBytes;
    26		private int mSizeInBytes;
    27		
    28		public VariableLengthInt(int value) {
    29			setValue(value);
    30		}
    31		
    32		public VariableLengthInt(InputStream in) throws IOException {
    33			
    34			parseBytes(in);
    35		}
    36		
    37		public VariableLengthInt(byte[] buffer, int off) {
    38			
    39			parseBytes(buffer, off);
    40		}
    41		
    42		public void setValue(int value) {
    43			mValue = value;
    44			buildBytes();
    45		}
    46		public int getValue() {
    47			return mValue;
    48		}
    49		
    50		public int getByteCount() {
    51			return mSizeInBytes;
    52		}
    53		public byte[] getBytes() {
    54			return mBytes;
    55		}
    56		
    57		private void parseBytes(InputStream in) throws IOException {
    58			int[] ints = new int[4];
    59			
    60			mSizeInBytes = 1;
    61			mValue = 0;
    62			int shift = 0;
    63			
    64			int b = in.read();
    65			while(mSizeInBytes <= 4) {
    66				
    67				boolean variable = (b & 0x80) > 0;
    68				if(!variable) {
    69					ints[mSizeInBytes-1] = (b & 0x7F);
    70					break;
    71				}
    72				ints[mSizeInBytes-1] = (b & 0x7F);
    73				
    74				b = in.read();
    75				mSizeInBytes++;
    76			}
    77			
    78			for(int i = 1; i < mSizeInBytes; i++) {
    79				shift += 7;
    80			}
    81			
    82			mBytes = new byte[mSizeInBytes];

    37	    		throw new NullPointerException("The given byte array is Null!");
    38	    	}
    39	    	
    40	        final char[] chars = new char[2 * buf.length];
    41	        for( int i = 0; i < buf.length; ++i ) {
    42	            chars[2 * i] = HEX_CHARS[(buf[i] & 0xF0) >>> 4];
    43	            chars[2 * i + 1] = HEX_CHARS[buf[i] & 0x0F];
    44	        }
    45	        return new String(chars);
    46	    }

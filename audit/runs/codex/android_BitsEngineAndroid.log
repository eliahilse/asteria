   210		public static BitsBitmap 
   211		makeColorTransparent( 
   212				final BitsBitmap bitmap, 
   213				final int color ) {
   214			
   215			if( bitmap == null ) {
   216				BitsLog.e("BitsBitmap - makeColorTransparent", "The given BitsBitmap object is Null!");
   217				throw new NullPointerException("The given BitsBitmap object is Null!");
   218			}
   219			
   220			if( bitmap.mSource.getConfig() != Bitmap.Config.ARGB_8888 ) {
   221				BitsLog.e("BitsBitmap - makeColorTransparent", "The given BitsBitmap object has no alpha channel!");
   222				return bitmap;
   223			}
   224			
   225			for(int y = 0; y < bitmap.getHeight(); ++y) {
   226				for(int x = 0; x < bitmap.getWidth(); ++x) {
   227					int argb = bitmap.getPixel(x, y);
   228			        if((argb | 0xFF000000) == 0) 		        {
   229			        	bitmap.setPixel(x, y, 0x00FFFFFF & argb);
   230			        }
   231			    }
   232			}
   233	
   234			return bitmap;
   235		}

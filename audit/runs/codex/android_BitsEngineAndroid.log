    51		public static final void 
    52		initInstance( ) {
    53	
    54			BitsLog.d("BitsIO - initInstance", "Initializing singleton instance...");
    55			
    56			//create the public storage dir
    57			instance.mPublicDir = new File( Environment.getExternalStorageDirectory(), BitsApp.sPublicStorageFolder);
    58			if( instance.isPublicStorageWritable() == true ) {
    59				if( instance.mPublicDir.exists() == false ) {
    60					if( instance.mPublicDir.mkdirs() == true ) {
    61						//create .nomedia file to prevent media scanning
    62						final File noMedia = new File( instance.mPublicDir, ".nomedia");
    63						try {
    64							noMedia.createNewFile();
    65						} catch(Exception e) {
    66							BitsLog.w( e, "BitsIO - createNewInstance", "Unable to create .nomedia file in the Apps public storage dir. The content may be scanned by Androids media scanner.");
    67						}
    68					} else {
    69						BitsLog.e("BitsIO - createNewInstance", "Unable to create the Apps public storage dir: " + instance.mPublicDir.getAbsolutePath() );
    70					}
    71				}
    72			} else {
    73				BitsLog.e("BitsIO - createNewInstance", "Unable to create the Apps public storage dir. The public storage is not writable: " + instance.mPublicDir.getAbsolutePath() );
    74			}
    75	
    76			instance.mPrivateDir = BitsApp.sAppContext.getFilesDir();
    77		}

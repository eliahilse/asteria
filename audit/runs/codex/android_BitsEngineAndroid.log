    10	import com.leff.midi.event.NoteOn;
    11	import com.leff.midi.event.meta.Tempo;
    12	import com.leff.midi.event.meta.TimeSignature;
    13	
    14	public class MidiFileFromScratch {
    15	
    16		public static void main(String[] args) {
    17			
    18			// 1. Create some MidiTracks
    19			MidiTrack tempoTrack = new MidiTrack();
    20			MidiTrack noteTrack = new MidiTrack();
    21			
    22			// 2. Add events to the tracks
    23			// 2a. Track 0 is typically the tempo map
    24			TimeSignature ts = new TimeSignature();
    25			ts.setTimeSignature(4, 4, TimeSignature.DEFAULT_METER, TimeSignature.DEFAULT_DIVISION);
    26			
    27			Tempo t = new Tempo();
    28			t.setBpm(228);
    29			
    30			tempoTrack.insertEvent(ts);
    31			tempoTrack.insertEvent(t);
    32			
    33			// 2b. Track 1 will have some notes in it
    34			for(int i = 0; i < 80; i++) {
    35				
    36				int channel = 0, pitch = 1 + i, velocity = 100;
    37				NoteOn on = new NoteOn(i*480, channel, pitch, velocity);
    38				NoteOff off = new NoteOff(i*480 + 120, channel, pitch, 0);
    39				
    40				noteTrack.insertEvent(on);
    41				noteTrack.insertEvent(off);
    42				
    43				// There is also a utility function for notes that you should use instead of the above.
    44				noteTrack.insertNote(channel, pitch + 2, velocity, i*480, 120);
    45			}
    46			
    47			// It's best not to manually insert EndOfTrack events; MidiTrack will
    48			// call closeTrack() on itself before writing itself to a file
    49			
    50			// 3. Create a MidiFile with the tracks we created
    51			ArrayList<MidiTrack> tracks = new ArrayList<MidiTrack>();
    52			tracks.add(tempoTrack);
    53			tracks.add(noteTrack);
    54			
    55			MidiFile midi = new MidiFile(MidiFile.DEFAULT_RESOLUTION, tracks);
    56			
    57			// 4. Write the MIDI data to a file
    58			File output = new File("exampleout.mid");
    59			try {
    60				midi.writeToFile(output);
    61			} catch(IOException e) {
    62				System.err.println(e);
    63			}
    64		}
    65	}


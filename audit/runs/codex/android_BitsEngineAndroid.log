    16	
    17	package com.leff.midi;
    18	
    19	import java.io.IOException;
    20	import java.io.InputStream;
    21	import java.io.OutputStream;
    22	import java.lang.reflect.Method;
    23	import java.util.Iterator;
    24	import java.util.TreeSet;
    25	
    26	import com.leff.midi.event.MidiEvent;
    27	import com.leff.midi.event.NoteOn;
    28	import com.leff.midi.event.meta.EndOfTrack;
    29	import com.leff.midi.event.meta.Tempo;
    30	import com.leff.midi.event.meta.TimeSignature;
    31	import com.leff.midi.util.MidiUtil;
    32	import com.leff.midi.util.VariableLengthInt;
    33	
    34	
    35	public class MidiTrack {
    36		
    37		private static final boolean VERBOSE = false;
    38	
    39		public static final byte[] IDENTIFIER = { 'M', 'T', 'r', 'k' };
    40		
    41		private int mSize;
    42		private boolean mSizeNeedsRecalculating;
    43		private boolean mClosed;
    44		
    45		private TreeSet<MidiEvent> mEvents;
    46		
    47		public static MidiTrack createTempoTrack() {
    48			
    49			MidiTrack T = new MidiTrack();
    50			
    51			T.insertEvent(new TimeSignature());
    52			T.insertEvent(new Tempo());
    53			
    54			return T;
    55		}
    56		
    57		public MidiTrack() {
    58			mEvents = new TreeSet<MidiEvent>();
    59			mSize = 0;
    60			mSizeNeedsRecalculating = false;
    61			mClosed = false;
    62		}
    63		
    64		public MidiTrack(InputStream in) throws IOException {
    65			this();
    66			
    67			byte[] buffer = new byte[32];
    68			in.read(buffer, 0, 4);
    69			
    70			if(!MidiUtil.bytesEqual(buffer, IDENTIFIER, 0, 4)) {
    71				System.err.println("Track identifier did not match MTrk!");
    72				return;
    73			}
    74			
    75			in.read(buffer, 0, 4);
    76			mSize = MidiUtil.bytesToInt(buffer, 0, 4);
    77			
    78			long totalTicks = 0;
    79			
    80			while(true) {
    81				
    82				VariableLengthInt delta = new VariableLengthInt(in);
    83				totalTicks += delta.getValue();
    84				
    85				MidiEvent E = MidiEvent.parseEvent(totalTicks, delta.getValue(), in);
    86				if(E == null) {
    87					System.out.println("Event skipped!");
    88					continue;
    89				}
    90				
    91				if(VERBOSE) {
    92					System.out.println(E);
    93				}
    94	
    95				// Not adding the EndOfTrack event here allows the track to be edited
    96				// after being read in from file.
    97				if(E.getClass().equals(EndOfTrack.class)) {
    98					break;
    99				}
   100				mEvents.add(E);
   101				
   102			}
   103		}
   104		
   105		public TreeSet<MidiEvent> getEvents() {
   106			return mEvents;
   107		}
   108		
   109		public int getEventCount() {
   110			return mEvents.size();
   111		}
   112		
   113		public int getSize() {
   114			if(mSizeNeedsRecalculating) {
   115				recalculateSize();
   116			}
   117			return mSize;
   118		}
   119		
   120		public long getLengthInTicks() {
   121			if(mEvents.size() == 0) {
   122				return 0;
   123			}
   124			
   125			MidiEvent E = mEvents.last();
   126			return E.getTick();
   127		}
   128		
   129		public void insertNote(int channel, int pitch, int velocity, long tick, long duration) {
   130			
   131			insertEvent(new NoteOn(tick, channel, pitch, velocity));
   132			insertEvent(new NoteOn(tick + duration, channel, pitch, 0));
   133		}
   134		
   135		@SuppressWarnings({ "rawtypes", "unchecked" })
   136		public void insertEvent(MidiEvent newEvent) {
   137			
   138			if(newEvent == null) {
   139				return;
   140			}
   141			
   142			if(mClosed) {
   143				System.err.println("Error: Cannot add an event to a closed track.");
   144				return;
   145			}
   146			
   147			MidiEvent prev = null, next = null;
   148			
   149			// floor() and ceiling() are not supported on Android before API Level 9 (Gingerbread)
   150			try {
   151				Class treeSet = Class.forName("java.util.TreeSet");
   152				Method floor = treeSet.getMethod("floor", Object.class);
   153				Method ceiling = treeSet.getMethod("ceiling", Object.class);
   154				
   155				prev = (MidiEvent)floor.invoke(mEvents, newEvent);
   156				next = (MidiEvent)ceiling.invoke(mEvents, newEvent);
   157				
   158			} catch(Exception e) {
   159				// methods are not supported - must perform linear search
   160				Iterator<MidiEvent> it = mEvents.iterator();
   161				
   162				while(it.hasNext()) {
   163					next = it.next();
   164					
   165					if(next.getTick() > newEvent.getTick()) {
   166						break;
   167					}
   168					
   169					prev = next;
   170					next = null;
   171				}
   172			}
   173			
   174			mEvents.add(newEvent);
   175			mSizeNeedsRecalculating = true;
   176			
   177			// Set its delta time based on the previous event (or itself if no previous event exists)
   178			if(prev != null) {
   179				newEvent.setDelta(newEvent.getTick() - prev.getTick());
   180			} else {
   181				newEvent.setDelta(newEvent.getTick());
   182			}
   183			
   184			// Update the next event's delta time relative to the new event.
   185			if(next != null) {
   186				next.setDelta(next.getTick() - newEvent.getTick());
   187			}
   188			
   189			mSize += newEvent.getSize();
   190			
   191			if(newEvent.getClass().equals(EndOfTrack.class)) {
   192				if(next != null) {
   193					throw new IllegalArgumentException("Attempting to insert EndOfTrack before an existing event. Use closeTrack() when finished with MidiTrack.");
   194				}
   195				mClosed = true;
   196			}
   197		}
   198		
   199		public boolean removeEvent(MidiEvent E) {
   200			
   201			Iterator<MidiEvent> it = mEvents.iterator();
   202			MidiEvent prev = null, curr = null, next = null;
   203	
   204			while(it.hasNext()) {
   205				next = it.next();
   206				
   207				if(E.equals(curr)) {
   208					break;
   209				}
   210				
   211				prev = curr;
   212				curr = next;
   213				next = null;
   214			}
   215			
   216			if(next == null) {
   217				// Either the event was not found in the track,
   218				// or this is the last event in the track.
   219				// Either way, we won't need to update any delta times
   220				return mEvents.remove(curr);
   221			}
   222			
   223			if(!mEvents.remove(curr)) {
   224				return false;
   225			}
   226			
   227			if(prev != null) {
   228				next.setDelta(next.getTick() - prev.getTick());
   229			} else {
   230				next.setDelta(next.getTick());
   231			}
   232			return true;
   233		}
   234		
   235		public void closeTrack() {
   236			long lastTick = 0;
   237			if(mEvents.size() > 0) {
   238				MidiEvent last = mEvents.last();
   239				lastTick = last.getTick() + 1;
   240			}
   241			EndOfTrack eot = new EndOfTrack(lastTick, 0);
   242			insertEvent(eot);
   243		}
   244		
   245		public void dumpEvents() {
   246			Iterator<MidiEvent> it = mEvents.iterator();
   247			while(it.hasNext()) {
   248				System.out.println(it.next());
   249			}
   250		}
   251		
   252		private void recalculateSize() {
   253			
   254			mSize = 0;
   255			
   256			Iterator<MidiEvent> it = mEvents.iterator();
   257			MidiEvent last = null;
   258			while(it.hasNext()) {
   259				MidiEvent E = it.next();
   260				mSize += E.getSize();
   261				
   262				// If an event is of the same type as the previous event,
   263				// no status byte is written.
   264				if(last != null && !E.requiresStatusByte(last)) {
   265					mSize--;
   266				}
   267				last = E;
   268			}
   269			
   270			mSizeNeedsRecalculating = false;
   271		}
   272		
   273		public void writeToFile(OutputStream out) throws IOException {
   274			
   275			if(!mClosed) {
   276				closeTrack();
   277			}
   278			
   279			if(mSizeNeedsRecalculating) {
   280				recalculateSize();
   281			}
   282			
   283			out.write(IDENTIFIER);
   284			out.write(MidiUtil.intToBytes(mSize, 4));
   285			
   286			Iterator<MidiEvent> it = mEvents.iterator();
   287			MidiEvent lastEvent = null;
   288			
   289			while(it.hasNext()) {
   290				MidiEvent event = it.next();
   291				if(VERBOSE) {
   292					System.out.println("Writing: " + event);
   293				}
   294				
   295				event.writeToFile(out, event.requiresStatusByte(lastEvent));
   296				
   297				lastEvent = event;
   298			}
   299		}
   300	}

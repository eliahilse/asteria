   682	        // set texture size based on max font size (width or height)
   683	        // NOTE: these values are fixed, based on the defined characters. when
   684	        // changing start/end characters (CHAR_START/CHAR_END) this will need adjustment too!
   685	        if ( maxSize <= 24 )                            // IF Max Size is 18 or Less
   686	           font.mTextureSize = 256;                           // Set 256 Texture Size
   687	        else if ( maxSize <= 40 )                       // ELSE IF Max Size is 40 or Less
   688	        	font.mTextureSize = 512;                           // Set 512 Texture Size
   689	        else if ( maxSize <= 80 )                       // ELSE IF Max Size is 80 or Less
   690	        	font.mTextureSize = 1024;                          // Set 1024 Texture Size
   691	        else                                            // ELSE IF Max Size is Larger Than 80 (and Less than FONT_SIZE_MAX)
   692	        	font.mTextureSize = 2048;                          // Set 2048 Texture Size
   693	
   694	        // create an empty bitmap (alpha only)
   695	        final Bitmap bitmap = Bitmap.createBitmap( font.mTextureSize, font.mTextureSize, Bitmap.Config.ARGB_8888 ); // Create Bitmap
   696	        final Canvas canvas = new Canvas( bitmap ); // Create Canvas for Rendering to Bitmap
   697	        bitmap.eraseColor( 0x00000000 ); // Set Transparent Background (ARGB)
   698	
   699	        // render each of the characters to the canvas (ie. build the font map)
   700	        float x = 0; // Set Start Position (X)
   701	        float y = ( font.mCharCellHeight - 1 ) - font.mFontDescent;  // Set Start Position (Y)
   702	        for ( char c = BitsGLFont.CHAR_START; c <= BitsGLFont.CHAR_END; c++ )  {  // FOR Each Character
   703	        	s[0] = c; // Set Character to Draw
   704	        	
   705	        	canvas.drawText( s, 0, 1, x, y, paint ); // Draw Character
   706	        	x += font.mCharCellWidth; // Move to Next Character
   707	        	if ( ( x + font.mCharCellWidth ) > font.mTextureSize )  {  // IF End of Line Reached
   708	        		x = 0; // Set X for New Row
   709	        		y += font.mCharCellHeight; // Move Down a Row
   710	        	}
   711	        }
   712	        s[0] = BitsGLFont.CHAR_NONE; // Set Character to Use for NONE
   713	        canvas.drawText( s, 0, 1, x, y, paint ); // Draw Character
   714	        
   715	        font.mBitmap = new BitsBitmap( bitmap );
   716	    }

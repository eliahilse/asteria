   253	    private final void
   254	    setImageWH(
   255	    		final BitsGLImage image ) {
   256	    	
   257	    	if( image == null ) {
   258	    		BitsLog.e("BitsGLFactory - setImageWH", "The given BitsGLImage is Null!");
   259	    		throw new NullPointerException("The given BitsGLImage is Null!");
   260	    	}
   261	    	
   262	        //pre-calculate the texture size
   263	        if(image.mResourceId > -1) {
   264	    		this.mBitmapFactoryOptions.inJustDecodeBounds = true;
   265	    		this.getBitmap(image.mResourceId);
   266	    		this.mBitmapFactoryOptions.inJustDecodeBounds = false;
   267	    		image.mWidth = this.mBitmapFactoryOptions.outWidth;
   268	    		image.mHeight = this.mBitmapFactoryOptions.outHeight;
   269				BitsLog.d("BitsGLFactory - setImageWH", "Image size: " + image.mWidth + "x" + image.mHeight );
   270	        } else {
   271	        	if(image.mBitmap != null) {
   272	           		try {
   273	    				image.mBitmapHash = BitsUtils.getHash( image.mBitmap );
   274	    			} catch (Exception e) {
   275	    				BitsLog.e( e, "BitsGLFactory - setImageWH", "Unable to calculate the MD5 hash.");
   276	    			}
   277		   			image.mWidth = image.mBitmap.getWidth( );
   278		   			image.mHeight = image.mBitmap.getHeight( );
   279	    			BitsLog.d("BitsGLFactory - setImageWH", "Image size: " + image.mWidth + "x" + image.mHeight );
   280	        	} else {
   281	        		if(image.mFile != null) {
   282	        			this.mBitmapFactoryOptions.inJustDecodeBounds = true;
   283	        			this.getBitmap(image.mFile);
   284	        			this.mBitmapFactoryOptions.inJustDecodeBounds = false;
   285	        			image.mWidth = this.mBitmapFactoryOptions.outWidth;
   286	        			image.mHeight = this.mBitmapFactoryOptions.outHeight;
   287	        			BitsLog.d("BitsGLFactory - setImageWH", "Image size: " + image.mWidth + "x" + image.mHeight );
   288	        		} else {
   289	        			BitsLog.e("BitsGLFactory - setImageWH", "The given BitsGLImage does not contain a resource ID, bitmap or file string!");
   290	        			throw new IllegalArgumentException("The given BitsGLImage does not contain a resource ID, bitmap or file string!");
   291	        		}
   292	        	}
   293	        }
   294	    }

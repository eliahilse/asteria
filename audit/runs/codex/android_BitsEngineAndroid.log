   272		public final boolean
   273		deleteDir(
   274				final String dir,
   275				final boolean recursive ) {
   276			
   277			if( dir == null ) {
   278				BitsLog.e("BitsIO - deleteDir", "The given dir is null.");
   279				return false;
   280			}
   281			if( dir.equals("") == true ) {
   282				BitsLog.e("BitsIO - deleteDir", "The given dir is empty.");
   283				return false;
   284			}
   285			
   286			final File f = new File( dir );
   287		    if ( f.exists() == false ) {
   288		    	return true;
   289		    }
   290	
   291		    if( recursive == false || f.isDirectory() == false ) { //if it's a file or not recursive -> just delete
   292		    	return f.delete();
   293		    }
   294	
   295		    final String[] list = f.list();
   296		    for (int i = 0; i < list.length; i++) {
   297		    	if( this.deleteDir(dir + "/" + list[i], true) == false ) {
   298		    		return false;
   299		    	}
   300		    }
   301	
   302		    return f.delete();
   303		}

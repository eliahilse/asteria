   488	    /**
   489	     * 
   490	     * @param fontFile - Asset or file on the SD-Card
   491	     * @return
   492	     */
   493	    private final BitsGLFont 
   494	    getFont( 
   495	    		final String fontFile, 
   496	    		final int textureSize,
   497	    		final float[] fontCharWidths,
   498	    		final int fontSize,
   499	    		final int cellWidth, 
   500	    		final int cellHeight, 
   501	    		final int tweakWidth,
   502	    		final int fontDescent,
   503	    		final int filterMode,
   504	    		final boolean mark,
   505	    		final int type ) {
   506	    	
   507	    	BitsGLFont font = null;
   508	    	BitsGLFont emptyFont = null;
   509	
   510	    	BitsLog.d("BitsGLFactory - getFont", "Searching BitsFont in font pool...");
   511			final ArrayList<BitsGLFont> fontList = this.mFontList;
   512			final int size = fontList.size();
   513	        for( int i = 0; i < size; i++ ) {
   514	        	final BitsGLFont poolFont = fontList.get( i );
   515	        	/*
   516	        	 * Search for an empty font.
   517	        	 */
   518	    		if( poolFont.isLoaded	== false &&
   519	        		poolFont.mFile   	== null &&
   520	        		poolFont.mFontSize  == -1 &&
   521	        		poolFont.mBitmap    == null && 
   522	        		poolFont.mMark		== 0 ) { //if NOT marked
   523	        			emptyFont = poolFont;
   524	        	}
   525	
   526	    		/*
   527	    		 * Search for a font that is already loaded. 
   528	    		 */
   529	    		if( poolFont.mFile 	!= null && 
   530	        		poolFont.mMark  == 0 && //if NOT marked
   531	        		poolFont.mFontSize != -1 &&
   532	        		fontFile 		!= null ) {
   533	            	if( poolFont.mFile.equals( fontFile ) && 
   534	        			poolFont.mFontSize == fontSize ) {
   535	        			BitsLog.d("BitsGLFactory - getFont", "...found via file name and size. BitsFont already loaded.");
   536	        		   	font = poolFont;
   537	        		   	break;
   538	        		}
   539	        	}
   540	    	}
   541	    	
   542	        /*
   543	         * No BitsFont found.
   544	         */
   545	        if( font == null ) {
   546	        	if( emptyFont == null ) { //if there is no empty font in the font list
   547	            	BitsLog.d("BitsGLFactory - getFont", "...not found. Using a new BitsFont.");
   548	        		font = new BitsGLFont( ); //create a new font object
   549	        		this.mFontList.add(font); //and add it to the list
   550	        	} else { //if there is an empty font in the font list
   551	            	BitsLog.d("BitsGLFactory - getFont", "...not found. Using an empty BitsFont.");
   552	        		font = emptyFont;
   553	        	}
   554	        }
   555	        
   556	        font.mFile 			= fontFile;
   557	        font.mFontSize 		= fontSize;
   558	        font.mFontDescent 	= fontDescent;
   559	        font.mType 			= type;
   560	        font.mFilterMode	= filterMode;
   561	        
   562	        switch( type ) {
   563	        	case BitsGLFont.TYPE_FILE: {
   564	            	this.createFontBitmap( font );
   565	            	
   566	                // setup the array of character texture regions
   567	                int x = 0; // Initialize X
   568	                int y = 0; // Initialize Y
   569	                for ( int c = 0; c < BitsGLFont.CHAR_CNT; c++ )  { // FOR Each Character (On Texture)
   570	                   font.mCharTextureRegions[c] = new BitsGLTextureRegion( x, y, font.mCharCellWidth-1, font.mCharCellHeight-1 ); // Create Region for Character
   571	                   x += font.mCharCellWidth; // Move to Next Char (Cell)
   572	                   if ( x + font.mCharCellWidth > font.mTextureSize )  {
   573	                      x = 0; // Reset X Position to Start
   574	                      y += font.mCharCellHeight; // Move to Next Row (Cell)
   575	                   }
   576	                }
   577	        		break; 
   578	        	}
   579	        	case BitsGLFont.TYPE_BITMAP: {
   580	            	font.mFontHeight = cellHeight;
   581	            	font.mCharCellHeight = cellHeight; 
   582	            	font.mMaxCharHeight = cellHeight;
   583	            	font.mCharCellWidth = cellWidth;
   584	            	font.mMaxCharWidth = cellWidth;
   585	
   586	            	this.setFontWH(font);
   587	
   588	        		// setup the array of character widths
   589	        		if( fontCharWidths.length != BitsGLFont.CHAR_CNT ) {
   590	        			BitsLog.e("BitsGLFactory - getFont", "The given fontCharWidths-Arrays size is not 96!");
   591	        		} else {
   592	        			for( int i = 0; i < BitsGLFont.CHAR_CNT; i++ ) {
   593	        				font.mCharWidths[i] = fontCharWidths[i];
   594	        			}
   595	        		}
   596		            // setup the array of character texture regions
   597		            int x = 0; // Initialize X
   598		            int y = fontDescent; // Initialize Y
   599		            for ( int c = 0; c < BitsGLFont.CHAR_CNT; c++ )  { // FOR Each Character (On Texture)
   600		               font.mCharTextureRegions[c] = new BitsGLTextureRegion( x, y, font.mCharCellWidth, font.mCharCellHeight ); // Create Region for Character
   601		               x += font.mCharCellWidth; // Move to Next Char (Cell)
   602		               if ( x + font.mCharCellWidth > font.mTextureSize )  {
   603		                  x = 0; // Reset X Position to Start
   604		                  y += font.mCharCellHeight; // Move to Next Row (Cell)
   605		               }
   606		            }
   607	        		break;
   608	        	}
   609	        }
   610	
   611	        if( mark == true ) {
   612	        	this.markForLoading(font);
   613	        }
   614	        
   615	        return font;
   616	    }
   617	    
   618	    private final void 
   619	    createFontBitmap(
   620	    		final BitsGLFont font ) {
   621	    	
   622	    	Typeface tf = null;
   623	    	
   624	    	try {
   625	    		tf = Typeface.createFromAsset( BitsApp.sAppContext.getAssets( ), font.mFile ); // Create the Typeface from asset Font File
   626	    	} catch( Exception e ) {
   627	    		try {
   628	    			tf = Typeface.createFromFile( font.mFile );
   629	    		} catch( Exception ee ) {
   630	    			BitsLog.e( ee, "BitsGLFactory - createFontBitmap", "Font not found. Unable to load the font: " + font.mFile );
   631	    			throw new RuntimeException("Font not found. Unable to load the font: " + font.mFile);
   632	    		}
   633	    	}
   634	        
   635	        final Paint paint = new Paint(); // Create Android Paint Instance
   636	        paint.setTextSize( font.mFontSize ); // Set Text Size
   637	        paint.setColor( 0xffffffff ); // Set ARGB (White, Opaque)
   638	        paint.setTypeface( tf ); // Set Typeface
   639	        
   640	//        paint.setAntiAlias(true);
   641	//        paint.setFilterBitmap(true);
   642	//        paint.setDither(true);
   643	
   644	        // get font metrics
   645	        final Paint.FontMetrics fm = paint.getFontMetrics(); // Get Font Metrics
   646	        font.mFontHeight = (float)Math.ceil( Math.abs( fm.bottom ) + Math.abs( fm.top ) ); // Calculate Font Height
   647	
   648	        // determine the width of each character (including unknown character)
   649	        // also determine the maximum character width
   650	        final char[] s = new char[2]; // Create Character Array
   651	        font.mMaxCharWidth = font.mMaxCharHeight = 0; // Reset Character Width/Height Maximums
   652	        final float[] w = new float[2]; // Working Width Value
   653	        int cnt = 0; // Array Counter
   654	        for ( char c = BitsGLFont.CHAR_START; c <= BitsGLFont.CHAR_END; c++ )  { // FOR Each Character
   655	           s[0] = c; // Set Character
   656	           paint.getTextWidths( s, 0, 1, w ); // Get Character Bounds
   657	           font.mCharWidths[cnt] = w[0]; // Get Width
   658	           if ( font.mCharWidths[cnt] > font.mMaxCharWidth ) // IF Width Larger Than Max Width
   659	        	   font.mMaxCharWidth = font.mCharWidths[cnt]; // Save New Max Width
   660	           cnt++; // Advance Array Counter
   661	        }
   662	        s[0] = BitsGLFont.CHAR_NONE; // Set Unknown Character
   663	        paint.getTextWidths( s, 0, 1, w ); // Get Character Bounds
   664	        font.mCharWidths[cnt] = w[0]; // Get Width
   665	        if ( font.mCharWidths[cnt] > font.mMaxCharWidth ) // IF Width Larger Than Max Width
   666	        	font.mMaxCharWidth = font.mCharWidths[cnt]; // Save New Max Width
   667	        cnt++; // Advance Array Counter
   668	
   669	        // set character height to font height
   670	        font.mMaxCharHeight = font.mFontHeight; // Set Character Height
   671	
   672	        // find the maximum size, validate, and setup cell sizes
   673	        font.mCharCellWidth = (int)font.mMaxCharWidth;  // Set Cell Width
   674	        font.mCharCellHeight = (int)font.mMaxCharHeight;  // Set Cell Height
   675	        
   676	        final int maxSize = font.mCharCellWidth > font.mCharCellHeight ? font.mCharCellWidth : font.mCharCellHeight;  // Save Max Size (Width/Height)
   677	        if ( maxSize < BitsGLFont.SIZE_MIN || maxSize > BitsGLFont.SIZE_MAX ) {  // IF Maximum Size Outside Valid Bounds
   678	        	BitsLog.e( "BitsGLGraphicsFactory - loadFont", "The font texture is larger than the max. size: (max -> font) (" + maxSize + "->" + BitsGLFont.SIZE_MAX + ")");
   679	        	return;
   680	        }

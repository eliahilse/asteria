    16	
    17	package com.leff.midi.event.meta;
    18	
    19	import java.io.IOException;
    20	import java.io.InputStream;
    21	import java.io.OutputStream;
    22	
    23	import com.leff.midi.event.MidiEvent;
    24	import com.leff.midi.util.VariableLengthInt;
    25	
    26	public abstract class MetaEvent extends MidiEvent {
    27		
    28		protected int mType;
    29		protected VariableLengthInt mLength;
    30		
    31		protected MetaEvent(long tick, long delta, int type, VariableLengthInt length) {
    32			super(tick, delta);
    33			
    34			mType = type & 0xFF;
    35			mLength = length;
    36		}
    37		
    38		protected abstract int getEventSize();
    39		
    40		@Override
    41		public void writeToFile(OutputStream out, boolean writeType) throws IOException {
    42			writeToFile(out);
    43		}
    44		
    45		protected void writeToFile(OutputStream out) throws IOException {
    46			super.writeToFile(out, true);
    47			out.write(0xFF);
    48			out.write(mType);
    49		}
    50	
    51		public static MetaEvent parseMetaEvent(long tick, long delta, InputStream in) throws IOException {
    52			
    53			int type = in.read();
    54			
    55			boolean isText = false;
    56			switch(type) {
    57				case SEQUENCE_NUMBER:
    58				case MIDI_CHANNEL_PREFIX:
    59				case END_OF_TRACK:
    60				case TEMPO:
    61				case SMPTE_OFFSET:
    62				case TIME_SIGNATURE:
    63				case KEY_SIGNATURE:
    64					break;
    65				case TEXT_EVENT:
    66				case COPYRIGHT_NOTICE:
    67				case TRACK_NAME:
    68				case INSTRUMENT_NAME:
    69				case LYRICS:
    70				case MARKER:
    71				case CUE_POINT:
    72				case SEQUENCER_SPECIFIC:		// Not technically text, but follows same structure
    73				default:						// Also not technically text, but it should follow
    74					isText = true;
    75					break;
    76			}
    77			
    78			if(isText) {
    79	
    80				VariableLengthInt length = new VariableLengthInt(in);
    81				byte[] buffer = new byte[length.getValue()];
    82				
    83				in.read(buffer);
    84				String text = new String(buffer);
    85				
    86				switch(type) {
    87					case TEXT_EVENT:
    88						return new Text(tick, delta, text);
    89					case COPYRIGHT_NOTICE:
    90						return new CopyrightNotice(tick, delta, text);
    91					case TRACK_NAME:
    92						return new TrackName(tick, delta, text);
    93					case INSTRUMENT_NAME:
    94						return new InstrumentName(tick, delta, text);
    95					case LYRICS:
    96						return new Lyrics(tick, delta, text);
    97					case MARKER:
    98						return new Marker(tick, delta, text);
    99					case CUE_POINT:
   100						return new CuePoint(tick, delta, text);
   101					case SEQUENCER_SPECIFIC:
   102						return new SequencerSpecificEvent(tick, delta, buffer);
   103					default:
   104						return new GenericMetaEvent(tick, delta, type, length, buffer);
   105				}
   106			}
   107			
   108			switch(type) {
   109				case SEQUENCE_NUMBER:
   110					return SequenceNumber.parseSequenceNumber(tick, delta, in);
   111				case MIDI_CHANNEL_PREFIX:
   112					return MidiChannelPrefix.parseMidiChannelPrefix(tick, delta, in);
   113				case END_OF_TRACK:
   114					in.read();			// Size = 0;
   115					return new EndOfTrack(tick, delta);
   116				case TEMPO:
   117					return Tempo.parseTempo(tick, delta, in);
   118				case SMPTE_OFFSET:
   119					return SmpteOffset.parseSmpteOffset(tick, delta, in);
   120				case TIME_SIGNATURE:
   121					return TimeSignature.parseTimeSignature(tick, delta, in);
   122				case KEY_SIGNATURE:
   123					return KeySignature.parseKeySignature(tick, delta, in);
   124			}
   125			System.out.println("Completely broken in MetaEvent.parseMetaEvent()");
   126			return null;
   127		}
   128		
   129		public static final int SEQUENCE_NUMBER		= 0;
   130		public static final int TEXT_EVENT			= 1;
   131		public static final int COPYRIGHT_NOTICE	= 2;
   132		public static final int TRACK_NAME			= 3;
   133		public static final int INSTRUMENT_NAME		= 4;
   134		public static final int LYRICS				= 5;
   135		public static final int MARKER				= 6;
   136		public static final int CUE_POINT			= 7;
   137		public static final int MIDI_CHANNEL_PREFIX	= 0x20;
   138		public static final int END_OF_TRACK		= 0x2F;
   139		public static final int TEMPO				= 0x51;
   140		public static final int SMPTE_OFFSET		= 0x54;
   141		public static final int TIME_SIGNATURE		= 0x58;
   142		public static final int KEY_SIGNATURE		= 0x59;
   143		public static final int SEQUENCER_SPECIFIC	= 0x7F;
   144	}

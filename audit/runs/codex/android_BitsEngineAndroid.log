    60	    getInstance( ) {
    61	    	
    62	    	return instance;
    63	    }
    64	    
    65	    public static final void 
    66	    resetInstance( ) {
    67	    	
    68	    	/*
    69	    	 * Important for devices, that needs textures with a power of 2 size.
    70	    	 * (e.g. Galaxy Tab 7)
    71	    	 */
    72	    	instance.mBitmapFactoryOptions.inScaled = false;
    73	    	
    74	    	BitsLog.d( "BitsGLFactory - resetInstance", "Resetting the singleton instance..." );
    75			final ArrayList<BitsGLImage> imageList = instance.mImageList;
    76			final int size = imageList.size(); 
    77			for( int i = 0; i < size; i++ ) {
    78				final BitsGLImage poolImage = imageList.get(i);
    79	            if( poolImage.mTextureId != -1 && 
    80	            	poolImage.isLoaded ) {            	
    81	            	BitsLog.d("BitsGLFactory - resetInstance", "Releasing texture: " + String.valueOf(poolImage.mTextureId));
    82	            	final int[] textureId = new int[1];
    83	        		textureId[0] = poolImage.mTextureId;
    84	        		GLES11.glDeleteTextures(1, textureId, 0);	                
    85	        		poolImage.reset();
    86	            }
    87	        }
    88			imageList.clear();
    89	
    90			BitsLog.d("BitsGLFactory - resetInstance", "Releasing render stacks...");
    91			final ArrayList<BitsGLRenderStack> stackList = instance.mRenderStackList;
    92			final int size2 = stackList.size();
    93	        for( int i = 0; i < size2; i++ ) {
    94	        	final BitsGLRenderStack poolStack = stackList.get(i);
    95	            if( poolStack.mIndexBufferId != -1 && 
    96	            	poolStack.mVertexBufferId != -1 && 
    97	            	poolStack.isLoaded ) {            	
    98	            	BitsLog.d( "BitsGLFactory - resetInstance", "Releasing vertex buffer: " + String.valueOf( poolStack.mVertexBufferId ) );
    99	            	final int[] bufferVertexId = new int[1];
   100	            	bufferVertexId[0]= poolStack.mVertexBufferId;
   101	                GLES11.glDeleteBuffers( 1, bufferVertexId, 0 );
   102	                BitsLog.d( "BitsGLFactory - resetInstance", "Releasing index buffer: " + String.valueOf( poolStack.mIndexBufferId ) );
   103	            	final int[] bufferIndexId = new int[1];
   104	            	bufferIndexId[0] = poolStack.mIndexBufferId;
   105	                GLES11.glDeleteBuffers( 1, bufferIndexId, 0 );
   106	                poolStack.reset();
   107	            }
   108	        }
   109	        stackList.clear();
   110	        
   111			final ArrayList<BitsGLFont> fontList = instance.mFontList;
   112			final int size3 = fontList.size();
   113	        for( int i = 0; i < size3; i++ ) {
   114	        	final BitsGLFont poolFont = fontList.get( i );
   115	            if( poolFont.mTextureId != -1 && 
   116	            	poolFont.isLoaded == true ) {            	
   117	            	BitsLog.d("BitsGLFactory - resetInstance", "Releasing font texture: " + String.valueOf(poolFont.mTextureId));
   118	            	final int[] textureId = new int[1];
   119	        		textureId[0] = poolFont.mTextureId;
   120	        		poolFont.reset();
   121	                GLES11.glDeleteTextures(1, textureId, 0);
   122	            }
   123	        }
   124	        fontList.clear();
   125	    }

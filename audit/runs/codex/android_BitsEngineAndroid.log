   197	    /**
   198	     * This method loads an image file that can be either located on the SD card (or any other readable location)<br>
   199	     * or inside a class path (e.g. inside an embedded jar file).<br>
   200	     * If the image file is located inside a class path, you must add the prefix "?" to the "file" String.<br>
   201	     * <br>
   202	     * The loaded image will be returned as an android bitmap, that can be used to create a new BitsBitmap.<br>
   203	     * 
   204	     * @param file
   205	     * @param isClassPath
   206	     * @return An android bitmap object.
   207	     */
   208	    public final BitsBitmap 
   209	    getBitmap( 
   210	    		final String file ) {
   211	    	
   212	    	if( file == null ) {
   213	    		BitsLog.e("BitsGLFactory - getBitmap", "The file String is Null!");
   214	    		throw new NullPointerException("The given file String is Null!");
   215	    	}
   216	    	
   217	    	if( file.equals("") == true ) {
   218	    		BitsLog.e("BitsGLFactory - getBitmap", "The file String is empty!");
   219	    		throw new IllegalArgumentException("The given file String is empty!");
   220	    	}
   221	    	
   222	    	BitsBitmap bitmap = null;
   223	    	
   224	    	if( !file.startsWith( "?" ) ) {
   225	    		if( this.mBitmapFactoryOptions.inJustDecodeBounds == true ) {
   226	    			BitsLog.d( "BitsGLFactory - getBitmap", "Loading file bitmaps size: " + file );
   227	    			BitmapFactory.decodeFile( file, this.mBitmapFactoryOptions );
   228	    		} else {
   229	    			BitsLog.d( "BitsGLFactory - getBitmap", "Loading file bitmap: " + file );
   230	    			bitmap = new BitsBitmap( BitmapFactory.decodeFile(
   231	    					file,
   232	    					this.mBitmapFactoryOptions ) );
   233	    		}
   234	    	} else {
   235	    	    InputStream is = getClass().getClassLoader().getResourceAsStream(file.substring(1));
   236	    	    if( is == null ) {
   237	    	    	BitsLog.e( "BitsGLFactory - getBitmap", "The file does not exist in the classpath: " + file );
   238	    	    	throw new NullPointerException("The file does not exist in the classpath: " + file);
   239	    	    }
   240	
   241		    	if( this.mBitmapFactoryOptions.inJustDecodeBounds == true ) {
   242		    		BitsLog.d( "BitsGLFactory - getBitmap", "Loading classpath bitmaps size: " + file.substring(1) );
   243		    		BitmapFactory.decodeStream( is, null, this.mBitmapFactoryOptions );
   244		    	} else {
   245		    		BitsLog.d( "BitsGLFactory - getBitmap", "Loading classpath bitmap: " + file.substring(1) );
   246		    		bitmap = new BitsBitmap( BitmapFactory.decodeStream( is, null, this.mBitmapFactoryOptions ) );
   247		    	}
   248	    	}
   249	
   250	    	return bitmap;
   251	    }

   177	    	
   178			if( this.mBitmapFactoryOptions.inJustDecodeBounds == true ) {
   179				BitsLog.d( "BitsGLFactory - getBitmap", "Loading resource bitmaps size: " + String.valueOf( resourceId ) );
   180				BitmapFactory.decodeResource(
   181						BitsApp.sAppContext.getResources( ),
   182						resourceId,
   183						this.mBitmapFactoryOptions );
   184				
   185				return null;
   186			} else {
   187		    	BitsLog.d( "BitsGLFactory - getBitmap", "Loading resource bitmap: " + String.valueOf( resourceId ) );
   188				final BitsBitmap bitmap = new BitsBitmap( BitmapFactory.decodeResource(
   189						BitsApp.sAppContext.getResources( ),
   190						resourceId,
   191						this.mBitmapFactoryOptions ) );
   192				
   193				return bitmap;
   194			}
   195	    }

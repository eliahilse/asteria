   319		
   320		public final byte[]
   321		getRawWav( 
   322				final byte[] rawData,
   323				final int channels,
   324				final int samplesPerSecond,
   325				final int bytesPerSecond,
   326				final int bytesPerSample,
   327				final int bitsPerSample ) {
   328			
   329	    	final int size = 44 + rawData.length * 2;
   330	    	
   331	    	final ByteBuffer buff = ByteBuffer.allocate(size);
   332	        buff.put("RIFF".getBytes());
   333	        buff.put(new byte[] { (byte) (size - 8), (byte) ((size - 8) >> 8), (byte) ((size - 8) >> 16), (byte) ((size - 8) >> 24) });
   334	        buff.put("WAVE".getBytes());
   335	        buff.put("fmt ".getBytes());
   336	        buff.put(new byte[] { (byte) (16), (byte) (16 >> 8), (byte) (16 >> 16), (byte) (16 >> 24) }); //chunk size
   337	        buff.put(new byte[] { (byte) (1), (byte) (1 >> 8) }); //1 == PCM
   338	        buff.put(new byte[] { (byte) (channels), (byte) (channels >> 8) }); //mono == 1 / stereo == 2
   339	        buff.put(new byte[] { (byte) (samplesPerSecond), (byte) (samplesPerSecond >> 8), (byte) (samplesPerSecond >> 16), (byte) (samplesPerSecond >> 24) }); //samples per second 8000,11025,16000,22050,44100
   340	        buff.put(new byte[] { (byte) (bytesPerSecond), (byte) (bytesPerSecond >> 8), (byte) (bytesPerSecond >> 16), (byte) (bytesPerSecond >> 24) }); //bytes per second
   341	        buff.put(new byte[] { (byte) (bytesPerSample), (byte) (bytesPerSample >> 8) }); //number of bytes in one sample, for all channels
   342	        buff.put(new byte[] { (byte) (bitsPerSample), (byte) (bitsPerSample >> 8) }); //bits per sample -> 16 or 24
   343	        buff.put("data".getBytes());
   344	        buff.put(new byte[] { (byte) (rawData.length * 2), (byte) ((rawData.length * 2) >> 8), (byte) ((rawData.length * 2) >> 16), (byte) ((rawData.length * 2) >> 24) });
   345	    	for (int i = 0; i < rawData.length; i++) {
   346	    		int value = rawData[i];
   347	    		value = value - 0x20;
   348	    		buff.put((byte) value);
   349	    		buff.put((byte) value);
   350	    	}
   351	    	
   352	    	return buff.array();
   353		}
   354	}


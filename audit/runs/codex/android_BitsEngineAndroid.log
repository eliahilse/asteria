    49	    private 
    50	    BitsGLFactory( ) {
    51	    	
    52	    	/*
    53	    	 * Important for devices, that needs textures with a power of 2 size.
    54	    	 * (e.g. Galaxy Tab 7)
    55	    	 */
    56	    	this.mBitmapFactoryOptions.inScaled = false;
    57	    }

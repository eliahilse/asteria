    18	package net.gliblybits.bitsengine.io;
    19	
    20	import java.io.BufferedOutputStream;
    21	import java.io.File;
    22	import java.io.FileInputStream;
    23	import java.io.FileOutputStream;
    24	import java.io.IOException;
    25	import java.util.zip.ZipEntry;
    26	import java.util.zip.ZipFile;
    27	import java.util.zip.ZipInputStream;
    28	
    29	import net.gliblybits.bitsengine.utils.BitsLog;
    30	
    31	public final class 
    32	BitsZip {
    33		
    34		private static final int  BUFFER_SIZE = 4096;
    35	
    36	  	private static final void 
    37	  	extractFile(
    38	  			final ZipInputStream in, 
    39	  			final String outDir, 
    40	  			final String name) 
    41	  	throws IOException {
    42	    
    43	  		final byte[] buffer = new byte[BUFFER_SIZE];
    44	  		final BufferedOutputStream out = new BufferedOutputStream(new FileOutputStream(new File(outDir,name)));
    45	    	int count = -1;
    46	    	while ((count = in.read(buffer)) != -1) {
    47	    		out.write(buffer, 0, count);
    48	    	}
    49	    	out.close();
    50	  	}
    51	
    52	  	private static final String 
    53	  	dirPart(
    54	  			final String name) {
    55	  		
    56	  		final int s = name.lastIndexOf( File.separatorChar );
    57	    	return s == -1 ? null : name.substring( 0, s );
    58	  	}
    59	
    60	   /**
    61	   	* Extract zipfile to outdir with complete directory structure
    62	   	* @param zipfile Input .zip file
    63	   	* @param outdir Output directory
    64	   	*/
    65	  	public static final boolean 
    66	  	extract(
    67			  final String zipFile, final String outDir ) {
    68	  		
    69		  try {
    70			  final ZipInputStream zin = new ZipInputStream(new FileInputStream(zipFile));
    71			  ZipEntry entry;
    72			  String name, dir;
    73			  
    74			  while( (entry = zin.getNextEntry()) != null ) {
    75				  name = entry.getName();
    76				  if( entry.isDirectory() == true ) {
    77					  final File f = new File( outDir, name );
    78					  if( f.exists() == false ) {
    79						  f.mkdirs();
    80					  }
    81					  continue;
    82				  }
    83				  
    84				  dir = dirPart( name );
    85				  if( dir != null ) {
    86					  final File f = new File( outDir, name );
    87					  if( f.exists() == false ) {
    88						  f.mkdirs();
    89					  }
    90				  }
    91	
    92				  extractFile(zin, outDir, name);
    93			  }
    94			  zin.close();
    95		  } catch (IOException e) {
    96			  BitsLog.e( e, "BitsZip - extract", "Unable to extract the zip file: " + zipFile + " to " + outDir);
    97			  return false;
    98		  }
    99		  return true;
   100	  }
   101	  
   102	  	public static boolean 
   103	  	exists( 
   104	  			final String zipFile, 
   105	  			final String file ) {
   106	  		
   107	  		try {
   108	            //open the source zip file
   109	            final ZipFile sourceZipFile = new ZipFile( zipFile );
   110	            if( sourceZipFile.getEntry(file) == null ) {
   111	            	sourceZipFile.close();
   112	            	return false;
   113	            } else {
   114	            	sourceZipFile.close();
   115	            	return true;
   116	            }
   117	        }
   118	        catch( Exception e ) {
   119	        	BitsLog.e( e, "BitsZip - fileExists", "Unable to open the zip file: " + zipFile );
   120	        	return false;
   121	        }
   122	  	}
   123	}


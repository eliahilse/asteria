    16	
    17	package com.leff.midi.event;
    18	
    19	import java.io.IOException;
    20	import java.io.InputStream;
    21	import java.io.OutputStream;
    22	
    23	import com.leff.midi.event.meta.MetaEvent;
    24	import com.leff.midi.util.VariableLengthInt;
    25	
    26	
    27	public abstract class MidiEvent implements Comparable<MidiEvent> {
    28	
    29		protected long mTick;
    30		protected VariableLengthInt mDelta;
    31		
    32		public MidiEvent(long tick, long delta) {
    33			mTick = tick;
    34			mDelta = new VariableLengthInt((int)delta);
    35		}
    36		
    37		public long getTick() {
    38			return mTick;
    39		}
    40		public long getDelta() {
    41			return mDelta.getValue();
    42		}
    43		
    44		public void setDelta(long d) {
    45			mDelta.setValue((int)d);
    46		}
    47		
    48		protected abstract int getEventSize();
    49		
    50		public int getSize() {
    51			return getEventSize() + mDelta.getByteCount();
    52		}
    53		
    54		public boolean requiresStatusByte(MidiEvent prevEvent) {
    55			if(prevEvent == null) {
    56				return true;
    57			}
    58			if(this instanceof MetaEvent) {
    59				return true;
    60			}
    61			if(this.getClass().equals(prevEvent.getClass())) {
    62				return false;
    63			}
    64			return true;
    65		}
    66		
    67		public void writeToFile(OutputStream out, boolean writeType) throws IOException {
    68			out.write(mDelta.getBytes());
    69		}
    70		
    71		private static int sId = -1;
    72		private static int sType = -1;
    73		private static int sChannel = -1;
    74		
    75		public static final MidiEvent parseEvent(long tick, long delta, InputStream in) throws IOException {
    76			
    77			in.mark(1);
    78			boolean reset = false;
    79			
    80			int id = in.read();
    81			if(!verifyIdentifier(id)) {
    82				in.reset();
    83				reset = true;
    84			}
    85			
    86			if(sType >= 0x8 && sType <= 0xE) {
    87				
    88				return ChannelEvent.parseChannelEvent(tick, delta, sType, sChannel, in);
    89			}
    90			else if(sId == 0xFF) {
    91				
    92				return MetaEvent.parseMetaEvent(tick, delta, in);
    93			}
    94			else if(sId == 0xF0 || sId == 0xF7) {
    95	
    96				VariableLengthInt size = new VariableLengthInt(in);
    97				byte[] data = new byte[size.getValue()];
    98				in.read(data);
    99				return new SystemExclusiveEvent(sId, tick, delta, data);
   100			}
   101			else {
   102				System.out.println("Unable to handle status byte, skipping: " + sId);
   103				if(reset) {
   104					in.read();
   105				}
   106			}
   107			
   108			return null;
   109		}
   110		
   111		private static boolean verifyIdentifier(int id) {
   112			
   113			sId = id;
   114			
   115			int type = id >> 4;
   116			int channel = id & 0x0F;
   117			
   118			if(type >= 0x8 && type <= 0xE) {
   119				sId = id;
   120				sType = type;
   121				sChannel = channel;
   122			}
   123			else if(id == 0xFF) {
   124				sId = id;
   125				sType = -1;
   126				sChannel = -1;
   127			}
   128			else if(type == 0xF) {
   129				sId = id;
   130				sType = type;
   131				sChannel = -1;
   132			}
   133			else {
   134				return false;
   135			}
   136			return true;
   137		}
   138	
   139		@Override
   140		public String toString() {
   141			return "" + mTick + " (" + mDelta.getValue() + "): " + this.getClass().getSimpleName();
   142		}
   143	}

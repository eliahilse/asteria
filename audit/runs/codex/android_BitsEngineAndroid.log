   127		public final String
   128		findFile( 
   129				final String path,
   130				final String file,
   131				final boolean isPrefix ) {
   132			
   133			if( file == null || path == null ) {
   134				BitsLog.e("BitsIO - findFile", "The given path or file name is null.");
   135				return null;
   136			}
   137			if( file.equals("") == true || path.equals("") == true ) {
   138				BitsLog.e("BitsIO - findFile", "The given path or file name is empty.");
   139				return null;
   140			}
   141			
   142			final File f = new File(path);
   143			
   144			if( f.exists() == true ) {
   145				final String[] files = f.list();
   146				for( int i = 0; i < files.length; i++ ) {
   147					if( isPrefix == true ) {
   148						if( files[i].matches("(?i)^" + file + ".*$") == true ) { //will ignore the case; looks for 
   149							return path + "/" + files[i];
   150						}					
   151					} else {
   152						if( files[i].equalsIgnoreCase(file) == true ) {
   153							return path + "/" + files[i];
   154						}
   155					}
   156				}
   157			}
   158			
   159			return null;
   160		}
   161		
   162		public final boolean
   163		fileExists(
   164				final String file,
   165				final boolean ignoreCase ) {
   166			
   167			if( file == null ) {
   168				BitsLog.e("BitsIO - fileExists", "The given file name is null.");
   169				return false;
   170			}
   171			if( file.equals("") == true ) {
   172				BitsLog.e("BitsIO - fileExists", "The given file name is empty.");
   173				return false;
   174			}
   175	
   176			if( ignoreCase == true ) {
   177				final int idx = file.lastIndexOf("/");
   178				final String path = ( (idx == -1) ? System.getProperty("user.dir") : file.substring(0, (idx == -1 ? file.length()-1 : idx)) );
   179				final String name = file.substring( (idx == -1 ? 0 : idx + 1));
   180				final File f = new File(path);
   181				
   182				if( f.exists() == true ) {
   183					final String[] files = f.list();
   184					for( int i = 0; i < files.length; i++ ) {
   185						if( files[i].equalsIgnoreCase(name) == true ) {
   186							return true;
   187						}
   188					}
   189				}
   190			} else {
   191				final File f = new File(file);
   192				return f.exists();
   193			}
   194			
   195			return false;
   196		}
   197		
   198		public final void 
   199		writeFile( 
   200				final String file, 
   201				final byte[] buffer,
   202				final boolean doAppend ) {
   203			
   204			if( file == null && buffer == null ) {
   205				BitsLog.e("BitsIO - writeFile", "The given file name or buffer is null.");
   206				return;
   207			}
   208			if( file.equals("") == true ) {
   209				BitsLog.e("BitsIO - writeFile", "The given file name is empty.");
   210				return;
   211			}
   212			
   213			try {
   214				BitsLog.d( "BitsIO - writeFile", "Writing file: " + file );
   215				final FileOutputStream out = new FileOutputStream( new File( file ), doAppend );
   216				out.write( buffer );
   217				out.flush( );
   218				out.close( );
   219				BitsLog.d( "BitsIO - writeFile", "...done writing file: " + file );
   220			} catch (Exception se) {
   221				BitsLog.e( se, "BitsIO - writeFile", "Unable to write file: " + file );
   222			}
   223		}
   224		
   225		public final byte[] 
   226		readFile( 
   227				final String file ) {
   228			
   229			if( file == null ) {
   230				BitsLog.e("BitsIO - readFile", "The given file is null.");
   231				return null;
   232			}
   233			if( file.equals("") == true ) {
   234				BitsLog.e("BitsIO - readFile", "The given file name is empty.");
   235				return null;
   236			}
   237			
   238			try {
   239				BitsLog.d( "BitsIO - readFile", "Reading file: " + file );
   240				final FileInputStream out = new FileInputStream( new File( file)  );
   241				final byte[] buffer = new byte[(int)out.getChannel().size()];
   242				out.read( buffer );
   243				out.close( );
   244				BitsLog.d( "BitsIO - readFile", "...done reading file: " + file );
   245				return buffer;
   246			} catch( Exception e ) {
   247				BitsLog.e( e, "BitsIO - readFile", "Unable to read file: " + file);
   248			}
   249			return null;
   250		}

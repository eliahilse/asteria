    15	public class MidiManipulation {
    16	
    17		public static void main(String[] args) {
    18			
    19			// 1. Open up a MIDI file
    20			MidiFile mf = null;
    21			File input = new File("example.mid");
    22			
    23			try {
    24				mf = new MidiFile(input);
    25			} catch(IOException e) {
    26				System.err.println("Error parsing MIDI file:");
    27				e.printStackTrace();
    28				return;
    29			}
    30			
    31			// 2. Do some editing to the file
    32			// 2a. Strip out anything but notes from track 1
    33			MidiTrack T = mf.getTracks().get(1);
    34			
    35			// It's a bad idea to modify a set while iterating, so we'll collect
    36			// the events first, then remove them afterwards
    37			Iterator<MidiEvent> it = T.getEvents().iterator();
    38			ArrayList<MidiEvent> eventsToRemove = new ArrayList<MidiEvent>();
    39			
    40			while(it.hasNext()) {
    41				MidiEvent E = it.next();
    42				
    43				if(!E.getClass().equals(NoteOn.class) && !E.getClass().equals(NoteOff.class)) {
    44					eventsToRemove.add(E);
    45				}
    46			}
    47			
    48			for(MidiEvent E : eventsToRemove) {
    49				T.removeEvent(E);
    50			}
    51			
    52			// 2b. Completely remove track 2
    53			mf.removeTrack(2);
    54			
    55			// 2c. Reduce the tempo by half
    56			T = mf.getTracks().get(0);
    57			
    58			it = T.getEvents().iterator();
    59			while(it.hasNext()) {
    60				MidiEvent E = it.next();
    61				
    62				if(E.getClass().equals(Tempo.class)) {
    63					
    64					Tempo tempo = (Tempo)E;
    65					tempo.setBpm(tempo.getBpm() / 2);
    66				}
    67			}
    68			
    69			// 3. Save the file back to disk
    70			try {
    71				mf.writeToFile(input);
    72			} catch(IOException e) {
    73				System.err.println("Error writing MIDI file:");
    74				e.printStackTrace();
    75			}
    76		}
    77	}

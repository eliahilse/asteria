    10	import com.leff.midi.util.MidiEventListener;
    11	import com.leff.midi.util.MidiProcessor;
    12	
    13	public class EventPrinter implements MidiEventListener {
    14	
    15		private String mLabel;
    16		public EventPrinter(String label) {
    17			mLabel = label;
    18		}
    19	
    20		// 0. Implement the listener functions that will be called by the MidiProcessor
    21		@Override
    22		public void onStart(boolean fromBeginning) {
    23			
    24			if(fromBeginning) {
    25				System.out.println(mLabel + " Started!");
    26			}
    27			else {
    28				System.out.println(mLabel + " resumed");
    29			}
    30		}
    31	
    32		@Override
    33		public void onEvent(MidiEvent event, long ms) {
    34			System.out.println(mLabel + " received event: " + event);
    35		}
    36	
    37		@Override
    38		public void onStop(boolean finished) {
    39			
    40			if(finished) {
    41				System.out.println(mLabel + " Finished!");
    42			}
    43			else {
    44				System.out.println(mLabel + " paused");
    45			}
    46		}
    47		
    48		public static void main(String[] args) {
    49			
    50			// 1. Read in a MidiFile
    51			MidiFile midi = null;
    52			try {
    53				midi = new MidiFile(new File("inputmid.mid"));
    54			} catch(IOException e) {
    55				System.err.println(e);
    56				return;
    57			}
    58			
    59			// 2. Create a MidiProcessor
    60			MidiProcessor processor = new MidiProcessor(midi);
    61			
    62			// 3. Register listeners for the events you're interested in
    63			EventPrinter ep = new EventPrinter("Individual Listener");
    64			processor.registerEventListener(ep, Tempo.class);
    65			processor.registerEventListener(ep, NoteOn.class);
    66			
    67			// or listen for all events:
    68			EventPrinter ep2 = new EventPrinter("Listener For All");
    69			processor.registerEventListener(ep2, MidiEvent.class);
    70			
    71			// 4. Start the processor
    72			processor.start();
    73			
    74			// Listeners will be triggered in real time with the MIDI events
    75			// And you can pause/resume with stop() and start()
    76			try {
    77				Thread.sleep(10 * 1000);
    78				processor.stop();
    79	
    80				Thread.sleep(10 * 1000);
    81				processor.start();
    82			} catch(Exception e) {}
    83		}
    84	}

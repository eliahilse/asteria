   491		public static final BufferedImage getImage(BufferedImage iImage) {
   492			int width = iImage.getWidth();
   493			int height = iImage.getHeight();
   494			float dif = (float)(width) / (float)(height);
   495			if ((width > ApoRelaxLevel.MAX) || (height > ApoRelaxLevel.MAX)) {
   496				if (width > height) {
   497					width = ApoRelaxLevel.MAX;
   498					height = (int)(width / dif);
   499				} else {
   500					height = ApoRelaxLevel.MAX;
   501					width = (int)(height * dif);
   502				}
   503				BufferedImage iNew = new BufferedImage(width, height, BufferedImage.TYPE_INT_RGB);
   504				Graphics2D g = iNew.createGraphics();
   505				g.drawImage(iImage.getScaledInstance(width, height, BufferedImage.SCALE_SMOOTH), 0, 0, null);
   506				g.dispose();
   507				return iNew;
   508			} else {
   509				return iImage;
   510			}
   511		}

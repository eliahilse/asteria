    50		public boolean mouseMoved(int x, int y, ApoRelaxComponent component) {
    51			if (this.bMoving) {
    52				return false;
    53			}
    54			x = x - this.getXLevel(10);
    55			y = y - this.getYLevel(15);
    56			
    57			for (int i = 0; i < this.recs.length; i++) {
    58				if (this.recs[i].intersects(x, y)) {
    59					if (this.mouseOverRec != i) {
    60						this.mouseOverRec = i;
    61						component.setCursor(Cursor.getPredefinedCursor(Cursor.HAND_CURSOR));
    62						return true;
    63					} else {
    64						return false;
    65					}
    66				} else if (i + 1 == this.recs.length) {
    67					if (this.mouseOverRec != -1) {
    68						this.mouseOverRec = -1;
    69						component.setCursor(Cursor.getPredefinedCursor(Cursor.DEFAULT_CURSOR));
    70						return true;
    71					}
    72				}
    73			}
    74			component.setCursor(Cursor.getPredefinedCursor(Cursor.DEFAULT_CURSOR));
    75			return false;
    76		}
    77		
    78		public int mouseReleased(int x, int y, boolean bRight) {
    79			if (this.bMoving) {
    80				return 0;
    81			}
    82			
    83			x = x - this.getXLevel(10);
    84			y = y - this.getYLevel(15);
    85			if (bRight) {
    86				this.chooseRec = -1;
    87			} else {
    88				if (this.chooseRec < 0) {
    89					for (int i = 0; i < this.recs.length; i++) {
    90						if (this.recs[i].intersects(x, y)) {
    91							this.recs[i].setChoosen(true);
    92							this.chooseRec = i;
    93							return 2;
    94						}
    95					}
    96				} else {
    97					for (int i = 0; i < this.recs.length; i++) {
    98						if (this.recs[i].intersects(x, y)) {
    99							this.recs[i].setChoosen(false);
   100							if (this.chooseRec != i) {
   101								this.changeTwoTiles(i, this.chooseRec, true);
   102								return 1;
   103							} else {
   104								this.chooseRec = -1;
   105								return 2;
   106							}
   107						} else {
   108							
   109						}
   110						if (i + 1 >= this.recs.length) {
   111							if (this.chooseRec >= 0) {
   112								this.recs[this.chooseRec].setChoosen(false);
   113								this.chooseRec = -1;
   114								return 2;
   115							}
   116						}
   117					}
   118				}
   119			}
   120			return 0;
   121		}
   122		
   123		public void changeTwoTiles(int i, int choose, boolean bWithMove) {
   124			int curNumber = this.recs[i].getCurNumber();
   125			BufferedImage iNew = this.recs[curNumber].getIBackground();
   126			int otherCurNumber = this.recs[choose].getCurNumber();
   127			BufferedImage iNewOther = this.recs[otherCurNumber].getIBackground();
   128			this.recs[i].changeImage(this.recs[choose], iNewOther, otherCurNumber, bWithMove);
   129			this.recs[choose].changeImage(this.recs[i], iNew, curNumber, bWithMove);
   130			this.chooseRec = -1;
   131			this.mouseOverRec = -1;
   132		}
   133	
   134		public void restart() {
   135		}
   136		
   137		public boolean think(int delta) {
   138			this.bMoving = false;
   139			this.bCorrect = true;
   140			for (int i = 0; i < this.recs.length; i++) {
   141				this.recs[i].think(delta);
   142				if (this.recs[i].isMoving()) {
   143					this.bMoving = true;
   144				}
   145				if (!this.recs[i].isCorrect()) {
   146					this.bCorrect = false;
   147				}
   148			}
   149			return this.bMoving;
   150		}
   151	
   152		public boolean isCorrect() {
   153			if (this.bMoving) {
   154				return false;
   155			}
   156			return this.bCorrect;
   157		}
   158		
   159		public int getXLevel(int changeX) {
   160			return changeX + 25 + (ApoRelaxLevel.MAX - this.width)/2;
   161		}
   162		
   163		public int getYLevel(int changeY) {
   164			return changeY + 25 + (ApoRelaxLevel.MAX - this.height)/2;
   165		}
   166		
   167		public void render(Graphics2D g, int changeX, int changeY) {
   168			g.setColor(Color.BLACK);
   169			int max = 450;
   170			if (this.levelName != null) {
   171				g.setFont(ApoRelaxConstants.FONT_LEVELNAME);
   172				int w = g.getFontMetrics().stringWidth(this.levelName);
   173				g.drawString(this.levelName, changeX + max/2 - w/2, changeY + 20);
   174			}
   175			if (this.description != null) {
   176				g.setFont(ApoRelaxConstants.FONT_DESCRIPTIONS);
   177				int w = g.getFontMetrics().stringWidth(this.description);
   178				while (w > max - 10) {
   179					Font f = g.getFont();
   180					g.setFont(new Font(f.getName(), f.getStyle(), f.getSize() - 1));
   181					w = g.getFontMetrics().stringWidth(this.description);
   182				}
   183				g.drawString(this.description, changeX + max/2 - w/2, changeY + max - 5);
   184			}
   185			
   186			if (this.recs != null) {
   187				int x = this.getXLevel(changeX);
   188				int y = this.getYLevel(changeY);
   189	
   190				Stroke stroke = g.getStroke();
   191				g.setColor(Color.BLACK);
   192				g.setStroke(new BasicStroke(3));
   193				g.drawRoundRect(x - 2, y - 2, this.width + 2, this.height + 2, 10, 10);
   194				g.setStroke(stroke);
   195				
   196				for (int i = 0; i < this.recs.length; i++) {
   197					this.recs[i].render(g, x, y);
   198					
   199					if (i == this.mouseOverRec) {
   200						g.setStroke(new BasicStroke(3));
   201						g.setColor(Color.RED);
   202						g.drawRect((int)(this.recs[i].getX() + x), (int)(this.recs[i].getY() + y), (int)(this.recs[i].getWidth() - 1), (int)(this.recs[i].getHeight() - 1));
   203						g.setStroke(stroke);
   204					}
   205				}
   206				
   207				for (int i = 0; i < this.recs.length; i++) {
   208					if (this.recs[i].isMoving()) {
   209						this.recs[i].renderImage(g, x, y);
   210					}
   211				}
   212			}
   213		}
   214	}


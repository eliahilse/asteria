   483		@Override
   484		public void render(Graphics2D g) {
   485			if (this.iBackground != null) {
   486				g.drawImage(this.iBackground, 0, 0, null);
   487				
   488				g.setRenderingHint(RenderingHints.KEY_ANTIALIASING, RenderingHints.VALUE_ANTIALIAS_ON);		
   489				
   490				int x = this.getXLevel(10);
   491				int y = this.getYLevel(15);
   492				if (this.iLevel != null) {
   493					g.drawImage(this.iLevel, x, y, null); 
   494				}
   495	//			this.level.render(g, 10, 0);
   496	
   497				g.setColor(Color.RED);
   498				Stroke stroke = g.getStroke();
   499	//			g.setStroke(new BasicStroke(3));
   500				for (int i = 0; i < this.recs.size(); i++) {
   501					g.drawRect((int)(x + this.recs.get(i).x), (int)(y + this.recs.get(i).y), (int)(this.recs.get(i).width), (int)(this.recs.get(i).height));
   502				}
   503				g.setStroke(stroke);
   504				
   505				g.setColor(Color.BLACK);
   506				if (this.textFieldLevelname.isBVisible()) {
   507					this.textFieldLevelname.render(g, 0, 0);
   508					
   509					g.setFont(ApoRelaxConstants.FONT_INSTRUCTIONS);
   510					String s = "Levelname: ";
   511					int w = g.getFontMetrics().stringWidth(s);
   512					int h = g.getFontMetrics().getHeight() - 2 * g.getFontMetrics().getDescent();
   513					g.drawString(s, (int)(this.textFieldLevelname.getX() - w), (int)(this.textFieldLevelname.getY() + this.textFieldLevelname.getHeight()/2 + h/2));
   514				}
   515	
   516				try {
   517					for (int i = this.strings.size() - 1; i >= 0; i--) {
   518						this.strings.get(i).render(g, 0, 0);
   519					}
   520				} catch (Exception ex) {	
   521				}
   522			}
   523		}

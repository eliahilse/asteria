   462		@Override
   463		public void think(int delta) {
   464			if (this.textFieldLevelname != null) {
   465				this.textFieldLevelname.think(delta);
   466			}
   467			for (int i = this.strings.size() - 1; i >= 0; i--) {
   468				this.strings.get(i).think(delta);
   469				if (!this.strings.get(i).isBVisible()) {
   470					this.strings.remove(i);
   471				}
   472			}
   473		}

   104		public static final ApoRelaxLevel getRandomLevel(final BufferedImage iLevel) {
   105			if (ApoRelaxLevelGeneration.recs == null) {
   106				ApoRelaxLevelGeneration.makeRecs();
   107			}
   108			
   109			int rec = (int)(Math.random() * ApoRelaxLevelGeneration.recs.length);
   110			if (rec == ApoRelaxLevelGeneration.recs.length) {
   111				rec = 0;
   112			}
   113			ApoRelaxTile[] tiles = new ApoRelaxTile[ApoRelaxLevelGeneration.recs[rec][0].getX()];
   114			for (int i = 1; i <= tiles.length; i++) {
   115				int x = (int)Math.round((float)(ApoRelaxLevelGeneration.recs[rec][i].getX() * (float)iLevel.getWidth()) / 100f);
   116				int y = (int)Math.round((float)(ApoRelaxLevelGeneration.recs[rec][i].getY() * (float)(iLevel.getHeight())) / 100f);
   117				int width = (int)Math.round((float)(ApoRelaxLevelGeneration.recs[rec][i].getWidth() * (float)(iLevel.getWidth())) / 100f);
   118				int height = (int)Math.round((float)(ApoRelaxLevelGeneration.recs[rec][i].getHeight() * (float)(iLevel.getHeight())) / 100f);
   119				if (x + width > iLevel.getWidth()) {
   120					width = iLevel.getWidth() - x;
   121				}
   122				if (y + height > iLevel.getHeight()) {
   123					height = iLevel.getHeight() - y;
   124				}
   125				tiles[i - 1] = ApoRelaxLevelGeneration.getRelaxTile(iLevel, x, y, width, height, i - 1);
   126			}
   127			
   128			ApoRelaxLevel simpleLevel = new ApoRelaxLevel("Random Level", "Click on a tile to select it. Then, click a different piece to swap them.", tiles, iLevel.getWidth(), iLevel.getHeight());
   129			
   130			ApoRelaxLevelGeneration.swapLevel(simpleLevel, tiles);
   131			
   132			return simpleLevel;
   133		}
   134		
   135		private static final void swapLevel(final ApoRelaxLevel simpleLevel, final ApoRelaxTile[] tiles) {
   136			boolean bMustSwap = true;
   137			
   138			while (bMustSwap) {
   139				int swaps = (int)(Math.random() * tiles.length * 2) + 3;
   140				for (int i = 0; i < swaps; i++) {
   141					int first = (int)(Math.random() * tiles.length);
   142					if (first >= tiles.length) {
   143						first = 0;
   144					}
   145					int second = (int)(Math.random() * tiles.length);
   146					while (second == first) {
   147						second += 1;
   148					}
   149					if (second >= tiles.length) {
   150						second = 0;
   151					}
   152					simpleLevel.changeTwoTiles(first, second, false);			
   153				}
   154				for (int i = 0; i < tiles.length; i++) {
   155					if (tiles[i].getCurNumber() != tiles[i].getNumber()) {
   156						bMustSwap = false;
   157					}
   158				}
   159			}
   160		}

   313		@Override
   314		public void think(int delta) {
   315			for (int i = this.strings.size() - 1; i >= 0; i--) {
   316				this.strings.get(i).think(delta);
   317				if (!this.strings.get(i).isBVisible()) {
   318					this.strings.remove(i);
   319				}
   320				if (i == 0) {
   321					if (this.strings.size() <= 0) {
   322						this.getGame().setShouldRepaint(false);
   323					}
   324				}
   325			}
   326			if (this.curLooseTime > 0) {
   327				this.curLooseTime -= delta;
   328				if (this.curLooseTime <= 0) {
   329					if (this.curLevel != null) {
   330						this.getGame().setShouldRepaint(false);
   331						this.getGame().render();
   332					}
   333				}
   334			} else if (this.curLevel != null) {
   335				if (!this.getGame().getButtons()[11].isBVisible()) {
   336					if (this.curLevel.think(delta)) {
   337						if (!this.getGame().shouldRepaint()) {
   338							this.getGame().setShouldRepaint(true);
   339						}
   340					} else {
   341						if (this.getGame().shouldRepaint()) {
   342							this.getGame().setShouldRepaint(false);
   343							this.getGame().render();
   344						}
   345					}
   346					if (this.curLevel.isCorrect()) {
   347						this.getGame().getButtons()[11].setBVisible(true);
   348						this.strings.add(new ApoRelaxString(225, 200, "=== Congratulation ===", true));
   349						this.strings.add(new ApoRelaxString(250, 400, "Press next to start the next level", true));
   350						this.getGame().setShouldRepaint(true);
   351						this.getGame().playSound(ApoRelaxPanel.SOUND_WIN, 100);
   352						if (this.level >= 0) {
   353							this.getGame().setMaxLevel(this.level + 1);
   354						}
   355					}
   356				}
   357			}
   358		}

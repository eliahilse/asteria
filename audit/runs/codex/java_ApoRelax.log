    72		public BufferedImage getImageMouseOver(BufferedImage iOriginal, int searchColor, Color drawColor, int w) {
    73			int width = iOriginal.getWidth();
    74			int height = iOriginal.getHeight();
    75			BufferedImage iSelect = GraphicsEnvironment.getLocalGraphicsEnvironment().getDefaultScreenDevice().getDefaultConfiguration().createCompatibleImage( width, height, BufferedImage.TRANSLUCENT );
    76			Graphics2D g	= (Graphics2D)iSelect.getGraphics();
    77	
    78			g.setRenderingHint(RenderingHints.KEY_ANTIALIASING, RenderingHints.VALUE_ANTIALIAS_ON);
    79			
    80			g.drawImage(iOriginal, 0, 0, null);
    81			
    82			g.setColor(drawColor);
    83			int color = searchColor;
    84			for (int y = 0; y < height; y++) {
    85				for (int x = 0; x < width; x++) {
    86					if (x + 1 < iOriginal.getWidth()) {
    87						if ((iOriginal.getRGB(x + 1, y) != color) &&
    88							(iOriginal.getRGB(x, y) == color)) {
    89							g.fillRect(x - w/2, y, w, 1);
    90						}
    91					}
    92					if ((x - 1 >= 0)) {
    93						if ((iOriginal.getRGB(x, y) == color) &&
    94							(iOriginal.getRGB(x - 1, y) != color)) {
    95							g.fillRect(x, y, w, 1);
    96						}
    97					} 
    98					if ((y - 1 >= 0)) {
    99						if ((iOriginal.getRGB(x, y) == color) &&
   100							(iOriginal.getRGB(x, y - 1) != color)) {
   101							g.fillRect(x, y, 1, w);
   102						}
   103					}
   104					if (y + 1 < height) {
   105						if ((iOriginal.getRGB(x, y + 1) != color) &&
   106							(iOriginal.getRGB(x, y) == color)) {
   107							g.fillRect(x, y - w/2, 1, w);
   108						}
   109					}
   110				}
   111			}
   112					
   113			g.dispose();
   114			
   115			return iSelect;
   116		}

   404		public boolean mousePressed(int x, int y, boolean bRight) {
   405			if ((this.textFieldLevelname != null) && (this.textFieldLevelname.isBVisible())) {
   406				if (this.textFieldLevelname.mousePressed(x, y)) {
   407					return true;
   408				}
   409			}
   410			this.lastPoint = new Point(-1, -1);
   411			if (!bRight) {
   412				x -= this.getXLevel(10);
   413				y -= this.getYLevel(15);
   414				for (int i = 0; i < this.recs.size(); i++) {
   415					if (this.recs.get(i).contains(x, y)) {
   416						this.lastPoint = new Point(x, y);
   417						Rectangle2D.Double left = this.getRec(this.LEFT, this.recs.get(i)); 
   418						if (left.contains(x, y)) {
   419							this.direction = this.LEFT;
   420						} else if (getRec(this.RIGHT, this.recs.get(i)).contains(x, y)) {
   421							this.direction = this.RIGHT;
   422						} else if (getRec(this.UP, this.recs.get(i)).contains(x, y)) {
   423							this.direction = this.UP;
   424						} else if (getRec(this.DOWN, this.recs.get(i)).contains(x, y)) {
   425							this.direction = this.DOWN;
   426						} else {
   427							this.direction = this.CENTER;
   428						}
   429						this.curSelection = i;
   430						this.changePoint = new Point((int)(x - this.recs.get(i).x), (int)(y - this.recs.get(i).y));
   431					}
   432				}
   433			}
   434			if (this.lastPoint.x < 0) {
   435				this.direction = this.NONE;
   436			}
   437			return false;
   438		}
   439		
   440		private Rectangle2D.Double getRec(int direction, Rectangle2D.Double rec) {
   441			int size = 8;
   442			if (direction == this.LEFT) {
   443				return new Rectangle2D.Double(rec.x, rec.y, size, rec.height);
   444			} else if (direction == this.RIGHT) {
   445				return new Rectangle2D.Double(rec.x + rec.width - size, rec.y, size, rec.height);
   446			} else if (direction == this.UP) {
   447				return new Rectangle2D.Double(rec.x, rec.y, rec.width, size);
   448			} else if (direction == this.DOWN) {
   449				return new Rectangle2D.Double(rec.x, rec.y + rec.height - size, rec.width, size);
   450			}
   451			return null;
   452		}

    70		public static final ApoRelaxLevel getEditorLevel(final BufferedImage iLevel, ArrayList<Rectangle2D.Double> recs) {
    71			ApoRelaxLevelGeneration.initImageArray();
    72			
    73			ApoRelaxTile[] tiles = new ApoRelaxTile[recs.size()];
    74			for (int i = 0; i < tiles.length; i++) {
    75				int x = (int)Math.round((float)(recs.get(i).getX()));
    76				int y = (int)Math.round((float)(recs.get(i).getY()));
    77				int width = (int)Math.round((float)(recs.get(i).getWidth()));
    78				int height = (int)Math.round((float)(recs.get(i).getHeight()));
    79				if (x + width > iLevel.getWidth()) {
    80					width = iLevel.getWidth() - x;
    81				}
    82				if (y + height > iLevel.getHeight()) {
    83					height = iLevel.getHeight() - y;
    84				}
    85				tiles[i] = ApoRelaxLevelGeneration.getRelaxTile(iLevel, x, y, width, height, i);
    86			}
    87			
    88			ApoRelaxLevel simpleLevel = new ApoRelaxLevel("Random Level", "Click on a tile to select it. Then, click a different piece to swap them.", tiles, iLevel.getWidth(), iLevel.getHeight());
    89			
    90			ApoRelaxLevelGeneration.swapLevel(simpleLevel, tiles);
    91			
    92			return simpleLevel;
    93		}	

   372		private void checkCollision(int x, int y, int width, int height, int r) {
   373			Rectangle2D.Double rec = this.recs.get(r);
   374			Rectangle2D.Double oldRec = new Rectangle2D.Double(rec.x, rec.y, rec.width, rec.height);
   375			rec.x = x;
   376			rec.y = y;
   377			rec.width = width;
   378			rec.height = height;
   379			if (rec.x < 0) {
   380				rec.x = 0;
   381			} else if (rec.x + rec.width >= this.iLevel.getWidth()) {
   382				rec.x = this.iLevel.getWidth() - rec.width;
   383			}
   384			
   385			if (rec.y < 0) {
   386				rec.y = 0;
   387			} else if (rec.y + rec.height >= this.iLevel.getHeight()) {
   388				rec.y = this.iLevel.getHeight() - rec.height;
   389			}
   390			
   391			for (int i = 0; i < this.recs.size(); i++) {
   392				if (i != r) {
   393					if (this.recs.get(i).intersects(rec)) {
   394						this.recs.get(r).x = oldRec.x;
   395						this.recs.get(r).y = oldRec.y;
   396						this.recs.get(r).width = oldRec.width;
   397						this.recs.get(r).height = oldRec.height;
   398						break;
   399					}
   400				}
   401			}
   402		}

   225		private void makeIncreaseWall(int startX, int width) {
   226			int wallWidth = this.random.nextInt(3) + 2;
   227			int x = this.random.nextInt(width) + startX;
   228			int count = 0;
   229			while ((this.isEmpty(x, wallWidth)) && (count < 15)) {
   230				x += 1;
   231				if (x + wallWidth > startX + width) {
   232					x = startX;
   233				}
   234				count++;
   235			}
   236			if (count >= 15) {
   237				return;
   238			}
   239			int maxY = this.level.getHeight() - 2;

    88				if (c == null) {
    89					try {
    90						c = findSystemClass(name);
    91					} catch (Exception e) {
    92					}
    93				}
    94	
    95				if (c == null) {
    96					throw new ClassNotFoundException(name);
    97				}
    98	
    99			} catch (Throwable ex) {
   100				throw new ClassNotFoundException(name);
   101			}
   102	
   103			return c;
   104		}

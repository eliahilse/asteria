   157		private void loadPropertiesPlayer(int player, String playerPath) {
   158			if ((playerPath == null) || (playerPath.length() <= 0)) {
   159				return;
   160			}
   161			int playerInt = -1;
   162			try {
   163				playerInt = Integer.parseInt(playerPath);
   164			} catch (NumberFormatException ex) {
   165				playerInt = -1;
   166			}
   167			if (playerInt >= 0) {
   168				if (player == ApoMarioConstants.PLAYER_ONE) {
   169					this.getLevel().setPlayerOneAI(playerInt);
   170					this.getLevel().changePlayerOneAI(0);
   171				} else if (player == ApoMarioConstants.PLAYER_TWO) {
   172					this.getLevel().setPlayerTwoAI(playerInt);
   173					this.getLevel().changePlayerTwoAI(0);
   174				}
   175			} else {
   176				this.getLevel().loadPlayer(player, playerPath);
   177			}
   178		}

   205		private void makeGround(int startX) {
   206			int curX = startX;
   207			int curY = this.level.getHeight() - 2;
   208			while (curX < level.getWidth() - 10) {
   209				int nextY = this.random.nextInt(4) - 1;
   210				int width = this.random.nextInt(7) + 3;
   211				while ((curY + nextY > this.level.getHeight() - 1) 
   212					|| (curY + nextY < this.level.getHeight() - 4)) {
   213					nextY = this.random.nextInt(4) - 1;
   214				}
   215				curY = nextY + curY;
   216				for (int x = curX; x < curX + width; x++) {
   217					for (int y = this.level.getHeight() - 1; y >= curY; y--) {
   218						this.level.makeGroundWall(x, y);
   219					}
   220				}
   221				curX += width;
   222			}
   223		}

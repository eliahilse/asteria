   164						data.writeInt(1);
   165						data.writeInt((int)(flower.getX()/ApoMarioConstants.TILE_SIZE));
   166						data.writeInt((int)(flower.getY()/ApoMarioConstants.TILE_SIZE));
   167						data.writeInt(flower.getTimeToShow());
   168						data.writeInt(flower.getStartTime());
   169					} else if (this.level.getEnemies().get(i) instanceof ApoMarioKoopa) {

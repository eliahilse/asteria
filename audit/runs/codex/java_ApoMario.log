    59		@SuppressWarnings({ "unchecked", "deprecation" })
    60		public Class loadClass(String name) throws ClassNotFoundException {
    61			Class c;
    62			try {
    63				//System.out.println( "name = "+name );
    64				c = findLoadedClass(name);
    65	
    66				if (c == null) {
    67					// Convert class name argument to filename

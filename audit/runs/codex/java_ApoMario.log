   154							}
   155						}
   156					}
   157				}
   158				
   159				int enemies = this.level.getEnemies().size();
   160				data.writeInt(enemies);
   161				for (int i = 0; i < enemies; i++) {
   162					if (this.level.getEnemies().get(i) instanceof ApoMarioFlower) {

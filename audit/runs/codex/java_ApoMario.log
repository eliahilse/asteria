   596		
   597		public void makeGroundCorrectNoCollision(int startX, int endX, int startY, int endY) {
   598			try {
   599				if (startX < 0) {
   600					startX = 0;
   601				}
   602				if (startY < 0) {
   603					startY = 0;
   604				}
   605				if (endX > this.width) {
   606					endX = this.width;
   607				}
   608				if (endY > this.height) {
   609					endY = this.height;
   610				}
   611				for (int x = startX; x < endX; x++) {
   612					for (int y = endY - 1; y >= startY; y--) {
   613						if (this.isGroundWallNoCollision(x, y)) {
   614							if (this.isGroundWallNoCollision(x, y-1)) {
   615								if ((!this.isGroundWallNoCollision(x - 1, y)) && (!this.isGroundWallNoCollision(x + 1, y))) {
   616									BufferedImage iLeft = ApoMarioImageContainer.TILES_LEVEL.getSubimage(4 * ApoMarioConstants.TILE_SIZE * ApoMarioConstants.APP_SIZE, 9 * ApoMarioConstants.TILE_SIZE * ApoMarioConstants.APP_SIZE, 1 * ApoMarioConstants.TILE_SIZE * ApoMarioConstants.APP_SIZE, 1 * ApoMarioConstants.TILE_SIZE * ApoMarioConstants.APP_SIZE);
   617									BufferedImage iRight = ApoMarioImageContainer.TILES_LEVEL.getSubimage(6 * ApoMarioConstants.TILE_SIZE * ApoMarioConstants.APP_SIZE, 9 * ApoMarioConstants.TILE_SIZE * ApoMarioConstants.APP_SIZE, 1 * ApoMarioConstants.TILE_SIZE * ApoMarioConstants.APP_SIZE, 1 * ApoMarioConstants.TILE_SIZE * ApoMarioConstants.APP_SIZE);
   618									BufferedImage iNew = GraphicsEnvironment.getLocalGraphicsEnvironment().getDefaultScreenDevice().getDefaultConfiguration().createCompatibleImage(iLeft.getWidth(), iLeft.getHeight(), BufferedImage.TYPE_INT_ARGB_PRE);
   619									Graphics2D g = (Graphics2D)(iNew.getGraphics());
   620									g.drawImage(iLeft.getSubimage(0, 0, iLeft.getWidth()/2, iLeft.getHeight()), 0, 0, null);
   621									g.drawImage(iRight.getSubimage(iRight.getWidth()/2, 0, iRight.getWidth()/2, iRight.getHeight()), iRight.getWidth()/2, 0, null);
   622									g.dispose();
   623									this.levelEntities[y][x].setIBackground(iNew);
   624								} else if (!this.isGroundWallNoCollision(x - 1, y)) {
   625									if ((this.isGroundWallNoCollision(x + 1, y) && ((!this.isGroundWallNoCollision(x + 1, y - 1))))) {

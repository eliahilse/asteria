   106		private byte[] loadClassData(String filename) throws IOException {
   107	
   108			// Create a file object relative to directory provided
   109			File f = new File(this.root, filename);
   110			
   111			// Get size of class file
   112			int size = (int) f.length();
   113			
   114			// Reserve space to read
   115			byte buff[] = new byte[size];
   116	
   117			// Get stream to read from
   118			FileInputStream fis = new FileInputStream(f);
   119			DataInputStream dis = new DataInputStream(fis);
   120	
   121			// Read in data
   122			dis.readFully(buff);
   123	
   124			// close stream
   125			dis.close();
   126	
   127			// return data
   128			return buff;
   129		}

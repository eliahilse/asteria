   292						} else if (this.enemies.get(i) instanceof ApoMarioShell) {
   293							this.enemies.remove(i);
   294						}
   295					}
   296				}
   297				this.goodies.clear();
   298				for (int x = 0; x < this.levelEntities[0].length; x++) {
   299					for (int y = 0; y < this.levelEntities.length; y++) {
   300						if (this.levelEntities[y][x] != null) {
   301							this.levelEntities[y][x].init();
   302						}
   303					}
   304				}
   305				for (int i = 0; i < this.players.size(); i++) {
   306					this.players.get(i).init();
   307				}
   308				this.time = 60000 + this.levelEntities[0].length * 400;
   309				this.levelStartTime = this.time;
   310			} else {
   311				if (this.enemies == null) {
   312					this.enemies = new ArrayList<ApoMarioEnemy>();
   313				} else {
   314					this.enemies.clear();
   315				}
   316				if (this.goodies == null) {
   317					this.goodies = new ArrayList<ApoMarioEnemy>();
   318				} else {
   319					this.goodies.clear();
   320				}
   321				ApoMarioLevel.ID = 0;
   322				this.particle = new ArrayList<ApoMarioParticle>();
   323				this.bStop = false;
   324				if (bRealNew) {
   325					this.cannons.clear();
   326				}
   327				
   328				if ((levelInt != this.levelInt) && (this.levelInt != -1) && (bNew) && (width == -1)) {
   329					this.width = (int)(Math.random() * 500 + 100);
   330					this.difficulty = (int)(Math.random() * 400);
   331				} else if (width > 0) {
   332					this.width = width;
   333					this.difficulty = difficulty;
   334				}
   335				this.levelInt = levelInt;
   336				this.height = 15;
   337				this.levelEntities = new ApoMarioEntity[this.height][this.width];
   338				for (int x = 0; x < this.width; x++) {
   339					this.makeGroundWall(x, this.height-1);
   340				}
   341				if (this.levelInt != -1) {
   342					this.randomLevel = new ApoMarioRandomLevel(this);
   343					this.randomLevel.setWidth(this.width);
   344					this.randomLevel.setDifficulty(this.difficulty);
   345					this.randomLevel.makeRandomLevel(levelInt);
   346					this.time = this.randomLevel.getTime();
   347					this.difficulty = this.randomLevel.getDifficulty();
   348				}
   349			}
   350			this.levelStartTime = this.time;
   351			this.makeMyBackground();
   352		}

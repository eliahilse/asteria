   196		private void makeBFull() {
   197			this.bFull = new boolean[this.width];
   198			for (int i = 0; i < this.width; i++) {
   199				if (this.isEmpty(i, 1)) {
   200					this.bFull[i] = true;
   201				}
   202			}
   203		}

   377					g.drawOval(10 + i * 47 + 15, 525 + 15, 5, 5);
   378				} else if (i == this.GREEN_COIN) {
   379					g.setColor(0, 255, 0, 255);
   380					g.drawFilledOval(10 + i * 47 + 15, 525 + 15, 5, 5);
   381					g.setColor(0, 0, 0, 255);
   382					g.drawOval(10 + i * 47 + 15, 525 + 15, 5, 5);
   383				}
   384				if (i == this.RED_WALL) {
   385					this.drawWall(g, 0, 0, 10 + i * 47, 525, 0);

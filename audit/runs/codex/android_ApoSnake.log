   227		private void uploadString() {
   228			if (this.getGame().getUserlevels().addLevel(this.getLevelString())) {
   229				this.uploadString = new ApoSnakeString(240, 470, 20, "Uploading successfully", true, 20, true);
   230				this.getGame().loadUserlevels();
   231			} else {
   232				this.uploadString = new ApoSnakeString(240, 470, 20, "Uploading failed", true, 20, true);
   233			}
   234		}

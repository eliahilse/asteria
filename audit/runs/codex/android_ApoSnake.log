   240		private String getLevelString() {
   241			String level = "";
   242			char c = (char)(this.level[0].length + 96);
   243			level += String.valueOf(c);
   244			c = (char)(this.level.length + 96);
   245			level += String.valueOf(c);
   246			for (int y = 0; y < this.level.length; y++) {
   247				for (int x = 0; x < this.level[0].length; x++) {
   248					if (this.level[y][x] >= 10) {
   249						c = (char)(87 + this.level[y][x]);
   250						level += String.valueOf(c);
   251					} else {
   252						level += String.valueOf(this.level[y][x]);
   253					}
   254				}
   255			}
   256			return level;
   257		}

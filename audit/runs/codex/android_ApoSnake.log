   231		public void renderButtons(BitsGraphics g, final BitsFont font) {
   232			if (this.getButtons() != null) {
   233				for (int i = 0; i < this.getButtons().length; i++) {
   234					if (this.getButtons()[i].isBVisible()) {
   235						int x = (int)(this.getButtons()[i].getX());
   236						int y = (int)(this.getButtons()[i].getY());
   237						int width = (int)(this.getButtons()[i].getWidth());
   238						int height = (int)(this.getButtons()[i].getHeight());
   239						
   240						g.setColor(160, 160, 160, 255);
   241						g.drawFilledRoundRect(x, y, width, height, 6, 10);
   242						g.setLineSize(2.0f);
   243						g.setColor(48f/255f, 48f/255f, 48f/255f, 1.0f);
   244						g.drawRoundRect(x, y, width, height, 6, 10);
   245						g.setLineSize(1.0f);
   246						
   247						this.drawString(g, this.getButtons()[i].getFunction(), x + width/2, y + height/2 - font.mCharCellHeight/2 - 3, font);
   248					}
   249				}
   250			}
   251		}
   252	}

   394		
   395		private void drawWall(BitsGraphics g, int x, int y, int changeX, int changeY, int value) {
   396			g.setColor(200, 0, 0);
   397			if (value == 1) {
   398				g.setColor(90, 165, 200);
   399			} else if (value == 2) {
   400				g.setColor(0, 200, 0);							
   401			}
   402			g.drawFilledRect(changeX + 4 + x * 30, changeY + 4 + y * 30, 22, 22);
   403			g.setColor(150, 0, 0);
   404			if (value == 1) {
   405				g.setColor(0, 90, 200);
   406			} else if (value == 2) {
   407				g.setColor(0, 150, 0);							
   408			}
   409			g.drawFilledRect(changeX + 8 + x * 30, changeY + 8 + y * 30, 15, 15);
   410			g.setColor(0, 0, 0, 255);
   411			g.drawRect(changeX + 4 + x * 30, changeY + 4 + y * 30, 22, 22);
   412		}
   413		
   414		private void drawSnakeEyes(BitsGraphics g, int x, int y, int changeX, int changeY, int value) {
   415			g.drawFilledOval(changeX + x * 30 + 15, changeY + y * 30 + 15, 12, 12);
   416	
   417			g.setColor(0, 0, 0, 255);
   418			g.drawOval(changeX + x * 30 + 15, changeY + y * 30 + 15, 12, 12);
   419			
   420			if (value == 1) {
   421				g.drawFilledRect(changeX + x * 30 + 2, changeY + y * 30 + 11, 9, 3);
   422				g.drawFilledRect(changeX + x * 30 + 2, changeY + y * 30 + 16, 9, 3);
   423			} else if (value == 3) {
   424				g.drawFilledRect(changeX + (x + 1) * 30 - 11, changeY + y * 30 + 11, 9, 3);
   425				g.drawFilledRect(changeX + (x + 1) * 30 - 11, changeY + y * 30 + 16, 9, 3);
   426			} else if (value == 2) {
   427				g.drawFilledRect(changeX + (x) * 30 + 11, changeY + (y + 1) * 30 - 11, 3, 9);
   428				g.drawFilledRect(changeX + (x) * 30 + 16, changeY + (y + 1) * 30 - 11, 3, 9);
   429			} else if (value == 4) {
   430				g.drawFilledRect(changeX + (x) * 30 + 11, changeY + (y) * 30 + 2, 3, 9);
   431				g.drawFilledRect(changeX + (x) * 30 + 16, changeY + (y) * 30 + 2, 3, 9);
   432			}
   433		}
   434	
   435	}
     1	package net.apogames.aposnake.game;
     2	
     3	import net.gliblybits.bitsengine.utils.BitsLog;
     4	
     5	public class ApoSnakeSolve {
     6	
     7		private boolean bSolved;
     8		
     9		private boolean bBreak;
    10		
    11		private int count;
    12		
    13		public boolean shouldBreak() {
    14			return bBreak;
    15		}
    16	
    17		public void setBreak(boolean bBreak) {
    18			this.bBreak = bBreak;
    19		}
    20	
    21		public boolean canBeSolved(final int[][] level) {
    22			this.bSolved = false;
    23			this.bBreak = false;
    24			this.count = 0;
    25			
    26			this.checkLevel(this.getClone(level));
    27			
    28			return this.bSolved;
    29		}
    30		
    31		private void checkLevel(final int[][] level) {
    32			if (this.isLevelDone(level)) {
    33				this.bSolved = true;
    34			}
    35			if (this.bSolved) {
    36				return;
    37			}
    38			if (this.bBreak) {
    39				return;
    40			}
    41			this.count += 1;
    42	//		BitsLog.d("count", "count: "+count);
    43			for (int y = 0; y < 8; y++) {
    44				for (int x = 0; x < level[y].length; x++) {
    45					if (level[y + 8][x] >= 3) {
    46						int north = this.isNorthFree(level, x, y);
    47						if (north > 0) {
    48	//						BitsLog.d("test", level[13][0]+" "+level[14][0]+" "+level[15][0]);
    49							int[][] clone = this.getClone(level);
    50							clone[y + 8][x] = (byte)(clone[y + 8][x] - 1);
    51							setNorth(clone, x, y, north);
    52							this.checkLevel(clone);
    53							if ((this.bSolved) || (this.bBreak)) {
    54								return;
    55							}
    56	//						BitsLog.d("test", level[13][0]+" "+level[14][0]+" "+level[15][0]);
    57	//						this.setNorthBack(level, x, y, north);
    58	//						BitsLog.d("test", level[13][0]+" "+level[14][0]+" "+level[15][0]);
    59						}
    60						int east = this.isEastFree(level, x, y);
    61						if (east > 0) {
    62	//						BitsLog.d("test", "before "+level[15][0]+" "+level[15][1]+" "+level[15][2]);
    63							int[][] clone = this.getClone(level);
    64							clone[y + 8][x] = (byte)(clone[y + 8][x] - 1);
    65							setEast(clone, x, y, east);
    66							this.checkLevel(clone);
    67							if ((this.bSolved) || (this.bBreak)) {
    68								return;
    69							}
    70	//						BitsLog.d("test", "mid "+level[15][0]+" "+level[15][1]+" "+level[15][2]);
    71	//						this.setEastBack(level, x, y, east);
    72	//						BitsLog.d("test", "after "+level[15][0]+" "+level[15][1]+" "+level[15][2]);
    73						}
    74						int south = this.isSouthFree(level, x, y);
    75						if (south > 0) {
    76							int[][] clone = this.getClone(level);
    77							clone[y + 8][x] = (byte)(clone[y + 8][x] - 1);
    78							setSouth(clone, x, y, south);

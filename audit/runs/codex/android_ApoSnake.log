    86				if (this.userlevels.getLevels().get(i).equals(level)) {
    87					return false;
    88				}
    89			}
    90			return ApoSnakeUserlevelsLoad.getInstance().save(level);
    91		}
    92		
    93		public float getStars(int level) {
    94			if (this.userlevels.getCount().get(this.sortByUpload.get(level)) <= 0) {
    95				return 0;
    96			}
    97			return (float)((float)this.userlevels.getAll().get(this.sortByUpload.get(level)) / (float)this.userlevels.getCount().get(this.sortByUpload.get(level)));
    98		}
    99		
   100		public String getStatistics(int level) {		
   101			int[] values = new int[4];
   102			values[0] = this.userlevels.getFun().get(this.sortByUpload.get(level));
   103			values[1] = this.userlevels.getCreative().get(this.sortByUpload.get(level));
   104			values[2] = this.userlevels.getEasy().get(this.sortByUpload.get(level));
   105			values[3] = this.userlevels.getHard().get(this.sortByUpload.get(level));
   106			
   107			int max = this.getHighest(-1, values);
   108			int maxTwo = this.getHighest(max, values);
   109			String result = "";
   110			for (int i = 0; i < values.length; i++) {
   111				if ((i != max) && (i != maxTwo)) {
   112					result += "0";
   113				} else {
   114					if (values[i] > 0) {
   115						result += "1";
   116					} else {
   117						result += "0";
   118					}
   119				}
   120			}
   121	
   122			return result;
   123		}
   124		
   125		private int getHighest(int not, int[] values) {
   126			int curValue = 0;
   127			if (not == 0) {
   128				curValue = 1;
   129			}
   130			int max = values[curValue];
   131			for (int i = 0; i < values.length; i++) {
   132				if ((max < values[i]) && (i != not)) {
   133					max = values[i];
   134					curValue = i;
   135				}
   136			}
   137			return curValue;
   138		}
   139		
   140		public int getID(int level) {
   141			return this.userlevels.getId().get(this.sortByUpload.get(level));
   142		}
   143	}

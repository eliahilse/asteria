    44		private String[] getAllLevelsSorted() {
    45			BitsLog.d("level", ""+this.userlevels.getLevels().size());
    46			if (this.userlevels.getLevels().size() <= 0) {
    47				return null;
    48			}
    49			int size = this.sortByUpload.size();
    50			String[] levels = new String[size];
    51			for (int level = 0; level < levels.length; level++) {
    52				String curLevel = this.userlevels.getLevels().get(this.sortByUpload.get(level));
    53				BitsLog.d("level", curLevel);
    54				levels[level] = curLevel;
    55			}
    56			return levels;
    57		}
    58		
    59		private void sortByUpload() {
    60			this.sortByUpload.clear();
    61			for (int i = 0; i < this.userlevels.getLevels().size(); i++) {
    62				if (!ApoSnakeLevel.isIn(this.userlevels.getLevels().get(i))) {
    63					float time = this.userlevels.getTimes().get(i);
    64					boolean bAdd = false;
    65					for (int k = 0; k < this.sortByUpload.size(); k++) {
    66						float sortTime = this.userlevels.getTimes().get(this.sortByUpload.get(k));
    67						if (time > sortTime) {
    68							this.sortByUpload.add(k, i);
    69							bAdd = true;
    70							break;
    71						}
    72					}
    73					if (!bAdd) {
    74						this.sortByUpload.add(i);
    75					}
    76				}
    77			}
    78		}

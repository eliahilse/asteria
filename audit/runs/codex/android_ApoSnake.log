   105		@Override
   106		public void touchedPressed(int x, int y, int finger) {
   107			if (y > 505) {
   108				for (int i = 0; i <= this.GREEN_COIN; i++) {
   109					if ((x >= 5 + i * 47) && (x < 45 + i * 47) && (y >= 520) && (y < 560)) {
   110						this.curSelect = i;
   111					}
   112				}
   113			} else {
   114				int changeX = (480 - level[0].length * 30)/2;
   115				int changeY = (480 - level.length * 30)/2 + ApoSnakePuzzleGame.changeY;
   116				
   117				if ((y >= changeY) && (y < changeY + level.length * 30) &&
   118					(x >= changeX) && (x < changeX + level[0].length * 30)) {
   119					int newY = (y - changeY)/30;
   120					int newX = (x - changeX)/30;
   121					if (this.curSelect == this.EMPTY) {
   122						level[newY][newX] = 0;
   123					} else if (this.curSelect == this.RED_SNAKE) {
   124						if ((level[newY][newX] >= 1) && (level[newY][newX] <= 4)) {
   125							level[newY][newX] += 1;
   126							if (level[newY][newX] > 4) {
   127								level[newY][newX] = 1;
   128							}
   129						} else {
   130							level[newY][newX] = 1;
   131						}
   132					} else if (this.curSelect == this.RED_COIN) {
   133						level[newY][newX] = 5;
   134					} else if (this.curSelect == this.RED_WALL) {
   135						level[newY][newX] = 6;
   136					} else if (this.curSelect == this.BLUE_SNAKE) {
   137						if ((level[newY][newX] >= 7) && (level[newY][newX] <= 10)) {
   138							level[newY][newX] += 1;
   139							if (level[newY][newX] > 10) {
   140								level[newY][newX] = 7;
   141							}
   142						} else {
   143							level[newY][newX] = 7;
   144						}
   145					} else if (this.curSelect == this.BLUE_COIN) {
   146						level[newY][newX] = 11;
   147					} else if (this.curSelect == this.BLUE_WALL) {
   148						level[newY][newX] = 12;
   149					} else if (this.curSelect == this.GREEN_SNAKE) {
   150						if ((level[newY][newX] >= 13) && (level[newY][newX] <= 16)) {
   151							level[newY][newX] += 1;
   152							if (level[newY][newX] > 16) {
   153								level[newY][newX] = 13;
   154							}
   155						} else {
   156							level[newY][newX] = 13;
   157						}
   158					} else if (this.curSelect == this.GREEN_COIN) {
   159						level[newY][newX] = 17;
   160					} else if (this.curSelect == this.GREEN_WALL) {
   161						level[newY][newX] = 18;
   162					}
   163					this.checkTestLevel();
   164				}
   165			}
   166		}

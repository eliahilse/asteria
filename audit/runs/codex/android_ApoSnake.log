    70		public void setLevelSolved(boolean bSolved) {
    71			if ((!bSolved) || (!ApoSnake.isOnline())) {
    72				this.getGame().getButtons()[8].setVisible(false);
    73			} else {
    74				this.getGame().getButtons()[8].setVisible(true);
    75			}
    76		}
    77		
    78		private void checkTestLevel() {
    79			int snakes = 0;
    80			int coins = 0;
    81			for (int y = 0; y < this.level.length; y += 1) {
    82				for (int x = 0; x < this.level[y].length; x += 1) {
    83					if ((this.level[y][x] >= 1) && (this.level[y][x] <= 4)) {
    84						snakes += 1;
    85					}
    86					if ((this.level[y][x] >= 7) && (this.level[y][x] <= 10)) {
    87						snakes += 1;
    88					}
    89					if ((this.level[y][x] >= 13) && (this.level[y][x] <= 16)) {
    90						snakes += 1;
    91					}
    92					if ((this.level[y][x] == 5) || (this.level[y][x] == 11) || (this.level[y][x] == 17)) {
    93						coins += 1;
    94					}
    95				}
    96			}
    97			if ((snakes > 0) && (coins > 0)) {
    98				this.getGame().getButtons()[7].setVisible(true);
    99			} else {
   100				this.getGame().getButtons()[7].setVisible(false);
   101				this.getGame().getButtons()[8].setVisible(false);
   102			}
   103		}

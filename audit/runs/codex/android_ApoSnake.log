     9	public class ApoSnakePuzzleChooser extends ApoSnakeModel {
    10	
    11		public static final String BACK = "back";
    12		public static final String LEVEL_CHOOSER = "ApoSnake - Levelchooser";
    13		
    14		private ApoLevelChooserButton[] levels;
    15		
    16		private int solved = 0;
    17		
    18		private int curShow = 0;
    19		
    20		public ApoSnakePuzzleChooser(ApoSnakePanel game) {
    21			super(game);
    22		}
    23	
    24		@Override
    25		public void init() {
    26			this.getStringWidth().put(ApoSnakePuzzleChooser.BACK, (int)(ApoSnakeMenu.font.getLength(ApoSnakePuzzleChooser.BACK)));
    27			this.getStringWidth().put(ApoSnakePuzzleChooser.LEVEL_CHOOSER, (int)(ApoSnakeMenu.title_font.getLength(ApoSnakePuzzleChooser.LEVEL_CHOOSER)));
    28			
    29			this.curShow = 0;
    30			
    31			if (this.levels == null) {
    32				this.levels = new ApoLevelChooserButton[ApoSnakeLevel.MAX_LEVELS];
    33				
    34				int xPos = 20;
    35				int yPos = 50;
    36				int radius = 70;
    37				int add = 20;
    38				int curLevel = 0;
    39				for (int y = 0; y < 6; y++) {
    40					for (int x = 0; x < 5; x++) {
    41						this.levels[curLevel] = new ApoLevelChooserButton(null, xPos, yPos, radius, radius, String.valueOf(curLevel + 1));
    42						
    43						xPos += radius + add;
    44						curLevel += 1;
    45						if (curLevel >= this.levels.length) {
    46							break;
    47						}
    48					}
    49					xPos = 20;
    50					yPos += radius + add;
    51					if (curLevel >= this.levels.length) {
    52						break;
    53					}
    54					if (curLevel % 30 == 0) {
    55						yPos = 70;
    56					}
    57				}
    58				this.setSolved(0);
    59			}
    60		}
    61		
    62		public final int getSolved() {
    63			return this.solved;
    64		}
    65	
    66		public final void setSolved(int solved) {
    67			if (this.solved < solved) {
    68				this.solved = solved;
    69				if (this.solved > ApoSnakeLevel.MAX_LEVELS - 1) {
    70					this.solved = ApoSnakeLevel.MAX_LEVELS - 1;
    71				}
    72				if (this.solved < this.levels.length) {
    73					for (int i = 0; i < this.solved && i < this.levels.length; i++) {
    74						this.levels[i].setSolved(true);
    75					}
    76				}
    77				this.getGame().savePreferences(ApoSnake.settings);
    78			}
    79		}	
    80	
    81		@Override
    82		public void touchedPressed(int x, int y, int finger) {
    83			if (this.levels != null) {
    84				for (int i = this.curShow; i < this.curShow + 64 && i < this.levels.length && i <= this.solved; i++) {
    85					if (this.levels[i].intersects(x, y)) {
    86						this.getGame().setPuzzleGame(i, "", false);
    87					}
    88				}
    89			}
    90		}
    91	
    92		@Override
    93		public void touchedReleased(int x, int y, int finger) {
    94			
    95		}
    96	
    97		@Override
    98		public void touchedDragged(int x, int y, int oldX, int oldY, int finger) {
    99			
   100		}
   101	
   102		@Override
   103		public void touchedButton(String function) {
   104			if (function.equals(ApoSnakePuzzleChooser.BACK)) {
   105				this.onBackButtonPressed();
   106			}
   107		}
   108		
   109		public void onBackButtonPressed() {
   110			this.getGame().setMenu();
   111		}
   112	
   113		@Override
   114		public void think(int delta) {
   115			
   116		}
   117	
   118		@Override
   119		public void render(BitsGraphics g) {
   120			this.getGame().drawString(g, ApoSnakePuzzleChooser.LEVEL_CHOOSER, 240, 2, ApoSnakeMenu.title_font, new float[] {1, 1, 1, 1}, new float[] {0, 0, 0, 1});
   121			
   122			this.getGame().renderButtons(g);
   123			
   124			if (this.levels != null) {
   125				for (int i = this.curShow; i < this.curShow + 64 && i < this.levels.length; i++) {
   126					int x = (int)(this.levels[i].getX());
   127					int y = (int)(this.levels[i].getY());
   128					int radius = (int)(this.levels[i].getWidth());
   129					
   130					g.setColor(255, 255, 255, 255);
   131					if (this.levels[i].isSolved()) {
   132						g.setColor(102, 135, 89, 255);
   133					} else if (this.solved < i) {
   134						g.setColor(128, 128, 128, 255);
   135					}
   136					g.drawFilledCircle(x + radius/2, y + radius/2, radius/2, 120);
   137	
   138					g.setLineSize(2.5f);
   139					g.setColor(48, 48, 48);
   140					g.drawCircle(x + radius/2, y + radius/2, radius/2, 120);
   141					g.drawFilledRect(x + radius/2 - 4, y + 10, 3, 6);
   142					g.drawFilledRect(x + radius/2 + 1, y + 10, 3, 6);
   143					
   144					if (this.solved == i) {
   145						this.getGame().drawString(g, this.levels[i].getFunction(), x + radius/2 - (int)ApoSnakeMenu.font.getLength(this.levels[i].getFunction())/2, y + radius/2 - ApoSnakeMenu.font.mCharCellHeight/2, ApoSnakeMenu.font, new float[] {1, 1, 1, 1}, new float[] {0, 0, 0, 1});
   146					} else {
   147						this.getGame().drawString(g, this.levels[i].getFunction(), x + radius/2 - (int)ApoSnakeMenu.font.getLength(this.levels[i].getFunction())/2, y + radius/2 - ApoSnakeMenu.font.mCharCellHeight/2, ApoSnakeMenu.font);
   148					}
   149					
   150					g.setLineSize(1.0f);
   151				}
   152			}
   153		}
   154	
   155	}

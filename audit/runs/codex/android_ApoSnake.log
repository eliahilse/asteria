    53		public void checkTouchInput() {
    54			for (int i = 0; i < this.touched.length; i++) {
    55				final BitsTouchPointer pointer = BitsTouchPointerManager.getIt().get(i);
    56				boolean newTouched = false;
    57				if (pointer == null) {
    58					newTouched = false;
    59				} else {
    60					newTouched = pointer.isDown;
    61				}
    62				if ((newTouched) && (!this.touched[i])) {
    63					if (pointer != null) {
    64						int x = pointer.mX;
    65						int y = pointer.mY;
    66						this.oldX = x;
    67						this.oldY = y;
    68						
    69						boolean bButton = false;
    70						if (this.getButtons() != null) {
    71							for (int b = 0; b < this.getButtons().length; b++) {
    72								if ((this.getButtons()[b].isBVisible()) && (this.getButtons()[b].intersects(x, y, 1, 1))) {
    73									String function = this.getButtons()[b].getFunction();
    74									this.setButtonFunction(function);
    75									bButton = true;
    76									break;
    77								}
    78							}
    79						}
    80						if (!bButton) {
    81							if (this.model != null) {
    82								this.model.touchedPressed(x, y, i);
    83							}
    84						}
    85					}
    86				} else if ((!newTouched) && (this.touched[i])) {
    87					int x = 0;
    88					int y = 0;
    89					if (pointer != null) {
    90						x = pointer.mX;
    91						y = pointer.mY;
    92					}
    93					if (this.model != null) {
    94						this.model.touchedReleased(x, y, i);
    95					}
    96				} else if ((newTouched) && (this.touched[i])) {
    97					if (pointer != null) {
    98						int x = pointer.mX;
    99						int y = pointer.mY;
   100						
   101						if ((this.model != null) && ((this.oldX != x) || (this.oldY != y))) {
   102							this.model.touchedDragged(x, y, this.oldX, this.oldY, i);
   103						}
   104						this.oldX = x;
   105						this.oldY = y;
   106					}
   107				}
   108				this.touched[i] = newTouched; 
   109			}
   110		}

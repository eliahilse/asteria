    22		public void loadUserlevels() {
    23			try {
    24				this.userlevels = ApoSnakeUserlevelsLoad.getInstance();
    25				this.userlevels.load();
    26				
    27				if (this.userlevels.getLevels().size() > 0) {
    28					this.sortByUpload();
    29					
    30					ApoSnakeLevel.editorLevels = this.getAllLevelsSorted();
    31					
    32					this.game.setUserlevelsVisible();
    33				}
    34			} catch (Exception ex) {

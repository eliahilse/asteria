   102		private int isSouthFree(final int[][] level, final int x, final int y) {
   103			int i = 1;
   104			for (int curY = y + 1; curY < 8; curY++) {
   105				if (level[curY + 8][x] < 2) {
   106					return i;
   107				} else {
   108					i += 1;
   109				}
   110			}
   111			return -1;
   112		}
   113		
   114		private void setSouth(final int[][] level, final int x, final int y, final int south) {
   115			for (int curY = y + south; curY > y; curY--) {
   116				level[curY + 8][x] = level[curY + 8 - 1][x];
   117			}
   118			level[y + 8][x] = 0;
   119		}
   120		
   121		private void setSouthBack(final int[][] level, final int x, final int y, final int south) {
   122			for (int curY = y; curY < y + south; curY++) {
   123				level[curY + 8][x] = level[curY + 8 + 1][x];
   124			}
   125			level[y + 8][x] = (byte)(level[y + 8][x] + 1);
   126			level[y + 8 + south][x] = 0;
   127		}

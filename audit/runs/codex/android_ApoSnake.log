   210		private boolean isLevelDone(final int[][] level) {
   211			for (int y = 0; y < 8; y++) {
   212				for (int x = 0; x < level[y].length; x++) {
   213					if ((level[y + 8][x] == 2) && (level[y][x] <= 0)) {
   214						return false;
   215					}
   216					if (((level[y + 8][x] < 2) || (level[y + 8][x] > 2)) && (level[y][x] == 1)) {
   217						return false;
   218					}
   219					if (level[y + 8][x] >= 3) {
   220						return false;
   221					}
   222				}
   223			}
   224			return true;
   225		}
   226		
   227		private int[][] getClone(final int[][] copy) {
   228			int[][] clone = new int[copy.length][copy[0].length];
   229			for (int y = 0; y < clone.length; y++) {
   230				for (int x = 0; x < clone[y].length; x++) {
   231					clone[y][x] = copy[y][x];
   232				}
   233			}
   234			return clone;
   235		}

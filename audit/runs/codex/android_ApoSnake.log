    47			this.getStringWidth().put(ApoSnakeEditor.XPLUS, (int)(ApoSnakeMenu.game_font.getLength(ApoSnakeEditor.XPLUS)));
    48			this.getStringWidth().put(ApoSnakeEditor.YMINUS, (int)(ApoSnakeMenu.game_font.getLength(ApoSnakeEditor.YMINUS)));
    49			this.getStringWidth().put(ApoSnakeEditor.YPLUS, (int)(ApoSnakeMenu.game_font.getLength(ApoSnakeEditor.YPLUS)));
    50			
    51			String s = "ApoSnake - Editor";
    52			this.getStringWidth().put(s, (int) ApoSnakeMenu.game_font.getLength(s));
    53			
    54			if (this.level == null) {
    55				this.makeLevel();
    56			}
    57			
    58			this.checkTestLevel();
    59		}

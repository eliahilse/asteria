   178		@Override
   179		public void touchedButton(String function) {
   180			if (function.equals(ApoSnakeEditor.BACK)) {
   181				this.onBackButtonPressed();
   182			} else if (function.equals(ApoSnakeEditor.TEST)) {
   183				String levelString = this.getLevelString();
   184				BitsLog.d("levelString", levelString);
   185				this.getGame().setPuzzleGame(-1, levelString, false);
   186			} else if (function.equals(ApoSnakeEditor.UPLOAD)) {
   187				this.setLevelSolved(false);
   188				this.uploadString = new ApoSnakeString(240, 470, 20, "Uploading ...", true, 200, true);
   189				
   190				Thread t = new Thread(new Runnable() {
   191	
   192					public void run() {
   193						ApoSnakeEditor.this.uploadString();
   194					}
   195		 		});
   196		 		t.start();
   197			} else if (function.equals(ApoSnakeEditor.XMINUS)) {
   198				if (this.level[0].length - 1 >= 3) {
   199					this.newLevelSize(this.level[0].length - 1, this.level.length);
   200				}
   201			} else if (function.equals(ApoSnakeEditor.XPLUS)) {
   202				if (this.level[0].length + 1 <= 14) {
   203					this.newLevelSize(this.level[0].length + 1, this.level.length);
   204				}
   205			} else if (function.equals(ApoSnakeEditor.YMINUS)) {
   206				if (this.level.length - 1 >= 3) {
   207					this.newLevelSize(this.level[0].length, this.level.length - 1);
   208				}
   209			} else if (function.equals(ApoSnakeEditor.YPLUS)) {
   210				if (this.level.length + 1 <= 14) {
   211					this.newLevelSize(this.level[0].length, this.level.length + 1);
   212				}
   213			}
   214		}
   215		
   216		private void newLevelSize(int newWidth, int newHeight) {
   217			int[][] newLevel = new int[newHeight][newWidth];
   218			for (int y = 0; y < newHeight && y < level.length; y++) {
   219				for (int x = 0; x < newWidth && x < level[y].length; x++) {
   220					newLevel[y][x] = this.level[y][x];
   221				}
   222			}
   223			this.level = newLevel;
   224			this.checkTestLevel();
   225		}
